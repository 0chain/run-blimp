#!/bin/bash
# tpc_batch — run a batch of queries ONE AT A TIME through blimp, the way the
# SF1000 benchmark is run. Per query:
#   TICKS=2 blimp --query <q> --evict-family --tick --verify
#     one call: evict the query's MV family, author (+ the author's row-hash
#     verify), append + tick 1, append + tick 2, then compare the tick's answer
#     with the original query over base
# and prints one summary line per query.
#
# usage: ./tpc_batch <list-file>     (default: suites/all-99)
# The list file names the queries, whitespace- or line-separated, '#' comments:
#   17                  a TPC-DS query number (blimp --tpc 17)
#   first-10            a named suite under suites/
#   my_query.sql        a SQL file (blimp --sql); relative to the list file
#   queries/            a directory: every .sql file in it
# env: TPC_BATCH_OUT  log directory (default ./tpc_batch_logs)
#      BLIMP_ENV      wiring file, as for blimp
#      TPC_BATCH_EVICT=0  warm run: keep each query's MVs (default 1: evict the family first)
#      EVICT_FAMILY_AFTER=0 keep each query's family once it is measured
#                         (default 1: evict it — a long list otherwise keeps
#                         every query's MVs, and shared ones go stale)
#      TPC_BATCH_RESET_EVERY=N reset the source tables to their base load before
#                         every N-th query (default 10; 0 = never): roll every
#                         table back to its first snapshot, expire the
#                         abandoned snapshots and delete the data files they
#                         appended (bench_reset.py; log in $TPC_BATCH_OUT), then
#                         tell the gateway which tables moved. Without it a
#                         99-query batch reads ~200 ticks of appends by the end.
#      TPC_BATCH_RESET_PRUNE=0 reset without deleting the appended files
#      TPC_BATCH_VERIFY=0 ticks only: skip the phase-4 verify against base
#      TPC_BATCH_TICK=0   no append/tick: serve (or author) once, then the
#                         phase-4 verify if on — verify-only:
#                           TPC_BATCH_EVICT=0 TPC_BATCH_TICK=0 ./tpc_batch L
#                         author-only (evict the family, no verify):
#                           TPC_BATCH_TICK=0 TPC_BATCH_VERIFY=0 ./tpc_batch L
# --tick appends TPC-DS rows: on non-TPC-DS tables phase 2 reports CDC TICK
# FAILED and the ticks measure an unchanged MV (see README).
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
LIST="${1:-$HERE/suites/all-99}"
[ -f "$LIST" ] || { echo "no such list file: $LIST"; exit 2; }
LDIR="$(cd "$(dirname "$LIST")" && pwd)"
OUT="${TPC_BATCH_OUT:-./tpc_batch_logs}"; mkdir -p "$OUT"
SUM="$OUT/summary.txt"; : > "$SUM"
export EVICT_FAMILY_AFTER="${EVICT_FAMILY_AFTER:-1}"
ENVF="${BLIMP_ENV:-$HOME/.blimp_env}"
PY3="${BLIMP_PY:-$HOME/.blimp_venv/bin/python3}"; [ -x "$PY3" ] || PY3=python3

# reset_sources <label>: base data back, appended files gone, gateway told.
# Runs between queries only: bench_cdc's phase 4b drained the previous query's
# background work, so nothing is still reading the files it deletes.
reset_sources(){
  local log="$OUT/reset_$1.log" np="" tables
  [ "${TPC_BATCH_RESET_PRUNE:-1}" = 0 ] && np="--no-prune"
  if ! "$PY3" "$HERE/bench_reset.py" "$ENVF" apply $np > "$log" 2>&1; then
    echo "== reset before $1 FAILED (see $log) — continuing on the current data"; return
  fi
  tables=$(sed -n 's/^tables rolled back: //p' "$log")
  ( set -a; . "$ENVF"; set +a
    for tb in $tables; do
      curl -s -m 60 "http://${GW:-127.0.0.1}:9000/admin/source/snapshot_changed" -H "Authorization: Bearer ${CLUSTER_TOKEN:-}" \
        -H "Content-Type: application/json" -d "{\"namespace\":\"${NAMESPACE:-tpcds}\",\"table\":\"$tb\",\"trigger\":\"tpc_batch-reset\"}" >/dev/null
    done )
  echo "== reset before $1: $(grep -c '^rollback ' "$log") table(s) rolled back, $(sed -n 's/^pruned //p' "$log")"
}
nq=0

# entries: "tpc <n>" or "sql <path>", in list order
entries(){
  local t p f
  for t in $(grep -v '^[[:space:]]*#' "$1"); do
    if [[ "$t" =~ ^[0-9]+$ ]]; then echo "tpc $t"
    elif [ -f "$HERE/suites/$t" ]; then entries "$HERE/suites/$t"
    else
      case "$t" in /*) p="$t" ;; *) p="$LDIR/$t" ;; esac
      if [ -d "$p" ]; then for f in "$p"/*.sql; do [ -f "$f" ] && echo "sql $f"; done
      elif [ -f "$p" ]; then echo "sql $p"
      else echo "skip $t: not a query number, suite, .sql file or directory" >&2; fi
    fi
  done
}

# b <arg> <flags> <log>: one blimp run, every output line stamped with epoch seconds
b(){ "$HERE/blimp" --query $1 $2 2>&1 | while IFS= read -r l; do printf '%(%s)T %s\n' -1 "$l"; done > "$3"; }

while read -r kind q; do
  if [ "$kind" = tpc ]; then n="q$q"; arg="--tpc $q"; else n="$(basename "$q" .sql)"; arg="--sql $q"; fi
  RE="${TPC_BATCH_RESET_EVERY:-10}"
  if [ "$RE" -gt 0 ] 2>/dev/null && [ "$nq" -gt 0 ] && [ $((nq % RE)) -eq 0 ]; then reset_sources "$n"; fi
  nq=$((nq+1))
  t0=$(date +%s)
  echo "== $n $(date -u +%T)"
  # one call: evict family, author, tick 1, tick 2, verify (TICKS=2)
  # TPC_BATCH_EVICT=0: warm run — keep the query's MVs (no --evict-family)
  ev="--evict-family"; [ "${TPC_BATCH_EVICT:-1}" = 0 ] && ev=""
  # TPC_BATCH_VERIFY=0: ticks only, no phase-4 verify against base
  vf="--verify"; [ "${TPC_BATCH_VERIFY:-1}" = 0 ] && vf=""
  # TPC_BATCH_TICK=0: no append/tick (verify-only or author-only)
  tk="--tick"; [ "${TPC_BATCH_TICK:-1}" = 0 ] && tk=""
  # TPC_BATCH_TICKS: append/tick rounds per query (default 2)
  TICKS=${TPC_BATCH_TICKS:-2} b "$arg" "$ev $tk $vf" "$OUT/${n}_1.log"
  # author = wall seconds from phase 1 to the next phase (2 with a tick, else 4
  # or the results): the author's build, its row-hash verify and the drain of
  # its background work — or the warm serve when nothing was evicted
  aw=$(awk '/>> phase 1/{a=$1} /(>> phase [24]|= RESULTS =)/{if(a){print $1-a; exit}}' "$OUT/${n}_1.log")
  # check = wall seconds of the phase-4 verify (the original query over base)
  cw=$(awk '/>> phase 4/{a=$1} /(= RESULTS =|^[0-9]+ DONE)/{if(a){print $1-a; exit}} END{}' "$OUT/${n}_1.log")
  av=$(grep -m1 -oE "$n: author=[0-9?]+ materialize=[0-9?]+ verify=[0-9?]+" "$OUT/${n}_1.log" | sed 's/.*verify=//')
  case "$av" in ''|'?') ;; *) av=$(awk -v m="$av" 'BEGIN{printf "%.1f", m/1000}') ;; esac
  t1=$(grep -oE "$n: tick: [0-9.]+" "$OUT/${n}_1.log" | head -1 | awk '{print $3}')
  t2=$(grep -oE "$n: tick: [0-9.]+" "$OUT/${n}_1.log" | sed -n 2p | awk '{print $3}')
  v=$(grep -oE "$n: verify: [A-Z()a-z]+" "$OUT/${n}_1.log" | tail -1 | awk '{print $3}')
  # ticks whose gateway trace recorded a scale fallback (bench_cdc.sh prints them)
  fb=$(grep -c "$n: SCALE-FALLBACK" "$OUT/${n}_1.log"); fbf=""; [ "${fb:-0}" -gt 0 ] && fbf=" fallback=$fb"
  printf '%-14s author=%ss verify=%ss tick1=%ss tick2=%ss result=%s wall=%ss check=%ss%s\n' \
    "$n" "${aw:-?}" "${av:-?}" "${t1:-?}" "${t2:-?}" "${v:-?}" "$(( $(date +%s) - t0 ))" "${cw:-?}" "$fbf" | tee -a "$SUM"
done < <(entries "$LIST")
echo; echo "== summary ($(wc -l < "$SUM") queries; logs in $OUT)"; cat "$SUM"
