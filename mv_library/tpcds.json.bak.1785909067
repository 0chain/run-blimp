   "source_schema": "tpcds",
   "original_sql": "SELECT s_store_name, s_store_id, sum(CASE WHEN (d_day_name='Sunday') THEN ss_sales_price ELSE NULL END) sun_sales, sum(CASE WHEN (d_day_name='Monday') THEN ss_sales_price ELSE NULL END) mon_sales, sum(CASE WHEN (d_day_name='Tuesday') THEN ss_sales_price ELSE NULL END) tue_sales, sum(CASE WHEN (d_day_name='Wednesday') THEN ss_sales_price ELSE NULL END) wed_sales, sum(CASE WHEN (d_day_name='Thursday') THEN ss_sales_price ELSE NULL END) thu_sales, sum(CASE WHEN (d_day_name='Friday') THEN ss_sales_price ELSE NULL END) fri_sales, sum(CASE WHEN (d_day_name='Saturday') THEN ss_sales_price ELSE NULL END) sat_sales FROM date_dim, store_sales, store WHERE d_date_sk = ss_sold_date_sk AND s_store_sk = ss_store_sk AND s_gmt_offset = -5 AND d_year = 2000 GROUP BY s_store_name, s_store_id ORDER BY s_store_name, s_store_id, sun_sales, mon_sales, tue_sales, wed_sales, thu_sales, fri_sales, sat_sales LIMIT 100",
   "mv_sql": "SELECT s_store_name, s_store_id, s_gmt_offset, d_year, d_day_name,\n       sum(ss_sales_price) AS sales\nFROM date_dim, store_sales, store\nWHERE d_date_sk = ss_sold_date_sk AND s_store_sk = ss_store_sk\nGROUP BY s_store_name, s_store_id, s_gmt_offset, d_year, d_day_name",
   "rewrite_sql": "SELECT s_store_name, s_store_id,\n       sum(CASE WHEN (d_day_name='Sunday') THEN sales ELSE NULL END) sun_sales,\n       sum(CASE WHEN (d_day_name='Monday') THEN sales ELSE NULL END) mon_sales,\n       sum(CASE WHEN (d_day_name='Tuesday') THEN sales ELSE NULL END) tue_sales,\n       sum(CASE WHEN (d_day_name='Wednesday') THEN sales ELSE NULL END) wed_sales,\n       sum(CASE WHEN (d_day_name='Thursday') THEN sales ELSE NULL END) thu_sales,\n       sum(CASE WHEN (d_day_name='Friday') THEN sales ELSE NULL END) fri_sales,\n       sum(CASE WHEN (d_day_name='Saturday') THEN sales ELSE NULL END) sat_sales\nFROM iceberg.tpcds_mv.mv_h_abf1c141faa8\nWHERE s_gmt_offset = -5 AND d_year = 2000\nGROUP BY s_store_name, s_store_id\nORDER BY s_store_name, s_store_id, sun_sales, mon_sales, tue_sales, wed_sales,\n         thu_sales, fri_sales, sat_sales\nLIMIT 100",
   "delta_sql": "SELECT s_store_name, s_store_id, s_gmt_offset, d_year, d_day_name,\n       sum(ss_sales_price) AS sales\nFROM date_dim, $DELTA(store_sales), store\nWHERE d_date_sk = ss_sold_date_sk AND s_store_sk = ss_store_sk\nGROUP BY s_store_name, s_store_id, s_gmt_offset, d_year, d_day_name",
