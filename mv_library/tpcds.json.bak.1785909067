   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT i_item_id,\n       i_item_desc,\n       s_state,\n       count(ss_quantity) AS store_sales_quantitycount,\n       avg(ss_quantity) AS store_sales_quantityave,\n       stddev_samp(ss_quantity) AS store_sales_quantitystdev,\n       stddev_samp(ss_quantity)/avg(ss_quantity) AS store_sales_quantitycov,\n       count(sr_return_quantity) AS store_returns_quantitycount,\n       avg(sr_return_quantity) AS store_returns_quantityave,\n       stddev_samp(sr_return_quantity) AS store_returns_quantitystdev,\n       stddev_samp(sr_return_quantity)/avg(sr_return_quantity) AS store_returns_quantitycov,\n       count(cs_quantity) AS catalog_sales_quantitycount,\n       avg(cs_quantity) AS catalog_sales_quantityave,\n       stddev_samp(cs_quantity) AS catalog_sales_quantitystdev,\n       stddev_samp(cs_quantity)/avg(cs_quantity) AS catalog_sales_quantitycov\nFROM store_sales,\n     store_returns,\n     catalog_sales,\n     date_dim d1,\n     date_dim d2,\n     date_dim d3,\n     store,\n     item\nWHERE d1.d_quarter_name = '2001Q1'\n  AND d1.d_date_sk = ss_sold_date_sk\n  AND i_item_sk = ss_item_sk\n  AND s_store_sk = ss_store_sk\n  AND ss_customer_sk = sr_customer_sk\n  AND ss_item_sk = sr_item_sk\n  AND ss_ticket_number = sr_ticket_number\n  AND sr_returned_date_sk = d2.d_date_sk\n  AND d2.d_quarter_name IN ('2001Q1',\n                            '2001Q2',\n                            '2001Q3')\n  AND sr_customer_sk = cs_bill_customer_sk\n  AND sr_item_sk = cs_item_sk\n  AND cs_sold_date_sk = d3.d_date_sk\n  AND d3.d_quarter_name IN ('2001Q1',\n                            '2001Q2',\n                            '2001Q3')\nGROUP BY i_item_id,\n         i_item_desc,\n         s_state\nORDER BY i_item_id NULLS FIRST,\n         i_item_desc NULLS FIRST,\n         s_state NULLS FIRST\nLIMIT 100",
   "mv_sql": "SELECT i_item_id, i_item_desc, s_state, d1.d_quarter_name AS d1_quarter_name, d2.d_quarter_name AS d2_quarter_name, d3.d_quarter_name AS d3_quarter_name, count(ss_quantity) AS ss_qty_count, sum(ss_quantity) AS ss_qty_sum, sum(ss_quantity*ss_quantity) AS ss_qty_sumsq, count(sr_return_quantity) AS sr_qty_count, sum(sr_return_quantity) AS sr_qty_sum, sum(sr_return_quantity*sr_return_quantity) AS sr_qty_sumsq, count(cs_quantity) AS cs_qty_count, sum(cs_quantity) AS cs_qty_sum, sum(cs_quantity*cs_quantity) AS cs_qty_sumsq FROM store_sales, store_returns, catalog_sales, date_dim d1, date_dim d2, date_dim d3, store, item WHERE d1.d_date_sk = ss_sold_date_sk AND i_item_sk = ss_item_sk AND s_store_sk = ss_store_sk AND ss_customer_sk = sr_customer_sk AND ss_item_sk = sr_item_sk AND ss_ticket_number = sr_ticket_number AND sr_returned_date_sk = d2.d_date_sk AND sr_customer_sk = cs_bill_customer_sk AND sr_item_sk = cs_item_sk AND cs_sold_date_sk = d3.d_date_sk GROUP BY i_item_id, i_item_desc, s_state, d1.d_quarter_name, d2.d_quarter_name, d3.d_quarter_name",
   "rewrite_sql": "SELECT i_item_id, i_item_desc, s_state, sum(ss_qty_count) AS store_sales_quantitycount, sum(ss_qty_sum)::double precision / sum(ss_qty_count) AS store_sales_quantityave, sqrt( (sum(ss_qty_sumsq) - sum(ss_qty_sum)*sum(ss_qty_sum)/sum(ss_qty_count)) / nullif(sum(ss_qty_count)-1,0) ) AS store_sales_quantitystdev, sqrt( (sum(ss_qty_sumsq) - sum(ss_qty_sum)*sum(ss_qty_sum)/sum(ss_qty_count)) / nullif(sum(ss_qty_count)-1,0) ) / (sum(ss_qty_sum)::double precision / sum(ss_qty_count)) AS store_sales_quantitycov, sum(sr_qty_count) AS store_returns_quantitycount, sum(sr_qty_sum)::double precision / sum(sr_qty_count) AS store_returns_quantityave, sqrt( (sum(sr_qty_sumsq) - sum(sr_qty_sum)*sum(sr_qty_sum)/sum(sr_qty_count)) / nullif(sum(sr_qty_count)-1,0) ) AS store_returns_quantitystdev, sqrt( (sum(sr_qty_sumsq) - sum(sr_qty_sum)*sum(sr_qty_sum)/sum(sr_qty_count)) / nullif(sum(sr_qty_count)-1,0) ) / (sum(sr_qty_sum)::double precision / sum(sr_qty_count)) AS store_returns_quantitycov, sum(cs_qty_count) AS catalog_sales_quantitycount, sum(cs_qty_sum)::double precision / sum(cs_qty_count) AS catalog_sales_quantityave, sqrt( (sum(cs_qty_sumsq) - sum(cs_qty_sum)*sum(cs_qty_sum)/sum(cs_qty_count)) / nullif(sum(cs_qty_count)-1,0) ) AS catalog_sales_quantitystdev, sqrt( (sum(cs_qty_sumsq) - sum(cs_qty_sum)*sum(cs_qty_sum)/sum(cs_qty_count)) / nullif(sum(cs_qty_count)-1,0) ) / (sum(cs_qty_sum)::double precision / sum(cs_qty_count)) AS catalog_sales_quantitycov FROM tpcds_mv.store_sales_returns_catalog_rollup WHERE d1_quarter_name = '2001Q1' AND d2_quarter_name IN ('2001Q1','2001Q2','2001Q3') AND d3_quarter_name IN ('2001Q1','2001Q2','2001Q3') GROUP BY i_item_id, i_item_desc, s_state ORDER BY i_item_id NULLS FIRST, i_item_desc NULLS FIRST, s_state NULLS FIRST LIMIT 100",
   "delta_sql": "SELECT i_item_id, i_item_desc, s_state, d1.d_quarter_name AS d1_quarter_name, d2.d_quarter_name AS d2_quarter_name, d3.d_quarter_name AS d3_quarter_name, count(ss_quantity) AS ss_qty_count, sum(ss_quantity) AS ss_qty_sum, sum(ss_quantity*ss_quantity) AS ss_qty_sumsq, count(sr_return_quantity) AS sr_qty_count, sum(sr_return_quantity) AS sr_qty_sum, sum(sr_return_quantity*sr_return_quantity) AS sr_qty_sumsq, count(cs_quantity) AS cs_qty_count, sum(cs_quantity) AS cs_qty_sum, sum(cs_quantity*cs_quantity) AS cs_qty_sumsq FROM $DELTA(store_sales), $DELTA(store_returns), $DELTA(catalog_sales), date_dim d1, date_dim d2, date_dim d3, store, item WHERE d1.d_date_sk = ss_sold_date_sk AND i_item_sk = ss_item_sk AND s_store_sk = ss_store_sk AND ss_customer_sk = sr_customer_sk AND ss_item_sk = sr_item_sk AND ss_ticket_number = sr_ticket_number AND sr_returned_date_sk = d2.d_date_sk AND sr_customer_sk = cs_bill_customer_sk AND sr_item_sk = cs_item_sk AND cs_sold_date_sk = d3.d_date_sk GROUP BY i_item_id, i_item_desc, s_state, d1.d_quarter_name, d2.d_quarter_name, d3.d_quarter_name",
   "row_hash_at_author": "3eac1f3c2ef5215eb9bd13e28ae0975a",
   "sql_fingerprint_sha256": "15541b9c7113fa68"
