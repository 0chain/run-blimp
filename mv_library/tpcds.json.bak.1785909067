   "mv_table": "mv_h_485a95d74fa7",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 544658,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT w_substr, sm_type, web_name, sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk <= 30) THEN 1 ELSE 0 END) AS \"30 days\", sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk > 30) AND (ws_ship_date_sk - ws_sold_date_sk <= 60) THEN 1 ELSE 0 END) AS \"31-60 days\", sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk > 60) AND (ws_ship_date_sk - ws_sold_date_sk <= 90) THEN 1 ELSE 0 END) AS \"61-90 days\", sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk > 90) AND (ws_ship_date_sk - ws_sold_date_sk <= 120) THEN 1 ELSE 0 END) AS \"91-120 days\", sum(CASE WHEN (ws_ship_date_sk - ws_sold_date_sk > 120) THEN 1 ELSE 0 END) AS \">120 days\" FROM web_sales, (SELECT SUBSTRING(w_warehouse_name,1,20) w_substr, * FROM warehouse) sq1, ship_mode, web_site, date_dim WHERE d_month_seq BETWEEN 1200 AND 1200 + 11 AND ws_ship_date_sk = d_date_sk AND ws_warehouse_sk = w_warehouse_sk AND ws_ship_mode_sk = sm_ship_mode_sk AND ws_web_site_sk = web_site_sk GROUP BY w_substr, sm_type, web_name ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3 NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT w_substr, sm_type, web_name, d_month_seq,\n       ws_ship_date_sk - ws_sold_date_sk AS days_diff,\n       count(*) AS cnt\nFROM web_sales, (SELECT SUBSTRING(w_warehouse_name,1,20) w_substr, * FROM warehouse) sq1,\n     ship_mode, web_site, date_dim\nWHERE ws_ship_date_sk = d_date_sk\n  AND ws_warehouse_sk = w_warehouse_sk\n  AND ws_ship_mode_sk = sm_ship_mode_sk\n  AND ws_web_site_sk = web_site_sk\nGROUP BY w_substr, sm_type, web_name, d_month_seq, ws_ship_date_sk - ws_sold_date_sk",
   "rewrite_sql": "SELECT w_substr, sm_type, web_name,\n       sum(CASE WHEN days_diff <= 30 THEN cnt ELSE 0 END) AS \"30 days\",\n       sum(CASE WHEN (days_diff > 30) AND (days_diff <= 60) THEN cnt ELSE 0 END) AS \"31-60 days\",\n       sum(CASE WHEN (days_diff > 60) AND (days_diff <= 90) THEN cnt ELSE 0 END) AS \"61-90 days\",\n       sum(CASE WHEN (days_diff > 90) AND (days_diff <= 120) THEN cnt ELSE 0 END) AS \"91-120 days\",\n       sum(CASE WHEN days_diff > 120 THEN cnt ELSE 0 END) AS \">120 days\"\nFROM iceberg.tpcds_mv.mv_h_485a95d74fa7\nWHERE d_month_seq BETWEEN 1200 AND 1200 + 11\nGROUP BY w_substr, sm_type, web_name\nORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3 NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT w_substr, sm_type, web_name, d_month_seq,\n       ws_ship_date_sk - ws_sold_date_sk AS days_diff,\n       count(*) AS cnt\nFROM $DELTA(web_sales), (SELECT SUBSTRING(w_warehouse_name,1,20) w_substr, * FROM warehouse) sq1,\n     ship_mode, web_site, date_dim\nWHERE ws_ship_date_sk = d_date_sk\n  AND ws_warehouse_sk = w_warehouse_sk\n  AND ws_ship_mode_sk = sm_ship_mode_sk\n  AND ws_web_site_sk = web_site_sk\nGROUP BY w_substr, sm_type, web_name, d_month_seq, ws_ship_date_sk - ws_sold_date_sk",
   "row_hash_at_author": "ac1b37d48282a2666637761146095720",
   "sql_fingerprint_sha256": "4c0f3629b2f29717"
  },
  {
   "labels": [
    "q39"
   ],
   "qid_pattern": "",
   "category": "subquery",
   "shape_class": "groupby|none|equality|avg|none",
   "tier": "harness",
   "archetype_id": "",
   "mv_table": "mv_h_4d6daeabac0f",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 2700000,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "WITH inv AS (SELECT w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, stdev, mean, CASE mean WHEN 0 THEN NULL ELSE stdev/mean END cov FROM (SELECT w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, stddev_samp(inv_quantity_on_hand)*1.000 stdev, avg(inv_quantity_on_hand) mean FROM inventory, item, warehouse, date_dim WHERE inv_item_sk = i_item_sk AND inv_warehouse_sk = w_warehouse_sk AND inv_date_sk = d_date_sk AND d_year =2001 GROUP BY w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy) foo WHERE CASE mean WHEN 0 THEN 0 ELSE stdev/mean END > 1) SELECT inv1.w_warehouse_sk wsk1, inv1.i_item_sk isk1, inv1.d_moy dmoy1, inv1.mean mean1, inv1.cov cov1, inv2.w_warehouse_sk, inv2.i_item_sk, inv2.d_moy, inv2.mean, inv2.cov FROM inv inv1, inv inv2 WHERE inv1.i_item_sk = inv2.i_item_sk AND inv1.w_warehouse_sk = inv2.w_warehouse_sk AND inv1.d_moy=1 AND inv2.d_moy=1+1 ORDER BY inv1.w_warehouse_sk NULLS FIRST, inv1.i_item_sk NULLS FIRST, inv1.d_moy NULLS FIRST, inv1.mean NULLS FIRST, inv1.cov NULLS FIRST, inv2.d_moy NULLS FIRST, inv2.mean NULLS FIRST, inv2.cov NULLS FIRST",
   "mv_sql": "SELECT w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, d_year,\n       count(inv_quantity_on_hand) AS qcnt,\n       sum(inv_quantity_on_hand) AS qsum,\n       sum(inv_quantity_on_hand*inv_quantity_on_hand) AS qsq\nFROM inventory, item, warehouse, date_dim\nWHERE inv_item_sk = i_item_sk AND inv_warehouse_sk = w_warehouse_sk AND inv_date_sk = d_date_sk\nGROUP BY w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, d_year",
   "rewrite_sql": "WITH inv AS\n  (SELECT w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, stdev, mean,\n          CASE mean WHEN 0 THEN NULL ELSE stdev/mean END cov\n   FROM (SELECT w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy,\n                CASE WHEN sum(qcnt) > 1 THEN sqrt((sum(qcnt)*sum(qsq) - sum(qsum)*sum(qsum))/(sum(qcnt)*(sum(qcnt)-1))) ELSE NULL END*1.000 stdev,\n                sum(qsum)/sum(qcnt) mean\n         FROM iceberg.tpcds_mv.mv_h_4d6daeabac0f\n         WHERE d_year = 2001\n         GROUP BY w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy) foo\n   WHERE CASE mean WHEN 0 THEN 0 ELSE stdev/mean END > 1)\nSELECT inv1.w_warehouse_sk wsk1, inv1.i_item_sk isk1, inv1.d_moy dmoy1, inv1.mean mean1,\n       inv1.cov cov1, inv2.w_warehouse_sk, inv2.i_item_sk, inv2.d_moy, inv2.mean, inv2.cov\nFROM inv inv1, inv inv2\nWHERE inv1.i_item_sk = inv2.i_item_sk AND inv1.w_warehouse_sk = inv2.w_warehouse_sk\n  AND inv1.d_moy=1 AND inv2.d_moy=1+1\nORDER BY inv1.w_warehouse_sk NULLS FIRST, inv1.i_item_sk NULLS FIRST, inv1.d_moy NULLS FIRST,\n         inv1.mean NULLS FIRST, inv1.cov NULLS FIRST, inv2.d_moy NULLS FIRST,\n         inv2.mean NULLS FIRST, inv2.cov NULLS FIRST",
   "delta_sql": "SELECT w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, d_year,\n       count(inv_quantity_on_hand) AS qcnt,\n       sum(inv_quantity_on_hand) AS qsum,\n       sum(inv_quantity_on_hand*inv_quantity_on_hand) AS qsq\nFROM $DELTA(inventory), item, warehouse, date_dim\nWHERE inv_item_sk = i_item_sk AND inv_warehouse_sk = w_warehouse_sk AND inv_date_sk = d_date_sk\nGROUP BY w_warehouse_name, w_warehouse_sk, i_item_sk, d_moy, d_year",
   "row_hash_at_author": "0bbb6fee70ecf5d7f9cf6c57236cdd10",
   "sql_fingerprint_sha256": "4258faa5604d82ad"
  },
  {
   "labels": [
    "q48"
   ],
   "qid_pattern": "",
   "category": "join",
   "shape_class": "global-scalar|none|or-of-and|additive|none",
   "tier": "harness",
   "archetype_id": "",
   "mv_table": "mv_h_507fb0de630c",
   "mv_namespace": "tpcds_mv",
