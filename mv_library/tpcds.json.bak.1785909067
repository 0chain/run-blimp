34',\n                                     '56571',\n                                     '14060',\n                                     '19505',\n                                     '72425',\n                                     '56575',\n                                     '74351',\n                                     '68786',\n                                     '51650',\n                                     '20004',\n                                     '18383',\n                                     '76614',\n                                     '11634',\n                                     '18906',\n                                     '15765',\n                                     '41368',\n                                     '73241',\n                                     '76698',\n                                     '78567',\n                                     '97189',\n                                     '28545',\n                                     '76231',\n                                     '75691',\n                                     '22246',\n                                     '51061',\n                                     '90578',\n                                     '56691',\n                                     '68014',\n                                     '51103',\n                                     '94167',\n                                     '57047',\n                                     '14867',\n                                     '73520',\n                                     '15734',\n                                     '63435',\n                                     '25733',\n                                     '35474',\n                                     '24676',\n                                     '94627',\n                                     '53535',\n                                     '17879',\n                                     '15559',\n                                     '53268',\n                                     '59166',\n                                     '11928',\n                                     '59402',\n                                     '33282',\n                                     '45721',\n                                     '43933',\n                                     '68101',\n                                     '33515',\n                                     '36634',\n                                     '71286',\n                                     '19736',\n                                     '58058',\n                                     '55253',\n                                     '67473',\n                                     '41918',\n                                     '19515',\n                                     '36495',\n                                     '19430',\n                                     '22351',\n                                     '77191',\n                                     '91393',\n                                     '49156',\n                                     '50298',\n                                     '87501',\n                                     '18652',\n                                     '53179',\n                                     '18767',\n                                     '63193',\n                                     '23968',\n                                     '65164',\n                                     '68880',\n                                     '21286',\n                                     '72823',\n                                     '58470',\n                                     '67301',\n                                     '13394',\n                                     '31016',\n                                     '70372',\n                                     '67030',\n                                     '40604',\n                                     '24317',\n                                     '45748',\n                                     '39127',\n                                     '26065',\n                                     '77721',\n                                     '31029',\n                                     '31880',\n                                     '60576',\n                                     '24671',\n                                     '45549',\n                                     '13376',\n                                     '50016',\n                                     '33123',\n                                     '19769',\n                                     '22927',\n                                     '97789',\n                                     '46081',\n                                     '72151',\n                                     '15723',\n                                     '46136',\n                                     '51949',\n                                     '68100',\n                                     '96888',\n                                     '64528',\n                                     '14171',\n                                     '79777',\n                                     '28709',\n                                     '11489',\n                                     '25103',\n                                     '32213',\n                                     '78668',\n                                     '22245',\n                                     '15798',\n                                     '27156',\n                                     '37930',\n                                     '62971',\n                                     '21337',\n                                     '51622',\n                                     '67853',\n                                     '10567',\n                                     '38415',\n                                     '15455',\n                                     '58263',\n                                     '42029',\n                                     '60279',\n                                     '37125',\n                                     '56240',\n                                     '88190',\n                                     '50308',\n                                     '26859',\n                                     '64457',\n                                     '89091',\n                                     '82136',\n                                     '62377',\n                                     '36233',\n                                     '63837',\n                                     '58078',\n                                     '17043',\n                                     '30010',\n                                     '60099',\n                                     '28810',\n                                     '98025',\n                                     '29178',\n                                     '87343',\n                                     '73273',\n                                     '30469',\n                                     '64034',\n                                     '39516',\n                                     '86057',\n                                     '21309',\n                                     '90257',\n                                     '67875',\n                                     '40162',\n                                     '11356',\n                                     '73650',\n                                     '61810',\n                                     '72013',\n                                     '30431',\n                                     '22461',\n                                     '19512',\n                                     '13375',\n                                     '55307',\n                                     '30625',\n                                     '83849',\n                                     '68908',\n                                     '26689',\n                                     '96451',\n                                     '38193',\n                                     '46820',\n                                     '88885',\n                                     '84935',\n                                     '69035',\n                                     '83144',\n                                     '47537',\n                                     '56616',\n                                     '94983',\n                                     '48033',\n                                     '69952',\n                                     '25486',\n                                     '61547',\n                                     '27385',\n                                     '61860',\n                                     '58048',\n                                     '56910',\n                                     '16807',\n                                     '17871',\n                                     '35258',\n                                     '31387',\n                                     '35458',\n                                     '35576') INTERSECT\n        SELECT ca_zip\n        FROM\n          (SELECT SUBSTRING(ca_zip, 1, 5) ca_zip,\n                  count(*) cnt\n           FROM customer_address,\n                customer\n           WHERE ca_address_sk = c_current_addr_sk\n             AND c_preferred_cust_flag='Y'\n           GROUP BY ca_zip\n           HAVING count(*) > 10)A1)A2) V1\nWHERE d_qoy = 2\n  AND d_year = 1998\n  AND (s_zip2 = SUBSTRING(V1.ca_zip, 1, 2))\nGROUP BY s_store_name\nORDER BY s_store_name\nLIMIT 100",
   "delta_sql": "SELECT s_store_name,\n       SUBSTRING(s_zip, 1, 2) AS s_zip2,\n       d_qoy,\n       d_year,\n       sum(ss_net_profit) AS net_profit_sum\nFROM $DELTA(store_sales), date_dim, store\nWHERE ss_store_sk = s_store_sk AND ss_sold_date_sk = d_date_sk\nGROUP BY s_store_name, SUBSTRING(s_zip, 1, 2), d_qoy, d_year",
