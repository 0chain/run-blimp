   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 3677402,
   "mv_cols": 6,
   "source_schema": "tpcds",
   "original_sql": "SELECT ss_customer_sk,\n       sum(act_sales) sumsales\nFROM\n  (SELECT ss_item_sk,\n          ss_ticket_number,\n          ss_customer_sk,\n          CASE\n              WHEN sr_return_quantity IS NOT NULL THEN (ss_quantity-sr_return_quantity)*ss_sales_price\n              ELSE (ss_quantity*ss_sales_price)\n          END act_sales\n   FROM store_sales\n   LEFT OUTER JOIN store_returns ON (sr_item_sk = ss_item_sk\n                                     AND sr_ticket_number = ss_ticket_number) ,reason\n   WHERE sr_reason_sk = r_reason_sk\n     AND r_reason_desc = 'reason 28') t\nGROUP BY ss_customer_sk\nORDER BY sumsales NULLS FIRST,\n         ss_customer_sk NULLS FIRST\nLIMIT 100",
   "mv_sql": "SELECT ss_item_sk, ss_ticket_number, ss_customer_sk, sr_reason_sk, SUM(CASE WHEN sr_return_quantity IS NOT NULL THEN (ss_quantity-sr_return_quantity)*ss_sales_price ELSE (ss_quantity*ss_sales_price) END) AS sum_act_sales, COUNT(*) AS cnt FROM store_sales LEFT OUTER JOIN store_returns ON (sr_item_sk = ss_item_sk AND sr_ticket_number = ss_ticket_number) GROUP BY ss_item_sk, ss_ticket_number, ss_customer_sk, sr_reason_sk",
   "rewrite_sql": "SELECT ss_customer_sk, sum(sumsales) sumsales FROM (SELECT m.ss_customer_sk, m.sum_act_sales AS sumsales FROM tpcds_mv.store_sales_returns_by_reason m LEFT JOIN reason r ON m.sr_reason_sk = r.r_reason_sk WHERE r.r_reason_desc = 'reason 28') t GROUP BY ss_customer_sk ORDER BY sumsales NULLS FIRST, ss_customer_sk NULLS FIRST LIMIT 100",
   "delta_sql": "SELECT ss_item_sk, ss_ticket_number, ss_customer_sk, sr_reason_sk, SUM(CASE WHEN sr_return_quantity IS NOT NULL THEN (ss_quantity-sr_return_quantity)*ss_sales_price ELSE (ss_quantity*ss_sales_price) END) AS sum_act_sales, COUNT(*) AS cnt FROM $DELTA(store_sales) LEFT OUTER JOIN $DELTA(store_returns) ON (sr_item_sk = ss_item_sk AND sr_ticket_number = ss_ticket_number) GROUP BY ss_item_sk, ss_ticket_number, ss_customer_sk, sr_reason_sk",
   "row_hash_at_author": "1962e78c8440869c602e986c9637b58f",
