   "source_schema": "tpcds",
   "original_sql": "SELECT *\nFROM\n  (SELECT count(*) h8_30_to_9\n   FROM store_sales,\n        household_demographics,\n        time_dim,\n        store\n   WHERE ss_sold_time_sk = time_dim.t_time_sk\n     AND ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND ss_store_sk = s_store_sk\n     AND time_dim.t_hour = 8\n     AND time_dim.t_minute >= 30\n     AND ((household_demographics.hd_dep_count = 4\n           AND household_demographics.hd_vehicle_count<=4+2)\n          OR (household_demographics.hd_dep_count = 2\n              AND household_demographics.hd_vehicle_count<=2+2)\n          OR (household_demographics.hd_dep_count = 0\n              AND household_demographics.hd_vehicle_count<=0+2))\n     AND store.s_store_name = 'ese') s1,\n  (SELECT count(*) h9_to_9_30\n   FROM store_sales,\n        household_demographics,\n        time_dim,\n        store\n   WHERE ss_sold_time_sk = time_dim.t_time_sk\n     AND ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND ss_store_sk = s_store_sk\n     AND time_dim.t_hour = 9\n     AND time_dim.t_minute < 30\n     AND ((household_demographics.hd_dep_count = 4\n           AND household_demographics.hd_vehicle_count<=4+2)\n          OR (household_demographics.hd_dep_count = 2\n              AND household_demographics.hd_vehicle_count<=2+2)\n          OR (household_demographics.hd_dep_count = 0\n              AND household_demographics.hd_vehicle_count<=0+2))\n     AND store.s_store_name = 'ese') s2,\n  (SELECT count(*) h9_30_to_10\n   FROM store_sales,\n        household_demographics,\n        time_dim,\n        store\n   WHERE ss_sold_time_sk = time_dim.t_time_sk\n     AND ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND ss_store_sk = s_store_sk\n     AND time_dim.t_hour = 9\n     AND time_dim.t_minute >= 30\n     AND ((household_demographics.hd_dep_count = 4\n           AND household_demographics.hd_vehicle_count<=4+2)\n          OR (household_demographics.hd_dep_count = 2\n              AND household_demographics.hd_vehicle_count<=2+2)\n          OR (household_demographics.hd_dep_count = 0\n              AND household_demographics.hd_vehicle_count<=0+2))\n     AND store.s_store_name = 'ese') s3,\n  (SELECT count(*) h10_to_10_30\n   FROM store_sales,\n        household_demographics,\n        time_dim,\n        store\n   WHERE ss_sold_time_sk = time_dim.t_time_sk\n     AND ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND ss_store_sk = s_store_sk\n     AND time_dim.t_hour = 10\n     AND time_dim.t_minute < 30\n     AND ((household_demographics.hd_dep_count = 4\n           AND household_demographics.hd_vehicle_count<=4+2)\n          OR (household_demographics.hd_dep_count = 2\n              AND household_demographics.hd_vehicle_count<=2+2)\n          OR (household_demographics.hd_dep_count = 0\n              AND household_demographics.hd_vehicle_count<=0+2))\n     AND store.s_store_name = 'ese') s4,\n  (SELECT count(*) h10_30_to_11\n   FROM store_sales,\n        household_demographics,\n        time_dim,\n        store\n   WHERE ss_sold_time_sk = time_dim.t_time_sk\n     AND ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND ss_store_sk = s_store_sk\n     AND time_dim.t_hour = 10\n     AND time_dim.t_minute >= 30\n     AND ((household_demographics.hd_dep_count = 4\n           AND household_demographics.hd_vehicle_count<=4+2)\n          OR (household_demographics.hd_dep_count = 2\n              AND household_demographics.hd_vehicle_count<=2+2)\n          OR (household_demographics.hd_dep_count = 0\n              AND household_demographics.hd_vehicle_count<=0+2))\n     AND store.s_store_name = 'ese') s5,\n  (SELECT count(*) h11_to_11_30\n   FROM store_sales,\n        household_demographics,\n        time_dim,\n        store\n   WHERE ss_sold_time_sk = time_dim.t_time_sk\n     AND ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND ss_store_sk = s_store_sk\n     AND time_dim.t_hour = 11\n     AND time_dim.t_minute < 30\n     AND ((household_demographics.hd_dep_count = 4\n           AND household_demographics.hd_vehicle_count<=4+2)\n          OR (household_demographics.hd_dep_count = 2\n              AND household_demographics.hd_vehicle_count<=2+2)\n          OR (household_demographics.hd_dep_count = 0\n              AND household_demographics.hd_vehicle_count<=0+2))\n     AND store.s_store_name = 'ese') s6,\n  (SELECT count(*) h11_30_to_12\n   FROM store_sales,\n        household_demographics,\n        time_dim,\n        store\n   WHERE ss_sold_time_sk = time_dim.t_time_sk\n     AND ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND ss_store_sk = s_store_sk\n     AND time_dim.t_hour = 11\n     AND time_dim.t_minute >= 30\n     AND ((household_demographics.hd_dep_count = 4\n           AND household_demographics.hd_vehicle_count<=4+2)\n          OR (household_demographics.hd_dep_count = 2\n              AND household_demographics.hd_vehicle_count<=2+2)\n          OR (household_demographics.hd_dep_count = 0\n              AND household_demographics.hd_vehicle_count<=0+2))\n     AND store.s_store_name = 'ese') s7,\n  (SELECT count(*) h12_to_12_30\n   FROM store_sales,\n        household_demographics,\n        time_dim,\n        store\n   WHERE ss_sold_time_sk = time_dim.t_time_sk\n     AND ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND ss_store_sk = s_store_sk\n     AND time_dim.t_hour = 12\n     AND time_dim.t_minute < 30\n     AND ((household_demographics.hd_dep_count = 4\n           AND household_demographics.hd_vehicle_count<=4+2)\n          OR (household_demographics.hd_dep_count = 2\n              AND household_demographics.hd_vehicle_count<=2+2)\n          OR (household_demographics.hd_dep_count = 0\n              AND household_demographics.hd_vehicle_count<=0+2))\n     AND store.s_store_name = 'ese') s8",
   "mv_sql": "SELECT ss_store_sk, ss_hdemo_sk, time_dim.t_hour AS t_hour, time_dim.t_minute AS t_minute, household_demographics.hd_dep_count AS hd_dep_count, household_demographics.hd_vehicle_count AS hd_vehicle_count, store.s_store_name AS s_store_name, COUNT(*) AS cnt FROM store_sales, household_demographics, time_dim, store WHERE ss_sold_time_sk = time_dim.t_time_sk AND ss_hdemo_sk = household_demographics.hd_demo_sk AND ss_store_sk = s_store_sk GROUP BY ss_store_sk, ss_hdemo_sk, time_dim.t_hour, time_dim.t_minute, household_demographics.hd_dep_count, household_demographics.hd_vehicle_count, store.s_store_name",
   "rewrite_sql": "SELECT s1.h8_30_to_9, s2.h9_to_9_30, s3.h9_30_to_10, s4.h10_to_10_30, s5.h10_30_to_11, s6.h11_to_11_30, s7.h11_30_to_12, s8.h12_to_12_30 FROM (SELECT SUM(cnt) h8_30_to_9 FROM tpcds_mv.store_sales_hdemo_time_rollup WHERE s_store_name='ese' AND t_hour=8 AND t_minute>=30 AND ((hd_dep_count=4 AND hd_vehicle_count<=4+2) OR (hd_dep_count=2 AND hd_vehicle_count<=2+2) OR (hd_dep_count=0 AND hd_vehicle_count<=0+2))) s1, (SELECT SUM(cnt) h9_to_9_30 FROM tpcds_mv.store_sales_hdemo_time_rollup WHERE s_store_name='ese' AND t_hour=9 AND t_minute<30 AND ((hd_dep_count=4 AND hd_vehicle_count<=4+2) OR (hd_dep_count=2 AND hd_vehicle_count<=2+2) OR (hd_dep_count=0 AND hd_vehicle_count<=0+2))) s2, (SELECT SUM(cnt) h9_30_to_10 FROM tpcds_mv.store_sales_hdemo_time_rollup WHERE s_store_name='ese' AND t_hour=9 AND t_minute>=30 AND ((hd_dep_count=4 AND hd_vehicle_count<=4+2) OR (hd_dep_count=2 AND hd_vehicle_count<=2+2) OR (hd_dep_count=0 AND hd_vehicle_count<=0+2))) s3, (SELECT SUM(cnt) h10_to_10_30 FROM tpcds_mv.store_sales_hdemo_time_rollup WHERE s_store_name='ese' AND t_hour=10 AND t_minute<30 AND ((hd_dep_count=4 AND hd_vehicle_count<=4+2) OR (hd_dep_count=2 AND hd_vehicle_count<=2+2) OR (hd_dep_count=0 AND hd_vehicle_count<=0+2))) s4, (SELECT SUM(cnt) h10_30_to_11 FROM tpcds_mv.store_sales_hdemo_time_rollup WHERE s_store_name='ese' AND t_hour=10 AND t_minute>=30 AND ((hd_dep_count=4 AND hd_vehicle_count<=4+2) OR (hd_dep_count=2 AND hd_vehicle_count<=2+2) OR (hd_dep_count=0 AND hd_vehicle_count<=0+2))) s5, (SELECT SUM(cnt) h11_to_11_30 FROM tpcds_mv.store_sales_hdemo_time_rollup WHERE s_store_name='ese' AND t_hour=11 AND t_minute<30 AND ((hd_dep_count=4 AND hd_vehicle_count<=4+2) OR (hd_dep_count=2 AND hd_vehicle_count<=2+2) OR (hd_dep_count=0 AND hd_vehicle_count<=0+2))) s6, (SELECT SUM(cnt) h11_30_to_12 FROM tpcds_mv.store_sales_hdemo_time_rollup WHERE s_store_name='ese' AND t_hour=11 AND t_minute>=30 AND ((hd_dep_count=4 AND hd_vehicle_count<=4+2) OR (hd_dep_count=2 AND hd_vehicle_count<=2+2) OR (hd_dep_count=0 AND hd_vehicle_count<=0+2))) s7, (SELECT SUM(cnt) h12_to_12_30 FROM tpcds_mv.store_sales_hdemo_time_rollup WHERE s_store_name='ese' AND t_hour=12 AND t_minute<30 AND ((hd_dep_count=4 AND hd_vehicle_count<=4+2) OR (hd_dep_count=2 AND hd_vehicle_count<=2+2) OR (hd_dep_count=0 AND hd_vehicle_count<=0+2))) s8",
   "delta_sql": "SELECT ss_store_sk, ss_hdemo_sk, time_dim.t_hour AS t_hour, time_dim.t_minute AS t_minute, household_demographics.hd_dep_count AS hd_dep_count, household_demographics.hd_vehicle_count AS hd_vehicle_count, store.s_store_name AS s_store_name, COUNT(*) AS cnt FROM $DELTA(store_sales), household_demographics, time_dim, store WHERE ss_sold_time_sk = time_dim.t_time_sk AND ss_hdemo_sk = household_demographics.hd_demo_sk AND ss_store_sk = s_store_sk GROUP BY ss_store_sk, ss_hdemo_sk, time_dim.t_hour, time_dim.t_minute, household_demographics.hd_dep_count, household_demographics.hd_vehicle_count, store.s_store_name",
   "row_hash_at_author": "7f1bda0886ad97f29111b552b57a0622",
