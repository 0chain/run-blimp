   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 1403961,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT i_item_id, ca_country, ca_state, ca_county, avg(cast(cs_quantity AS decimal(12, 2))) agg1, avg(cast(cs_list_price AS decimal(12, 2))) agg2, avg(cast(cs_coupon_amt AS decimal(12, 2))) agg3, avg(cast(cs_sales_price AS decimal(12, 2))) agg4, avg(cast(cs_net_profit AS decimal(12, 2))) agg5, avg(cast(c_birth_year AS decimal(12, 2))) agg6, avg(cast(cd1.cd_dep_count AS decimal(12, 2))) agg7 FROM catalog_sales, customer_demographics cd1, customer_demographics cd2, customer, customer_address, date_dim, item WHERE cs_sold_date_sk = d_date_sk AND cs_item_sk = i_item_sk AND cs_bill_cdemo_sk = cd1.cd_demo_sk AND cs_bill_customer_sk = c_customer_sk AND cd1.cd_gender = 'F' AND cd1.cd_education_status = 'Unknown' AND c_current_cdemo_sk = cd2.cd_demo_sk AND c_current_addr_sk = ca_address_sk AND c_birth_month IN (1, 6, 8, 9, 12, 2) AND d_year = 1998 AND ca_state IN ('MS', 'IN', 'ND', 'OK', 'NM', 'VA', 'MS') GROUP BY ROLLUP (i_item_id, ca_country, ca_state, ca_county) ORDER BY ca_country NULLS FIRST, ca_state NULLS FIRST, ca_county NULLS FIRST, i_item_id NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT i_item_id, ca_country, ca_state, ca_county, d_year,\n       cd1.cd_gender AS cd_gender, cd1.cd_education_status AS cd_education_status, c_birth_month,\n       sum(cast(cs_quantity AS decimal(12,2))) AS q_sum, count(cs_quantity) AS q_cnt,\n       sum(cast(cs_list_price AS decimal(12,2))) AS lp_sum, count(cs_list_price) AS lp_cnt,\n       sum(cast(cs_coupon_amt AS decimal(12,2))) AS cp_sum, count(cs_coupon_amt) AS cp_cnt,\n       sum(cast(cs_sales_price AS decimal(12,2))) AS sp_sum, count(cs_sales_price) AS sp_cnt,\n       sum(cast(cs_net_profit AS decimal(12,2))) AS np_sum, count(cs_net_profit) AS np_cnt,\n       sum(cast(c_birth_year AS decimal(12,2))) AS by_sum, count(c_birth_year) AS by_cnt,\n       sum(cast(cd1.cd_dep_count AS decimal(12,2))) AS dc_sum, count(cd1.cd_dep_count) AS dc_cnt\nFROM catalog_sales, customer_demographics cd1, customer_demographics cd2, customer,\n     customer_address, date_dim, item\nWHERE cs_sold_date_sk = d_date_sk\n  AND cs_item_sk = i_item_sk\n  AND cs_bill_cdemo_sk = cd1.cd_demo_sk\n  AND cs_bill_customer_sk = c_customer_sk\n  AND c_current_cdemo_sk = cd2.cd_demo_sk\n  AND c_current_addr_sk = ca_address_sk\nGROUP BY i_item_id, ca_country, ca_state, ca_county, d_year,\n         cd1.cd_gender, cd1.cd_education_status, c_birth_month",
   "rewrite_sql": "SELECT i_item_id, ca_country, ca_state, ca_county,\n       sum(q_sum)/sum(q_cnt) agg1,\n       sum(lp_sum)/sum(lp_cnt) agg2,\n       sum(cp_sum)/sum(cp_cnt) agg3,\n       sum(sp_sum)/sum(sp_cnt) agg4,\n       sum(np_sum)/sum(np_cnt) agg5,\n       sum(by_sum)/sum(by_cnt) agg6,\n       sum(dc_sum)/sum(dc_cnt) agg7\nFROM iceberg.tpcds_mv.mv_h_bccd5474d6b5\nWHERE cd_gender = 'F'\n  AND cd_education_status = 'Unknown'\n  AND c_birth_month IN (1, 6, 8, 9, 12, 2)\n  AND d_year = 1998\n  AND ca_state IN ('MS', 'IN', 'ND', 'OK', 'NM', 'VA', 'MS')\nGROUP BY ROLLUP (i_item_id, ca_country, ca_state, ca_county)\nORDER BY ca_country NULLS FIRST, ca_state NULLS FIRST, ca_county NULLS FIRST, i_item_id NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT i_item_id, ca_country, ca_state, ca_county, d_year,\n       cd1.cd_gender AS cd_gender, cd1.cd_education_status AS cd_education_status, c_birth_month,\n       sum(cast(cs_quantity AS decimal(12,2))) AS q_sum, count(cs_quantity) AS q_cnt,\n       sum(cast(cs_list_price AS decimal(12,2))) AS lp_sum, count(cs_list_price) AS lp_cnt,\n       sum(cast(cs_coupon_amt AS decimal(12,2))) AS cp_sum, count(cs_coupon_amt) AS cp_cnt,\n       sum(cast(cs_sales_price AS decimal(12,2))) AS sp_sum, count(cs_sales_price) AS sp_cnt,\n       sum(cast(cs_net_profit AS decimal(12,2))) AS np_sum, count(cs_net_profit) AS np_cnt,\n       sum(cast(c_birth_year AS decimal(12,2))) AS by_sum, count(c_birth_year) AS by_cnt,\n       sum(cast(cd1.cd_dep_count AS decimal(12,2))) AS dc_sum, count(cd1.cd_dep_count) AS dc_cnt\nFROM $DELTA(catalog_sales), customer_demographics cd1, customer_demographics cd2, customer,\n     customer_address, date_dim, item\nWHERE cs_sold_date_sk = d_date_sk\n  AND cs_item_sk = i_item_sk\n  AND cs_bill_cdemo_sk = cd1.cd_demo_sk\n  AND cs_bill_customer_sk = c_customer_sk\n  AND c_current_cdemo_sk = cd2.cd_demo_sk\n  AND c_current_addr_sk = ca_address_sk\nGROUP BY i_item_id, ca_country, ca_state, ca_county, d_year,\n         cd1.cd_gender, cd1.cd_education_status, c_birth_month",
