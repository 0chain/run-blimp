   "mv_table": "mv_h_30c12e4d6ce1",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 2070564,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "WITH web_v1 AS (SELECT ws_item_sk item_sk, d_date, sum(sum(ws_sales_price)) OVER (PARTITION BY ws_item_sk ORDER BY d_date ROWS BETWEEN unbounded preceding AND CURRENT ROW) cume_sales FROM web_sales, date_dim WHERE ws_sold_date_sk=d_date_sk AND d_month_seq BETWEEN 1200 AND 1200+11 AND ws_item_sk IS NOT NULL GROUP BY ws_item_sk, d_date), store_v1 AS (SELECT ss_item_sk item_sk, d_date, sum(sum(ss_sales_price)) OVER (PARTITION BY ss_item_sk ORDER BY d_date ROWS BETWEEN unbounded preceding AND CURRENT ROW) cume_sales FROM store_sales, date_dim WHERE ss_sold_date_sk=d_date_sk AND d_month_seq BETWEEN 1200 AND 1200+11 AND ss_item_sk IS NOT NULL GROUP BY ss_item_sk, d_date) SELECT * FROM (SELECT item_sk, d_date, web_sales, store_sales, max(web_sales) OVER (PARTITION BY item_sk ORDER BY d_date ROWS BETWEEN unbounded preceding AND CURRENT ROW) web_cumulative, max(store_sales) OVER (PARTITION BY item_sk ORDER BY d_date ROWS BETWEEN unbounded preceding AND CURRENT ROW) store_cumulative FROM (SELECT CASE WHEN web.item_sk IS NOT NULL THEN web.item_sk ELSE store.item_sk END item_sk, CASE WHEN web.d_date IS NOT NULL THEN web.d_date ELSE store.d_date END d_date, web.cume_sales web_sales, store.cume_sales store_sales FROM web_v1 web FULL OUTER JOIN store_v1 store ON (web.item_sk = store.item_sk AND web.d_date = store.d_date))x)y WHERE web_cumulative > store_cumulative ORDER BY item_sk NULLS FIRST, d_date NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT 'w' AS channel, ws_item_sk AS item_sk, d_date, d_month_seq,\n       sum(ws_sales_price) AS sales\nFROM web_sales, date_dim\nWHERE d_month_seq BETWEEN 1200 AND 1200+11 AND ws_sold_date_sk = d_date_sk AND ws_item_sk IS NOT NULL\nGROUP BY 1, 2, 3, 4 UNION ALL SELECT 's' AS channel, ss_item_sk AS item_sk, d_date, d_month_seq,\n       sum(ss_sales_price) AS sales\nFROM store_sales, date_dim\nWHERE d_month_seq BETWEEN 1200 AND 1200+11 AND ss_sold_date_sk = d_date_sk AND ss_item_sk IS NOT NULL\nGROUP BY 1, 2, 3, 4",
   "rewrite_sql": "WITH web_v1 AS\n  (SELECT item_sk, d_date,\n          sum(sum(sales)) OVER (PARTITION BY item_sk ORDER BY d_date\n                                ROWS BETWEEN unbounded preceding AND CURRENT ROW) cume_sales\n   FROM iceberg.tpcds_mv.mv_h_30c12e4d6ce1 WHERE channel = 'w' AND d_month_seq BETWEEN 1200 AND 1200+11\n   GROUP BY item_sk, d_date),\n     store_v1 AS\n  (SELECT item_sk, d_date,\n          sum(sum(sales)) OVER (PARTITION BY item_sk ORDER BY d_date\n                                ROWS BETWEEN unbounded preceding AND CURRENT ROW) cume_sales\n   FROM iceberg.tpcds_mv.mv_h_30c12e4d6ce1 WHERE channel = 's' AND d_month_seq BETWEEN 1200 AND 1200+11\n   GROUP BY item_sk, d_date)\nSELECT *\nFROM (SELECT item_sk, d_date, web_sales, store_sales,\n             max(web_sales) OVER (PARTITION BY item_sk ORDER BY d_date\n                                  ROWS BETWEEN unbounded preceding AND CURRENT ROW) web_cumulative,\n             max(store_sales) OVER (PARTITION BY item_sk ORDER BY d_date\n                                    ROWS BETWEEN unbounded preceding AND CURRENT ROW) store_cumulative\n      FROM (SELECT CASE WHEN web.item_sk IS NOT NULL THEN web.item_sk ELSE store.item_sk END item_sk,\n                   CASE WHEN web.d_date IS NOT NULL THEN web.d_date ELSE store.d_date END d_date,\n                   web.cume_sales web_sales, store.cume_sales store_sales\n            FROM web_v1 web FULL OUTER JOIN store_v1 store\n                 ON (web.item_sk = store.item_sk AND web.d_date = store.d_date))x)y\nWHERE web_cumulative > store_cumulative\nORDER BY item_sk NULLS FIRST, d_date NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT 'w' AS channel, ws_item_sk AS item_sk, d_date, d_month_seq,\n       sum(ws_sales_price) AS sales\nFROM $DELTA(web_sales), date_dim\nWHERE d_month_seq BETWEEN 1200 AND 1200+11 AND ws_sold_date_sk = d_date_sk AND ws_item_sk IS NOT NULL\nGROUP BY 1, 2, 3, 4 UNION ALL SELECT 's' AS channel, ss_item_sk AS item_sk, d_date, d_month_seq,\n       sum(ss_sales_price) AS sales\nFROM $DELTA(store_sales), date_dim\nWHERE d_month_seq BETWEEN 1200 AND 1200+11 AND ss_sold_date_sk = d_date_sk AND ss_item_sk IS NOT NULL\nGROUP BY 1, 2, 3, 4",
   "row_hash_at_author": "705c606c99131c821eb92e37dee8a5cf",
