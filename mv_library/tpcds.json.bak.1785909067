  {
   "labels": [
    "q95"
   ],
   "qid_pattern": "",
   "category": "subquery",
   "shape_class": "global-scalar|in-subquery|between-range|count-distinct|outer-limit-order",
   "tier": "harness",
   "archetype_id": "",
   "mv_table": "mv_h_208a0d58bded",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 1063295,
   "mv_cols": 9,
   "source_schema": "tpcds",
   "original_sql": "WITH ws_wh AS (SELECT ws1.ws_order_number, ws1.ws_warehouse_sk wh1, ws2.ws_warehouse_sk wh2 FROM web_sales ws1, web_sales ws2 WHERE ws1.ws_order_number = ws2.ws_order_number AND ws1.ws_warehouse_sk <> ws2.ws_warehouse_sk) SELECT count(DISTINCT ws_order_number) AS \"order count\" , sum(ws_ext_ship_cost) AS \"total shipping cost\" , sum(ws_net_profit) AS \"total net profit\" FROM web_sales ws1 , date_dim , customer_address , web_site WHERE d_date BETWEEN '1999-02-01' AND cast('1999-04-02' AS date) AND ws1.ws_ship_date_sk = d_date_sk AND ws1.ws_ship_addr_sk = ca_address_sk AND ca_state = 'IL' AND ws1.ws_web_site_sk = web_site_sk AND web_company_name = 'pri' AND ws1.ws_order_number IN (SELECT ws_order_number FROM ws_wh) AND ws1.ws_order_number IN (SELECT wr_order_number FROM web_returns, ws_wh WHERE wr_order_number = ws_wh.ws_order_number) ORDER BY count(DISTINCT ws_order_number) LIMIT 100",
   "mv_sql": "SELECT 'sale' AS part, ws_order_number AS order_number, ws_warehouse_sk AS warehouse_sk,\n       d_date, ca_state, web_company_name,\n       sum(ws_ext_ship_cost) AS ship_cost, sum(ws_net_profit) AS net_profit, count(*) AS cnt\nFROM web_sales, date_dim, customer_address, web_site\nWHERE ws_ship_date_sk = d_date_sk\n  AND ws_ship_addr_sk = ca_address_sk\n  AND ws_web_site_sk = web_site_sk\nGROUP BY 1, 2, 3, 4, 5, 6\nUNION ALL\nSELECT 'wh' AS part, ws_order_number AS order_number, ws_warehouse_sk AS warehouse_sk,\n       CAST(NULL AS DATE) AS d_date, CAST(NULL AS VARCHAR) AS ca_state,\n       CAST(NULL AS VARCHAR) AS web_company_name,\n       CAST(NULL AS DECIMAL(38,2)) AS ship_cost, CAST(NULL AS DECIMAL(38,2)) AS net_profit, count(*) AS cnt\nFROM web_sales\nGROUP BY 1, 2, 3, 4, 5, 6\nUNION ALL\nSELECT 'return' AS part, wr_order_number AS order_number, CAST(NULL AS INTEGER) AS warehouse_sk,\n       CAST(NULL AS DATE) AS d_date, CAST(NULL AS VARCHAR) AS ca_state,\n       CAST(NULL AS VARCHAR) AS web_company_name,\n       CAST(NULL AS DECIMAL(38,2)) AS ship_cost, CAST(NULL AS DECIMAL(38,2)) AS net_profit, count(*) AS cnt\nFROM web_returns\nGROUP BY 1, 2, 3, 4, 5, 6",
   "rewrite_sql": "WITH ws_wh AS\n  (SELECT order_number AS ws_order_number FROM iceberg.tpcds_mv.mv_h_208a0d58bded WHERE part = 'wh'\n   GROUP BY order_number HAVING count(DISTINCT warehouse_sk) >= 2)\nSELECT count(DISTINCT ws1.order_number) AS \"order count\" ,\n       sum(ws1.ship_cost) AS \"total shipping cost\" ,\n       sum(ws1.net_profit) AS \"total net profit\"\nFROM iceberg.tpcds_mv.mv_h_208a0d58bded ws1\nWHERE ws1.part = 'sale'\n  AND ws1.d_date BETWEEN '1999-02-01' AND cast('1999-04-02' AS date)\n  AND ws1.ca_state = 'IL'\n  AND ws1.web_company_name = 'pri'\n  AND ws1.order_number IN (SELECT ws_order_number FROM ws_wh)\n  AND ws1.order_number IN (SELECT r.order_number FROM iceberg.tpcds_mv.mv_h_208a0d58bded r, ws_wh\n                           WHERE r.part = 'return' AND r.order_number = ws_wh.ws_order_number)\nORDER BY count(DISTINCT ws1.order_number)\nLIMIT 100",
   "delta_sql": "SELECT 'sale' AS part, ws_order_number AS order_number, ws_warehouse_sk AS warehouse_sk,\n       d_date, ca_state, web_company_name,\n       sum(ws_ext_ship_cost) AS ship_cost, sum(ws_net_profit) AS net_profit, count(*) AS cnt\nFROM $DELTA(web_sales), date_dim, customer_address, web_site\nWHERE ws_ship_date_sk = d_date_sk\n  AND ws_ship_addr_sk = ca_address_sk\n  AND ws_web_site_sk = web_site_sk\nGROUP BY 1, 2, 3, 4, 5, 6\nUNION ALL\nSELECT 'wh' AS part, ws_order_number AS order_number, ws_warehouse_sk AS warehouse_sk,\n       CAST(NULL AS DATE) AS d_date, CAST(NULL AS VARCHAR) AS ca_state,\n       CAST(NULL AS VARCHAR) AS web_company_name,\n       CAST(NULL AS DECIMAL(38,2)) AS ship_cost, CAST(NULL AS DECIMAL(38,2)) AS net_profit, count(*) AS cnt\nFROM $DELTA(web_sales)\nGROUP BY 1, 2, 3, 4, 5, 6\nUNION ALL\nSELECT 'return' AS part, wr_order_number AS order_number, CAST(NULL AS INTEGER) AS warehouse_sk,\n       CAST(NULL AS DATE) AS d_date, CAST(NULL AS VARCHAR) AS ca_state,\n       CAST(NULL AS VARCHAR) AS web_company_name,\n       CAST(NULL AS DECIMAL(38,2)) AS ship_cost, CAST(NULL AS DECIMAL(38,2)) AS net_profit, count(*) AS cnt\nFROM $DELTA(web_returns)\nGROUP BY 1, 2, 3, 4, 5, 6",
   "row_hash_at_author": "e043d8b18114bf18ba3d72cf0d7e7e1f",
   "sql_fingerprint_sha256": "91c5ebfd9032a8ff"
  },
  {
   "labels": [
    "q48"
   ],
   "qid_pattern": "",
   "category": "join",
   "shape_class": "global-scalar|none|or-of-and|additive|none",
   "tier": "harness",
   "archetype_id": "",
   "mv_table": "mv_h_27746c6355ea",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 124,
   "mv_cols": -1,
   "source_schema": "tpcds_sf1",
   "original_sql": "SELECT SUM (ss_quantity) FROM store_sales, store, customer_demographics, customer_address, date_dim WHERE s_store_sk = ss_store_sk AND ss_sold_date_sk = d_date_sk AND d_year = 2000 AND ((cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'M' AND cd_education_status = '4 yr Degree' AND ss_sales_price BETWEEN 100.00 AND 150.00) OR (cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'D' AND cd_education_status = '2 yr Degree' AND ss_sales_price BETWEEN 50.00 AND 100.00) OR (cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'S' AND cd_education_status = 'College' AND ss_sales_price BETWEEN 150.00 AND 200.00)) AND ((ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('CO', 'OH', 'TX') AND ss_net_profit BETWEEN 0 AND 2000) OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('OR', 'MN', 'KY') AND ss_net_profit BETWEEN 150 AND 3000) OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('VA', 'CA', 'MS') AND ss_net_profit BETWEEN 50 AND 25000))",
   "mv_sql": "SELECT d_year, cd_marital_status, cd_education_status, ca_state, ca_country,\n       sum(ss_quantity) AS qty_sum\nFROM store_sales, store, customer_demographics, customer_address, date_dim\nWHERE s_store_sk = ss_store_sk\n  AND ss_sold_date_sk = d_date_sk\n  AND ((cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'M' AND cd_education_status = '4 yr Degree'\n        AND ss_sales_price BETWEEN 100.00 AND 150.00)\n    OR (cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'D' AND cd_education_status = '2 yr Degree'\n        AND ss_sales_price BETWEEN 50.00 AND 100.00)\n    OR (cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'S' AND cd_education_status = 'College'\n        AND ss_sales_price BETWEEN 150.00 AND 200.00))\n  AND ((ss_addr_sk = ca_address_sk AND ca_country = 'United States'\n        AND ca_state IN ('CO', 'OH', 'TX') AND ss_net_profit BETWEEN 0 AND 2000)\n    OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States'\n        AND ca_state IN ('OR', 'MN', 'KY') AND ss_net_profit BETWEEN 150 AND 3000)\n    OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States'\n        AND ca_state IN ('VA', 'CA', 'MS') AND ss_net_profit BETWEEN 50 AND 25000))\nGROUP BY d_year, cd_marital_status, cd_education_status, ca_state, ca_country",
   "rewrite_sql": "SELECT SUM (qty_sum) AS \"sum(ss_quantity)\"\nFROM iceberg.tpcds_mv.mv_h_27746c6355ea\nWHERE d_year = 2000",
   "delta_sql": "SELECT d_year, cd_marital_status, cd_education_status, ca_state, ca_country,\n       sum(ss_quantity) AS qty_sum\nFROM $DELTA(store_sales), store, customer_demographics, customer_address, date_dim\nWHERE s_store_sk = ss_store_sk\n  AND ss_sold_date_sk = d_date_sk\n  AND ((cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'M' AND cd_education_status = '4 yr Degree'\n        AND ss_sales_price BETWEEN 100.00 AND 150.00)\n    OR (cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'D' AND cd_education_status = '2 yr Degree'\n        AND ss_sales_price BETWEEN 50.00 AND 100.00)\n    OR (cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'S' AND cd_education_status = 'College'\n        AND ss_sales_price BETWEEN 150.00 AND 200.00))\n  AND ((ss_addr_sk = ca_address_sk AND ca_country = 'United States'\n        AND ca_state IN ('CO', 'OH', 'TX') AND ss_net_profit BETWEEN 0 AND 2000)\n    OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States'\n        AND ca_state IN ('OR', 'MN', 'KY') AND ss_net_profit BETWEEN 150 AND 3000)\n    OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States'\n        AND ca_state IN ('VA', 'CA', 'MS') AND ss_net_profit BETWEEN 50 AND 25000))\nGROUP BY d_year, cd_marital_status, cd_education_status, ca_state, ca_country",
   "row_hash_at_author": "1984f216430f1d26cd87771a822dc2ed",
   "sql_fingerprint_sha256": "5895dbc73a640505"
  },
  {
   "labels": [
    "q56"
   ],
   "qid_pattern": "",
   "category": "aggregation",
   "shape_class": "groupby|in-subquery|equality|additive|outer-limit-order",
   "tier": "harness",
   "archetype_id": "",
   "mv_table": "mv_h_2c162ceede3e",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 11374,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "WITH ss AS (SELECT i_item_id, sum(ss_ext_sales_price) total_sales FROM store_sales, date_dim, customer_address, item WHERE i_item_id IN (SELECT i_item_id FROM item WHERE i_color IN ('slate', 'blanched', 'burnished')) AND ss_item_sk = i_item_sk AND ss_sold_date_sk = d_date_sk AND d_year = 2001 AND d_moy = 2 AND ss_addr_sk = ca_address_sk AND ca_gmt_offset = -5 GROUP BY i_item_id), cs AS (SELECT i_item_id, sum(cs_ext_sales_price) total_sales FROM catalog_sales, date_dim, customer_address, item WHERE i_item_id IN (SELECT i_item_id FROM item WHERE i_color IN ('slate', 'blanched', 'burnished')) AND cs_item_sk = i_item_sk AND cs_sold_date_sk = d_date_sk AND d_year = 2001 AND d_moy = 2 AND cs_bill_addr_sk = ca_address_sk AND ca_gmt_offset = -5 GROUP BY i_item_id), ws AS (SELECT i_item_id, sum(ws_ext_sales_price) total_sales FROM web_sales, date_dim, customer_address, item WHERE i_item_id IN (SELECT i_item_id FROM item WHERE i_color IN ('slate', 'blanched', 'burnished')) AND ws_item_sk = i_item_sk AND ws_sold_date_sk = d_date_sk AND d_year = 2001 AND d_moy = 2 AND ws_bill_addr_sk = ca_address_sk AND ca_gmt_offset = -5 GROUP BY i_item_id) SELECT i_item_id, sum(total_sales) total_sales FROM (SELECT * FROM ss UNION ALL SELECT * FROM cs UNION ALL SELECT * FROM ws) tmp1 GROUP BY i_item_id ORDER BY total_sales NULLS FIRST, i_item_id NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT 's' AS channel, i_item_id, d_year, d_moy, ca_gmt_offset,\n       sum(ss_ext_sales_price) AS total_sales\nFROM store_sales, date_dim, customer_address, item\nWHERE d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5 AND ss_item_sk = i_item_sk AND ss_sold_date_sk = d_date_sk AND ss_addr_sk = ca_address_sk\nGROUP BY 1, i_item_id, d_year, d_moy, ca_gmt_offset UNION ALL SELECT 'c' AS channel, i_item_id, d_year, d_moy, ca_gmt_offset,\n       sum(cs_ext_sales_price) AS total_sales\nFROM catalog_sales, date_dim, customer_address, item\nWHERE d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5 AND cs_item_sk = i_item_sk AND cs_sold_date_sk = d_date_sk AND cs_bill_addr_sk = ca_address_sk\nGROUP BY 1, i_item_id, d_year, d_moy, ca_gmt_offset UNION ALL SELECT 'w' AS channel, i_item_id, d_year, d_moy, ca_gmt_offset,\n       sum(ws_ext_sales_price) AS total_sales\nFROM web_sales, date_dim, customer_address, item\nWHERE d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5 AND ws_item_sk = i_item_sk AND ws_sold_date_sk = d_date_sk AND ws_bill_addr_sk = ca_address_sk\nGROUP BY 1, i_item_id, d_year, d_moy, ca_gmt_offset",
   "rewrite_sql": "WITH ss AS ( SELECT i_item_id, sum(total_sales) total_sales\n       FROM iceberg.tpcds_mv.mv_h_2c162ceede3e\n       WHERE channel = 's'\n         AND i_item_id IN (SELECT i_item_id FROM item WHERE i_color IN ('slate', 'blanched', 'burnished'))\n         AND d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5\n       GROUP BY i_item_id),\n     cs AS ( SELECT i_item_id, sum(total_sales) total_sales\n       FROM iceberg.tpcds_mv.mv_h_2c162ceede3e\n       WHERE channel = 'c'\n         AND i_item_id IN (SELECT i_item_id FROM item WHERE i_color IN ('slate', 'blanched', 'burnished'))\n         AND d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5\n       GROUP BY i_item_id),\n     ws AS ( SELECT i_item_id, sum(total_sales) total_sales\n       FROM iceberg.tpcds_mv.mv_h_2c162ceede3e\n       WHERE channel = 'w'\n         AND i_item_id IN (SELECT i_item_id FROM item WHERE i_color IN ('slate', 'blanched', 'burnished'))\n         AND d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5\n       GROUP BY i_item_id)\nSELECT i_item_id, sum(total_sales) total_sales\nFROM (SELECT * FROM ss UNION ALL SELECT * FROM cs UNION ALL SELECT * FROM ws) tmp1\nGROUP BY i_item_id\nORDER BY total_sales NULLS FIRST, i_item_id NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT 's' AS channel, i_item_id, d_year, d_moy, ca_gmt_offset,\n       sum(ss_ext_sales_price) AS total_sales\nFROM $DELTA(store_sales), date_dim, customer_address, item\nWHERE d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5 AND ss_item_sk = i_item_sk AND ss_sold_date_sk = d_date_sk AND ss_addr_sk = ca_address_sk\nGROUP BY 1, i_item_id, d_year, d_moy, ca_gmt_offset UNION ALL SELECT 'c' AS channel, i_item_id, d_year, d_moy, ca_gmt_offset,\n       sum(cs_ext_sales_price) AS total_sales\nFROM $DELTA(catalog_sales), date_dim, customer_address, item\nWHERE d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5 AND cs_item_sk = i_item_sk AND cs_sold_date_sk = d_date_sk AND cs_bill_addr_sk = ca_address_sk\nGROUP BY 1, i_item_id, d_year, d_moy, ca_gmt_offset UNION ALL SELECT 'w' AS channel, i_item_id, d_year, d_moy, ca_gmt_offset,\n       sum(ws_ext_sales_price) AS total_sales\nFROM $DELTA(web_sales), date_dim, customer_address, item\nWHERE d_year = 2001 AND d_moy = 2 AND ca_gmt_offset = -5 AND ws_item_sk = i_item_sk AND ws_sold_date_sk = d_date_sk AND ws_bill_addr_sk = ca_address_sk\nGROUP BY 1, i_item_id, d_year, d_moy, ca_gmt_offset",
