   "original_sql": "SELECT i_item_id,\n       i_item_desc,\n       s_store_id,\n       s_store_name,\n       sum(ss_quantity) AS store_sales_quantity,\n       sum(sr_return_quantity) AS store_returns_quantity,\n       sum(cs_quantity) AS catalog_sales_quantity\nFROM store_sales,\n     store_returns,\n     catalog_sales,\n     date_dim d1,\n     date_dim d2,\n     date_dim d3,\n     store,\n     item\nWHERE d1.d_moy = 9\n  AND d1.d_year = 1999\n  AND d1.d_date_sk = ss_sold_date_sk\n  AND i_item_sk = ss_item_sk\n  AND s_store_sk = ss_store_sk\n  AND ss_customer_sk = sr_customer_sk\n  AND ss_item_sk = sr_item_sk\n  AND ss_ticket_number = sr_ticket_number\n  AND sr_returned_date_sk = d2.d_date_sk\n  AND d2.d_moy BETWEEN 9 AND 9 + 3\n  AND d2.d_year = 1999\n  AND sr_customer_sk = cs_bill_customer_sk\n  AND sr_item_sk = cs_item_sk\n  AND cs_sold_date_sk = d3.d_date_sk\n  AND d3.d_year IN (1999,\n                    1999+1,\n                    1999+2)\nGROUP BY i_item_id,\n         i_item_desc,\n         s_store_id,\n         s_store_name\nORDER BY i_item_id,\n         i_item_desc,\n         s_store_id,\n         s_store_name\nLIMIT 100",
   "mv_sql": "SELECT ss_item_sk, ss_store_sk, ss_sold_date_sk, sr_returned_date_sk, cs_sold_date_sk, sum(ss_quantity) AS sum_ss_quantity, sum(sr_return_quantity) AS sum_sr_return_quantity, sum(cs_quantity) AS sum_cs_quantity FROM store_sales, store_returns, catalog_sales WHERE ss_customer_sk = sr_customer_sk AND ss_item_sk = sr_item_sk AND ss_ticket_number = sr_ticket_number AND sr_customer_sk = cs_bill_customer_sk AND sr_item_sk = cs_item_sk GROUP BY ss_item_sk, ss_store_sk, ss_sold_date_sk, sr_returned_date_sk, cs_sold_date_sk",
   "rewrite_sql": "SELECT i.i_item_id, i.i_item_desc, s.s_store_id, s.s_store_name, sum(m.sum_ss_quantity) AS store_sales_quantity, sum(m.sum_sr_return_quantity) AS store_returns_quantity, sum(m.sum_cs_quantity) AS catalog_sales_quantity FROM tpcds_mv.store_sales_returns_catalog_qty m JOIN item i ON i.i_item_sk = m.ss_item_sk JOIN store s ON s.s_store_sk = m.ss_store_sk JOIN date_dim d1 ON d1.d_date_sk = m.ss_sold_date_sk JOIN date_dim d2 ON d2.d_date_sk = m.sr_returned_date_sk JOIN date_dim d3 ON d3.d_date_sk = m.cs_sold_date_sk WHERE d1.d_moy = 9 AND d1.d_year = 1999 AND d2.d_moy BETWEEN 9 AND 9 + 3 AND d2.d_year = 1999 AND d3.d_year IN (1999, 1999+1, 1999+2) GROUP BY i.i_item_id, i.i_item_desc, s.s_store_id, s.s_store_name ORDER BY i.i_item_id, i.i_item_desc, s.s_store_id, s.s_store_name LIMIT 100",
   "delta_sql": "SELECT ss_item_sk, ss_store_sk, ss_sold_date_sk, sr_returned_date_sk, cs_sold_date_sk, sum(ss_quantity) AS sum_ss_quantity, sum(sr_return_quantity) AS sum_sr_return_quantity, sum(cs_quantity) AS sum_cs_quantity FROM $DELTA(store_sales), $DELTA(store_returns), $DELTA(catalog_sales) WHERE ss_customer_sk = sr_customer_sk AND ss_item_sk = sr_item_sk AND ss_ticket_number = sr_ticket_number AND sr_customer_sk = cs_bill_customer_sk AND sr_item_sk = cs_item_sk GROUP BY ss_item_sk, ss_store_sk, ss_sold_date_sk, sr_returned_date_sk, cs_sold_date_sk",
