  {
   "labels": [
    "q61"
   ],
   "qid_pattern": "",
   "category": "scan_filter",
   "shape_class": "global-scalar|none|or-of-and|additive|outer-limit-order",
   "tier": "harness",
   "archetype_id": "",
   "mv_table": "mv_h_a26d43bb4c54",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 13460,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT promotions, total, cast(promotions AS decimal(15,4))/cast(total AS decimal(15,4))*100 FROM (SELECT sum(ss_ext_sales_price) promotions FROM store_sales, store, promotion, date_dim, customer, customer_address, item WHERE ss_sold_date_sk = d_date_sk AND ss_store_sk = s_store_sk AND ss_promo_sk = p_promo_sk AND ss_customer_sk= c_customer_sk AND ca_address_sk = c_current_addr_sk AND ss_item_sk = i_item_sk AND ca_gmt_offset = -5 AND i_category = 'Jewelry' AND (p_channel_dmail = 'Y' OR p_channel_email = 'Y' OR p_channel_tv = 'Y') AND s_gmt_offset = -5 AND d_year = 1998 AND d_moy = 11) promotional_sales, (SELECT sum(ss_ext_sales_price) total FROM store_sales, store, date_dim, customer, customer_address, item WHERE ss_sold_date_sk = d_date_sk AND ss_store_sk = s_store_sk AND ss_customer_sk= c_customer_sk AND ca_address_sk = c_current_addr_sk AND ss_item_sk = i_item_sk AND ca_gmt_offset = -5 AND i_category = 'Jewelry' AND s_gmt_offset = -5 AND d_year = 1998 AND d_moy = 11) all_sales ORDER BY promotions, total LIMIT 100",
   "mv_sql": "SELECT 'p' AS part, i_category, ca_gmt_offset, s_gmt_offset, d_year, d_moy,\n       CASE WHEN (p_channel_dmail = 'Y' OR p_channel_email = 'Y' OR p_channel_tv = 'Y') THEN 1 ELSE 0 END AS promo_flag,\n       sum(ss_ext_sales_price) AS amt\nFROM store_sales, store, promotion, date_dim, customer, customer_address, item\nWHERE ss_sold_date_sk = d_date_sk\n  AND ss_store_sk = s_store_sk\n  AND ss_promo_sk = p_promo_sk\n  AND ss_customer_sk = c_customer_sk\n  AND ca_address_sk = c_current_addr_sk\n  AND ss_item_sk = i_item_sk\nGROUP BY 1, 2, 3, 4, 5, 6, 7\nUNION ALL\nSELECT 'a' AS part, i_category, ca_gmt_offset, s_gmt_offset, d_year, d_moy,\n       CAST(NULL AS INTEGER) AS promo_flag,\n       sum(ss_ext_sales_price) AS amt\nFROM store_sales, store, date_dim, customer, customer_address, item\nWHERE ss_sold_date_sk = d_date_sk\n  AND ss_store_sk = s_store_sk\n  AND ss_customer_sk = c_customer_sk\n  AND ca_address_sk = c_current_addr_sk\n  AND ss_item_sk = i_item_sk\nGROUP BY 1, 2, 3, 4, 5, 6, 7",
   "rewrite_sql": "SELECT promotions, total, cast(promotions AS decimal(15,4))/cast(total AS decimal(15,4))*100\nFROM (SELECT sum(amt) promotions FROM iceberg.tpcds_mv.mv_h_a26d43bb4c54\n      WHERE part = 'p' AND promo_flag = 1 AND ca_gmt_offset = -5 AND i_category = 'Jewelry'\n        AND s_gmt_offset = -5 AND d_year = 1998 AND d_moy = 11) promotional_sales,\n     (SELECT sum(amt) total FROM iceberg.tpcds_mv.mv_h_a26d43bb4c54\n      WHERE part = 'a' AND ca_gmt_offset = -5 AND i_category = 'Jewelry'\n        AND s_gmt_offset = -5 AND d_year = 1998 AND d_moy = 11) all_sales\nORDER BY promotions, total\nLIMIT 100",
   "delta_sql": "SELECT 'p' AS part, i_category, ca_gmt_offset, s_gmt_offset, d_year, d_moy,\n       CASE WHEN (p_channel_dmail = 'Y' OR p_channel_email = 'Y' OR p_channel_tv = 'Y') THEN 1 ELSE 0 END AS promo_flag,\n       sum(ss_ext_sales_price) AS amt\nFROM $DELTA(store_sales), store, promotion, date_dim, customer, customer_address, item\nWHERE ss_sold_date_sk = d_date_sk\n  AND ss_store_sk = s_store_sk\n  AND ss_promo_sk = p_promo_sk\n  AND ss_customer_sk = c_customer_sk\n  AND ca_address_sk = c_current_addr_sk\n  AND ss_item_sk = i_item_sk\nGROUP BY 1, 2, 3, 4, 5, 6, 7\nUNION ALL\nSELECT 'a' AS part, i_category, ca_gmt_offset, s_gmt_offset, d_year, d_moy,\n       CAST(NULL AS INTEGER) AS promo_flag,\n       sum(ss_ext_sales_price) AS amt\nFROM $DELTA(store_sales), store, date_dim, customer, customer_address, item\nWHERE ss_sold_date_sk = d_date_sk\n  AND ss_store_sk = s_store_sk\n  AND ss_customer_sk = c_customer_sk\n  AND ca_address_sk = c_current_addr_sk\n  AND ss_item_sk = i_item_sk\nGROUP BY 1, 2, 3, 4, 5, 6, 7",
   "row_hash_at_author": "a8074b8bbd40fc053ff97c065803864b",
