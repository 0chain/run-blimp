  {
   "labels": [
    "q49"
   ],
   "qid_pattern": "",
   "category": "window",
   "shape_class": "window|none|or-of-and|rank-window|outer-limit-order",
   "tier": "harness",
   "archetype_id": "",
   "mv_table": "mv_h_9f0f2930f0a6",
