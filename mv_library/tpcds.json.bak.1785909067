   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT case when pmc=0 then null else cast(amc AS decimal(15,4))/cast(pmc AS decimal(15,4)) end am_pm_ratio FROM (SELECT count(*) amc FROM web_sales, household_demographics, time_dim, web_page WHERE ws_sold_time_sk = time_dim.t_time_sk AND ws_ship_hdemo_sk = household_demographics.hd_demo_sk AND ws_web_page_sk = web_page.wp_web_page_sk AND time_dim.t_hour BETWEEN 8 AND 8+1 AND household_demographics.hd_dep_count = 6 AND web_page.wp_char_count BETWEEN 5000 AND 5200) at_, (SELECT count(*) pmc FROM web_sales, household_demographics, time_dim, web_page WHERE ws_sold_time_sk = time_dim.t_time_sk AND ws_ship_hdemo_sk = household_demographics.hd_demo_sk AND ws_web_page_sk = web_page.wp_web_page_sk AND time_dim.t_hour BETWEEN 19 AND 19+1 AND household_demographics.hd_dep_count = 6 AND web_page.wp_char_count BETWEEN 5000 AND 5200) pt ORDER BY am_pm_ratio LIMIT 100",
   "mv_sql": "SELECT t_hour, hd_dep_count, wp_char_count, count(*) AS cnt\nFROM web_sales, household_demographics, time_dim, web_page\nWHERE ws_sold_time_sk = time_dim.t_time_sk\n  AND ws_ship_hdemo_sk = household_demographics.hd_demo_sk\n  AND ws_web_page_sk = web_page.wp_web_page_sk\nGROUP BY t_hour, hd_dep_count, wp_char_count",
   "rewrite_sql": "SELECT case when pmc=0 then null else cast(amc AS decimal(15,4))/cast(pmc AS decimal(15,4)) end am_pm_ratio\nFROM (SELECT coalesce(sum(cnt),0) amc FROM iceberg.tpcds_mv.mv_h_a0e684b12eb1\n      WHERE t_hour BETWEEN 8 AND 8+1 AND hd_dep_count = 6 AND wp_char_count BETWEEN 5000 AND 5200) at_,\n     (SELECT coalesce(sum(cnt),0) pmc FROM iceberg.tpcds_mv.mv_h_a0e684b12eb1\n      WHERE t_hour BETWEEN 19 AND 19+1 AND hd_dep_count = 6 AND wp_char_count BETWEEN 5000 AND 5200) pt\nORDER BY am_pm_ratio\nLIMIT 100",
   "delta_sql": "SELECT t_hour, hd_dep_count, wp_char_count, count(*) AS cnt\nFROM $DELTA(web_sales), household_demographics, time_dim, web_page\nWHERE ws_sold_time_sk = time_dim.t_time_sk\n  AND ws_ship_hdemo_sk = household_demographics.hd_demo_sk\n  AND ws_web_page_sk = web_page.wp_web_page_sk\nGROUP BY t_hour, hd_dep_count, wp_char_count",
   "row_hash_at_author": "9107ab75327248b5870e72a08d84ca1a",
