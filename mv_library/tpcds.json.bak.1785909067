   "mv_table": "mv_h_e4e9e7443def",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 760910,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT sum(ws_ext_discount_amt) AS \"Excess Discount Amount\" FROM web_sales, item, date_dim WHERE i_manufact_id = 350 AND i_item_sk = ws_item_sk AND d_date BETWEEN '2000-01-27' AND cast('2000-04-26' AS date) AND d_date_sk = ws_sold_date_sk AND ws_ext_discount_amt > (SELECT 1.3 * avg(ws_ext_discount_amt) FROM web_sales, date_dim WHERE ws_item_sk = i_item_sk AND d_date BETWEEN '2000-01-27' AND cast('2000-04-26' AS date) AND d_date_sk = ws_sold_date_sk ) ORDER BY sum(ws_ext_discount_amt) LIMIT 100",
   "mv_sql": "SELECT i_manufact_id, i_item_sk, d_date, ws_ext_discount_amt,\n       sum(ws_ext_discount_amt) AS disc_sum, count(ws_ext_discount_amt) AS disc_cnt\nFROM web_sales, item, date_dim\nWHERE i_item_sk = ws_item_sk AND d_date_sk = ws_sold_date_sk\nGROUP BY i_manufact_id, i_item_sk, d_date, ws_ext_discount_amt",
   "rewrite_sql": "SELECT sum(m.disc_sum) AS \"Excess Discount Amount\"\nFROM iceberg.tpcds_mv.mv_h_e4e9e7443def m\nWHERE m.i_manufact_id = 350\n  AND m.d_date BETWEEN '2000-01-27' AND cast('2000-04-26' AS date)\n  AND m.ws_ext_discount_amt >\n    (SELECT 1.3 * sum(s.disc_sum)/sum(s.disc_cnt) FROM iceberg.tpcds_mv.mv_h_e4e9e7443def s\n     WHERE s.i_item_sk = m.i_item_sk\n       AND s.d_date BETWEEN '2000-01-27' AND cast('2000-04-26' AS date))\nORDER BY sum(m.disc_sum)\nLIMIT 100",
   "delta_sql": "SELECT i_manufact_id, i_item_sk, d_date, ws_ext_discount_amt,\n       sum(ws_ext_discount_amt) AS disc_sum, count(ws_ext_discount_amt) AS disc_cnt\nFROM $DELTA(web_sales), item, date_dim\nWHERE i_item_sk = ws_item_sk AND d_date_sk = ws_sold_date_sk\nGROUP BY i_manufact_id, i_item_sk, d_date, ws_ext_discount_amt",
   "row_hash_at_author": "fd21120418038aa5deb08d144bb661a6",
   "sql_fingerprint_sha256": "ab8d9e4ea5926bb9"
