  {
   "labels": [
    "q34"
   ],
   "qid_pattern": "",
   "category": "subquery",
   "shape_class": "groupby|none|or-of-and|additive|none",
   "tier": "tooluse_opus",
   "archetype_id": "",
   "mv_table": "mv_q34_ticket_counts",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": -1,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT c_last_name ,\n       c_first_name ,\n       c_salutation ,\n       c_preferred_cust_flag ,\n       ss_ticket_number ,\n       cnt\nFROM\n  (SELECT ss_ticket_number ,\n          ss_customer_sk ,\n          count(*) cnt\n   FROM store_sales,\n        date_dim,\n        store,\n        household_demographics\n   WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk\n     AND store_sales.ss_store_sk = store.s_store_sk\n     AND store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk\n     AND (date_dim.d_dom BETWEEN 1 AND 3\n          OR date_dim.d_dom BETWEEN 25 AND 28)\n     AND (household_demographics.hd_buy_potential = '>10000'\n          OR household_demographics.hd_buy_potential = 'Unknown')\n     AND household_demographics.hd_vehicle_count > 0\n     AND (CASE\n              WHEN household_demographics.hd_vehicle_count > 0 THEN (household_demographics.hd_dep_count*1.000)/ household_demographics.hd_vehicle_count\n              ELSE NULL\n          END) > 1.2\n     AND date_dim.d_year IN (1999,\n                             1999+1,\n                             1999+2)\n     AND store.s_county = 'Williamson County'\n   GROUP BY ss_ticket_number,\n            ss_customer_sk) dn,\n     customer\nWHERE ss_customer_sk = c_customer_sk\n  AND cnt BETWEEN 15 AND 20\nORDER BY c_last_name NULLS FIRST,\n         c_first_name NULLS FIRST,\n         c_salutation NULLS FIRST,\n         c_preferred_cust_flag DESC NULLS FIRST,\n         ss_ticket_number NULLS FIRST",
   "mv_sql": "SELECT ss.ss_ticket_number AS ss_ticket_number, ss.ss_customer_sk AS ss_customer_sk, ss.ss_store_sk AS ss_store_sk, ss.ss_hdemo_sk AS ss_hdemo_sk, d.d_year AS d_year, d.d_dom AS d_dom, count(*) AS cnt, sum(ss.ss_quantity) AS sum_quantity, count(ss.ss_quantity) AS count_quantity FROM store_sales ss, date_dim d WHERE ss.ss_sold_date_sk = d.d_date_sk GROUP BY ss.ss_ticket_number, ss.ss_customer_sk, ss.ss_store_sk, ss.ss_hdemo_sk, d.d_year, d.d_dom",
   "rewrite_sql": "SELECT c_last_name, c_first_name, c_salutation, c_preferred_cust_flag, ss_ticket_number, cnt FROM (SELECT m.ss_ticket_number AS ss_ticket_number, m.ss_customer_sk AS ss_customer_sk, SUM(m.cnt) AS cnt FROM tpcds_mv.mv_q34_ticket_counts m, store, household_demographics WHERE m.ss_store_sk = store.s_store_sk AND m.ss_hdemo_sk = household_demographics.hd_demo_sk AND (m.d_dom BETWEEN 1 AND 3 OR m.d_dom BETWEEN 25 AND 28) AND (household_demographics.hd_buy_potential = '>10000' OR household_demographics.hd_buy_potential = 'Unknown') AND household_demographics.hd_vehicle_count > 0 AND (CASE WHEN household_demographics.hd_vehicle_count > 0 THEN (household_demographics.hd_dep_count*1.000)/household_demographics.hd_vehicle_count ELSE NULL END) > 1.2 AND m.d_year IN (1999, 1999+1, 1999+2) AND store.s_county = 'Williamson County' GROUP BY m.ss_ticket_number, m.ss_customer_sk) dn, customer WHERE ss_customer_sk = c_customer_sk AND cnt BETWEEN 15 AND 20 ORDER BY c_last_name NULLS FIRST, c_first_name NULLS FIRST, c_salutation NULLS FIRST, c_preferred_cust_flag DESC NULLS FIRST, ss_ticket_number NULLS FIRST",
   "delta_sql": "SELECT ss.ss_ticket_number AS ss_ticket_number, ss.ss_customer_sk AS ss_customer_sk, ss.ss_store_sk AS ss_store_sk, ss.ss_hdemo_sk AS ss_hdemo_sk, d.d_year AS d_year, d.d_dom AS d_dom, count(*) AS cnt, sum(ss.ss_quantity) AS sum_quantity, count(ss.ss_quantity) AS count_quantity FROM $DELTA(store_sales) ss, $DELTA(date_dim) d WHERE ss.ss_sold_date_sk = d.d_date_sk GROUP BY ss.ss_ticket_number, ss.ss_customer_sk, ss.ss_store_sk, ss.ss_hdemo_sk, d.d_year, d.d_dom",
   "row_hash_at_author": "e6b8a24b19642b3be7ab4d07b9da9a7d",
   "sql_fingerprint_sha256": "0621692839857fdc"
  },
  {
   "labels": [
    "q44"
   ],
   "qid_pattern": "",
   "category": "subquery",
   "shape_class": "window|none|equality|rank-window|having-threshold",
   "tier": "tooluse_opus",
   "archetype_id": "",
   "mv_table": "mv_q44_store_item_netprofit",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 960349,
   "mv_cols": 6,
   "source_schema": "tpcds",
   "original_sql": "SELECT asceding.rnk,\n       i1.i_product_name best_performing,\n       i2.i_product_name worst_performing\nFROM\n  (SELECT *\n   FROM\n     (SELECT item_sk,\n             rank() OVER (\n                          ORDER BY rank_col ASC) rnk\n      FROM\n        (SELECT ss_item_sk item_sk,\n                avg(ss_net_profit) rank_col\n         FROM store_sales ss1\n         WHERE ss_store_sk = 4\n         GROUP BY ss_item_sk\n         HAVING avg(ss_net_profit) > 0.9*\n           (SELECT avg(ss_net_profit) rank_col\n            FROM store_sales\n            WHERE ss_store_sk = 4\n              AND ss_addr_sk IS NULL\n            GROUP BY ss_store_sk))V1)V11\n   WHERE rnk < 11) asceding,\n  (SELECT *\n   FROM\n     (SELECT item_sk,\n             rank() OVER (\n                          ORDER BY rank_col DESC) rnk\n      FROM\n        (SELECT ss_item_sk item_sk,\n                avg(ss_net_profit) rank_col\n         FROM store_sales ss1\n         WHERE ss_store_sk = 4\n         GROUP BY ss_item_sk\n         HAVING avg(ss_net_profit) > 0.9*\n           (SELECT avg(ss_net_profit) rank_col\n            FROM store_sales\n            WHERE ss_store_sk = 4\n              AND ss_addr_sk IS NULL\n            GROUP BY ss_store_sk))V2)V21\n   WHERE rnk < 11) descending,\n     item i1,\n     item i2\nWHERE asceding.rnk = descending.rnk\n  AND i1.i_item_sk=asceding.item_sk\n  AND i2.i_item_sk=descending.item_sk\nORDER BY asceding.rnk\nLIMIT 100",
   "mv_sql": "SELECT ss_store_sk, ss_item_sk, CASE WHEN ss_addr_sk IS NULL THEN 1 ELSE 0 END AS addr_is_null, SUM(ss_net_profit) AS sum_net_profit, COUNT(ss_net_profit) AS cnt_net_profit, COUNT(*) AS cnt_rows FROM store_sales GROUP BY ss_store_sk, ss_item_sk, CASE WHEN ss_addr_sk IS NULL THEN 1 ELSE 0 END",
   "rewrite_sql": "WITH g AS (SELECT ss_store_sk, ss_item_sk, addr_is_null, SUM(sum_net_profit) AS sum_net_profit, SUM(cnt_net_profit) AS cnt_net_profit FROM tpcds_mv.mv_q44_store_item_netprofit GROUP BY ss_store_sk, ss_item_sk, addr_is_null), base AS (SELECT ss_item_sk AS item_sk, SUM(sum_net_profit)/SUM(cnt_net_profit) AS rank_col FROM g WHERE ss_store_sk = 4 GROUP BY ss_item_sk HAVING SUM(cnt_net_profit) > 0), thr AS (SELECT SUM(sum_net_profit)/SUM(cnt_net_profit) AS rank_col FROM g WHERE ss_store_sk = 4 AND addr_is_null = 1 GROUP BY ss_store_sk HAVING SUM(cnt_net_profit) > 0), f AS (SELECT item_sk, rank_col FROM base WHERE rank_col > 0.9*(SELECT rank_col FROM thr)), asceding AS (SELECT item_sk, rnk FROM (SELECT item_sk, rank() OVER (ORDER BY rank_col ASC) rnk FROM f) V11 WHERE rnk < 11), descending AS (SELECT item_sk, rnk FROM (SELECT item_sk, rank() OVER (ORDER BY rank_col DESC) rnk FROM f) V21 WHERE rnk < 11) SELECT asceding.rnk, i1.i_product_name best_performing, i2.i_product_name worst_performing FROM asceding, descending, item i1, item i2 WHERE asceding.rnk = descending.rnk AND i1.i_item_sk = asceding.item_sk AND i2.i_item_sk = descending.item_sk ORDER BY asceding.rnk LIMIT 100",
   "delta_sql": "SELECT ss_store_sk, ss_item_sk, CASE WHEN ss_addr_sk IS NULL THEN 1 ELSE 0 END AS addr_is_null, SUM(ss_net_profit) AS sum_net_profit, COUNT(ss_net_profit) AS cnt_net_profit, COUNT(*) AS cnt_rows FROM $DELTA(store_sales) GROUP BY ss_store_sk, ss_item_sk, CASE WHEN ss_addr_sk IS NULL THEN 1 ELSE 0 END",
   "row_hash_at_author": "3eac1f3c2ef5215eb9bd13e28ae0975a",
   "sql_fingerprint_sha256": "c658052478455e10"
  },
  {
   "labels": [
    "q24"
   ],
   "qid_pattern": "",
   "category": "aggregation",
   "shape_class": "groupby|none|equality|avg|having-threshold",
   "tier": "tooluse_sonnet",
   "archetype_id": "",
   "mv_table": "ssales_rollup",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 223,
   "mv_cols": 13,
   "source_schema": "tpcds",
   "original_sql": "WITH ssales AS\n  (SELECT c_last_name,\n          c_first_name,\n          s_store_name,\n          ca_state,\n          s_state,\n          i_color,\n          i_current_price,\n          i_manager_id,\n          i_units,\n          i_size,\n          sum(ss_net_paid) netpaid\n   FROM store_sales,\n        store_returns,\n        store,\n        item,\n        customer,\n        customer_address\n   WHERE ss_ticket_number = sr_ticket_number\n     AND ss_item_sk = sr_item_sk\n     AND ss_customer_sk = c_customer_sk\n     AND ss_item_sk = i_item_sk\n     AND ss_store_sk = s_store_sk\n     AND c_current_addr_sk = ca_address_sk\n     AND c_birth_country <> upper(ca_country)\n     AND s_zip = ca_zip\n     AND s_market_id=8\n   GROUP BY c_last_name,\n            c_first_name,\n            s_store_name,\n            ca_state,\n            s_state,\n            i_color,\n            i_current_price,\n            i_manager_id,\n            i_units,\n            i_size)\nSELECT c_last_name,\n       c_first_name,\n       s_store_name,\n       sum(netpaid) paid\nFROM ssales\nWHERE i_color = 'peach'\nGROUP BY c_last_name,\n         c_first_name,\n         s_store_name\nHAVING sum(netpaid) >\n  (SELECT 0.05*avg(netpaid)\n   FROM ssales)\nORDER BY c_last_name,\n         c_first_name,\n         s_store_name",
   "mv_sql": "SELECT c_last_name, c_first_name, s_store_name, ca_state, s_state, i_color, i_current_price, i_manager_id, i_units, i_size, s_market_id, SUM(ss_net_paid) AS sum_netpaid, COUNT(ss_net_paid) AS count_netpaid FROM store_sales, store_returns, store, item, customer, customer_address WHERE ss_ticket_number = sr_ticket_number AND ss_item_sk = sr_item_sk AND ss_customer_sk = c_customer_sk AND ss_item_sk = i_item_sk AND ss_store_sk = s_store_sk AND c_current_addr_sk = ca_address_sk AND c_birth_country <> upper(ca_country) AND s_zip = ca_zip GROUP BY c_last_name, c_first_name, s_store_name, ca_state, s_state, i_color, i_current_price, i_manager_id, i_units, i_size, s_market_id",
   "rewrite_sql": "WITH ssales AS (SELECT c_last_name, c_first_name, s_store_name, i_color, SUM(sum_netpaid) AS netpaid, SUM(count_netpaid) AS cnt_netpaid FROM tpcds_mv.ssales_rollup WHERE s_market_id = 8 GROUP BY c_last_name, c_first_name, s_store_name, i_color) SELECT c_last_name, c_first_name, s_store_name, SUM(netpaid) AS paid FROM ssales WHERE i_color = 'peach' GROUP BY c_last_name, c_first_name, s_store_name HAVING SUM(netpaid) > (SELECT 0.05 * SUM(netpaid)/NULLIF(SUM(cnt_netpaid),0) FROM ssales) ORDER BY c_last_name, c_first_name, s_store_name",
   "delta_sql": "SELECT c_last_name, c_first_name, s_store_name, ca_state, s_state, i_color, i_current_price, i_manager_id, i_units, i_size, s_market_id, SUM(ss_net_paid) AS sum_netpaid, COUNT(ss_net_paid) AS count_netpaid FROM $DELTA(store_sales), $DELTA(store_returns), $DELTA(store), $DELTA(item), $DELTA(customer), $DELTA(customer_address) WHERE ss_ticket_number = sr_ticket_number AND ss_item_sk = sr_item_sk AND ss_customer_sk = c_customer_sk AND ss_item_sk = i_item_sk AND ss_store_sk = s_store_sk AND c_current_addr_sk = ca_address_sk AND c_birth_country <> upper(ca_country) AND s_zip = ca_zip GROUP BY c_last_name, c_first_name, s_store_name, ca_state, s_state, i_color, i_current_price, i_manager_id, i_units, i_size, s_market_id",
   "row_hash_at_author": "f7937b18223a50594951c83577fd3677",
