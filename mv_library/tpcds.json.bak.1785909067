   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT dt.d_year, item.i_category_id, item.i_category, sum(ss_ext_sales_price) FROM date_dim dt, store_sales, item WHERE dt.d_date_sk = store_sales.ss_sold_date_sk AND store_sales.ss_item_sk = item.i_item_sk AND item.i_manager_id = 1 AND dt.d_moy=11 AND dt.d_year=2000 GROUP BY dt.d_year, item.i_category_id, item.i_category ORDER BY sum(ss_ext_sales_price) DESC,dt.d_year, item.i_category_id, item.i_category LIMIT 100",
   "mv_sql": "SELECT dt.d_year AS d_year, item.i_category_id AS i_category_id, item.i_category AS i_category,\n       item.i_manager_id AS i_manager_id, dt.d_moy AS d_moy,\n       sum(ss_ext_sales_price) AS esp\nFROM date_dim dt, store_sales, item\nWHERE dt.d_date_sk = store_sales.ss_sold_date_sk AND store_sales.ss_item_sk = item.i_item_sk\nGROUP BY dt.d_year, item.i_category_id, item.i_category, item.i_manager_id, dt.d_moy",
   "rewrite_sql": "SELECT d_year, i_category_id, i_category, sum(esp) AS \"sum(ss_ext_sales_price)\"\nFROM iceberg.tpcds_mv.mv_h_47477610c2fa\nWHERE i_manager_id = 1 AND d_moy = 11 AND d_year = 2000\nGROUP BY d_year, i_category_id, i_category\nORDER BY sum(esp) DESC, d_year, i_category_id, i_category\nLIMIT 100",
   "delta_sql": "SELECT dt.d_year AS d_year, item.i_category_id AS i_category_id, item.i_category AS i_category,\n       item.i_manager_id AS i_manager_id, dt.d_moy AS d_moy,\n       sum(ss_ext_sales_price) AS esp\nFROM date_dim dt, $DELTA(store_sales), item\nWHERE dt.d_date_sk = store_sales.ss_sold_date_sk AND store_sales.ss_item_sk = item.i_item_sk\nGROUP BY dt.d_year, item.i_category_id, item.i_category, item.i_manager_id, dt.d_moy",
