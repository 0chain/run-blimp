   "source_schema": "tpcds",
   "original_sql": "SELECT avg(ss_quantity) avg1,\n       avg(ss_ext_sales_price) avg2,\n       avg(ss_ext_wholesale_cost) avg3,\n       sum(ss_ext_wholesale_cost)\nFROM store_sales ,\n     store ,\n     customer_demographics ,\n     household_demographics ,\n     customer_address ,\n     date_dim\nWHERE s_store_sk = ss_store_sk\n  AND ss_sold_date_sk = d_date_sk\n  AND d_year = 2001 and((ss_hdemo_sk=hd_demo_sk\n                         AND cd_demo_sk = ss_cdemo_sk\n                         AND cd_marital_status = 'M'\n                         AND cd_education_status = 'Advanced Degree'\n                         AND ss_sales_price BETWEEN 100.00 AND 150.00\n                         AND hd_dep_count = 3)\n                        OR (ss_hdemo_sk=hd_demo_sk\n                            AND cd_demo_sk = ss_cdemo_sk\n                            AND cd_marital_status = 'S'\n                            AND cd_education_status = 'College'\n                            AND ss_sales_price BETWEEN 50.00 AND 100.00\n                            AND hd_dep_count = 1 )\n                        OR (ss_hdemo_sk=hd_demo_sk\n                            AND cd_demo_sk = ss_cdemo_sk\n                            AND cd_marital_status = 'W'\n                            AND cd_education_status = '2 yr Degree'\n                            AND ss_sales_price BETWEEN 150.00 AND 200.00\n                            AND hd_dep_count = 1)) and((ss_addr_sk = ca_address_sk\n                                                        AND ca_country = 'United States'\n                                                        AND ca_state IN ('TX', 'OH', 'TX')\n                                                        AND ss_net_profit BETWEEN 100 AND 200)\n                                                       OR (ss_addr_sk = ca_address_sk\n                                                           AND ca_country = 'United States'\n                                                           AND ca_state IN ('OR', 'NM', 'KY')\n                                                           AND ss_net_profit BETWEEN 150 AND 300)\n                                                       OR (ss_addr_sk = ca_address_sk\n                                                           AND ca_country = 'United States'\n                                                           AND ca_state IN ('VA', 'TX', 'MS')\n                                                           AND ss_net_profit BETWEEN 50 AND 250))",
   "mv_sql": "SELECT d_year, cd_marital_status, cd_education_status, ca_state, ca_country, sum(ss_quantity) AS sum_qty, count(ss_quantity) AS cnt_qty, sum(ss_ext_sales_price) AS sum_ext_sales, count(ss_ext_sales_price) AS cnt_ext_sales, sum(ss_ext_wholesale_cost) AS sum_ext_wholesale, count(ss_ext_wholesale_cost) AS cnt_ext_wholesale FROM store_sales, store, customer_demographics, household_demographics, customer_address, date_dim WHERE s_store_sk = ss_store_sk AND ss_sold_date_sk = d_date_sk AND ((ss_hdemo_sk=hd_demo_sk AND cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'M' AND cd_education_status = 'Advanced Degree' AND ss_sales_price BETWEEN 100.00 AND 150.00 AND hd_dep_count = 3) OR (ss_hdemo_sk=hd_demo_sk AND cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'S' AND cd_education_status = 'College' AND ss_sales_price BETWEEN 50.00 AND 100.00 AND hd_dep_count = 1) OR (ss_hdemo_sk=hd_demo_sk AND cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'W' AND cd_education_status = '2 yr Degree' AND ss_sales_price BETWEEN 150.00 AND 200.00 AND hd_dep_count = 1)) AND ((ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('TX', 'OH', 'TX') AND ss_net_profit BETWEEN 100 AND 200) OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('OR', 'NM', 'KY') AND ss_net_profit BETWEEN 150 AND 300) OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('VA', 'TX', 'MS') AND ss_net_profit BETWEEN 50 AND 250)) GROUP BY d_year, cd_marital_status, cd_education_status, ca_state, ca_country",
   "rewrite_sql": "SELECT SUM(sum_qty)/SUM(cnt_qty) AS avg1, SUM(sum_ext_sales)/SUM(cnt_ext_sales) AS avg2, SUM(sum_ext_wholesale)/SUM(cnt_ext_wholesale) AS avg3, SUM(sum_ext_wholesale) AS sum3 FROM tpcds_mv.mv_q23 WHERE d_year = 2001 AND ((cd_marital_status = 'M' AND cd_education_status = 'Advanced Degree') OR (cd_marital_status = 'S' AND cd_education_status = 'College') OR (cd_marital_status = 'W' AND cd_education_status = '2 yr Degree')) AND ((ca_country = 'United States' AND ca_state IN ('TX','OH')) OR (ca_country = 'United States' AND ca_state IN ('OR','NM','KY')) OR (ca_country = 'United States' AND ca_state IN ('VA','TX','MS')))",
   "delta_sql": "SELECT d_year, cd_marital_status, cd_education_status, ca_state, ca_country, sum(ss_quantity) AS sum_qty, count(ss_quantity) AS cnt_qty, sum(ss_ext_sales_price) AS sum_ext_sales, count(ss_ext_sales_price) AS cnt_ext_sales, sum(ss_ext_wholesale_cost) AS sum_ext_wholesale, count(ss_ext_wholesale_cost) AS cnt_ext_wholesale FROM $DELTA(store_sales), store, customer_demographics, household_demographics, customer_address, date_dim WHERE s_store_sk = ss_store_sk AND ss_sold_date_sk = d_date_sk AND ((ss_hdemo_sk=hd_demo_sk AND cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'M' AND cd_education_status = 'Advanced Degree' AND ss_sales_price BETWEEN 100.00 AND 150.00 AND hd_dep_count = 3) OR (ss_hdemo_sk=hd_demo_sk AND cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'S' AND cd_education_status = 'College' AND ss_sales_price BETWEEN 50.00 AND 100.00 AND hd_dep_count = 1) OR (ss_hdemo_sk=hd_demo_sk AND cd_demo_sk = ss_cdemo_sk AND cd_marital_status = 'W' AND cd_education_status = '2 yr Degree' AND ss_sales_price BETWEEN 150.00 AND 200.00 AND hd_dep_count = 1)) AND ((ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('TX', 'OH', 'TX') AND ss_net_profit BETWEEN 100 AND 200) OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('OR', 'NM', 'KY') AND ss_net_profit BETWEEN 150 AND 300) OR (ss_addr_sk = ca_address_sk AND ca_country = 'United States' AND ca_state IN ('VA', 'TX', 'MS') AND ss_net_profit BETWEEN 50 AND 250)) GROUP BY d_year, cd_marital_status, cd_education_status, ca_state, ca_country",
   "row_hash_at_author": "0aa36175df9ddcd8d87aed37f7ae5f8b",
