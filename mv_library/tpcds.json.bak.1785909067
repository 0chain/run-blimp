   "mv_cols": 7,
   "source_schema": "tpcds",
   "original_sql": "SELECT w_state,\n       i_item_id,\n       sum(CASE\n               WHEN (cast(d_date AS date) < CAST ('2000-03-11' AS date)) THEN cs_sales_price - coalesce(cr_refunded_cash,0)\n               ELSE 0\n           END) AS sales_before,\n       sum(CASE\n               WHEN (cast(d_date AS date) >= CAST ('2000-03-11' AS date)) THEN cs_sales_price - coalesce(cr_refunded_cash,0)\n               ELSE 0\n           END) AS sales_after\nFROM catalog_sales\nLEFT OUTER JOIN catalog_returns ON (cs_order_number = cr_order_number\n                                    AND cs_item_sk = cr_item_sk) ,warehouse,\n                                                                  item,\n                                                                  date_dim\nWHERE i_current_price BETWEEN 0.99 AND 1.49\n  AND i_item_sk = cs_item_sk\n  AND cs_warehouse_sk = w_warehouse_sk\n  AND cs_sold_date_sk = d_date_sk\n  AND d_date BETWEEN CAST ('2000-02-10' AS date) AND CAST ('2000-04-10' AS date)\nGROUP BY w_state,\n         i_item_id\nORDER BY w_state,\n         i_item_id\nLIMIT 100",
   "mv_sql": "SELECT w_state, cs_item_sk, cs_sold_date_sk, SUM(cs_sales_price - coalesce(cr_refunded_cash,0)) AS sum_net_sales, SUM(cs_sales_price) AS sum_sales_price, SUM(coalesce(cr_refunded_cash,0)) AS sum_refunded_cash, COUNT(*) AS cnt_rows FROM catalog_sales LEFT OUTER JOIN catalog_returns ON (cs_order_number = cr_order_number AND cs_item_sk = cr_item_sk), warehouse WHERE cs_warehouse_sk = w_warehouse_sk GROUP BY w_state, cs_item_sk, cs_sold_date_sk",
   "rewrite_sql": "SELECT w_state, i_item_id, SUM(CASE WHEN cast(d_date AS date) < CAST('2000-03-11' AS date) THEN sum_net_sales ELSE 0 END) AS sales_before, SUM(CASE WHEN cast(d_date AS date) >= CAST('2000-03-11' AS date) THEN sum_net_sales ELSE 0 END) AS sales_after FROM tpcds_mv.mv_cs_ret_state_item_day m, item, date_dim WHERE i_item_sk = m.cs_item_sk AND d_date_sk = m.cs_sold_date_sk AND i_current_price BETWEEN 0.99 AND 1.49 AND d_date BETWEEN CAST('2000-02-10' AS date) AND CAST('2000-04-10' AS date) GROUP BY w_state, i_item_id ORDER BY w_state, i_item_id LIMIT 100",
   "delta_sql": "SELECT w_state, cs_item_sk, cs_sold_date_sk, SUM(cs_sales_price - coalesce(cr_refunded_cash,0)) AS sum_net_sales, SUM(cs_sales_price) AS sum_sales_price, SUM(coalesce(cr_refunded_cash,0)) AS sum_refunded_cash, COUNT(*) AS cnt_rows FROM $DELTA(catalog_sales) LEFT OUTER JOIN $DELTA(catalog_returns) ON (cs_order_number = cr_order_number AND cs_item_sk = cr_item_sk), $DELTA(warehouse) WHERE cs_warehouse_sk = w_warehouse_sk GROUP BY w_state, cs_item_sk, cs_sold_date_sk",
   "row_hash_at_author": "b94f7ecdd370a3b12899399402a05166",
   "sql_fingerprint_sha256": "9bc7c60e5b339651"
