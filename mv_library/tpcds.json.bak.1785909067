   "source_schema": "tpcds",
   "original_sql": "WITH results AS\n  (SELECT i_item_id,\n          s_state,\n          0 AS g_state,\n          ss_quantity agg1,\n          ss_list_price agg2,\n          ss_coupon_amt agg3,\n          ss_sales_price agg4\n   FROM store_sales,\n        customer_demographics,\n        date_dim,\n        store,\n        item\n   WHERE ss_sold_date_sk = d_date_sk\n     AND ss_item_sk = i_item_sk\n     AND ss_store_sk = s_store_sk\n     AND ss_cdemo_sk = cd_demo_sk\n     AND cd_gender = 'M'\n     AND cd_marital_status = 'S'\n     AND cd_education_status = 'College'\n     AND d_year = 2002\n     AND s_state = 'TN' )\nSELECT i_item_id,\n       s_state,\n       g_state,\n       agg1,\n       agg2,\n       agg3,\n       agg4\nFROM\n  ( SELECT i_item_id,\n           s_state,\n           0 AS g_state,\n           avg(agg1) agg1,\n           avg(agg2) agg2,\n           avg(agg3) agg3,\n           avg(agg4) agg4\n   FROM results\n   GROUP BY i_item_id ,\n            s_state\n   UNION ALL SELECT i_item_id,\n                    NULL AS s_state,\n                    1 AS g_state,\n                    avg(agg1) agg1,\n                    avg(agg2) agg2,\n                    avg(agg3) agg3,\n                    avg(agg4) agg4\n   FROM results\n   GROUP BY i_item_id\n   UNION ALL SELECT NULL AS i_item_id,\n                    NULL AS s_state,\n                    1 AS g_state,\n                    avg(agg1) agg1,\n                    avg(agg2) agg2,\n                    avg(agg3) agg3,\n                    avg(agg4) agg4\n   FROM results ) foo\nORDER BY i_item_id NULLS FIRST,\n         s_state NULLS FIRST\nLIMIT 100",
   "mv_sql": "SELECT i_item_id, s_state, cd_gender, cd_marital_status, cd_education_status, d_year, COUNT(ss_quantity) AS count_agg1, SUM(ss_quantity) AS sum_agg1, COUNT(ss_list_price) AS count_agg2, SUM(ss_list_price) AS sum_agg2, COUNT(ss_coupon_amt) AS count_agg3, SUM(ss_coupon_amt) AS sum_agg3, COUNT(ss_sales_price) AS count_agg4, SUM(ss_sales_price) AS sum_agg4 FROM store_sales, customer_demographics, date_dim, store, item WHERE ss_sold_date_sk = d_date_sk AND ss_item_sk = i_item_sk AND ss_store_sk = s_store_sk AND ss_cdemo_sk = cd_demo_sk GROUP BY i_item_id, s_state, cd_gender, cd_marital_status, cd_education_status, d_year",
   "rewrite_sql": "WITH results AS (SELECT i_item_id, s_state, sum_agg1, count_agg1, sum_agg2, count_agg2, sum_agg3, count_agg3, sum_agg4, count_agg4 FROM tpcds_mv.store_sales_cdemo_rollup WHERE cd_gender = 'M' AND cd_marital_status = 'S' AND cd_education_status = 'College' AND d_year = 2002 AND s_state = 'TN') SELECT i_item_id, s_state, g_state, agg1, agg2, agg3, agg4 FROM ( SELECT i_item_id, s_state, 0 AS g_state, SUM(sum_agg1)/SUM(count_agg1) AS agg1, SUM(sum_agg2)/SUM(count_agg2) AS agg2, SUM(sum_agg3)/SUM(count_agg3) AS agg3, SUM(sum_agg4)/SUM(count_agg4) AS agg4 FROM results GROUP BY i_item_id, s_state UNION ALL SELECT i_item_id, NULL AS s_state, 1 AS g_state, SUM(sum_agg1)/SUM(count_agg1), SUM(sum_agg2)/SUM(count_agg2), SUM(sum_agg3)/SUM(count_agg3), SUM(sum_agg4)/SUM(count_agg4) FROM results GROUP BY i_item_id UNION ALL SELECT NULL AS i_item_id, NULL AS s_state, 1 AS g_state, SUM(sum_agg1)/SUM(count_agg1), SUM(sum_agg2)/SUM(count_agg2), SUM(sum_agg3)/SUM(count_agg3), SUM(sum_agg4)/SUM(count_agg4) FROM results ) foo ORDER BY i_item_id NULLS FIRST, s_state NULLS FIRST LIMIT 100",
   "delta_sql": "SELECT i_item_id, s_state, cd_gender, cd_marital_status, cd_education_status, d_year, COUNT(ss_quantity) AS count_agg1, SUM(ss_quantity) AS sum_agg1, COUNT(ss_list_price) AS count_agg2, SUM(ss_list_price) AS sum_agg2, COUNT(ss_coupon_amt) AS count_agg3, SUM(ss_coupon_amt) AS sum_agg3, COUNT(ss_sales_price) AS count_agg4, SUM(ss_sales_price) AS sum_agg4 FROM $DELTA(store_sales), customer_demographics, date_dim, store, item WHERE ss_sold_date_sk = d_date_sk AND ss_item_sk = i_item_sk AND ss_store_sk = s_store_sk AND ss_cdemo_sk = cd_demo_sk GROUP BY i_item_id, s_state, cd_gender, cd_marital_status, cd_education_status, d_year",
