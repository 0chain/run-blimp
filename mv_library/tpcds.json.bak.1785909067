   "archetype_id": "",
   "mv_table": "mv_h_ad5ed6b4ec01",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 1795,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "WITH ss_items AS (SELECT i_item_id item_id, sum(ss_ext_sales_price) ss_item_rev FROM store_sales, item, date_dim WHERE ss_item_sk = i_item_sk AND d_date IN (SELECT d_date FROM date_dim WHERE d_week_seq = (SELECT d_week_seq FROM date_dim WHERE d_date = '2000-01-03')) AND ss_sold_date_sk = d_date_sk GROUP BY i_item_id), cs_items AS (SELECT i_item_id item_id, sum(cs_ext_sales_price) cs_item_rev FROM catalog_sales, item, date_dim WHERE cs_item_sk = i_item_sk AND d_date IN (SELECT d_date FROM date_dim WHERE d_week_seq = (SELECT d_week_seq FROM date_dim WHERE d_date = '2000-01-03')) AND cs_sold_date_sk = d_date_sk GROUP BY i_item_id), ws_items AS (SELECT i_item_id item_id, sum(ws_ext_sales_price) ws_item_rev FROM web_sales, item, date_dim WHERE ws_item_sk = i_item_sk AND d_date IN (SELECT d_date FROM date_dim WHERE d_week_seq = (SELECT d_week_seq FROM date_dim WHERE d_date = '2000-01-03')) AND ws_sold_date_sk = d_date_sk GROUP BY i_item_id) SELECT ss_items.item_id, ss_item_rev, ss_item_rev/((ss_item_rev+cs_item_rev+ws_item_rev)/3) * 100 ss_dev, cs_item_rev, cs_item_rev/((ss_item_rev+cs_item_rev+ws_item_rev)/3) * 100 cs_dev, ws_item_rev, ws_item_rev/((ss_item_rev+cs_item_rev+ws_item_rev)/3) * 100 ws_dev, (ss_item_rev+cs_item_rev+ws_item_rev)/3 average FROM ss_items, cs_items, ws_items WHERE ss_items.item_id=cs_items.item_id AND ss_items.item_id=ws_items.item_id AND ss_item_rev BETWEEN 0.9 * cs_item_rev AND 1.1 * cs_item_rev AND ss_item_rev BETWEEN 0.9 * ws_item_rev AND 1.1 * ws_item_rev AND cs_item_rev BETWEEN 0.9 * ss_item_rev AND 1.1 * ss_item_rev AND cs_item_rev BETWEEN 0.9 * ws_item_rev AND 1.1 * ws_item_rev AND ws_item_rev BETWEEN 0.9 * ss_item_rev AND 1.1 * ss_item_rev AND ws_item_rev BETWEEN 0.9 * cs_item_rev AND 1.1 * cs_item_rev ORDER BY ss_items.item_id NULLS FIRST, ss_item_rev NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT 's' AS channel, i_item_id, d_date, sum(ss_ext_sales_price) AS rev\nFROM store_sales, item, date_dim\nWHERE d_date = '2000-01-03' AND ss_item_sk = i_item_sk AND ss_sold_date_sk = d_date_sk\nGROUP BY 1, i_item_id, d_date UNION ALL SELECT 'c' AS channel, i_item_id, d_date, sum(cs_ext_sales_price) AS rev\nFROM catalog_sales, item, date_dim\nWHERE d_date = '2000-01-03' AND cs_item_sk = i_item_sk AND cs_sold_date_sk = d_date_sk\nGROUP BY 1, i_item_id, d_date UNION ALL SELECT 'w' AS channel, i_item_id, d_date, sum(ws_ext_sales_price) AS rev\nFROM web_sales, item, date_dim\nWHERE d_date = '2000-01-03' AND ws_item_sk = i_item_sk AND ws_sold_date_sk = d_date_sk\nGROUP BY 1, i_item_id, d_date",
   "rewrite_sql": "WITH ss_items AS\n  (SELECT i_item_id item_id, sum(rev) ss_item_rev FROM iceberg.tpcds_mv.mv_h_ad5ed6b4ec01\n   WHERE channel = 's' AND d_date IN (SELECT d_date FROM date_dim WHERE d_week_seq = (SELECT d_week_seq FROM date_dim WHERE d_date = '2000-01-03')) GROUP BY i_item_id),\n     cs_items AS\n  (SELECT i_item_id item_id, sum(rev) cs_item_rev FROM iceberg.tpcds_mv.mv_h_ad5ed6b4ec01\n   WHERE channel = 'c' AND d_date IN (SELECT d_date FROM date_dim WHERE d_week_seq = (SELECT d_week_seq FROM date_dim WHERE d_date = '2000-01-03')) GROUP BY i_item_id),\n     ws_items AS\n  (SELECT i_item_id item_id, sum(rev) ws_item_rev FROM iceberg.tpcds_mv.mv_h_ad5ed6b4ec01\n   WHERE channel = 'w' AND d_date IN (SELECT d_date FROM date_dim WHERE d_week_seq = (SELECT d_week_seq FROM date_dim WHERE d_date = '2000-01-03')) GROUP BY i_item_id)\nSELECT ss_items.item_id, ss_item_rev,\n       ss_item_rev/((ss_item_rev+cs_item_rev+ws_item_rev)/3) * 100 ss_dev,\n       cs_item_rev, cs_item_rev/((ss_item_rev+cs_item_rev+ws_item_rev)/3) * 100 cs_dev,\n       ws_item_rev, ws_item_rev/((ss_item_rev+cs_item_rev+ws_item_rev)/3) * 100 ws_dev,\n       (ss_item_rev+cs_item_rev+ws_item_rev)/3 average\nFROM ss_items, cs_items, ws_items\nWHERE ss_items.item_id=cs_items.item_id AND ss_items.item_id=ws_items.item_id\n  AND ss_item_rev BETWEEN 0.9 * cs_item_rev AND 1.1 * cs_item_rev\n  AND ss_item_rev BETWEEN 0.9 * ws_item_rev AND 1.1 * ws_item_rev\n  AND cs_item_rev BETWEEN 0.9 * ss_item_rev AND 1.1 * ss_item_rev\n  AND cs_item_rev BETWEEN 0.9 * ws_item_rev AND 1.1 * ws_item_rev\n  AND ws_item_rev BETWEEN 0.9 * ss_item_rev AND 1.1 * ss_item_rev\n  AND ws_item_rev BETWEEN 0.9 * cs_item_rev AND 1.1 * cs_item_rev\nORDER BY ss_items.item_id NULLS FIRST, ss_item_rev NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT 's' AS channel, i_item_id, d_date, sum(ss_ext_sales_price) AS rev\nFROM $DELTA(store_sales), item, date_dim\nWHERE d_date = '2000-01-03' AND ss_item_sk = i_item_sk AND ss_sold_date_sk = d_date_sk\nGROUP BY 1, i_item_id, d_date UNION ALL SELECT 'c' AS channel, i_item_id, d_date, sum(cs_ext_sales_price) AS rev\nFROM $DELTA(catalog_sales), item, date_dim\nWHERE d_date = '2000-01-03' AND cs_item_sk = i_item_sk AND cs_sold_date_sk = d_date_sk\nGROUP BY 1, i_item_id, d_date UNION ALL SELECT 'w' AS channel, i_item_id, d_date, sum(ws_ext_sales_price) AS rev\nFROM $DELTA(web_sales), item, date_dim\nWHERE d_date = '2000-01-03' AND ws_item_sk = i_item_sk AND ws_sold_date_sk = d_date_sk\nGROUP BY 1, i_item_id, d_date",
   "row_hash_at_author": "b7d38d9c4e3f9a9b511595d86876f346",
