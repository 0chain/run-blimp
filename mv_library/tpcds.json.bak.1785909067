   "mv_table": "mv_h_b23f285566cc",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 58092,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip, sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk <= 30) THEN 1 ELSE 0 END) AS \"30 days\", sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 30) AND (sr_returned_date_sk - ss_sold_date_sk <= 60) THEN 1 ELSE 0 END) AS \"31-60 days\", sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 60) AND (sr_returned_date_sk - ss_sold_date_sk <= 90) THEN 1 ELSE 0 END) AS \"61-90 days\", sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 90) AND (sr_returned_date_sk - ss_sold_date_sk <= 120) THEN 1 ELSE 0 END) AS \"91-120 days\", sum(CASE WHEN (sr_returned_date_sk - ss_sold_date_sk > 120) THEN 1 ELSE 0 END) AS \">120 days\" FROM store_sales, store_returns, store, date_dim d1, date_dim d2 WHERE d2.d_year = 2001 AND d2.d_moy = 8 AND ss_ticket_number = sr_ticket_number AND ss_item_sk = sr_item_sk AND ss_sold_date_sk = d1.d_date_sk AND sr_returned_date_sk = d2.d_date_sk AND ss_customer_sk = sr_customer_sk AND ss_store_sk = s_store_sk GROUP BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip ORDER BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip LIMIT 100",
   "mv_sql": "SELECT s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,\n       s_suite_number, s_city, s_county, s_state, s_zip,\n       d2.d_year AS d2_year, d2.d_moy AS d2_moy,\n       sr_returned_date_sk - ss_sold_date_sk AS days_diff,\n       count(*) AS cnt\nFROM store_sales, store_returns, store, date_dim d1, date_dim d2\nWHERE ss_ticket_number = sr_ticket_number\n  AND ss_item_sk = sr_item_sk\n  AND ss_sold_date_sk = d1.d_date_sk\n  AND sr_returned_date_sk = d2.d_date_sk\n  AND ss_customer_sk = sr_customer_sk\n  AND ss_store_sk = s_store_sk\nGROUP BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,\n         s_suite_number, s_city, s_county, s_state, s_zip, d2.d_year, d2.d_moy,\n         sr_returned_date_sk - ss_sold_date_sk",
   "rewrite_sql": "SELECT s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,\n       s_suite_number, s_city, s_county, s_state, s_zip,\n       sum(CASE WHEN (days_diff <= 30) THEN cnt ELSE 0 END) AS \"30 days\",\n       sum(CASE WHEN (days_diff > 30) AND (days_diff <= 60) THEN cnt ELSE 0 END) AS \"31-60 days\",\n       sum(CASE WHEN (days_diff > 60) AND (days_diff <= 90) THEN cnt ELSE 0 END) AS \"61-90 days\",\n       sum(CASE WHEN (days_diff > 90) AND (days_diff <= 120) THEN cnt ELSE 0 END) AS \"91-120 days\",\n       sum(CASE WHEN (days_diff > 120) THEN cnt ELSE 0 END) AS \">120 days\"\nFROM iceberg.tpcds_mv.mv_h_b23f285566cc\nWHERE d2_year = 2001 AND d2_moy = 8\nGROUP BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,\n         s_suite_number, s_city, s_county, s_state, s_zip\nORDER BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,\n         s_suite_number, s_city, s_county, s_state, s_zip\nLIMIT 100",
   "delta_sql": "SELECT s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,\n       s_suite_number, s_city, s_county, s_state, s_zip,\n       d2.d_year AS d2_year, d2.d_moy AS d2_moy,\n       sr_returned_date_sk - ss_sold_date_sk AS days_diff,\n       count(*) AS cnt\nFROM $DELTA(store_sales), $DELTA(store_returns), store, date_dim d1, date_dim d2\nWHERE ss_ticket_number = sr_ticket_number\n  AND ss_item_sk = sr_item_sk\n  AND ss_sold_date_sk = d1.d_date_sk\n  AND sr_returned_date_sk = d2.d_date_sk\n  AND ss_customer_sk = sr_customer_sk\n  AND ss_store_sk = s_store_sk\nGROUP BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type,\n         s_suite_number, s_city, s_county, s_state, s_zip, d2.d_year, d2.d_moy,\n         sr_returned_date_sk - ss_sold_date_sk",
   "row_hash_at_author": "479575e9f8caff3e5341c11cb1b9c0e4",
   "sql_fingerprint_sha256": "beb093589f583434"
