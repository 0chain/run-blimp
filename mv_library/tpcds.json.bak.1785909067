   "qid_pattern": "",
   "category": "subquery",
   "shape_class": "global-scalar|none|between-range|additive|none",
   "tier": "tooluse_sonnet",
   "archetype_id": "",
   "mv_table": "cool_cust_body",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": -1,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT count(*)\nFROM ((SELECT DISTINCT c_last_name,\n                         c_first_name,\n                         d_date\n         FROM store_sales,\n              date_dim,\n              customer\n         WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk\n           AND store_sales.ss_customer_sk = customer.c_customer_sk\n           AND d_month_seq BETWEEN 1200 AND 1200+11)\n      EXCEPT\n        (SELECT DISTINCT c_last_name,\n                         c_first_name,\n                         d_date\n         FROM catalog_sales,\n              date_dim,\n              customer\n         WHERE catalog_sales.cs_sold_date_sk = date_dim.d_date_sk\n           AND catalog_sales.cs_bill_customer_sk = customer.c_customer_sk\n           AND d_month_seq BETWEEN 1200 AND 1200+11)\n      EXCEPT\n        (SELECT DISTINCT c_last_name,\n                         c_first_name,\n                         d_date\n         FROM web_sales,\n              date_dim,\n              customer\n         WHERE web_sales.ws_sold_date_sk = date_dim.d_date_sk\n           AND web_sales.ws_bill_customer_sk = customer.c_customer_sk\n           AND d_month_seq BETWEEN 1200 AND 1200+11)) cool_cust",
   "mv_sql": "SELECT 'store' AS part, customer.c_customer_sk AS c_customer_sk, customer.c_last_name AS c_last_name, customer.c_first_name AS c_first_name, date_dim.d_date_sk AS d_date_sk, date_dim.d_date AS d_date, date_dim.d_month_seq AS d_month_seq, COUNT(*) AS cnt FROM store_sales, date_dim, customer WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk AND store_sales.ss_customer_sk = customer.c_customer_sk GROUP BY customer.c_customer_sk, customer.c_last_name, customer.c_first_name, date_dim.d_date_sk, date_dim.d_date, date_dim.d_month_seq UNION ALL SELECT 'catalog' AS part, customer.c_customer_sk AS c_customer_sk, customer.c_last_name AS c_last_name, customer.c_first_name AS c_first_name, date_dim.d_date_sk AS d_date_sk, date_dim.d_date AS d_date, date_dim.d_month_seq AS d_month_seq, COUNT(*) AS cnt FROM catalog_sales, date_dim, customer WHERE catalog_sales.cs_sold_date_sk = date_dim.d_date_sk AND catalog_sales.cs_bill_customer_sk = customer.c_customer_sk GROUP BY customer.c_customer_sk, customer.c_last_name, customer.c_first_name, date_dim.d_date_sk, date_dim.d_date, date_dim.d_month_seq UNION ALL SELECT 'web' AS part, customer.c_customer_sk AS c_customer_sk, customer.c_last_name AS c_last_name, customer.c_first_name AS c_first_name, date_dim.d_date_sk AS d_date_sk, date_dim.d_date AS d_date, date_dim.d_month_seq AS d_month_seq, COUNT(*) AS cnt FROM web_sales, date_dim, customer WHERE web_sales.ws_sold_date_sk = date_dim.d_date_sk AND web_sales.ws_bill_customer_sk = customer.c_customer_sk GROUP BY customer.c_customer_sk, customer.c_last_name, customer.c_first_name, date_dim.d_date_sk, date_dim.d_date, date_dim.d_month_seq",
   "rewrite_sql": "WITH agg AS (SELECT part, c_customer_sk, c_last_name, c_first_name, d_date, d_month_seq, SUM(cnt) AS cnt FROM tpcds_mv.cool_cust_body GROUP BY part, c_customer_sk, c_last_name, c_first_name, d_date, d_month_seq), store_set AS (SELECT DISTINCT c_last_name, c_first_name, d_date FROM agg WHERE part='store' AND d_month_seq BETWEEN 1200 AND 1200+11), catalog_set AS (SELECT DISTINCT c_last_name, c_first_name, d_date FROM agg WHERE part='catalog' AND d_month_seq BETWEEN 1200 AND 1200+11), web_set AS (SELECT DISTINCT c_last_name, c_first_name, d_date FROM agg WHERE part='web' AND d_month_seq BETWEEN 1200 AND 1200+11), cool_cust AS ((SELECT * FROM store_set) EXCEPT (SELECT * FROM catalog_set) EXCEPT (SELECT * FROM web_set)) SELECT count(*) FROM cool_cust",
   "delta_sql": "SELECT 'store' AS part, customer.c_customer_sk AS c_customer_sk, customer.c_last_name AS c_last_name, customer.c_first_name AS c_first_name, date_dim.d_date_sk AS d_date_sk, date_dim.d_date AS d_date, date_dim.d_month_seq AS d_month_seq, COUNT(*) AS cnt FROM $DELTA(store_sales), date_dim, customer WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk AND store_sales.ss_customer_sk = customer.c_customer_sk GROUP BY customer.c_customer_sk, customer.c_last_name, customer.c_first_name, date_dim.d_date_sk, date_dim.d_date, date_dim.d_month_seq UNION ALL SELECT 'catalog' AS part, customer.c_customer_sk AS c_customer_sk, customer.c_last_name AS c_last_name, customer.c_first_name AS c_first_name, date_dim.d_date_sk AS d_date_sk, date_dim.d_date AS d_date, date_dim.d_month_seq AS d_month_seq, COUNT(*) AS cnt FROM $DELTA(catalog_sales), date_dim, customer WHERE catalog_sales.cs_sold_date_sk = date_dim.d_date_sk AND catalog_sales.cs_bill_customer_sk = customer.c_customer_sk GROUP BY customer.c_customer_sk, customer.c_last_name, customer.c_first_name, date_dim.d_date_sk, date_dim.d_date, date_dim.d_month_seq UNION ALL SELECT 'web' AS part, customer.c_customer_sk AS c_customer_sk, customer.c_last_name AS c_last_name, customer.c_first_name AS c_first_name, date_dim.d_date_sk AS d_date_sk, date_dim.d_date AS d_date, date_dim.d_month_seq AS d_month_seq, COUNT(*) AS cnt FROM $DELTA(web_sales), date_dim, customer WHERE web_sales.ws_sold_date_sk = date_dim.d_date_sk AND web_sales.ws_bill_customer_sk = customer.c_customer_sk GROUP BY customer.c_customer_sk, customer.c_last_name, customer.c_first_name, date_dim.d_date_sk, date_dim.d_date, date_dim.d_month_seq",
   "row_hash_at_author": "873e841f9aac628d2f99c2bc6e51358d",
