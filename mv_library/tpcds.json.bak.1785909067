   "original_sql": "WITH ss AS (SELECT s_store_sk, sum(ss_ext_sales_price) AS sales, sum(ss_net_profit) AS profit FROM store_sales, date_dim, store WHERE ss_sold_date_sk = d_date_sk AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND ss_store_sk = s_store_sk GROUP BY s_store_sk) , sr AS (SELECT s_store_sk, sum(sr_return_amt) AS returns_, sum(sr_net_loss) AS profit_loss FROM store_returns, date_dim, store WHERE sr_returned_date_sk = d_date_sk AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND sr_store_sk = s_store_sk GROUP BY s_store_sk), cs AS (SELECT cs_call_center_sk, sum(cs_ext_sales_price) AS sales, sum(cs_net_profit) AS profit FROM catalog_sales, date_dim WHERE cs_sold_date_sk = d_date_sk AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) GROUP BY cs_call_center_sk), cr AS (SELECT cr_call_center_sk, sum(cr_return_amount) AS returns_, sum(cr_net_loss) AS profit_loss FROM catalog_returns, date_dim WHERE cr_returned_date_sk = d_date_sk AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) GROUP BY cr_call_center_sk ), ws AS (SELECT wp_web_page_sk, sum(ws_ext_sales_price) AS sales, sum(ws_net_profit) AS profit FROM web_sales, date_dim, web_page WHERE ws_sold_date_sk = d_date_sk AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND ws_web_page_sk = wp_web_page_sk GROUP BY wp_web_page_sk), wr AS (SELECT wp_web_page_sk, sum(wr_return_amt) AS returns_, sum(wr_net_loss) AS profit_loss FROM web_returns, date_dim, web_page WHERE wr_returned_date_sk = d_date_sk AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND wr_web_page_sk = wp_web_page_sk GROUP BY wp_web_page_sk) SELECT channel , id , sum(sales) AS sales , sum(returns_) AS returns_ , sum(profit) AS profit FROM (SELECT 'store channel' AS channel , ss.s_store_sk AS id , sales , coalesce(returns_, 0) AS returns_ , (profit - coalesce(profit_loss,0)) AS profit FROM ss LEFT JOIN sr ON ss.s_store_sk = sr.s_store_sk UNION ALL SELECT 'catalog channel' AS channel , cs_call_center_sk AS id , sales , returns_ , (profit - profit_loss) AS profit FROM cs , cr UNION ALL SELECT 'web channel' AS channel , ws.wp_web_page_sk AS id , sales , coalesce(returns_, 0) returns_ , (profit - coalesce(profit_loss,0)) AS profit FROM ws LEFT JOIN wr ON ws.wp_web_page_sk = wr.wp_web_page_sk ) x GROUP BY ROLLUP (channel, id) ORDER BY channel NULLS FIRST, id NULLS FIRST, returns_ DESC LIMIT 100",
   "mv_sql": "SELECT 'ss' AS part, s_store_sk AS id, d_date,\n       sum(ss_ext_sales_price) AS sales, sum(ss_net_profit) AS profit,\n       CAST(NULL AS DECIMAL(38,2)) AS returns_, CAST(NULL AS DECIMAL(38,2)) AS profit_loss\nFROM store_sales, date_dim, store\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND ss_sold_date_sk = d_date_sk AND ss_store_sk = s_store_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'sr' AS part, s_store_sk AS id, d_date,\n       CAST(NULL AS DECIMAL(38,2)) AS sales, CAST(NULL AS DECIMAL(38,2)) AS profit,\n       sum(sr_return_amt) AS returns_, sum(sr_net_loss) AS profit_loss\nFROM store_returns, date_dim, store\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND sr_returned_date_sk = d_date_sk AND sr_store_sk = s_store_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'cs' AS part, cs_call_center_sk AS id, d_date,\n       sum(cs_ext_sales_price) AS sales, sum(cs_net_profit) AS profit,\n       CAST(NULL AS DECIMAL(38,2)) AS returns_, CAST(NULL AS DECIMAL(38,2)) AS profit_loss\nFROM catalog_sales, date_dim\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND cs_sold_date_sk = d_date_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'cr' AS part, cr_call_center_sk AS id, d_date,\n       CAST(NULL AS DECIMAL(38,2)) AS sales, CAST(NULL AS DECIMAL(38,2)) AS profit,\n       sum(cr_return_amount) AS returns_, sum(cr_net_loss) AS profit_loss\nFROM catalog_returns, date_dim\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND cr_returned_date_sk = d_date_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'ws' AS part, wp_web_page_sk AS id, d_date,\n       sum(ws_ext_sales_price) AS sales, sum(ws_net_profit) AS profit,\n       CAST(NULL AS DECIMAL(38,2)) AS returns_, CAST(NULL AS DECIMAL(38,2)) AS profit_loss\nFROM web_sales, date_dim, web_page\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND ws_sold_date_sk = d_date_sk AND ws_web_page_sk = wp_web_page_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'wr' AS part, wp_web_page_sk AS id, d_date,\n       CAST(NULL AS DECIMAL(38,2)) AS sales, CAST(NULL AS DECIMAL(38,2)) AS profit,\n       sum(wr_return_amt) AS returns_, sum(wr_net_loss) AS profit_loss\nFROM web_returns, date_dim, web_page\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND wr_returned_date_sk = d_date_sk AND wr_web_page_sk = wp_web_page_sk\nGROUP BY 1, 2, 3",
   "rewrite_sql": "WITH ss AS (SELECT id AS s_store_sk, sum(sales) AS sales, sum(profit) AS profit\n            FROM iceberg.tpcds_mv.mv_h_d78dbf690fd0 WHERE part = 'ss' AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) GROUP BY id),\n     sr AS (SELECT id AS s_store_sk, sum(returns_) AS returns_, sum(profit_loss) AS profit_loss\n            FROM iceberg.tpcds_mv.mv_h_d78dbf690fd0 WHERE part = 'sr' AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) GROUP BY id),\n     cs AS (SELECT id AS cs_call_center_sk, sum(sales) AS sales, sum(profit) AS profit\n            FROM iceberg.tpcds_mv.mv_h_d78dbf690fd0 WHERE part = 'cs' AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) GROUP BY id),\n     cr AS (SELECT id AS cr_call_center_sk, sum(returns_) AS returns_, sum(profit_loss) AS profit_loss\n            FROM iceberg.tpcds_mv.mv_h_d78dbf690fd0 WHERE part = 'cr' AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) GROUP BY id),\n     ws AS (SELECT id AS wp_web_page_sk, sum(sales) AS sales, sum(profit) AS profit\n            FROM iceberg.tpcds_mv.mv_h_d78dbf690fd0 WHERE part = 'ws' AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) GROUP BY id),\n     wr AS (SELECT id AS wp_web_page_sk, sum(returns_) AS returns_, sum(profit_loss) AS profit_loss\n            FROM iceberg.tpcds_mv.mv_h_d78dbf690fd0 WHERE part = 'wr' AND d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) GROUP BY id)\nSELECT channel , id , sum(sales) AS sales , sum(returns_) AS returns_ , sum(profit) AS profit\nFROM (SELECT 'store channel' AS channel , ss.s_store_sk AS id , sales ,\n             coalesce(returns_, 0) AS returns_ , (profit - coalesce(profit_loss,0)) AS profit\n      FROM ss LEFT JOIN sr ON ss.s_store_sk = sr.s_store_sk\n      UNION ALL\n      SELECT 'catalog channel' AS channel , cs_call_center_sk AS id , sales , returns_ ,\n             (profit - profit_loss) AS profit\n      FROM cs , cr\n      UNION ALL\n      SELECT 'web channel' AS channel , ws.wp_web_page_sk AS id , sales ,\n             coalesce(returns_, 0) returns_ , (profit - coalesce(profit_loss,0)) AS profit\n      FROM ws LEFT JOIN wr ON ws.wp_web_page_sk = wr.wp_web_page_sk ) x\nGROUP BY ROLLUP (channel, id)\nORDER BY channel NULLS FIRST, id NULLS FIRST, returns_ DESC\nLIMIT 100",
   "delta_sql": "SELECT 'ss' AS part, s_store_sk AS id, d_date,\n       sum(ss_ext_sales_price) AS sales, sum(ss_net_profit) AS profit,\n       CAST(NULL AS DECIMAL(38,2)) AS returns_, CAST(NULL AS DECIMAL(38,2)) AS profit_loss\nFROM $DELTA(store_sales), date_dim, store\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND ss_sold_date_sk = d_date_sk AND ss_store_sk = s_store_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'sr' AS part, s_store_sk AS id, d_date,\n       CAST(NULL AS DECIMAL(38,2)) AS sales, CAST(NULL AS DECIMAL(38,2)) AS profit,\n       sum(sr_return_amt) AS returns_, sum(sr_net_loss) AS profit_loss\nFROM $DELTA(store_returns), date_dim, store\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND sr_returned_date_sk = d_date_sk AND sr_store_sk = s_store_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'cs' AS part, cs_call_center_sk AS id, d_date,\n       sum(cs_ext_sales_price) AS sales, sum(cs_net_profit) AS profit,\n       CAST(NULL AS DECIMAL(38,2)) AS returns_, CAST(NULL AS DECIMAL(38,2)) AS profit_loss\nFROM $DELTA(catalog_sales), date_dim\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND cs_sold_date_sk = d_date_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'cr' AS part, cr_call_center_sk AS id, d_date,\n       CAST(NULL AS DECIMAL(38,2)) AS sales, CAST(NULL AS DECIMAL(38,2)) AS profit,\n       sum(cr_return_amount) AS returns_, sum(cr_net_loss) AS profit_loss\nFROM $DELTA(catalog_returns), date_dim\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND cr_returned_date_sk = d_date_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'ws' AS part, wp_web_page_sk AS id, d_date,\n       sum(ws_ext_sales_price) AS sales, sum(ws_net_profit) AS profit,\n       CAST(NULL AS DECIMAL(38,2)) AS returns_, CAST(NULL AS DECIMAL(38,2)) AS profit_loss\nFROM $DELTA(web_sales), date_dim, web_page\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND ws_sold_date_sk = d_date_sk AND ws_web_page_sk = wp_web_page_sk\nGROUP BY 1, 2, 3 UNION ALL SELECT 'wr' AS part, wp_web_page_sk AS id, d_date,\n       CAST(NULL AS DECIMAL(38,2)) AS sales, CAST(NULL AS DECIMAL(38,2)) AS profit,\n       sum(wr_return_amt) AS returns_, sum(wr_net_loss) AS profit_loss\nFROM $DELTA(web_returns), date_dim, web_page\nWHERE d_date BETWEEN cast('2000-08-23' AS date) AND cast('2000-09-22' AS date) AND wr_returned_date_sk = d_date_sk AND wr_web_page_sk = wp_web_page_sk\nGROUP BY 1, 2, 3",
   "row_hash_at_author": "5df52a66864f2ce66cbbf6dd2ca870a1",
