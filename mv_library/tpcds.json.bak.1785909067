   "mv_cols": 6,
   "source_schema": "tpcds",
   "original_sql": "SELECT ss_customer_sk, sum(act_sales) sumsales FROM (SELECT ss_item_sk, ss_ticket_number, ss_customer_sk, CASE WHEN sr_return_quantity IS NOT NULL THEN (ss_quantity-sr_return_quantity)*ss_sales_price ELSE (ss_quantity*ss_sales_price) END act_sales FROM store_sales LEFT OUTER JOIN store_returns ON (sr_item_sk = ss_item_sk AND sr_ticket_number = ss_ticket_number) ,reason WHERE sr_reason_sk = r_reason_sk AND r_reason_desc = 'reason 28') t GROUP BY ss_customer_sk ORDER BY sumsales NULLS FIRST, ss_customer_sk NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT ss_customer_sk, r_reason_desc,\n       sum(CASE WHEN sr_return_quantity IS NOT NULL\n                THEN (ss_quantity-sr_return_quantity)*ss_sales_price\n                ELSE (ss_quantity*ss_sales_price) END) AS sumsales\nFROM store_sales\nJOIN store_returns ON (sr_item_sk = ss_item_sk AND sr_ticket_number = ss_ticket_number),\n     reason\nWHERE sr_reason_sk = r_reason_sk\nGROUP BY ss_customer_sk, r_reason_desc",
   "rewrite_sql": "SELECT ss_customer_sk, sum(sumsales) sumsales\nFROM iceberg.tpcds_mv.mv_h_b7b7dedec36b\nWHERE r_reason_desc = 'reason 28'\nGROUP BY ss_customer_sk\nORDER BY sumsales NULLS FIRST, ss_customer_sk NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT ss_customer_sk, r_reason_desc,\n       sum(CASE WHEN sr_return_quantity IS NOT NULL\n                THEN (ss_quantity-sr_return_quantity)*ss_sales_price\n                ELSE (ss_quantity*ss_sales_price) END) AS sumsales\nFROM $DELTA(store_sales)\nJOIN $DELTA(store_returns) ON (sr_item_sk = ss_item_sk AND sr_ticket_number = ss_ticket_number),\n     reason\nWHERE sr_reason_sk = r_reason_sk\nGROUP BY ss_customer_sk, r_reason_desc",
