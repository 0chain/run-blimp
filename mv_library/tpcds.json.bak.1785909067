   "original_sql": "SELECT count(*) FROM store_sales , household_demographics, time_dim, store WHERE ss_sold_time_sk = time_dim.t_time_sk AND ss_hdemo_sk = household_demographics.hd_demo_sk AND ss_store_sk = s_store_sk AND time_dim.t_hour = 20 AND time_dim.t_minute >= 30 AND household_demographics.hd_dep_count = 7 AND store.s_store_name = 'ese' ORDER BY count(*) LIMIT 100",
   "mv_sql": "SELECT t_hour, t_minute, hd_dep_count, s_store_name, count(*) AS cnt\nFROM store_sales , household_demographics, time_dim, store\nWHERE ss_sold_time_sk = time_dim.t_time_sk\n  AND ss_hdemo_sk = household_demographics.hd_demo_sk\n  AND ss_store_sk = s_store_sk\nGROUP BY t_hour, t_minute, hd_dep_count, s_store_name",
   "rewrite_sql": "SELECT coalesce(sum(cnt),0) AS \"count_star()\"\nFROM iceberg.tpcds_mv.mv_h_7597c4dffbd0\nWHERE t_hour = 20 AND t_minute >= 30 AND hd_dep_count = 7 AND s_store_name = 'ese'\nORDER BY coalesce(sum(cnt),0)\nLIMIT 100",
   "delta_sql": "SELECT t_hour, t_minute, hd_dep_count, s_store_name, count(*) AS cnt\nFROM $DELTA(store_sales) , household_demographics, time_dim, store\nWHERE ss_sold_time_sk = time_dim.t_time_sk\n  AND ss_hdemo_sk = household_demographics.hd_demo_sk\n  AND ss_store_sk = s_store_sk\nGROUP BY t_hour, t_minute, hd_dep_count, s_store_name",
