   "archetype_id": "",
   "mv_table": "mv_h_12af385a973d",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 1063295,
   "mv_cols": 9,
   "source_schema": "tpcds",
   "original_sql": "SELECT count(DISTINCT ws_order_number) AS \"order count\" , sum(ws_ext_ship_cost) AS \"total shipping cost\" , sum(ws_net_profit) AS \"total net profit\" FROM web_sales ws1 , date_dim , customer_address , web_site WHERE d_date BETWEEN '1999-02-01' AND cast('1999-04-02' AS date) AND ws1.ws_ship_date_sk = d_date_sk AND ws1.ws_ship_addr_sk = ca_address_sk AND ca_state = 'IL' AND ws1.ws_web_site_sk = web_site_sk AND web_company_name = 'pri' AND EXISTS (SELECT * FROM web_sales ws2 WHERE ws1.ws_order_number = ws2.ws_order_number AND ws1.ws_warehouse_sk <> ws2.ws_warehouse_sk) AND NOT exists (SELECT * FROM web_returns wr1 WHERE ws1.ws_order_number = wr1.wr_order_number) ORDER BY count(DISTINCT ws_order_number) LIMIT 100",
   "mv_sql": "SELECT 'sale' AS part, ws_order_number AS order_number, ws_warehouse_sk AS warehouse_sk,\n       d_date, ca_state, web_company_name,\n       sum(ws_ext_ship_cost) AS ship_cost, sum(ws_net_profit) AS net_profit, count(*) AS cnt\nFROM web_sales, date_dim, customer_address, web_site\nWHERE ws_ship_date_sk = d_date_sk\n  AND ws_ship_addr_sk = ca_address_sk\n  AND ws_web_site_sk = web_site_sk\nGROUP BY 1, 2, 3, 4, 5, 6\nUNION ALL\nSELECT 'wh' AS part, ws_order_number AS order_number, ws_warehouse_sk AS warehouse_sk,\n       CAST(NULL AS DATE) AS d_date, CAST(NULL AS VARCHAR) AS ca_state,\n       CAST(NULL AS VARCHAR) AS web_company_name,\n       CAST(NULL AS DECIMAL(38,2)) AS ship_cost, CAST(NULL AS DECIMAL(38,2)) AS net_profit, count(*) AS cnt\nFROM web_sales\nGROUP BY 1, 2, 3, 4, 5, 6\nUNION ALL\nSELECT 'return' AS part, wr_order_number AS order_number, CAST(NULL AS INTEGER) AS warehouse_sk,\n       CAST(NULL AS DATE) AS d_date, CAST(NULL AS VARCHAR) AS ca_state,\n       CAST(NULL AS VARCHAR) AS web_company_name,\n       CAST(NULL AS DECIMAL(38,2)) AS ship_cost, CAST(NULL AS DECIMAL(38,2)) AS net_profit, count(*) AS cnt\nFROM web_returns\nGROUP BY 1, 2, 3, 4, 5, 6",
   "rewrite_sql": "SELECT count(DISTINCT ws1.order_number) AS \"order count\" ,\n       sum(ws1.ship_cost) AS \"total shipping cost\" ,\n       sum(ws1.net_profit) AS \"total net profit\"\nFROM iceberg.tpcds_mv.mv_h_12af385a973d ws1\nWHERE ws1.part = 'sale'\n  AND ws1.d_date BETWEEN '1999-02-01' AND cast('1999-04-02' AS date)\n  AND ws1.ca_state = 'IL'\n  AND ws1.web_company_name = 'pri'\n  AND ws1.warehouse_sk IS NOT NULL\n  AND (SELECT count(DISTINCT w.warehouse_sk) FROM iceberg.tpcds_mv.mv_h_12af385a973d w\n       WHERE w.part = 'wh' AND w.order_number = ws1.order_number) >= 2\n  AND NOT exists (SELECT * FROM iceberg.tpcds_mv.mv_h_12af385a973d wr1\n                  WHERE wr1.part = 'return' AND wr1.order_number = ws1.order_number)\nORDER BY count(DISTINCT ws1.order_number)\nLIMIT 100",
   "delta_sql": "SELECT 'sale' AS part, ws_order_number AS order_number, ws_warehouse_sk AS warehouse_sk,\n       d_date, ca_state, web_company_name,\n       sum(ws_ext_ship_cost) AS ship_cost, sum(ws_net_profit) AS net_profit, count(*) AS cnt\nFROM $DELTA(web_sales), date_dim, customer_address, web_site\nWHERE ws_ship_date_sk = d_date_sk\n  AND ws_ship_addr_sk = ca_address_sk\n  AND ws_web_site_sk = web_site_sk\nGROUP BY 1, 2, 3, 4, 5, 6\nUNION ALL\nSELECT 'wh' AS part, ws_order_number AS order_number, ws_warehouse_sk AS warehouse_sk,\n       CAST(NULL AS DATE) AS d_date, CAST(NULL AS VARCHAR) AS ca_state,\n       CAST(NULL AS VARCHAR) AS web_company_name,\n       CAST(NULL AS DECIMAL(38,2)) AS ship_cost, CAST(NULL AS DECIMAL(38,2)) AS net_profit, count(*) AS cnt\nFROM $DELTA(web_sales)\nGROUP BY 1, 2, 3, 4, 5, 6\nUNION ALL\nSELECT 'return' AS part, wr_order_number AS order_number, CAST(NULL AS INTEGER) AS warehouse_sk,\n       CAST(NULL AS DATE) AS d_date, CAST(NULL AS VARCHAR) AS ca_state,\n       CAST(NULL AS VARCHAR) AS web_company_name,\n       CAST(NULL AS DECIMAL(38,2)) AS ship_cost, CAST(NULL AS DECIMAL(38,2)) AS net_profit, count(*) AS cnt\nFROM $DELTA(web_returns)\nGROUP BY 1, 2, 3, 4, 5, 6",
   "row_hash_at_author": "e043d8b18114bf18ba3d72cf0d7e7e1f",
