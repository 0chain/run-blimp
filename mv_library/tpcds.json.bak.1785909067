  {
   "labels": [
    "q35"
   ],
   "qid_pattern": "",
   "category": "aggregation",
   "shape_class": "groupby|exists|or-of-and|avg|outer-limit-order",
   "tier": "tooluse_sonnet",
   "archetype_id": "",
   "mv_table": "customer_channel_activity",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": -1,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT ca_state,\n       cd_gender,\n       cd_marital_status,\n       cd_dep_count,\n       count(*) cnt1,\n       min(cd_dep_count) min1,\n       max(cd_dep_count) max1,\n       avg(cd_dep_count) avg1,\n       cd_dep_employed_count,\n       count(*) cnt2,\n       min(cd_dep_employed_count) min2,\n       max(cd_dep_employed_count) max2,\n       avg(cd_dep_employed_count) avg2,\n       cd_dep_college_count,\n       count(*) cnt3,\n       min(cd_dep_college_count),\n       max(cd_dep_college_count),\n       avg(cd_dep_college_count)\nFROM customer c,\n     customer_address ca,\n     customer_demographics\nWHERE c.c_current_addr_sk = ca.ca_address_sk\n  AND cd_demo_sk = c.c_current_cdemo_sk\n  AND EXISTS\n    (SELECT *\n     FROM store_sales,\n          date_dim\n     WHERE c.c_customer_sk = ss_customer_sk\n       AND ss_sold_date_sk = d_date_sk\n       AND d_year = 2002\n       AND d_qoy < 4)\n  AND (EXISTS\n         (SELECT *\n          FROM web_sales,\n               date_dim\n          WHERE c.c_customer_sk = ws_bill_customer_sk\n            AND ws_sold_date_sk = d_date_sk\n            AND d_year = 2002\n            AND d_qoy < 4)\n       OR EXISTS\n         (SELECT *\n          FROM catalog_sales,\n               date_dim\n          WHERE c.c_customer_sk = cs_ship_customer_sk\n            AND cs_sold_date_sk = d_date_sk\n            AND d_year = 2002\n            AND d_qoy < 4))\nGROUP BY ca_state,\n         cd_gender,\n         cd_marital_status,\n         cd_dep_count,\n         cd_dep_employed_count,\n         cd_dep_college_count\nORDER BY ca_state NULLS FIRST,\n         cd_gender NULLS FIRST,\n         cd_marital_status NULLS FIRST,\n         cd_dep_count NULLS FIRST,\n         cd_dep_employed_count NULLS FIRST,\n         cd_dep_college_count NULLS FIRST\nLIMIT 100",
   "mv_sql": "SELECT ca.ca_state AS ca_state, cd.cd_gender AS cd_gender, cd.cd_marital_status AS cd_marital_status, cd.cd_dep_count AS cd_dep_count, cd.cd_dep_employed_count AS cd_dep_employed_count, cd.cd_dep_college_count AS cd_dep_college_count, c.c_customer_sk AS c_customer_sk, d.d_year AS d_year, d.d_qoy AS d_qoy, 'store' AS chan_tag, COUNT(*) AS cnt_match FROM customer c, customer_address ca, customer_demographics cd, store_sales, date_dim d WHERE c.c_current_addr_sk = ca.ca_address_sk AND cd.cd_demo_sk = c.c_current_cdemo_sk AND c.c_customer_sk = store_sales.ss_customer_sk AND store_sales.ss_sold_date_sk = d.d_date_sk GROUP BY ca.ca_state, cd.cd_gender, cd.cd_marital_status, cd.cd_dep_count, cd.cd_dep_employed_count, cd.cd_dep_college_count, c.c_customer_sk, d.d_year, d.d_qoy UNION ALL SELECT ca.ca_state AS ca_state, cd.cd_gender AS cd_gender, cd.cd_marital_status AS cd_marital_status, cd.cd_dep_count AS cd_dep_count, cd.cd_dep_employed_count AS cd_dep_employed_count, cd.cd_dep_college_count AS cd_dep_college_count, c.c_customer_sk AS c_customer_sk, d.d_year AS d_year, d.d_qoy AS d_qoy, 'web' AS chan_tag, COUNT(*) AS cnt_match FROM customer c, customer_address ca, customer_demographics cd, web_sales, date_dim d WHERE c.c_current_addr_sk = ca.ca_address_sk AND cd.cd_demo_sk = c.c_current_cdemo_sk AND c.c_customer_sk = web_sales.ws_bill_customer_sk AND web_sales.ws_sold_date_sk = d.d_date_sk GROUP BY ca.ca_state, cd.cd_gender, cd.cd_marital_status, cd.cd_dep_count, cd.cd_dep_employed_count, cd.cd_dep_college_count, c.c_customer_sk, d.d_year, d.d_qoy UNION ALL SELECT ca.ca_state AS ca_state, cd.cd_gender AS cd_gender, cd.cd_marital_status AS cd_marital_status, cd.cd_dep_count AS cd_dep_count, cd.cd_dep_employed_count AS cd_dep_employed_count, cd.cd_dep_college_count AS cd_dep_college_count, c.c_customer_sk AS c_customer_sk, d.d_year AS d_year, d.d_qoy AS d_qoy, 'catalog' AS chan_tag, COUNT(*) AS cnt_match FROM customer c, customer_address ca, customer_demographics cd, catalog_sales, date_dim d WHERE c.c_current_addr_sk = ca.ca_address_sk AND cd.cd_demo_sk = c.c_current_cdemo_sk AND c.c_customer_sk = catalog_sales.cs_ship_customer_sk AND catalog_sales.cs_sold_date_sk = d.d_date_sk GROUP BY ca.ca_state, cd.cd_gender, cd.cd_marital_status, cd.cd_dep_count, cd.cd_dep_employed_count, cd.cd_dep_college_count, c.c_customer_sk, d.d_year, d.d_qoy",
   "rewrite_sql": "WITH agg AS (SELECT ca_state, cd_gender, cd_marital_status, cd_dep_count, cd_dep_employed_count, cd_dep_college_count, c_customer_sk, chan_tag, SUM(cnt_match) AS cnt_match FROM tpcds_mv.customer_channel_activity WHERE d_year = 2002 AND d_qoy < 4 GROUP BY ca_state, cd_gender, cd_marital_status, cd_dep_count, cd_dep_employed_count, cd_dep_college_count, c_customer_sk, chan_tag), cust_flags AS (SELECT ca_state, cd_gender, cd_marital_status, cd_dep_count, cd_dep_employed_count, cd_dep_college_count, c_customer_sk, MAX(CASE WHEN chan_tag = 'store' THEN cnt_match ELSE 0 END) AS store_cnt, MAX(CASE WHEN chan_tag = 'web' THEN cnt_match ELSE 0 END) AS web_cnt, MAX(CASE WHEN chan_tag = 'catalog' THEN cnt_match ELSE 0 END) AS catalog_cnt FROM agg GROUP BY ca_state, cd_gender, cd_marital_status, cd_dep_count, cd_dep_employed_count, cd_dep_college_count, c_customer_sk) SELECT ca_state, cd_gender, cd_marital_status, cd_dep_count, COUNT(*) cnt1, MIN(cd_dep_count) min1, MAX(cd_dep_count) max1, AVG(CAST(cd_dep_count AS DOUBLE)) avg1, cd_dep_employed_count, COUNT(*) cnt2, MIN(cd_dep_employed_count) min2, MAX(cd_dep_employed_count) max2, AVG(CAST(cd_dep_employed_count AS DOUBLE)) avg2, cd_dep_college_count, COUNT(*) cnt3, MIN(cd_dep_college_count), MAX(cd_dep_college_count), AVG(CAST(cd_dep_college_count AS DOUBLE)) FROM cust_flags WHERE store_cnt > 0 AND (web_cnt > 0 OR catalog_cnt > 0) GROUP BY ca_state, cd_gender, cd_marital_status, cd_dep_count, cd_dep_employed_count, cd_dep_college_count ORDER BY ca_state NULLS FIRST, cd_gender NULLS FIRST, cd_marital_status NULLS FIRST, cd_dep_count NULLS FIRST, cd_dep_employed_count NULLS FIRST, cd_dep_college_count NULLS FIRST LIMIT 100",
   "delta_sql": "SELECT ca.ca_state AS ca_state, cd.cd_gender AS cd_gender, cd.cd_marital_status AS cd_marital_status, cd.cd_dep_count AS cd_dep_count, cd.cd_dep_employed_count AS cd_dep_employed_count, cd.cd_dep_college_count AS cd_dep_college_count, c.c_customer_sk AS c_customer_sk, d.d_year AS d_year, d.d_qoy AS d_qoy, 'store' AS chan_tag, COUNT(*) AS cnt_match FROM customer c, customer_address ca, customer_demographics cd, $DELTA(store_sales), date_dim d WHERE c.c_current_addr_sk = ca.ca_address_sk AND cd.cd_demo_sk = c.c_current_cdemo_sk AND c.c_customer_sk = store_sales.ss_customer_sk AND store_sales.ss_sold_date_sk = d.d_date_sk GROUP BY ca.ca_state, cd.cd_gender, cd.cd_marital_status, cd.cd_dep_count, cd.cd_dep_employed_count, cd.cd_dep_college_count, c.c_customer_sk, d.d_year, d.d_qoy UNION ALL SELECT ca.ca_state AS ca_state, cd.cd_gender AS cd_gender, cd.cd_marital_status AS cd_marital_status, cd.cd_dep_count AS cd_dep_count, cd.cd_dep_employed_count AS cd_dep_employed_count, cd.cd_dep_college_count AS cd_dep_college_count, c.c_customer_sk AS c_customer_sk, d.d_year AS d_year, d.d_qoy AS d_qoy, 'web' AS chan_tag, COUNT(*) AS cnt_match FROM customer c, customer_address ca, customer_demographics cd, $DELTA(web_sales), date_dim d WHERE c.c_current_addr_sk = ca.ca_address_sk AND cd.cd_demo_sk = c.c_current_cdemo_sk AND c.c_customer_sk = web_sales.ws_bill_customer_sk AND web_sales.ws_sold_date_sk = d.d_date_sk GROUP BY ca.ca_state, cd.cd_gender, cd.cd_marital_status, cd.cd_dep_count, cd.cd_dep_employed_count, cd.cd_dep_college_count, c.c_customer_sk, d.d_year, d.d_qoy UNION ALL SELECT ca.ca_state AS ca_state, cd.cd_gender AS cd_gender, cd.cd_marital_status AS cd_marital_status, cd.cd_dep_count AS cd_dep_count, cd.cd_dep_employed_count AS cd_dep_employed_count, cd.cd_dep_college_count AS cd_dep_college_count, c.c_customer_sk AS c_customer_sk, d.d_year AS d_year, d.d_qoy AS d_qoy, 'catalog' AS chan_tag, COUNT(*) AS cnt_match FROM customer c, customer_address ca, customer_demographics cd, $DELTA(catalog_sales), date_dim d WHERE c.c_current_addr_sk = ca.ca_address_sk AND cd.cd_demo_sk = c.c_current_cdemo_sk AND c.c_customer_sk = catalog_sales.cs_ship_customer_sk AND catalog_sales.cs_sold_date_sk = d.d_date_sk GROUP BY ca.ca_state, cd.cd_gender, cd.cd_marital_status, cd.cd_dep_count, cd.cd_dep_employed_count, cd.cd_dep_college_count, c.c_customer_sk, d.d_year, d.d_qoy",
   "row_hash_at_author": "0a34a43ed14c0dde052d3693591faf62",
   "sql_fingerprint_sha256": "7f0c64abae43d552"
