   "original_sql": "SELECT i_brand_id brand_id, i_brand brand, sum(ss_ext_sales_price) ext_price FROM date_dim, store_sales, item WHERE d_date_sk = ss_sold_date_sk AND ss_item_sk = i_item_sk AND i_manager_id=28 AND d_moy=11 AND d_year=1999 GROUP BY i_brand, i_brand_id ORDER BY ext_price DESC, i_brand_id LIMIT 100",
   "mv_sql": "SELECT i_brand_id, i_brand, i_manager_id, d_moy, d_year,\n       sum(ss_ext_sales_price) AS ext_price\nFROM date_dim, store_sales, item\nWHERE d_date_sk = ss_sold_date_sk AND ss_item_sk = i_item_sk\nGROUP BY i_brand_id, i_brand, i_manager_id, d_moy, d_year",
   "rewrite_sql": "SELECT i_brand_id brand_id, i_brand brand, sum(ext_price) ext_price\nFROM iceberg.tpcds_mv.mv_h_adcd7b3d5cd9\nWHERE i_manager_id = 28 AND d_moy = 11 AND d_year = 1999\nGROUP BY i_brand, i_brand_id\nORDER BY ext_price DESC, i_brand_id\nLIMIT 100",
   "delta_sql": "SELECT i_brand_id, i_brand, i_manager_id, d_moy, d_year,\n       sum(ss_ext_sales_price) AS ext_price\nFROM date_dim, $DELTA(store_sales), item\nWHERE d_date_sk = ss_sold_date_sk AND ss_item_sk = i_item_sk\nGROUP BY i_brand_id, i_brand, i_manager_id, d_moy, d_year",
