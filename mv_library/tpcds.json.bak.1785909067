   "source_schema": "tpcds",
   "original_sql": "SELECT i_brand_id brand_id, i_brand brand, i_manufact_id, i_manufact, sum(ss_ext_sales_price) ext_price FROM date_dim, store_sales, item, customer, customer_address, store WHERE d_date_sk = ss_sold_date_sk AND ss_item_sk = i_item_sk AND i_manager_id=8 AND d_moy=11 AND d_year=1998 AND ss_customer_sk = c_customer_sk AND c_current_addr_sk = ca_address_sk AND SUBSTRING(ca_zip, 1, 5) <> SUBSTRING(s_zip, 1, 5) AND ss_store_sk = s_store_sk GROUP BY i_brand, i_brand_id, i_manufact_id, i_manufact ORDER BY ext_price DESC, i_brand, i_brand_id, i_manufact_id, i_manufact LIMIT 100",
   "mv_sql": "SELECT i_brand, i_brand_id, i_manufact_id, i_manufact, i_manager_id, d_moy, d_year,\n       CASE WHEN SUBSTRING(ca_zip, 1, 5) <> SUBSTRING(s_zip, 1, 5) THEN 1 ELSE 0 END AS zip_diff,\n       sum(ss_ext_sales_price) AS ext_price\nFROM date_dim, store_sales, item, customer, customer_address, store\nWHERE d_date_sk = ss_sold_date_sk\n  AND ss_item_sk = i_item_sk\n  AND ss_customer_sk = c_customer_sk\n  AND c_current_addr_sk = ca_address_sk\n  AND ss_store_sk = s_store_sk\nGROUP BY i_brand, i_brand_id, i_manufact_id, i_manufact, i_manager_id, d_moy, d_year,\n         CASE WHEN SUBSTRING(ca_zip, 1, 5) <> SUBSTRING(s_zip, 1, 5) THEN 1 ELSE 0 END",
   "rewrite_sql": "SELECT i_brand_id brand_id, i_brand brand, i_manufact_id, i_manufact,\n       sum(ext_price) ext_price\nFROM iceberg.tpcds_mv.mv_h_b7b87f57725b\nWHERE i_manager_id = 8 AND d_moy = 11 AND d_year = 1998 AND zip_diff = 1\nGROUP BY i_brand, i_brand_id, i_manufact_id, i_manufact\nORDER BY ext_price DESC, i_brand, i_brand_id, i_manufact_id, i_manufact\nLIMIT 100",
   "delta_sql": "SELECT i_brand, i_brand_id, i_manufact_id, i_manufact, i_manager_id, d_moy, d_year,\n       CASE WHEN SUBSTRING(ca_zip, 1, 5) <> SUBSTRING(s_zip, 1, 5) THEN 1 ELSE 0 END AS zip_diff,\n       sum(ss_ext_sales_price) AS ext_price\nFROM date_dim, $DELTA(store_sales), item, customer, customer_address, store\nWHERE d_date_sk = ss_sold_date_sk\n  AND ss_item_sk = i_item_sk\n  AND ss_customer_sk = c_customer_sk\n  AND c_current_addr_sk = ca_address_sk\n  AND ss_store_sk = s_store_sk\nGROUP BY i_brand, i_brand_id, i_manufact_id, i_manufact, i_manager_id, d_moy, d_year,\n         CASE WHEN SUBSTRING(ca_zip, 1, 5) <> SUBSTRING(s_zip, 1, 5) THEN 1 ELSE 0 END",
