   "source_schema": "tpcds",
   "original_sql": "SELECT ca_zip, sum(cs_sales_price) FROM catalog_sales, customer, customer_address, date_dim WHERE cs_bill_customer_sk = c_customer_sk AND c_current_addr_sk = ca_address_sk AND (SUBSTRING(ca_zip, 1, 5) IN ('85669', '86197', '88274', '83405', '86475', '85392', '85460', '80348', '81792') OR ca_state IN ('CA', 'WA', 'GA') OR cs_sales_price > 500) AND cs_sold_date_sk = d_date_sk AND d_qoy = 2 AND d_year = 2001 GROUP BY ca_zip ORDER BY ca_zip NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT ca_zip, ca_state, d_qoy, d_year,\n       CASE WHEN cs_sales_price > 500 THEN 1 ELSE 0 END AS hi_price,\n       sum(cs_sales_price) AS sales_sum\nFROM catalog_sales, customer, customer_address, date_dim\nWHERE cs_bill_customer_sk = c_customer_sk\n  AND c_current_addr_sk = ca_address_sk\n  AND cs_sold_date_sk = d_date_sk\nGROUP BY ca_zip, ca_state, d_qoy, d_year, CASE WHEN cs_sales_price > 500 THEN 1 ELSE 0 END",
   "rewrite_sql": "SELECT ca_zip, sum(sales_sum) AS \"sum(cs_sales_price)\"\nFROM iceberg.tpcds_mv.mv_h_3e1a8feae4a1\nWHERE (SUBSTRING(ca_zip, 1, 5) IN ('85669', '86197', '88274', '83405', '86475', '85392', '85460', '80348', '81792')\n       OR ca_state IN ('CA', 'WA', 'GA')\n       OR hi_price = 1)\n  AND d_qoy = 2\n  AND d_year = 2001\nGROUP BY ca_zip\nORDER BY ca_zip NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT ca_zip, ca_state, d_qoy, d_year,\n       CASE WHEN cs_sales_price > 500 THEN 1 ELSE 0 END AS hi_price,\n       sum(cs_sales_price) AS sales_sum\nFROM $DELTA(catalog_sales), customer, customer_address, date_dim\nWHERE cs_bill_customer_sk = c_customer_sk\n  AND c_current_addr_sk = ca_address_sk\n  AND cs_sold_date_sk = d_date_sk\nGROUP BY ca_zip, ca_state, d_qoy, d_year, CASE WHEN cs_sales_price > 500 THEN 1 ELSE 0 END",
