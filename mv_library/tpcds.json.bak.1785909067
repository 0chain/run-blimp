  {
   "labels": [
    "q22"
   ],
   "qid_pattern": "",
   "category": "aggregation",
   "shape_class": "rollup|none|between-range|avg|outer-limit-order",
   "tier": "tooluse_sonnet",
   "archetype_id": "",
   "mv_table": "inv_qoh_rollup",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": -1,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT i_product_name ,\n       i_brand ,\n       i_class ,\n       i_category ,\n       avg(inv_quantity_on_hand) qoh\nFROM inventory ,\n     date_dim ,\n     item\nWHERE inv_date_sk=d_date_sk\n  AND inv_item_sk=i_item_sk\n  AND d_month_seq BETWEEN 1200 AND 1200 + 11\nGROUP BY rollup(i_product_name ,i_brand ,i_class ,i_category)\nORDER BY qoh NULLS FIRST,\n         i_product_name NULLS FIRST,\n         i_brand NULLS FIRST,\n         i_class NULLS FIRST,\n         i_category NULLS FIRST\nLIMIT 100",
   "mv_sql": "SELECT inv_item_sk, d_month_seq, SUM(inv_quantity_on_hand) AS sum_qoh, COUNT(inv_quantity_on_hand) AS count_qoh FROM inventory, date_dim WHERE inv_date_sk=d_date_sk GROUP BY inv_item_sk, d_month_seq",
   "rewrite_sql": "SELECT i_product_name, i_brand, i_class, i_category, AVG_QOH AS qoh FROM ( SELECT i_product_name, i_brand, i_class, i_category, SUM(sum_qoh) AS s, SUM(count_qoh) AS c, CASE WHEN SUM(count_qoh)=0 THEN NULL ELSE SUM(sum_qoh)*1.0/SUM(count_qoh) END AS AVG_QOH FROM tpcds_mv.inv_qoh_rollup r JOIN item i ON r.inv_item_sk = i.i_item_sk WHERE r.d_month_seq BETWEEN 1200 AND 1200+11 GROUP BY rollup(i_product_name, i_brand, i_class, i_category) ) t ORDER BY qoh NULLS FIRST, i_product_name NULLS FIRST, i_brand NULLS FIRST, i_class NULLS FIRST, i_category NULLS FIRST LIMIT 100",
   "delta_sql": "SELECT inv_item_sk, d_month_seq, SUM(inv_quantity_on_hand) AS sum_qoh, COUNT(inv_quantity_on_hand) AS count_qoh FROM $DELTA(inventory), date_dim WHERE inv_date_sk=d_date_sk GROUP BY inv_item_sk, d_month_seq",
   "row_hash_at_author": "0fcaf12da45c8b1f928c4c9a59e6e36b",
   "sql_fingerprint_sha256": "1aff753f39ee3aef"
  },
  {
   "labels": [
    "q37"
   ],
   "qid_pattern": "",
   "category": "aggregation",
   "shape_class": "groupby|none|between-range|additive|outer-limit-order",
   "tier": "tooluse_sonnet",
   "archetype_id": "",
   "mv_table": "item_inv_catsales_rollup",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": -1,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT i_item_id,\n       i_item_desc,\n       i_current_price\nFROM item,\n     inventory,\n     date_dim,\n     catalog_sales\nWHERE i_current_price BETWEEN 68 AND 68 + 30\n  AND inv_item_sk = i_item_sk\n  AND d_date_sk=inv_date_sk\n  AND d_date BETWEEN cast('2000-02-01' AS date) AND cast('2000-04-01' AS date)\n  AND i_manufact_id IN (677,\n                        940,\n                        694,\n                        808)\n  AND inv_quantity_on_hand BETWEEN 100 AND 500\n  AND cs_item_sk = i_item_sk\nGROUP BY i_item_id,\n         i_item_desc,\n         i_current_price\nORDER BY i_item_id\nLIMIT 100",
   "mv_sql": "SELECT i_item_sk, i_item_id, i_item_desc, i_manufact_id, inv_date_sk, inv_quantity_on_hand, COUNT(*) AS match_count FROM item, inventory, catalog_sales WHERE inv_item_sk = i_item_sk AND cs_item_sk = i_item_sk GROUP BY i_item_sk, i_item_id, i_item_desc, i_manufact_id, inv_date_sk, inv_quantity_on_hand",
   "rewrite_sql": "SELECT i_item_id, i_item_desc, i_current_price FROM (SELECT m.i_item_id, m.i_item_desc, i.i_current_price, i.i_manufact_id, d.d_date, m.inv_quantity_on_hand, SUM(m.match_count) AS match_count FROM tpcds_mv.item_inv_catsales_rollup m JOIN item i ON i.i_item_sk = m.i_item_sk JOIN date_dim d ON d.d_date_sk = m.inv_date_sk WHERE i.i_current_price BETWEEN 68 AND 68 + 30 AND d.d_date BETWEEN cast('2000-02-01' AS date) AND cast('2000-04-01' AS date) AND i.i_manufact_id IN (677,940,694,808) AND m.inv_quantity_on_hand BETWEEN 100 AND 500 GROUP BY m.i_item_id, m.i_item_desc, i.i_current_price, i.i_manufact_id, d.d_date, m.inv_quantity_on_hand HAVING SUM(m.match_count) > 0) t GROUP BY i_item_id, i_item_desc, i_current_price ORDER BY i_item_id LIMIT 100",
   "delta_sql": "SELECT i_item_sk, i_item_id, i_item_desc, i_manufact_id, inv_date_sk, inv_quantity_on_hand, COUNT(*) AS match_count FROM item, $DELTA(inventory), $DELTA(catalog_sales) WHERE inv_item_sk = i_item_sk AND cs_item_sk = i_item_sk GROUP BY i_item_sk, i_item_id, i_item_desc, i_manufact_id, inv_date_sk, inv_quantity_on_hand",
   "row_hash_at_author": "ac519abe856a6c526cfadd3958f51e97",
