   "mv_table": "mv_h_6df383d79a56",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 247940,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT c_last_name, c_first_name, ca_city, bought_city, ss_ticket_number, extended_price, extended_tax, list_price FROM (SELECT ss_ticket_number, ss_customer_sk, ca_city bought_city, sum(ss_ext_sales_price) extended_price, sum(ss_ext_list_price) list_price, sum(ss_ext_tax) extended_tax FROM store_sales, date_dim, store, household_demographics, customer_address WHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk AND store_sales.ss_store_sk = store.s_store_sk AND store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk AND store_sales.ss_addr_sk = customer_address.ca_address_sk AND date_dim.d_dom BETWEEN 1 AND 2 AND (household_demographics.hd_dep_count = 4 OR household_demographics.hd_vehicle_count= 3) AND date_dim.d_year IN (1999, 1999+1, 1999+2) AND store.s_city IN ('Fairview', 'Midway') GROUP BY ss_ticket_number, ss_customer_sk, ss_addr_sk, ca_city) dn, customer, customer_address current_addr WHERE ss_customer_sk = c_customer_sk AND customer.c_current_addr_sk = current_addr.ca_address_sk AND current_addr.ca_city <> bought_city ORDER BY c_last_name NULLS FIRST, ss_ticket_number NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT ss_ticket_number, ss_customer_sk, ss_addr_sk, ca_city, d_dom, d_year, s_city,\n       hd_dep_count, hd_vehicle_count,\n       sum(ss_ext_sales_price) AS extended_price,\n       sum(ss_ext_list_price) AS list_price,\n       sum(ss_ext_tax) AS extended_tax\nFROM store_sales, date_dim, store, household_demographics, customer_address\nWHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk\n  AND store_sales.ss_store_sk = store.s_store_sk\n  AND store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk\n  AND store_sales.ss_addr_sk = customer_address.ca_address_sk\nGROUP BY ss_ticket_number, ss_customer_sk, ss_addr_sk, ca_city, d_dom, d_year, s_city,\n         hd_dep_count, hd_vehicle_count",
   "rewrite_sql": "SELECT c_last_name, c_first_name, ca_city, bought_city, ss_ticket_number,\n       extended_price, extended_tax, list_price\nFROM (SELECT ss_ticket_number, ss_customer_sk, ca_city bought_city,\n             sum(extended_price) extended_price, sum(list_price) list_price,\n             sum(extended_tax) extended_tax\n      FROM iceberg.tpcds_mv.mv_h_6df383d79a56\n      WHERE d_dom BETWEEN 1 AND 2\n        AND (hd_dep_count = 4 OR hd_vehicle_count = 3)\n        AND d_year IN (1999, 1999+1, 1999+2)\n        AND s_city IN ('Fairview', 'Midway')\n      GROUP BY ss_ticket_number, ss_customer_sk, ss_addr_sk, ca_city) dn,\n     customer, customer_address current_addr\nWHERE ss_customer_sk = c_customer_sk\n  AND customer.c_current_addr_sk = current_addr.ca_address_sk\n  AND current_addr.ca_city <> bought_city\nORDER BY c_last_name NULLS FIRST, ss_ticket_number NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT ss_ticket_number, ss_customer_sk, ss_addr_sk, ca_city, d_dom, d_year, s_city,\n       hd_dep_count, hd_vehicle_count,\n       sum(ss_ext_sales_price) AS extended_price,\n       sum(ss_ext_list_price) AS list_price,\n       sum(ss_ext_tax) AS extended_tax\nFROM $DELTA(store_sales), date_dim, store, household_demographics, customer_address\nWHERE store_sales.ss_sold_date_sk = date_dim.d_date_sk\n  AND store_sales.ss_store_sk = store.s_store_sk\n  AND store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk\n  AND store_sales.ss_addr_sk = customer_address.ca_address_sk\nGROUP BY ss_ticket_number, ss_customer_sk, ss_addr_sk, ca_city, d_dom, d_year, s_city,\n         hd_dep_count, hd_vehicle_count",
   "row_hash_at_author": "12bf4f1cf13fb9a5bcd6e9e03a13d21f",
