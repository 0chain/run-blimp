   "mv_rows_at_author": 11745000,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT * FROM (SELECT w_warehouse_name, i_item_id, sum(CASE WHEN (cast(d_date AS date) < CAST ('2000-03-11' AS date)) THEN inv_quantity_on_hand ELSE 0 END) AS inv_before, sum(CASE WHEN (cast(d_date AS date) >= CAST ('2000-03-11' AS date)) THEN inv_quantity_on_hand ELSE 0 END) AS inv_after FROM inventory, warehouse, item, date_dim WHERE i_current_price BETWEEN 0.99 AND 1.49 AND i_item_sk = inv_item_sk AND inv_warehouse_sk = w_warehouse_sk AND inv_date_sk = d_date_sk AND d_date BETWEEN CAST ('2000-02-10' AS date) AND CAST ('2000-04-10' AS date) GROUP BY w_warehouse_name, i_item_id) x WHERE (CASE WHEN inv_before > 0 THEN (inv_after*1.000) / inv_before ELSE NULL END) BETWEEN 2.000/3.000 AND 3.000/2.000 ORDER BY w_warehouse_name NULLS FIRST, i_item_id NULLS FIRST LIMIT 100",
   "mv_sql": "SELECT w_warehouse_name, i_item_id, i_current_price, d_date,\n       sum(inv_quantity_on_hand) AS qoh\nFROM inventory, warehouse, item, date_dim\nWHERE i_item_sk = inv_item_sk\n  AND inv_warehouse_sk = w_warehouse_sk\n  AND inv_date_sk = d_date_sk\nGROUP BY w_warehouse_name, i_item_id, i_current_price, d_date",
   "rewrite_sql": "SELECT *\nFROM (SELECT w_warehouse_name, i_item_id,\n             sum(CASE WHEN (cast(d_date AS date) < CAST ('2000-03-11' AS date)) THEN qoh ELSE 0 END) AS inv_before,\n             sum(CASE WHEN (cast(d_date AS date) >= CAST ('2000-03-11' AS date)) THEN qoh ELSE 0 END) AS inv_after\n      FROM iceberg.tpcds_mv.mv_h_7c406cd78fb5\n      WHERE i_current_price BETWEEN 0.99 AND 1.49\n        AND d_date BETWEEN CAST ('2000-02-10' AS date) AND CAST ('2000-04-10' AS date)\n      GROUP BY w_warehouse_name, i_item_id) x\nWHERE (CASE WHEN inv_before > 0 THEN (inv_after*1.000) / inv_before ELSE NULL END)\n      BETWEEN 2.000/3.000 AND 3.000/2.000\nORDER BY w_warehouse_name NULLS FIRST, i_item_id NULLS FIRST\nLIMIT 100",
   "delta_sql": "SELECT w_warehouse_name, i_item_id, i_current_price, d_date,\n       sum(inv_quantity_on_hand) AS qoh\nFROM $DELTA(inventory), warehouse, item, date_dim\nWHERE i_item_sk = inv_item_sk\n  AND inv_warehouse_sk = w_warehouse_sk\n  AND inv_date_sk = d_date_sk\nGROUP BY w_warehouse_name, i_item_id, i_current_price, d_date",
   "row_hash_at_author": "f10093c8417dbeeb4d6d98d4d6679e27",
   "sql_fingerprint_sha256": "527d38d8ea72aa0e"
