   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 58092,
   "mv_cols": 14,
   "source_schema": "tpcds",
   "original_sql": "SELECT s_store_name,\n       s_company_id,\n       s_street_number,\n       s_street_name,\n       s_street_type,\n       s_suite_number,\n       s_city,\n       s_county,\n       s_state,\n       s_zip,\n       sum(CASE\n               WHEN (sr_returned_date_sk - ss_sold_date_sk <= 30) THEN 1\n               ELSE 0\n           END) AS \"30 days\",\n       sum(CASE\n               WHEN (sr_returned_date_sk - ss_sold_date_sk > 30)\n                    AND (sr_returned_date_sk - ss_sold_date_sk <= 60) THEN 1\n               ELSE 0\n           END) AS \"31-60 days\",\n       sum(CASE\n               WHEN (sr_returned_date_sk - ss_sold_date_sk > 60)\n                    AND (sr_returned_date_sk - ss_sold_date_sk <= 90) THEN 1\n               ELSE 0\n           END) AS \"61-90 days\",\n       sum(CASE\n               WHEN (sr_returned_date_sk - ss_sold_date_sk > 90)\n                    AND (sr_returned_date_sk - ss_sold_date_sk <= 120) THEN 1\n               ELSE 0\n           END) AS \"91-120 days\",\n       sum(CASE\n               WHEN (sr_returned_date_sk - ss_sold_date_sk > 120) THEN 1\n               ELSE 0\n           END) AS \">120 days\"\nFROM store_sales,\n     store_returns,\n     store,\n     date_dim d1,\n     date_dim d2\nWHERE d2.d_year = 2001\n  AND d2.d_moy = 8\n  AND ss_ticket_number = sr_ticket_number\n  AND ss_item_sk = sr_item_sk\n  AND ss_sold_date_sk = d1.d_date_sk\n  AND sr_returned_date_sk = d2.d_date_sk\n  AND ss_customer_sk = sr_customer_sk\n  AND ss_store_sk = s_store_sk\nGROUP BY s_store_name,\n         s_company_id,\n         s_street_number,\n         s_street_name,\n         s_street_type,\n         s_suite_number,\n         s_city,\n         s_county,\n         s_state,\n         s_zip\nORDER BY s_store_name,\n         s_company_id,\n         s_street_number,\n         s_street_name,\n         s_street_type,\n         s_suite_number,\n         s_city,\n         s_county,\n         s_state,\n         s_zip\nLIMIT 100",
   "mv_sql": "SELECT s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip, ss_sold_date_sk, sr_returned_date_sk, COUNT(*) AS cnt FROM store_sales, store_returns, store WHERE ss_ticket_number = sr_ticket_number AND ss_item_sk = sr_item_sk AND ss_customer_sk = sr_customer_sk AND ss_store_sk = s_store_sk GROUP BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip, ss_sold_date_sk, sr_returned_date_sk",
   "rewrite_sql": "SELECT s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip, SUM(CASE WHEN (m.sr_returned_date_sk - m.ss_sold_date_sk <= 30) THEN cnt ELSE 0 END) AS \"30 days\", SUM(CASE WHEN (m.sr_returned_date_sk - m.ss_sold_date_sk > 30) AND (m.sr_returned_date_sk - m.ss_sold_date_sk <= 60) THEN cnt ELSE 0 END) AS \"31-60 days\", SUM(CASE WHEN (m.sr_returned_date_sk - m.ss_sold_date_sk > 60) AND (m.sr_returned_date_sk - m.ss_sold_date_sk <= 90) THEN cnt ELSE 0 END) AS \"61-90 days\", SUM(CASE WHEN (m.sr_returned_date_sk - m.ss_sold_date_sk > 90) AND (m.sr_returned_date_sk - m.ss_sold_date_sk <= 120) THEN cnt ELSE 0 END) AS \"91-120 days\", SUM(CASE WHEN (m.sr_returned_date_sk - m.ss_sold_date_sk > 120) THEN cnt ELSE 0 END) AS \">120 days\" FROM tpcds_mv.store_sales_returns_by_store m JOIN date_dim d2 ON m.sr_returned_date_sk = d2.d_date_sk WHERE d2.d_year = 2001 AND d2.d_moy = 8 GROUP BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip ORDER BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip LIMIT 100",
   "delta_sql": "SELECT s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip, ss_sold_date_sk, sr_returned_date_sk, COUNT(*) AS cnt FROM $DELTA(store_sales), $DELTA(store_returns), store WHERE ss_ticket_number = sr_ticket_number AND ss_item_sk = sr_item_sk AND ss_customer_sk = sr_customer_sk AND ss_store_sk = s_store_sk GROUP BY s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip, ss_sold_date_sk, sr_returned_date_sk",
