   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT i_item_id,\n       avg(cs_quantity) agg1,\n       avg(cs_list_price) agg2,\n       avg(cs_coupon_amt) agg3,\n       avg(cs_sales_price) agg4\nFROM catalog_sales,\n     customer_demographics,\n     date_dim,\n     item,\n     promotion\nWHERE cs_sold_date_sk = d_date_sk\n  AND cs_item_sk = i_item_sk\n  AND cs_bill_cdemo_sk = cd_demo_sk\n  AND cs_promo_sk = p_promo_sk\n  AND cd_gender = 'M'\n  AND cd_marital_status = 'S'\n  AND cd_education_status = 'College'\n  AND (p_channel_email = 'N'\n       OR p_channel_event = 'N')\n  AND d_year = 2000\nGROUP BY i_item_id\nORDER BY i_item_id\nLIMIT 100",
   "mv_sql": "SELECT i_item_id, cd_gender, cd_marital_status, cd_education_status, p_channel_email, p_channel_event, d_year, SUM(cs_quantity) sum_quantity, COUNT(cs_quantity) cnt_quantity, SUM(cs_list_price) sum_list_price, COUNT(cs_list_price) cnt_list_price, SUM(cs_coupon_amt) sum_coupon_amt, COUNT(cs_coupon_amt) cnt_coupon_amt, SUM(cs_sales_price) sum_sales_price, COUNT(cs_sales_price) cnt_sales_price FROM catalog_sales, customer_demographics, date_dim, item, promotion WHERE cs_sold_date_sk = d_date_sk AND cs_item_sk = i_item_sk AND cs_bill_cdemo_sk = cd_demo_sk AND cs_promo_sk = p_promo_sk GROUP BY i_item_id, cd_gender, cd_marital_status, cd_education_status, p_channel_email, p_channel_event, d_year",
   "rewrite_sql": "SELECT i_item_id, SUM(sum_quantity)/SUM(cnt_quantity) agg1, SUM(sum_list_price)/SUM(cnt_list_price) agg2, SUM(sum_coupon_amt)/SUM(cnt_coupon_amt) agg3, SUM(sum_sales_price)/SUM(cnt_sales_price) agg4 FROM tpcds_mv.catalog_sales_cdemo_promo_rollup WHERE cd_gender = 'M' AND cd_marital_status = 'S' AND cd_education_status = 'College' AND (p_channel_email = 'N' OR p_channel_event = 'N') AND d_year = 2000 GROUP BY i_item_id ORDER BY i_item_id LIMIT 100",
   "delta_sql": "SELECT i_item_id, cd_gender, cd_marital_status, cd_education_status, p_channel_email, p_channel_event, d_year, SUM(cs_quantity) sum_quantity, COUNT(cs_quantity) cnt_quantity, SUM(cs_list_price) sum_list_price, COUNT(cs_list_price) cnt_list_price, SUM(cs_coupon_amt) sum_coupon_amt, COUNT(cs_coupon_amt) cnt_coupon_amt, SUM(cs_sales_price) sum_sales_price, COUNT(cs_sales_price) cnt_sales_price FROM $DELTA(catalog_sales), customer_demographics, date_dim, item, promotion WHERE cs_sold_date_sk = d_date_sk AND cs_item_sk = i_item_sk AND cs_bill_cdemo_sk = cd_demo_sk AND cs_promo_sk = p_promo_sk GROUP BY i_item_id, cd_gender, cd_marital_status, cd_education_status, p_channel_email, p_channel_event, d_year",
   "row_hash_at_author": "f7e7b32f113210c3b5d9920ca9011483",
