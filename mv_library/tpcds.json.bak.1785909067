   "mv_rows_at_author": 45648,
   "mv_cols": 5,
   "source_schema": "tpcds",
   "original_sql": "SELECT count(*)\nFROM store_sales ,\n     household_demographics,\n     time_dim,\n     store\nWHERE ss_sold_time_sk = time_dim.t_time_sk\n  AND ss_hdemo_sk = household_demographics.hd_demo_sk\n  AND ss_store_sk = s_store_sk\n  AND time_dim.t_hour = 20\n  AND time_dim.t_minute >= 30\n  AND household_demographics.hd_dep_count = 7\n  AND store.s_store_name = 'ese'\nORDER BY count(*)\nLIMIT 100",
   "mv_sql": "SELECT ss_sold_time_sk, ss_hdemo_sk, ss_store_sk, COUNT(*) AS cnt FROM store_sales, household_demographics, time_dim, store WHERE ss_sold_time_sk = time_dim.t_time_sk AND ss_hdemo_sk = household_demographics.hd_demo_sk AND ss_store_sk = s_store_sk GROUP BY ss_sold_time_sk, ss_hdemo_sk, ss_store_sk",
   "rewrite_sql": "SELECT SUM(cnt) AS cnt FROM tpcds_mv.store_sales_hdemo_time_store m, time_dim, household_demographics, store WHERE m.ss_sold_time_sk = time_dim.t_time_sk AND m.ss_hdemo_sk = household_demographics.hd_demo_sk AND m.ss_store_sk = store.s_store_sk AND time_dim.t_hour = 20 AND time_dim.t_minute >= 30 AND household_demographics.hd_dep_count = 7 AND store.s_store_name = 'ese' ORDER BY cnt LIMIT 100",
   "delta_sql": "SELECT ss_sold_time_sk, ss_hdemo_sk, ss_store_sk, COUNT(*) AS cnt FROM $DELTA(store_sales), household_demographics, time_dim, store WHERE ss_sold_time_sk = time_dim.t_time_sk AND ss_hdemo_sk = household_demographics.hd_demo_sk AND ss_store_sk = s_store_sk GROUP BY ss_sold_time_sk, ss_hdemo_sk, ss_store_sk",
   "row_hash_at_author": "46dc02a25fe65d4f2bad3642ee2c75f2",
   "sql_fingerprint_sha256": "a0d2c0e8394079cc"
  },
  {
   "labels": [
    "q65"
   ],
   "qid_pattern": "",
   "category": "subquery",
   "shape_class": "groupby|none|between-range|avg|outer-limit-order",
   "tier": "tooluse_sonnet",
   "archetype_id": "",
   "mv_table": "store_sales_item_month_revenue",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": -1,
   "mv_cols": -1,
   "source_schema": "tpcds",
   "original_sql": "SELECT s_store_name,\n       i_item_desc,\n       sc.revenue,\n       i_current_price,\n       i_wholesale_cost,\n       i_brand\nFROM store,\n     item,\n  (SELECT ss_store_sk,\n          avg(revenue) AS ave\n   FROM\n     (SELECT ss_store_sk,\n             ss_item_sk,\n             sum(ss_sales_price) AS revenue\n      FROM store_sales,\n           date_dim\n      WHERE ss_sold_date_sk = d_date_sk\n        AND d_month_seq BETWEEN 1176 AND 1176+11\n      GROUP BY ss_store_sk,\n               ss_item_sk) sa\n   GROUP BY ss_store_sk) sb,\n  (SELECT ss_store_sk,\n          ss_item_sk,\n          sum(ss_sales_price) AS revenue\n   FROM store_sales,\n        date_dim\n   WHERE ss_sold_date_sk = d_date_sk\n     AND d_month_seq BETWEEN 1176 AND 1176+11\n   GROUP BY ss_store_sk,\n            ss_item_sk) sc\nWHERE sb.ss_store_sk = sc.ss_store_sk\n  AND sc.revenue <= 0.1 * sb.ave\n  AND s_store_sk = sc.ss_store_sk\n  AND i_item_sk = sc.ss_item_sk\nORDER BY s_store_name NULLS FIRST,\n         i_item_desc NULLS FIRST\nLIMIT 100",
   "mv_sql": "SELECT ss_store_sk, ss_item_sk, ss_sold_date_sk, SUM(ss_sales_price) AS sum_sales_price, COUNT(ss_sales_price) AS count_sales_price FROM store_sales GROUP BY ss_store_sk, ss_item_sk, ss_sold_date_sk",
   "rewrite_sql": "WITH sa AS (SELECT b.ss_store_sk, b.ss_item_sk, SUM(b.sum_sales_price) AS revenue FROM tpcds_mv.store_sales_item_month_revenue b JOIN date_dim d ON b.ss_sold_date_sk = d.d_date_sk WHERE d.d_month_seq BETWEEN 1176 AND 1176+11 GROUP BY b.ss_store_sk, b.ss_item_sk), sb AS (SELECT ss_store_sk, AVG(revenue) AS ave FROM sa GROUP BY ss_store_sk) SELECT s_store_name, i_item_desc, sc.revenue, i_current_price, i_wholesale_cost, i_brand FROM store, item, sb, sa sc WHERE sb.ss_store_sk = sc.ss_store_sk AND sc.revenue <= 0.1 * sb.ave AND s_store_sk = sc.ss_store_sk AND i_item_sk = sc.ss_item_sk ORDER BY s_store_name NULLS FIRST, i_item_desc NULLS FIRST LIMIT 100",
   "delta_sql": "SELECT ss_store_sk, ss_item_sk, ss_sold_date_sk, SUM(ss_sales_price) AS sum_sales_price, COUNT(ss_sales_price) AS count_sales_price FROM $DELTA(store_sales) GROUP BY ss_store_sk, ss_item_sk, ss_sold_date_sk",
   "row_hash_at_author": "c6ce8f04f5eca69a9c61d831c85f9f87",
   "sql_fingerprint_sha256": "c7e667844505b1b4"
  },
  {
   "labels": [
    "q28"
   ],
   "qid_pattern": "",
   "category": "join",
   "shape_class": "global-scalar|none|or-of-and|count-distinct|none",
   "tier": "tooluse_sonnet",
   "archetype_id": "",
   "mv_table": "store_sales_qty_lp_branches",
   "mv_namespace": "tpcds_mv",
   "mv_rows_at_author": 447953,
   "mv_cols": 6,
   "source_schema": "tpcds",
   "original_sql": "SELECT *\nFROM\n  (SELECT avg(ss_list_price) B1_LP,\n          count(ss_list_price) B1_CNT,\n          count(DISTINCT ss_list_price) B1_CNTD\n   FROM store_sales\n   WHERE ss_quantity BETWEEN 0 AND 5\n     AND (ss_list_price BETWEEN 8 AND 8+10\n          OR ss_coupon_amt BETWEEN 459 AND 459+1000\n          OR ss_wholesale_cost BETWEEN 57 AND 57+20)) B1,\n  (SELECT avg(ss_list_price) B2_LP,\n          count(ss_list_price) B2_CNT,\n          count(DISTINCT ss_list_price) B2_CNTD\n   FROM store_sales\n   WHERE ss_quantity BETWEEN 6 AND 10\n     AND (ss_list_price BETWEEN 90 AND 90+10\n          OR ss_coupon_amt BETWEEN 2323 AND 2323+1000\n          OR ss_wholesale_cost BETWEEN 31 AND 31+20)) B2,\n  (SELECT avg(ss_list_price) B3_LP,\n          count(ss_list_price) B3_CNT,\n          count(DISTINCT ss_list_price) B3_CNTD\n   FROM store_sales\n   WHERE ss_quantity BETWEEN 11 AND 15\n     AND (ss_list_price BETWEEN 142 AND 142+10\n          OR ss_coupon_amt BETWEEN 12214 AND 12214+1000\n          OR ss_wholesale_cost BETWEEN 79 AND 79+20)) B3,\n  (SELECT avg(ss_list_price) B4_LP,\n          count(ss_list_price) B4_CNT,\n          count(DISTINCT ss_list_price) B4_CNTD\n   FROM store_sales\n   WHERE ss_quantity BETWEEN 16 AND 20\n     AND (ss_list_price BETWEEN 135 AND 135+10\n          OR ss_coupon_amt BETWEEN 6071 AND 6071+1000\n          OR ss_wholesale_cost BETWEEN 38 AND 38+20)) B4,\n  (SELECT avg(ss_list_price) B5_LP,\n          count(ss_list_price) B5_CNT,\n          count(DISTINCT ss_list_price) B5_CNTD\n   FROM store_sales\n   WHERE ss_quantity BETWEEN 21 AND 25\n     AND (ss_list_price BETWEEN 122 AND 122+10\n          OR ss_coupon_amt BETWEEN 836 AND 836+1000\n          OR ss_wholesale_cost BETWEEN 17 AND 17+20)) B5,\n  (SELECT avg(ss_list_price) B6_LP,\n          count(ss_list_price) B6_CNT,\n          count(DISTINCT ss_list_price) B6_CNTD\n   FROM store_sales\n   WHERE ss_quantity BETWEEN 26 AND 30\n     AND (ss_list_price BETWEEN 154 AND 154+10\n          OR ss_coupon_amt BETWEEN 7326 AND 7326+1000\n          OR ss_wholesale_cost BETWEEN 7 AND 7+20)) B6\nLIMIT 100",
   "mv_sql": "SELECT 'B1' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM store_sales WHERE (ss_list_price BETWEEN 8 AND 18 OR ss_coupon_amt BETWEEN 459 AND 1459 OR ss_wholesale_cost BETWEEN 57 AND 77) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B2' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM store_sales WHERE (ss_list_price BETWEEN 90 AND 100 OR ss_coupon_amt BETWEEN 2323 AND 3323 OR ss_wholesale_cost BETWEEN 31 AND 51) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B3' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM store_sales WHERE (ss_list_price BETWEEN 142 AND 152 OR ss_coupon_amt BETWEEN 12214 AND 13214 OR ss_wholesale_cost BETWEEN 79 AND 99) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B4' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM store_sales WHERE (ss_list_price BETWEEN 135 AND 145 OR ss_coupon_amt BETWEEN 6071 AND 7071 OR ss_wholesale_cost BETWEEN 38 AND 58) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B5' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM store_sales WHERE (ss_list_price BETWEEN 122 AND 132 OR ss_coupon_amt BETWEEN 836 AND 1836 OR ss_wholesale_cost BETWEEN 17 AND 37) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B6' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM store_sales WHERE (ss_list_price BETWEEN 154 AND 164 OR ss_coupon_amt BETWEEN 7326 AND 8326 OR ss_wholesale_cost BETWEEN 7 AND 27) GROUP BY ss_quantity, ss_list_price",
   "rewrite_sql": "WITH agg AS (SELECT part, ss_quantity, ss_list_price, SUM(sum_lp) AS sum_lp, SUM(cnt_lp) AS cnt_lp, COUNT(DISTINCT ss_list_price) AS cntd_lp FROM tpcds_mv.store_sales_qty_lp_branches GROUP BY part, ss_quantity, ss_list_price) SELECT (SELECT SUM(sum_lp)/NULLIF(SUM(cnt_lp),0) FROM agg WHERE part='B1' AND ss_quantity BETWEEN 0 AND 5) AS B1_LP, (SELECT SUM(cnt_lp) FROM agg WHERE part='B1' AND ss_quantity BETWEEN 0 AND 5) AS B1_CNT, (SELECT COUNT(DISTINCT ss_list_price) FROM agg WHERE part='B1' AND ss_quantity BETWEEN 0 AND 5) AS B1_CNTD, (SELECT SUM(sum_lp)/NULLIF(SUM(cnt_lp),0) FROM agg WHERE part='B2' AND ss_quantity BETWEEN 6 AND 10) AS B2_LP, (SELECT SUM(cnt_lp) FROM agg WHERE part='B2' AND ss_quantity BETWEEN 6 AND 10) AS B2_CNT, (SELECT COUNT(DISTINCT ss_list_price) FROM agg WHERE part='B2' AND ss_quantity BETWEEN 6 AND 10) AS B2_CNTD, (SELECT SUM(sum_lp)/NULLIF(SUM(cnt_lp),0) FROM agg WHERE part='B3' AND ss_quantity BETWEEN 11 AND 15) AS B3_LP, (SELECT SUM(cnt_lp) FROM agg WHERE part='B3' AND ss_quantity BETWEEN 11 AND 15) AS B3_CNT, (SELECT COUNT(DISTINCT ss_list_price) FROM agg WHERE part='B3' AND ss_quantity BETWEEN 11 AND 15) AS B3_CNTD, (SELECT SUM(sum_lp)/NULLIF(SUM(cnt_lp),0) FROM agg WHERE part='B4' AND ss_quantity BETWEEN 16 AND 20) AS B4_LP, (SELECT SUM(cnt_lp) FROM agg WHERE part='B4' AND ss_quantity BETWEEN 16 AND 20) AS B4_CNT, (SELECT COUNT(DISTINCT ss_list_price) FROM agg WHERE part='B4' AND ss_quantity BETWEEN 16 AND 20) AS B4_CNTD, (SELECT SUM(sum_lp)/NULLIF(SUM(cnt_lp),0) FROM agg WHERE part='B5' AND ss_quantity BETWEEN 21 AND 25) AS B5_LP, (SELECT SUM(cnt_lp) FROM agg WHERE part='B5' AND ss_quantity BETWEEN 21 AND 25) AS B5_CNT, (SELECT COUNT(DISTINCT ss_list_price) FROM agg WHERE part='B5' AND ss_quantity BETWEEN 21 AND 25) AS B5_CNTD, (SELECT SUM(sum_lp)/NULLIF(SUM(cnt_lp),0) FROM agg WHERE part='B6' AND ss_quantity BETWEEN 26 AND 30) AS B6_LP, (SELECT SUM(cnt_lp) FROM agg WHERE part='B6' AND ss_quantity BETWEEN 26 AND 30) AS B6_CNT, (SELECT COUNT(DISTINCT ss_list_price) FROM agg WHERE part='B6' AND ss_quantity BETWEEN 26 AND 30) AS B6_CNTD LIMIT 100",
   "delta_sql": "SELECT 'B1' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM $DELTA(store_sales) WHERE (ss_list_price BETWEEN 8 AND 18 OR ss_coupon_amt BETWEEN 459 AND 1459 OR ss_wholesale_cost BETWEEN 57 AND 77) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B2' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM $DELTA(store_sales) WHERE (ss_list_price BETWEEN 90 AND 100 OR ss_coupon_amt BETWEEN 2323 AND 3323 OR ss_wholesale_cost BETWEEN 31 AND 51) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B3' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM $DELTA(store_sales) WHERE (ss_list_price BETWEEN 142 AND 152 OR ss_coupon_amt BETWEEN 12214 AND 13214 OR ss_wholesale_cost BETWEEN 79 AND 99) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B4' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM $DELTA(store_sales) WHERE (ss_list_price BETWEEN 135 AND 145 OR ss_coupon_amt BETWEEN 6071 AND 7071 OR ss_wholesale_cost BETWEEN 38 AND 58) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B5' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM $DELTA(store_sales) WHERE (ss_list_price BETWEEN 122 AND 132 OR ss_coupon_amt BETWEEN 836 AND 1836 OR ss_wholesale_cost BETWEEN 17 AND 37) GROUP BY ss_quantity, ss_list_price UNION ALL SELECT 'B6' AS part, ss_quantity, ss_list_price, SUM(ss_list_price) AS sum_lp, COUNT(ss_list_price) AS cnt_lp, COUNT(*) AS cnt_star FROM $DELTA(store_sales) WHERE (ss_list_price BETWEEN 154 AND 164 OR ss_coupon_amt BETWEEN 7326 AND 8326 OR ss_wholesale_cost BETWEEN 7 AND 27) GROUP BY ss_quantity, ss_list_price",
   "row_hash_at_author": "4ce298f7c23cf8f7bd17490e8a7d33b6",
   "sql_fingerprint_sha256": "617360dff7ca12a8"
