#!/usr/bin/env bash
# ==============================================================================
# blimp — one command to set up, then validate, a Blimp prod source.
# ==============================================================================
#   blimp                 list the commands (this help)
#   blimp --setup         PROD: run on YOUR app node — connect a Blimp cluster to
#                         your data. Asks for your Iceberg REST + S3 endpoints;
#                         if you don't have them, stands up an Iceberg catalog
#                         (:8181) and/or an S3 warehouse bucket here for you,
#                         then prints the values to point the Blimp cluster at.
#   blimp --storage       TEST: storage/cache suite (warp, fio, mlperf, cache).
#   blimp --query         TEST: query + CDC suite (author → append → delta-merge).
#   blimp --bench         BENCH: statistical author / materialize / delta-merge
#                         timing profile (min/median/avg/max over N iterations).
#
# Wiring is saved to ~/.blimp_env (override path with BLIMP_ENV). --setup writes
# it; --storage/--query read it (and prompt for anything still missing).
# Non-interactive: pre-set the env vars (REGION, CLUSTER_ID, GW, ICEBERG_URL,
# WAREHOUSE, ORIGIN_BUCKET, NAMESPACE, GW_AK, GW_SK) and they won't be asked.
# ==============================================================================
set -uo pipefail
# Resolve $0 through any symlink so `blimp` works when installed as
# /usr/local/bin/blimp -> /opt/blimp/blimp — HERE must be the KIT dir (where the
# sibling scripts live), not the symlink's dir.
SELF="$0"; while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"; case "$link" in /*) SELF="$link";; *) SELF="$(dirname "$SELF")/$link";; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
ENVF="${BLIMP_ENV:-$HOME/.blimp_env}"
bold(){ printf '\033[1m%s\033[0m\n' "$*"; }
die(){ printf '\033[31m[blimp] FATAL: %s\033[0m\n' "$*" >&2; exit 1; }
# ask VAR "prompt" [default] — keep an already-set value; else prompt (default on empty)
ask(){ local var="$1" prompt="$2" def="${3:-}" cur="${!1:-}" v
  [ -n "$cur" ] && { printf '%s' "$cur"; return; }
  # No terminal (CI, `ssh host cmd`, nohup) → take the default instead of dying.
  # `read </dev/tty` on such a host printed "/dev/tty: No such device or address"
  # for EVERY prompt and the run ended with no wiring written.
  #
  # Test the OPEN, not `-r`: under nohup the /dev/tty device node still exists
  # and is readable, so `[ -r /dev/tty ]` passes and the redirect below then
  # fails with ENXIO ("No such device or address") because the process has no
  # controlling terminal. That is exactly what happened to `blimp --storage`
  # under nohup (2026-08-01): both gateway S3 key prompts errored, the run
  # continued with BLANK credentials, and warp/mlperf then measured nothing.
  if ! { : < /dev/tty; } 2>/dev/null; then
    printf '%s%s: <no tty, using default>\n' "$prompt" "${def:+ [$def]}" >&2
    printf '%s' "$def"; return
  fi
  printf '%s%s: ' "$prompt" "${def:+ [$def]}" >&2; read -r v </dev/tty || true
  printf '%s' "${v:-$def}"; }

usage(){
  bold "blimp — Blimp prod-source setup + validation"
  cat <<'H'

  blimp --setup      Connect a Blimp cluster to your data (run on your app node).
                     Uses your Iceberg REST + S3 endpoints if you have them, or
                     stands up an Iceberg catalog / S3 bucket here if you don't.
  blimp --storage    Test: storage & read-through cache suite.
  blimp --acid       Test: ACID / linearizability — a Jepsen-style porcupine
                     check that concurrent writers + readers never observe a
                     stale or torn value, run against all three data paths of
                     the node (gateway S3 :9000, router :8088, mountpoint-s3).
                     Reports LINEARIZABLE / NOT-LINEARIZABLE per endpoint.
  blimp --query      Test: query optimizer + incremental CDC (delta-merge) suite.
                     Add --verify to turn verification ON. OFF by default because
                     that is the PRODUCTION path: the gateway runs NO verification
                     while serving (it is a full source scan per request), so an
                     unflagged run measures what customers actually get. --verify
                     costs ~1.5 min per query at SF1000 and is the only in-suite
                     check that a delta-merge produced correct rows.
  blimp --bench      Bench: author / materialize / delta-merge timing profile
                     (min/median/avg/max over N iters; ITERS, AUTHOR_ITERS, CDC_ROWS).

  Wiring is read from / written to ~/.blimp_env  (set BLIMP_ENV to relocate).
H
  [ -f "$ENVF" ] && { echo; bold "current wiring ($ENVF):"; sed 's/^/  /' "$ENVF"; }
  return 0
}

save_env(){
  umask 077
  cat > "$ENVF" <<E
# written by 'blimp --setup' — the wiring for --storage / --query
REGION=$REGION
CLUSTER_REGION=${CLUSTER_REGION:-$REGION}
CLUSTER_ID=$CLUSTER_ID
GW=$GW
GATEWAY=$GW
ICEBERG_URL=$ICEBERG_URL
WAREHOUSE=$WAREHOUSE
ORIGIN_BUCKET=$ORIGIN_BUCKET
NAMESPACE=$NAMESPACE
# WHERE the origin bucket actually lives. Without these three, --storage's cache
# legs sent every origin GET/PUT to real AWS S3 in \$REGION — which is wrong for
# any non-AWS origin, and flatly broken for the MinIO source standup_data puts on
# this box (bucket blimp-sf1 does not exist on AWS). Blank = AWS S3 + IAM role.
S3_ENDPOINT=${S3_ENDPOINT:-}
S3_KEY=${S3_KEY:-}
S3_SECRET=${S3_SECRET:-}
GW_AK=${GW_AK:-}
GW_SK=${GW_SK:-}
BLIMP_PY=${BLIMP_PY:-python3}
E
  bold "saved wiring -> $ENVF"
}

# ---- the address the Blimp cluster (on AWS) reaches THIS node on -------------
# Cross-cloud the gateway can't reach a private IP, so advertise the PUBLIC
# address by default. ADVERTISE_HOST overrides — set it to the private IP for a
# same-VPC / same-account AWS run, or to a stable DNS name you control.
this_host(){
  [ -n "${ADVERTISE_HOST:-}" ] && { printf '%s' "$ADVERTISE_HOST"; return; }
  # VPC MODE: advertise the PRIVATE address, and specifically the one that
  # ROUTES TO THE GATEWAY. The public IP is unreachable from inside the VPC —
  # the gateway hung for 411s on every metadata GET to a catalog advertised at
  # the client's public IP, then died on a read timeout with no error surfaced
  # (cluster 1785550395356, 2026-08-01). `ip route get` picks the right source
  # address on a multi-NIC host, where "first hostname -I" is a coin flip.
  if [ "${MODE:-}" = vpc ]; then
    local src=""
    [ -n "${GW_PRIV:-}" ] && src=$(ip route get "$GW_PRIV" 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)
    [ -z "$src" ] && src="${CLIENT_PRIV:-}"
    [ -z "$src" ] && src=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -n "$src" ] && { printf '%s' "$src"; return; }
  fi
  # EXTERNAL (cross-region / cross-account / cross-cloud / on-prem): the gateway
  # can only come back over a public path, so advertise the public address.
  local ip; ip=$(curl -s -m 3 https://checkip.amazonaws.com 2>/dev/null | tr -d '[:space:]')
  [ -n "$ip" ] && { printf '%s' "$ip"; return; }
  hostname -I 2>/dev/null | awk '{print $1}'
}

# ---- stand up an Iceberg REST catalog here (docker compose) ------------------
# A single `docker run` — no compose plugin needed on the client box (the only
# thing that ever required it). The catalog is one container; compose bought us
# nothing here. `docker` (or `sudo docker`) is the only dependency.
standup_iceberg(){
  local DKR=docker; command -v docker >/dev/null || DKR="sudo docker"
  $DKR info >/dev/null 2>&1 || DKR="sudo docker"
  $DKR info >/dev/null 2>&1 || die "docker not available — needed to stand up the Iceberg catalog. Install docker, or pass an existing Iceberg REST URL."
  # IDEMPOTENT: a healthy catalog already serving THIS warehouse is reused. The
  # previous behaviour was `rm -f` then recreate on every --setup, which tore
  # down a working catalog (and anything mid-flight against it) to rebuild an
  # identical one. Only a missing, unhealthy, or differently-pointed container is
  # replaced.
  if curl -s -m 4 "http://localhost:8181/v1/config" >/dev/null 2>&1; then
    local cur cur_ep want_ep
    cur=$($DKR inspect -f '{{range .Config.Env}}{{println .}}{{end}}' iceberg-rest 2>/dev/null \
          | sed -n 's/^CATALOG_WAREHOUSE=//p' | head -1)
    # Reuse must also match the S3 endpoint, not just the warehouse: a catalog
    # started before the endpoint was wired points at real AWS and 403s every
    # registration, and warehouse-only matching would silently keep it.
    cur_ep=$($DKR inspect -f '{{range .Config.Env}}{{println .}}{{end}}' iceberg-rest 2>/dev/null \
             | sed -n 's/^CATALOG_S3_ENDPOINT=//p' | head -1)
    case "${S3_ENDPOINT:-}" in ""|*amazonaws.com*) want_ep="";; *) want_ep="$S3_ENDPOINT";; esac
    # Reuse must also match the WAL catalog URI: a pre-WAL container keeps the
    # ephemeral in-container SQLite that wedges with SQLITE_BUSY under
    # concurrent commits+reads (4x on 2026-08-03) and loses the catalog on
    # docker rm. A container without the durable WAL URI is replaced.
    local cur_uri
    cur_uri=$($DKR inspect -f '{{range .Config.Env}}{{println .}}{{end}}' iceberg-rest 2>/dev/null \
              | sed -n 's/^CATALOG_URI=//p' | head -1)
    if [ "$cur" = "$WAREHOUSE" ] && [ "$cur_ep" = "$want_ep" ] && [ "${cur_uri#*transaction_mode=IMMEDIATE}" != "$cur_uri" ]; then
      ICEBERG_URL="http://$(this_host):8181"
      bold "  Iceberg catalog already up over $WAREHOUSE — reusing it ($ICEBERG_URL)"
      return 0
    fi
    bold "  catalog on :8181 points at ${cur:-<unknown>}, not $WAREHOUSE — replacing it"
  fi
  bold "standing up an Iceberg REST catalog on :8181 over $WAREHOUSE"
  # NON-AWS S3 (the MinIO source standup_data puts on this box) needs the endpoint
  # AND path-style access pushed into the catalog's own S3FileIO. Without them the
  # catalog signs its metadata writes against real s3.<region>.amazonaws.com while
  # holding the MinIO key, and every table registration fails with
  #   S3Exception: The AWS Access Key Id you provided does not exist in our records (403)
  # -> "registered 0/24 tables". The client-side register script already handles
  # this (--s3-endpoint); the catalog SERVICE did not.
  local EP_ENV=""
  case "${S3_ENDPOINT:-}" in
    ""|*amazonaws.com*) ;;
    *) EP_ENV="-e CATALOG_S3_ENDPOINT=$S3_ENDPOINT -e CATALOG_S3_PATH__STYLE__ACCESS=true" ;;
  esac
  $DKR rm -f iceberg-rest >/dev/null 2>&1 || true
  # Durable WAL-mode catalog db on the HOST. The image default is an ephemeral
  # in-container SQLite in rollback-journal mode: concurrent seeder commits +
  # gateway added_files reads wedge it with SQLITE_BUSY/CommitStateUnknown
  # (4 wedges on 2026-08-03), and `docker rm` destroys the catalog outright.
  # WAL allows readers during a writer; busy_timeout absorbs bursts; the bind
  # mount survives container recreation.
  sudo mkdir -p /opt/blimp/catalog 2>/dev/null || mkdir -p /opt/blimp/catalog
  sudo chown -R 1000:1000 /opt/blimp/catalog 2>/dev/null || true
  # shellcheck disable=SC2086  # EP_ENV is an intentional word-split flag pair
  $DKR run -d --name iceberg-rest --restart unless-stopped -p 8181:8181 \
    -e CATALOG_WAREHOUSE="$WAREHOUSE" \
    -e CATALOG_IO__IMPL=org.apache.iceberg.aws.s3.S3FileIO \
    -e CATALOG_CATALOG__IMPL=org.apache.iceberg.jdbc.JdbcCatalog \
    -e CATALOG_URI='jdbc:sqlite:file:/catalog/cat.db?journal_mode=WAL&busy_timeout=30000&synchronous=NORMAL&transaction_mode=IMMEDIATE' \
    -e CATALOG_JDBC_USER=user -e CATALOG_JDBC_PASSWORD=password \
    -e CATALOG_CLIENTS=1 \
    -v /opt/blimp/catalog:/catalog \
    $EP_ENV \
    -e AWS_REGION="$REGION" \
    -e AWS_ACCESS_KEY_ID="${S3_KEY:-${CAT_AK:-${AWS_ACCESS_KEY_ID:-}}}" \
    -e AWS_SECRET_ACCESS_KEY="${S3_SECRET:-${CAT_SK:-${AWS_SECRET_ACCESS_KEY:-}}}" \
    tabulario/iceberg-rest:latest >/dev/null || die "failed to start iceberg-rest"
  for i in $(seq 1 20); do
    curl -s -m 4 "http://localhost:8181/v1/config" >/dev/null 2>&1 && break; sleep 3
  done
  curl -s -m 4 "http://localhost:8181/v1/config" >/dev/null 2>&1 || die "Iceberg catalog did not come up on :8181 (check: $DKR logs iceberg-rest)"
  ICEBERG_URL="http://$(this_host):8181"
  bold "  Iceberg catalog up — cluster reaches it at $ICEBERG_URL"
}

# ---- create an S3 warehouse bucket here (awscli) ----------------------------
# GUARDRAIL 1 (co-location): the Iceberg warehouse (table metadata) MUST live in
# the SAME bucket as the source data. The gateway reads catalog metadata through
# its single source bucket (localhost:9000 fronts ZS3_SOURCE_BUCKET only); a
# warehouse in a *different* bucket makes every metadata read 500 → grain
# unsampleable → the MV author refuses. So when a data bucket is known we put the
# warehouse at s3://<data-bucket>/wh; only with no data bucket do we mint one.
standup_bucket(){
  command -v aws >/dev/null || die "awscli not installed — needed to create an S3 bucket. Install it, or pass an existing s3:// warehouse."
  aws sts get-caller-identity >/dev/null 2>&1 || die "AWS creds not working — run 'aws configure' (or set AWS_PROFILE), or pass an existing s3:// warehouse."
  local bkt="${ORIGIN_BUCKET:-blimp-wh-${CLUSTER_ID:-$(this_host | tr -d '.')}}"
  bold "creating/using S3 warehouse bucket s3://$bkt in $REGION"
  if [ "$REGION" = us-east-1 ]; then
    aws s3api create-bucket --bucket "$bkt" --region "$REGION" >/dev/null 2>&1 || true
  else
    aws s3api create-bucket --bucket "$bkt" --region "$REGION" \
      --create-bucket-configuration "LocationConstraint=$REGION" >/dev/null 2>&1 || true
  fi
  aws s3api head-bucket --bucket "$bkt" >/dev/null 2>&1 || die "could not create/access s3://$bkt"
  WAREHOUSE="s3://$bkt/wh"
  bold "  warehouse -> $WAREHOUSE  (co-located with data bucket $bkt)"
}

# ---- GUARDRAIL 2 (IAM): grant BOTH the gateway instance role and the Iceberg
# catalog principal read/write on the data+warehouse bucket. On a split like the
# SF1 test — data written by aws-cli, catalog registered by IAM user
# blimp-catalog-*, gateway reading via its EC2 role — any one of the three
# lacking access is a silent 403 at author time. Same-account/VPC only (we can
# discover the gateway role); external creds are granted by the customer bucket
# owner instead. Merges into any existing bucket policy, never clobbers.
grant_bucket_access(){
  local bkt="${1:?bucket}"
  command -v aws >/dev/null && aws sts get-caller-identity >/dev/null 2>&1 || {
    bold "  (skip bucket-policy grant — no AWS creds here; ensure the bucket owner grants the gateway role + catalog user s3:Get/Put/List)"; return 0; }
  local acct; acct=$(aws sts get-caller-identity --query Account --output text 2>/dev/null)
  # gateway instance role ARN (same account) — discover from the running gateway
  local role_arn=""
  local prof; prof=$(aws ec2 describe-instances --region "$CLUSTER_REGION" \
    --filters "Name=tag:Name,Values=cluster-${CLUSTER_ID}-zs3server" "Name=instance-state-name,Values=running" \
    --query 'Reservations[0].Instances[0].IamInstanceProfile.Arn' --output text 2>/dev/null)
  if [ -n "$prof" ] && [ "$prof" != None ]; then
    local pname="${prof##*/}"
    role_arn=$(aws iam get-instance-profile --instance-profile-name "$pname" \
      --query 'InstanceProfile.Roles[0].Arn' --output text 2>/dev/null)
  fi
  [ "$role_arn" = None ] && role_arn=""
  # Explicit override for the cases discovery cannot cover: cross-account, a
  # gateway not tagged cluster-<id>-zs3server, or (the case that bit us) a client
  # whose own IAM role lacks ec2:DescribeInstances / iam:GetInstanceProfile.
  [ -z "$role_arn" ] && role_arn="${GATEWAY_ROLE_ARN:-}"
  # principals: account root (covers the catalog IAM user + aws-cli writer in this
  # account) plus the gateway role explicitly (belt & suspenders if it's assumed).
  local princ="\"arn:aws:iam::${acct}:root\""
  [ -n "$role_arn" ] && princ="$princ, \"$role_arn\""
  bold "  granting s3 access on s3://$bkt to account $acct${role_arn:+ + gateway role}"
  # MERGE, don't clobber. This used to build a single-statement document and
  # put-bucket-policy it, which REPLACES the whole policy — so a second --setup
  # silently deleted every other statement on the bucket. Measured on
  # 2026-08-01: an operator-added grant for the gateway role (the only thing
  # making reads work) was wiped by a re-run, and the gateway went back to 403
  # with "no identity-based policy allows the s3:ListBucket action".
  #
  # Keep every statement that is not ours, replace only Sid BlimpSourceAccess.
  local existing; existing=$(aws s3api get-bucket-policy --bucket "$bkt" --query Policy --output text 2>/dev/null)
  local pol; pol=$(EXISTING="$existing" PRINC="$princ" BKT="$bkt" python3 - <<'PYEOF'
import json, os
princ = json.loads("[" + os.environ["PRINC"] + "]")
bkt = os.environ["BKT"]
ours = {
    "Sid": "BlimpSourceAccess", "Effect": "Allow",
    "Principal": {"AWS": princ},
    "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation"],
    "Resource": [f"arn:aws:s3:::{bkt}", f"arn:aws:s3:::{bkt}/*"],
}
doc = {"Version": "2012-10-17", "Statement": []}
raw = os.environ.get("EXISTING", "").strip()
if raw:
    try:
        prev = json.loads(raw)
        doc["Statement"] = [st for st in prev.get("Statement", []) if st.get("Sid") != "BlimpSourceAccess"]
    except Exception:
        pass  # unparseable policy: fall through to ours alone rather than fail the setup
doc["Statement"].append(ours)
print(json.dumps(doc))
PYEOF
)
  [ -n "$existing" ] && bold "  (merging into the bucket's existing policy — other statements are preserved)"
  if aws s3api put-bucket-policy --bucket "$bkt" --policy "$pol" >/dev/null 2>&1; then
    if [ -n "$role_arn" ]; then
      bold "  ✓ bucket policy applied to s3://$bkt (account + gateway role $role_arn)"
    else
      # A policy naming ONLY <acct>:root grants the gateway NOTHING: for
      # same-account access :root merely DELEGATES to IAM, so a role without its
      # own s3 allow still gets 403. Saying "✓ applied" here is how a broken
      # grant looked successful while every read failed 403 (2026-08-01).
      bold "  ! bucket policy applied to s3://$bkt, but the GATEWAY ROLE could not be discovered"
      bold "    (this client's IAM has no ec2:DescribeInstances / iam:GetInstanceProfile, or the"
      bold "     gateway is in another account). A policy naming only <account>:root does NOT grant"
      bold "     the gateway access — it delegates to IAM, and the gateway role has no s3 allow."
      bold "    Fix with either:"
      bold "      GATEWAY_ROLE_ARN=arn:aws:iam::<acct>:role/<gateway-role> ./blimp --setup"
      bold "      or have the bucket owner add that role as a Principal on s3://$bkt"
    fi
  else
    bold "  (could not set bucket policy on s3://$bkt — may already be owned cross-account; ensure the owner grants the gateway role + catalog user)"
  fi
}

# ---- auto-assess network mode: same-VPC (private) vs external cloud (public) --
# The ONE signal that matters: can THIS node reach the cluster gateway's PRIVATE
# IP? Yes → vpc mode (private IPs, IAM role, VPC S3 endpoint — no egress). No
# (non-AWS, cross-VPC, or cross-account) → external mode (stable DNS, explicit
# creds, public advertise). Sets MODE / GW_DEFAULT / ADVERTISE_DEFAULT / CREDS_HINT.
# ---- read-through cache: point the cluster router at THIS node's origin ------
# The Blimp node's router (:8088) is provisioned with its upstream set to the
# gateway itself (-s3-endpoint http://127.0.0.1:9000) and an EMPTY -cache-buckets.
# That makes it a degenerate pass-through: a client GET for an origin object is
# looked up on the gateway (which does not have it) and the evictor never starts
# ("[evict] disabled (buckets=0)"). Setup used to only PRINT the fix and call it
# optional, so the cache-miss→write / cache-hit→read legs had no path at all and
# every cache number was zero.
#
# Retarget it here, at setup, so the client can pull its data THROUGH the Blimp
# node and a miss actually fetches from this node's origin and writes into the
# eblobber-backed cache. Only the zus-router container is touched — the gateway
# itself is already wired live over /admin/source/configure and is NOT restarted.
wire_router_cache(){
  bold "== read-through cache: pointing the Blimp node's router at s3://$ORIGIN_BUCKET =="
  # ONE AUTHENTICATED POST. No ssh, no SSM, no docker on the Blimp node — the
  # client box has none of those, and the kit must not need them.
  #
  # The Router is provisioned by zs3-init BEFORE the customer's source is known:
  # it starts with -s3-endpoint pointing at the gateway itself and an EMPTY
  # -cache-buckets, so it is a pass-through whose evictor never ran
  # ("[evict] disabled (buckets=0)"). Those were start-flags, so the only way to
  # re-point it used to be recreating the container — impossible from here. The
  # Router now takes them at runtime on /admin/cache/config.
  local body resp
  body=$(HB_BKT="$ORIGIN_BUCKET" HB_EP="${S3_ENDPOINT:-}" HB_REG="$REGION" \
    HB_KEY="${S3_KEY:-}" HB_SEC="${S3_SECRET:-}" HB_NS="${NAMESPACE:-tpcds}" \
    python3 -c 'import json,os;print(json.dumps({"buckets":os.environ["HB_BKT"],"s3_endpoint":os.environ["HB_EP"],"s3_region":os.environ["HB_REG"],"s3_access_key":os.environ["HB_KEY"],"s3_secret_key":os.environ["HB_SEC"],"default_namespace":os.environ["HB_NS"]}))' 2>/dev/null)
  resp=$(curl -s -m 30 -X POST "http://$GW:8088/admin/cache/config" \
    -H "Authorization: Bearer zus-$CLUSTER_ID" -H "Content-Type: application/json" \
    -d "$body" 2>/dev/null || true)
  case "$resp" in
    *'"upstream"'*)
      echo "  ✓ router retargeted — $(printf '%s' "$resp" | python3 -c 'import json,sys;d=json.load(sys.stdin);print("upstream=%s buckets=%s ns=%s"%(d.get("upstream"),",".join(d.get("buckets") or []),d.get("default_ns")))' 2>/dev/null)" ;;
    *unauthorized*)
      echo "  ! router rejected the admin token — check CLUSTER_ID ($CLUSTER_ID)" ;;
    "")
      echo "  ! router :8088 unreachable from this node — the cache stays off and"
      echo "    blimp --storage's cache legs will read 0 objects." ;;
    *)
      echo "  ! router retarget failed: $(printf '%s' "$resp" | head -c 200)"
      echo "    (an older router image has no runtime cache config — it must be"
      echo "     re-pointed by the operator, or the image updated)" ;;
  esac
}

# ---- the object set the router cache test pulls through the Blimp node -------
# The customer's own tables are the wrong shape for this: at SF1 the whole origin
# is 24 single-parquet objects (~370 MB), so a read cannot parallelise and every
# number is per-request-latency bound rather than a measure of the cluster. So
# place a purpose-built set in the origin at setup time — it lands in THIS node's
# storage (the MinIO standup_data stood up, or the customer's own bucket), and
# `blimp --storage` then pulls it through the Blimp node's router: first pass
# misses (origin -> router -> blimp node = the cache-fill/write rate), second
# pass hits (served from the eblobber cache = the cache-read rate).
seed_router_cache_set(){
  # 10 GiB / 10 parts — MUST match run_router.sh's defaults, or --setup seeds a
  # set the storage leg then regenerates at a different size. See the sizing
  # rationale there: per-blobber shard share has to exceed per-blobber RAM or the
  # cache "hit" is served from the eblobbers' page cache.
  local pfx="${BENCH_PREFIX:-_blimp_cachebench}" gb="${BENCH_GB:-10}" parts="${BENCH_PARTS:-10}"
  [ "${gb:-0}" -gt 0 ] || return 0
  local ep=""; [ -n "${S3_ENDPOINT:-}" ] && ep="--endpoint-url $S3_ENDPOINT"
  local want=$(( gb * 1073741824 )) have
  # shellcheck disable=SC2086
  have=$(AWS_ACCESS_KEY_ID="${S3_KEY:-${AWS_ACCESS_KEY_ID:-}}" AWS_SECRET_ACCESS_KEY="${S3_SECRET:-${AWS_SECRET_ACCESS_KEY:-}}" \
         aws s3 ls "s3://$ORIGIN_BUCKET/$pfx/" --recursive --region "$REGION" $ep 2>/dev/null | awk '{s+=$3} END{print s+0}')
  if [ "${have:-0}" -ge "$want" ]; then
    bold "  ✓ router cache test set already in s3://$ORIGIN_BUCKET/$pfx/ ($(awk -v b="$have" 'BEGIN{printf "%.1f",b/1073741824}') GiB)"
    return 0
  fi
  bold "  placing a ${gb} GB router cache test set in s3://$ORIGIN_BUCKET/$pfx/ ($parts parts)"
  local part_mb=$(( gb * 1024 / parts )) gen i=0
  gen=$(mktemp -d /var/tmp/blimp-bench.XXXXXX) || return 0
  while [ "$i" -lt "$parts" ]; do
    i=$((i+1))
    # /dev/urandom, not /dev/zero: zeros are trivially compressible and any layer
    # that compresses would flatter every number downstream.
    dd if=/dev/urandom of="$gen/part-$i.bin" bs=1M count="$part_mb" 2>/dev/null &
    [ $((i % 4)) -eq 0 ] && wait
  done
  wait
  # shellcheck disable=SC2086
  AWS_ACCESS_KEY_ID="${S3_KEY:-${AWS_ACCESS_KEY_ID:-}}" AWS_SECRET_ACCESS_KEY="${S3_SECRET:-${AWS_SECRET_ACCESS_KEY:-}}" \
    aws s3 cp "$gen/" "s3://$ORIGIN_BUCKET/$pfx/" --recursive --region "$REGION" $ep --only-show-errors \
    || echo "  ! could not upload the router cache test set to s3://$ORIGIN_BUCKET/$pfx/"
  rm -rf "$gen"
  bold "  ✓ router cache test set in place — blimp --storage reads it through http://$GW:8088"
}

assess_mode(){
  MODE=external; GW_PRIV=""; GW_PUB=""
  local imds="http://169.254.169.254/latest/meta-data" tok
  tok=$(curl -s -m 2 -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 120" 2>/dev/null)
  local H=(); [ -n "$tok" ] && H=(-H "X-aws-ec2-metadata-token: $tok")
  CLIENT_PRIV=$(curl -s -m 2 "${H[@]}" "$imds/local-ipv4" 2>/dev/null)
  CLIENT_PUB=$(curl -s -m 2 "${H[@]}" "$imds/public-ipv4" 2>/dev/null)
  # discover the cluster gateway's private IP (needs aws CLI + creds + a running gw)
  if command -v aws >/dev/null && aws sts get-caller-identity >/dev/null 2>&1; then
    read -r GW_PRIV GW_PUB <<<"$(aws ec2 describe-instances --region "$CLUSTER_REGION" \
      --filters "Name=tag:Name,Values=cluster-${CLUSTER_ID}-zs3server" "Name=instance-state-name,Values=running" \
      --query 'Reservations[0].Instances[0].[PrivateIpAddress,PublicIpAddress]' --output text 2>/dev/null)"
    [ "$GW_PRIV" = None ] && GW_PRIV=""; [ "$GW_PUB" = None ] && GW_PUB=""
  fi
  # FALLBACK when the EC2 lookup is unavailable. Discovery above needs
  # ec2:DescribeInstances, which a client's own instance role often lacks — and
  # when it silently returned nothing, GW_PRIV stayed empty, the probe below
  # never ran, MODE fell to external, and the node advertised its PUBLIC address
  # to a gateway that can only reach it privately. Every catalog read then hung
  # until timeout (cluster 1785550395356, 2026-08-01). So: if the operator
  # already told us the gateway address and it is a private one, probe THAT.
  if [ -z "$GW_PRIV" ] && [ -n "${GW:-}" ]; then
    case "$GW" in
      10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) GW_PRIV="$GW" ;;
    esac
  fi
  if [ -z "$GW_PRIV" ]; then
    bold "  ! gateway private IP not discoverable (this client's IAM may lack ec2:DescribeInstances)."
    bold "    Assuming EXTERNAL mode. If this node IS in the cluster's VPC, re-run with"
    bold "    GW=<gateway-private-ip> so the catalog is advertised on a reachable address."
  fi
  # authoritative probe: reach the gateway PRIVATE IP (covers same-VPC AND peered)
  if [ -n "$GW_PRIV" ] && [ "$(curl -s -m 3 -o /dev/null -w '%{http_code}' "http://$GW_PRIV:9000/minio/health/live" 2>/dev/null)" = 200 ]; then
    MODE=vpc
  fi
  # CREDENTIAL domain is decided by ACCOUNT, not network reachability. If the
  # describe-instances above FOUND the gateway, this node's AWS identity is in
  # the SAME account → the IAM role reaches S3 (cross-REGION is fine; S3 access
  # is account-scoped), so NO keys are needed even when the gateway's private IP
  # is unreachable (different region / AZ / unpeered VPC). Keys are required only
  # when the gateway isn't discoverable from here — a different account or a
  # non-AWS host. SAME_ACCT drives whether --setup prompts for keys.
  SAME_ACCT=0; { [ -n "$GW_PRIV" ] || [ -n "$GW_PUB" ]; } && SAME_ACCT=1
  if [ "$MODE" = vpc ]; then
    GW_DEFAULT="$GW_PRIV"; ADVERTISE_DEFAULT="$CLIENT_PRIV"; CREDS_HINT="blank (IAM instance role — same VPC/account)"
  else
    # External NETWORK path (public DNS + advertise this node publicly)…
    GW_DEFAULT="${GW_PUB:-zus-$CLUSTER_ID-0.zus.network}"
    ADVERTISE_DEFAULT="${CLIENT_PUB:-$(curl -s -m3 https://checkip.amazonaws.com 2>/dev/null | tr -d '[:space:]')}"
    if [ "$SAME_ACCT" = 1 ]; then
      # …but SAME account → still key-free (cross-region AWS-internal).
      CREDS_HINT="blank (IAM instance role — same account, cross-region)"
    else
      CREDS_HINT="explicit S3 keys (external / cross-account)"
    fi
  fi
  bold "network assessment → MODE=$MODE (gateway private ${GW_PRIV:-unknown} reachable: $([ "$MODE" = vpc ] && echo yes || echo no)$([ "$MODE" != vpc ] && [ "$SAME_ACCT" = 1 ] && echo ', same account — cross-region')"
  echo "  gateway → $GW_DEFAULT · advertise this node as → ${ADVERTISE_DEFAULT:-<set ADVERTISE_HOST>} · S3 creds → $CREDS_HINT"
}

# ---- install the prerequisites this kit needs (idempotent) ------------------
# So a fresh node needs nothing pre-installed: docker (stand up the catalog),
# python venv + pyiceberg/pyarrow/boto3 (register tables + CDC appends), unzip
# (DuckDB CLI for the query suite), aws CLI (bucket create/grant + SSM). apt
# systems get the packages installed; anything already present is skipped; a
# non-apt host just gets a clear per-tool hint instead of a hard failure. Set
# BLIMP_SKIP_DEPS=1 to bypass (offline / hardened hosts). The venv path is
# recorded to the wiring (BLIMP_PY) so the test scripts reuse it.
ensure_deps(){
  [ "${BLIMP_SKIP_DEPS:-0}" = 1 ] && return 0
  bold "== checking prerequisites =="
  if command -v apt-get >/dev/null; then
    local want=() ; command -v docker >/dev/null || want+=(docker.io)
    command -v unzip  >/dev/null || want+=(unzip)
    python3 -c 'import ensurepip' 2>/dev/null || want+=(python3-venv)
    command -v aws >/dev/null || command -v snap >/dev/null || want+=(awscli)
    if [ "${#want[@]}" -gt 0 ]; then
      bold "  installing: ${want[*]}"
      sudo apt-get update -qq 2>/dev/null || true
      sudo apt-get install -y -qq "${want[@]}" 2>&1 | tail -1 || true
    fi
    command -v docker >/dev/null && sudo systemctl enable --now docker >/dev/null 2>&1 || true
    # aws CLI: prefer snap (newer) when apt's awscli is absent
    command -v aws >/dev/null || { command -v snap >/dev/null && sudo snap install aws-cli --classic >/dev/null 2>&1 || true; }
  elif command -v dnf >/dev/null || command -v yum >/dev/null; then
    # RPM hosts — Amazon Linux 2023, RHEL, Fedora, Rocky. Without this branch the
    # kit printed a hint and then died at the catalog step ("docker not
    # available"), which contradicts the README's "you need nothing
    # pre-installed" on the single most likely AWS AMI (AL2023, 2026-08-01).
    local PKG; PKG=$(command -v dnf >/dev/null && echo dnf || echo yum)
    local want=()
    command -v docker >/dev/null || want+=(docker)
    command -v unzip  >/dev/null || want+=(unzip)
    python3 -c 'import ensurepip' 2>/dev/null || want+=(python3-pip)
    if [ "${#want[@]}" -gt 0 ]; then
      bold "  installing: ${want[*]}"
      sudo "$PKG" install -y -q "${want[@]}" 2>&1 | tail -1 || true
    fi
    if command -v docker >/dev/null; then
      sudo systemctl enable --now docker >/dev/null 2>&1 || true
      # AL2023 does not add the invoking user to the docker group, so every
      # later `docker` call would need sudo. Add it AND fall back to sudo for
      # this session, since a new group only applies to a new login.
      sudo usermod -aG docker "$(id -un)" >/dev/null 2>&1 || true
      # a fresh group needs a new login, so this session keeps using sudo — the
      # catalog step already falls back to `sudo docker` when `docker info` fails.
    fi
    command -v aws >/dev/null || sudo "$PKG" install -y -q awscli 2>&1 | tail -1 || true
  else
    command -v docker >/dev/null || echo "  ! docker not found (needed to stand up the catalog) — install it or pass an existing Iceberg URL"
    command -v aws    >/dev/null || echo "  ! aws CLI not found (needed to create/grant the S3 bucket) — install it or pass an existing warehouse"
  fi
  # python venv with the Iceberg libs (register_tpcds_tables.py / seed_tpcds.py)
  BLIMP_PY="${BLIMP_PY:-$HOME/.blimp_venv/bin/python3}"
  if ! "$BLIMP_PY" -c 'import pyiceberg' 2>/dev/null; then
    if command -v python3 >/dev/null && python3 -c 'import ensurepip' 2>/dev/null; then
      bold "  creating python venv + pyiceberg (one-time)…"
      python3 -m venv "$HOME/.blimp_venv" 2>/dev/null \
        && "$HOME/.blimp_venv/bin/pip" install -q --upgrade pip 2>/dev/null \
        && "$HOME/.blimp_venv/bin/pip" install -q "pyiceberg[s3fs]" pyarrow boto3 2>&1 | tail -1
      BLIMP_PY="$HOME/.blimp_venv/bin/python3"
    fi
  fi
  "$BLIMP_PY" -c 'import pyiceberg' 2>/dev/null \
    && bold "  ✓ deps ready (python: $BLIMP_PY)" \
    || { BLIMP_PY=python3; echo "  ! pyiceberg unavailable — register/CDC steps need: pip install 'pyiceberg[s3fs]' pyarrow boto3"; }
  export BLIMP_PY
}

cmd_setup(){
  bold "== blimp --setup — connect a Blimp cluster to this node's data =="
  ensure_deps
  echo
  REGION=$(ask REGION "AWS region" "ap-south-1")
  # REGION is overloaded: it is the Blimp CLUSTER's AWS region here, but
  # standup_data.sh REASSIGNS it to the ORIGIN's S3 region (us-east-1 for the
  # MinIO source it stands up on this box). Every EC2/SSM lookup for the gateway
  # must keep using the cluster's region, so pin it now, before that happens.
  CLUSTER_REGION="${CLUSTER_REGION:-$REGION}"; export CLUSTER_REGION
  CLUSTER_ID=$(ask CLUSTER_ID "Blimp cluster id (from blimp.software)")
  [ -n "$CLUSTER_ID" ] || die "CLUSTER_ID is required (the Blimp cluster to connect)"
  # Zero-touch: probe the private gateway path and pick vpc vs external mode, then
  # derive the gateway address, the address we advertise this node on, and the
  # creds default from it. Every value stays overridable via the prompts/env.
  echo; assess_mode
  GW=$(ask GW "Blimp gateway address" "$GW_DEFAULT")
  # this_host() advertises ADVERTISE_HOST to the cluster; default it from the mode
  # (private IP in vpc mode, public IP/DNS in external mode).
  [ -n "${ADVERTISE_HOST:-}" ] || ADVERTISE_HOST="$ADVERTISE_DEFAULT"
  export ADVERTISE_HOST
  NAMESPACE=$(ask NAMESPACE "Iceberg namespace" "tpcds")

  # --- Iceberg REST catalog: BYO or stand up ---
  echo; bold "Iceberg REST catalog"
  ICEBERG_URL=$(ask ICEBERG_URL "  Existing Iceberg REST URL (blank = stand one up here)")

  # --- S3 endpoint + data bucket + warehouse ---
  # Two scenarios: (a) you HAVE data — give the bucket; (b) you have NONE — leave
  # it blank and we generate a real TPC-DS SF1 (~1 GB) source for you: an S3 bucket
  # in THIS box's region (AWS), or a MinIO server on this box (non-AWS). Either way
  # standup_data emits ORIGIN_BUCKET/WAREHOUSE/S3_ENDPOINT/keys/REGION, and we
  # auto-register the 24 tables after the catalog is up (DATA_GENERATED gate).
  echo; bold "S3 / warehouse"
  DATA_GENERATED=0
  ORIGIN_BUCKET=$(ask ORIGIN_BUCKET "  Data bucket (blank = generate a TPC-DS SF1 source here)")
  if [ -z "$ORIGIN_BUCKET" ]; then
    bold "  no data bucket given — generating a TPC-DS SF1 (~1 GB) source"
    local gen; gen=$(REGION="$REGION" CLUSTER_ID="$CLUSTER_ID" ADVERTISE_HOST="${ADVERTISE_HOST:-}" \
      bash "$HERE/standup_data.sh") || die "SF1 data standup failed"
    eval "$gen"                      # sets ORIGIN_BUCKET WAREHOUSE S3_ENDPOINT [S3_KEY S3_SECRET] REGION
    DATA_GENERATED=1
    bold "  SF1 source → bucket $ORIGIN_BUCKET · endpoint $S3_ENDPOINT · region $REGION"
  else
    S3_ENDPOINT=$(ask S3_ENDPOINT "  S3 endpoint (blank = AWS S3 in $REGION)" "https://s3.${REGION}.amazonaws.com")
  fi
  # Warehouse (Iceberg metadata) co-locates INSIDE the data bucket (guardrail 1).
  WAREHOUSE=$(ask WAREHOUSE "  Warehouse s3://bucket/prefix (blank = s3://<data-bucket>/wh)" \
    "${ORIGIN_BUCKET:+s3://$ORIGIN_BUCKET/wh}")
  # Guardrail 1 enforcement: warn loudly if warehouse and data bucket diverge — a
  # split makes the gateway's catalog-metadata reads 500 and the MV author refuse.
  local wh_bkt; wh_bkt=$(echo "$WAREHOUSE" | sed -E 's#^s3://([^/]+).*#\1#')
  if [ -n "$ORIGIN_BUCKET" ] && [ "$wh_bkt" != "$ORIGIN_BUCKET" ]; then
    printf '\033[33m  ⚠ warehouse bucket (%s) ≠ data bucket (%s). The gateway serves catalog\n    metadata only from the data bucket; a split will make MV authoring fail.\n    Recommended: use s3://%s/wh. Continue anyway? [y/N] \033[0m' "$wh_bkt" "$ORIGIN_BUCKET" "$ORIGIN_BUCKET" >&2
    local yn; read -r yn </dev/tty || true
    [ "${yn:-N}" = y ] || [ "${yn:-N}" = Y ] || WAREHOUSE="s3://$ORIGIN_BUCKET/wh"
  fi
  # Explicit S3 keys are REQUIRED only when this node's AWS identity can't reach
  # the bucket via a role — i.e. a DIFFERENT account or a non-AWS host. We ask
  # ONLY then. vpc mode (same VPC) and external-but-SAME-account (cross-region /
  # unpeered VPC) both use the IAM instance role, so no prompt — asking-then-blank
  # was noise and a stray "none" poisons the catalog. A pre-set S3_KEY still wins.
  if { [ "${MODE:-external}" = external ] && [ "${SAME_ACCT:-0}" != 1 ]; } || [ -n "${S3_KEY:-}" ]; then
    S3_KEY=$(ask S3_KEY "  S3 access key ($CREDS_HINT)")
    S3_SECRET=$(ask S3_SECRET "  S3 secret key (required cross-account)")
  fi
  # Treat a blank / whitespace / literal "none" as "use the IAM role" — never
  # hand a bogus key to the catalog or gateway.
  case "$(printf '%s' "${S3_KEY:-}" | tr -d '[:space:]')" in ""|none|None|NONE) S3_KEY=""; S3_SECRET="";; esac

  # Guardrail 2: grant the gateway role + catalog principal access to the bucket
  # (same-account only; no-op with a clear hint when we can't).
  [ -n "$ORIGIN_BUCKET" ] && grant_bucket_access "$ORIGIN_BUCKET"

  # stand up the catalog now that WAREHOUSE is known
  [ -n "$ICEBERG_URL" ] || standup_iceberg

  # Scenario (b): we generated an SF1 source — register its 24 tables into the
  # catalog now (BYO-data users register their own with register_tpcds_tables.py).
  # register runs LOCALLY, so it reaches the catalog + MinIO on localhost.
  if [ "${DATA_GENERATED:-0}" = 1 ]; then
    # IDEMPOTENT: registration is add_files against the catalog, so re-running it
    # on an already-populated namespace is wasted work that ends in a warning.
    local have; have=$(curl -s -m 8 "http://localhost:8181/v1/namespaces/$NAMESPACE/tables" 2>/dev/null \
                       | grep -o '"name"' | wc -l | tr -d ' ')
    if [ "${have:-0}" -ge 24 ]; then
      bold "  ✓ $NAMESPACE already has $have tables registered — skipping registration"
    else
    bold "registering the 24 TPC-DS SF1 tables into the catalog"
    local reg_ep=""; case "$S3_ENDPOINT" in *:9000*) reg_ep="--s3-endpoint http://localhost:9000";; esac
    AWS_ACCESS_KEY_ID="${S3_KEY:-${AWS_ACCESS_KEY_ID:-}}" AWS_SECRET_ACCESS_KEY="${S3_SECRET:-${AWS_SECRET_ACCESS_KEY:-}}" \
      "${BLIMP_PY:-python3}" "$HERE/register_tpcds_tables.py" --catalog http://localhost:8181 \
      --warehouse "$WAREHOUSE" --source-bucket "$ORIGIN_BUCKET" --region "$REGION" \
      --namespace "$NAMESPACE" $reg_ep 2>&1 | tail -3 \
      || bold "  (auto-register had issues — re-run register_tpcds_tables.py manually)"
    fi
  fi

  save_env

  # --- how the Blimp cluster connects to this source ---
  # Only show the S3-key lines when keys are actually in play (external mode).
  # In vpc mode omit them entirely — the gateway uses its IAM role, so there is
  # no "secret you entered" to echo.
  local cred_lines=""
  if [ -n "${S3_KEY:-}" ]; then
    cred_lines="    S3 access key    : $S3_KEY
    S3 secret key    : •••• (the secret you entered above)"
  else
    cred_lines="    S3 credentials   : none — gateway reads via its IAM instance role"
  fi
  # Wire the cluster DIRECTLY over the authenticated admin API (no SSH):
  # POST /admin/source/configure sets the gateway's live source env — takes
  # effect on the next query, no restart. Bearer = zus-<CLUSTER_ID>. Falls
  # back to the manual UI/SSH instructions below when the endpoint is absent
  # (pre-2026-07-27 gateway image) or unreachable.
  if [ -n "${GW:-}" ] && [ -n "${CLUSTER_ID:-}" ]; then
    bold "== wiring the cluster over the admin API (no SSH) =="
    # s3_endpoint MUST be sent. The gateway's API documents its default as
    # https://s3.<region>.amazonaws.com, and this body used to OMIT the field —
    # so a non-AWS origin (the MinIO standup_data puts on this box) was wired as
    # real AWS and every DuckDB read of the source 403'd:
    #   [duckdb-prelude][source-env] src_endpoint="https://s3.us-east-1.amazonaws.com"
    #   HTTP GET error on 'https://blimp-sf1.s3.us-east-1.amazonaws.com/...' (403)
    #
    # ZS3_SOURCE_VIA_ROUTER=0 — SENT EXPLICITLY, NEVER OMITTED. With it on, the
    # gateway gives the source bucket a DuckDB secret scoped to the Router, and
    # the Router read-through-CACHES every source object it pulls into the
    # eblobbers. Source data must NOT enter the cache: the cache is for the
    # workload, and filling it with source scans both pollutes it and pushes the
    # allocation toward the evictor's watermark. Off by default; VIA_ROUTER=1 in
    # the environment is the deliberate opt-in.
    HOOK_BODY=$(HB_IRC="$ICEBERG_URL" HB_WH="$WAREHOUSE" HB_NS="$NAMESPACE" \
      HB_BKT="$ORIGIN_BUCKET" HB_KEY="${S3_KEY:-}" HB_SEC="${S3_SECRET:-}" HB_REG="$REGION" \
      HB_EP="${S3_ENDPOINT:-}" HB_VR="${VIA_ROUTER:-0}" HB_RB="${ROUTER_BASE:-}" \
      python3 -c 'import json,os;b={"source":"customer","iceberg_url":os.environ["HB_IRC"],"warehouse":os.environ["HB_WH"],"namespace":os.environ["HB_NS"],"bucket":os.environ["HB_BKT"],"s3_endpoint":os.environ["HB_EP"],"s3_key":os.environ["HB_KEY"],"s3_secret":os.environ["HB_SEC"],"s3_region":os.environ["HB_REG"],"via_router":os.environ.get("HB_VR")=="1"};b.update({"router_base":os.environ["HB_RB"]} if os.environ.get("HB_VR")=="1" and os.environ.get("HB_RB") else {});print(json.dumps(b))' 2>/dev/null)
    HOOK_RESP=$(curl -s -m 30 -X POST "http://$GW:9000/admin/source/configure" \
      -H "Authorization: Bearer zus-$CLUSTER_ID" -H "Content-Type: application/json" \
      -d "$HOOK_BODY" || true)
    case "$HOOK_RESP" in
      *'"status": "ok"'*|*'"status":"ok"'*)
        bold "  ✓ cluster wired: source=customer ns=$NAMESPACE bucket=$ORIGIN_BUCKET (live, no restart)"
        echo "    (read-through cache retarget is optional — see hookup_cluster_source.sh)";;
      *)
        echo "  ! API wiring unavailable ($(printf %s "$HOOK_RESP" | head -c 120)) — use the UI/manual steps below";;
    esac
  fi
  echo; bold "================= POINT THE BLIMP CLUSTER AT THIS SOURCE ================="
  cat <<OUT
  In the cluster UI → Query Optimizer → Production (BYO Iceberg source):
    Iceberg REST URL : $ICEBERG_URL
    Warehouse        : $WAREHOUSE
    S3 endpoint      : $S3_ENDPOINT
$cred_lines
    Namespace        : $NAMESPACE

  Then push data changes and refresh MVs incrementally with:
    curl -X POST http://$GW:9000/admin/source/snapshot_changed \\
      -H "Authorization: Bearer zus-$CLUSTER_ID" -H "Content-Type: application/json" \\
      -d '{"namespace":"$NAMESPACE","table":"<table>","trigger":"customer"}'

  Make sure the cluster gateway can reach this node on :8181 (security group / firewall).
==========================================================================
OUT
  # ---- finish the job HERE, once ------------------------------------------
  # Everything below used to be discovered LATER, one item per 25-minute suite
  # run: the gateway S3 keys (warp/mlperf silently measured nothing without
  # them), the benchmark tools (mount-s3 was apt-only so mlperf never ran on an
  # rpm host), the router's cache (never enabled, so every cache leg read zero
  # objects). Four full runs to learn four things. Do them all now, at setup,
  # so a customer types ONE command once and every suite works first time.
  bold "== finishing setup: credentials + tools =="

  # 1. Gateway S3 credentials. NOT the source-bucket keys — vpc mode leaves those
  #    blank on purpose (IAM instance role), but the gateway's own S3 endpoint
  #    authenticates by key and warp/mlperf/cache-mp-s3 are useless without it.
  # Auto-fetched from the gateway itself (GET /admin/credentials, same Bearer
  # zus-<CLUSTER_ID> every other admin call uses) — no UI copy-paste, no
  # interactive prompt. Idempotent: safe to call every --setup run; an
  # already-set GW_AK/GW_SK wins and skips the call, and a gateway image older
  # than this endpoint (404/unreachable) just leaves them unset, same as
  # before, with warp/mlperf/cache-mp-s3 skipped.
  if [ -z "${GW_AK:-}" ] || [ -z "${GW_SK:-}" ]; then
    resp=$(curl -s -m 10 "http://$GW:9000/admin/credentials" -H "Authorization: Bearer zus-$CLUSTER_ID" 2>/dev/null)
    fetched_ak=$(printf '%s' "$resp" | python3 -c 'import json,sys
try:
  d=json.load(sys.stdin)
  print(d.get("s3_access_key","") if d.get("status")=="ok" else "")
except Exception: print("")' 2>/dev/null)
    fetched_sk=$(printf '%s' "$resp" | python3 -c 'import json,sys
try:
  d=json.load(sys.stdin)
  print(d.get("s3_secret_key","") if d.get("status")=="ok" else "")
except Exception: print("")' 2>/dev/null)
    if [ -n "$fetched_ak" ] && [ -n "$fetched_sk" ]; then
      GW_AK="$fetched_ak"; GW_SK="$fetched_sk"
      echo "  ✓ gateway S3 credentials auto-fetched from GET /admin/credentials"
    fi
  fi
  if [ -n "${GW_AK:-}" ] && [ -n "${GW_SK:-}" ]; then
    sed -i.bak '/^GW_AK=/d;/^GW_SK=/d' "$ENVF" 2>/dev/null || true
    printf 'GW_AK=%s\nGW_SK=%s\n' "$GW_AK" "$GW_SK" >> "$ENVF"
    rm -f "$ENVF.bak"
    echo "  ✓ gateway S3 credentials saved to $ENVF"
  else
    echo "  ! no gateway S3 credentials — warp, mlperf and cache-mp-s3 will be skipped."
    echo "    Add GW_AK= / GW_SK= to $ENVF later and re-run; nothing else needs redoing."
  fi

  # 2. Benchmark tools, up front. They take minutes to install and used to be
  #    installed at the START of --storage, so a failure cost a whole run.
  if [ "${BLIMP_SKIP_DEPS:-0}" != "1" ]; then
    ensure_storage_tools
    ensure_acid_tools || true   # porcupine ACID checker (Go build); non-fatal
  fi

  # 3. Read-through cache. The router only caches buckets named in its
  #    -cache-buckets flag, and setup never set it — so on every cluster the
  #    router ran as a pass-through and the cache legs measured nothing. Report
  #    it here, at setup, instead of after a 25-minute benchmark.
  wire_router_cache
  seed_router_cache_set

  echo; bold "setup done — everything is wired. Validate with:  blimp --query    (and  blimp --storage )"
}

# preflight — verify EVERY prerequisite in seconds, before any long benchmark,
# and report them ALL at once.
#
# This exists because the suites checked prerequisites lazily: each ~25-minute
# run died on the next missing thing, so four runs were burned discovering four
# problems that a ten-second check would have listed together. Fail fast, fail
# complete, and name the fix for each.
preflight(){
  local need_gw_creds="${1:-0}" need_tools="${2:-0}" problems=0
  bold "== preflight =="
  if ! curl -s -o /dev/null -m 10 "http://$GW:9000/minio/health/live" 2>/dev/null; then
    echo "  ✗ gateway $GW:9000 unreachable — check the security group / GW= in $ENVF"
    problems=$((problems+1))
  else
    echo "  ✓ gateway reachable"
  fi
  if [ "$need_gw_creds" = "1" ]; then
    if [ -z "${GW_AK:-}" ] || [ -z "${GW_SK:-}" ]; then
      echo "  ✗ gateway S3 credentials missing (GW_AK/GW_SK in $ENVF)"
      echo "    → warp, mlperf and cache-mp-s3 cannot run. Get them from the Blimp UI."
      problems=$((problems+1))
    else
      echo "  ✓ gateway S3 credentials present"
    fi
  fi
  if [ "$need_tools" = "1" ]; then
    local miss=""
    command -v warp     >/dev/null || miss="$miss warp"
    command -v fio      >/dev/null || miss="$miss fio"
    command -v mount-s3 >/dev/null || miss="$miss mount-s3"
    [ -x /opt/dlio/venv_mlperf/bin/dlio_benchmark ] || miss="$miss dlio"
    if [ -n "$miss" ]; then
      echo "  ✗ missing benchmark tools:$miss  → run 'blimp --setup' (installs them)"
      problems=$((problems+1))
    else
      echo "  ✓ benchmark tools present (warp fio mount-s3 dlio)"
    fi
  fi
  if [ "$problems" -gt 0 ]; then
    die "$problems prerequisite(s) missing — fix the above and re-run. Nothing was benchmarked, so no time was wasted."
  fi
  echo "  all prerequisites met"
}

# ---- tests: source the saved wiring, then hand off to the suites -------------
# No wiring yet? Offer to run --setup right here (interactive terminals only)
# instead of just erroring — a first-time user can type `blimp --query` and be
# walked through setup, then the test runs. Non-interactive callers still die
# with the clear message.
need_env(){
  if [ ! -f "$ENVF" ]; then
    if [ -t 0 ] || [ -e /dev/tty ]; then
      printf 'No wiring yet. Run blimp --setup now? [Y/n] ' >&2
      local yn; read -r yn </dev/tty 2>/dev/null || yn=n
      case "${yn:-Y}" in n|N) die "run 'blimp --setup' first (or set BLIMP_ENV)";; esac
      cmd_setup
    else
      die "no wiring yet — run 'blimp --setup' first (or set BLIMP_ENV)."
    fi
  fi
  # shellcheck disable=SC1090
  . "$ENVF"
  GW="${GW:-${GATEWAY:-}}"; export GW GATEWAY="$GW"
}

# ensure_storage_tools — the --storage suite's benchmark tools, installed
# self-contained like ensure_deps: warp (pinned ≥1.1.4 — older warp's output
# format parses as blank numbers), fio, and mount-s3 + dlio for mlperf.
# BLIMP_SKIP_DEPS=1 opts out on hardened/offline hosts.
ensure_storage_tools(){
  [ "${BLIMP_SKIP_DEPS:-0}" = 1 ] && return 0
  bold "== checking storage-bench tools =="
  # warp: pin v1.1.4 (parser-compatible). Replace older installs.
  local wv; wv=$(warp --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  if [ "$wv" != "1.1.4" ]; then
    bold "  installing warp v1.1.4 (found: ${wv:-none})…"
    local arch; arch=$(uname -m); [ "$arch" = aarch64 ] && arch=arm64 || arch=x86_64
    curl -fsSL "https://github.com/minio/warp/releases/download/v1.1.4/warp_Linux_${arch}.tar.gz" \
      -o /tmp/warp.tgz && tar xzf /tmp/warp.tgz -C /tmp warp \
      && sudo install /tmp/warp /usr/local/bin/warp && rm -f /tmp/warp.tgz /tmp/warp \
      || echo "  ! warp install failed — warp sections will be skipped"
  fi
  command -v fio >/dev/null || {
    bold "  installing fio…"
    if command -v apt-get >/dev/null; then sudo apt-get install -y -qq fio 2>&1 | tail -1 || true
    elif command -v yum >/dev/null; then sudo yum install -y -q fio 2>&1 | tail -1 || true; fi
  }
  # mount-s3 — needed for BOTH the mlperf read path and the cache-mp-s3 leg.
  # This was apt-ONLY, so on an rpm host (AL2023, the default Amazon Linux client)
  # the whole block was skipped silently: `mount-s3: missing`, cache-mp-s3 reported
  # `n/a` on every run, and mlperf never ran at all. Mountpoint ships an .rpm too.
  command -v mount-s3 >/dev/null || {
    bold "  installing mount-s3 (mlperf + cache-mp-s3 read path)…"
    local arch pkg url out; arch=$(uname -m)
    if command -v apt-get >/dev/null; then pkg=deb
    elif command -v dnf >/dev/null || command -v yum >/dev/null; then pkg=rpm
    fi
    if [ -n "${pkg:-}" ]; then
      url="https://s3.amazonaws.com/mountpoint-s3-release/latest/${arch}/mount-s3.${pkg}"
      if out=$(curl -fsSL "$url" -o "/tmp/mount-s3.$pkg" 2>&1); then
        case "$pkg" in
          deb) out=$(sudo apt-get install -y -qq "/tmp/mount-s3.deb" 2>&1) ;;
          rpm) out=$(sudo dnf install -y -q "/tmp/mount-s3.rpm" 2>&1 \
                  || sudo yum install -y -q "/tmp/mount-s3.rpm" 2>&1) ;;
        esac
      fi
      rm -f "/tmp/mount-s3.$pkg"
      # Print the REASON. Swallowing it is why this sat broken: the summary said
      # "missing" and the operator had nothing to act on.
      command -v mount-s3 >/dev/null || {
        echo "  ! mount-s3 install failed ($url) — mlperf + cache-mp-s3 will be skipped"
        printf '%s\n' "$out" | tail -3 | sed 's/^/    | /'
      }
    else
      echo "  ! no apt/dnf/yum — cannot install mount-s3; mlperf + cache-mp-s3 will be skipped"
    fi
  }
  # dlio imports mpi4py at startup, which dlopen()s a real MPI runtime. Without
  # one it dies with "RuntimeError: cannot load MPI library" during dataset
  # GENERATION, so mlperf produced no numbers at all even with dlio installed
  # (AL2023, 2026-08-01) — and `mpirun` is required for accel>1 on top of that.
  # Amazon Linux ships it as openmpi/openmpi-devel; Debian as openmpi-bin +
  # libopenmpi-dev. Neither puts it on PATH/LD_LIBRARY_PATH — run_cluster.sh
  # prepends /usr/lib64/openmpi/{bin,lib} itself.
  # `ls a b` exits non-zero when EITHER path is missing, so the old check always
  # claimed MPI was absent — it reinstalled every run and then reported failure
  # even on a host where OpenMPI was already installed and working.
  if ! { [ -x /usr/lib64/openmpi/bin/mpirun ] || [ -x /usr/bin/mpirun ] || command -v mpirun >/dev/null; }; then
    bold "  installing openmpi (dlio/mlperf needs an MPI runtime)…"
    if command -v dnf >/dev/null; then sudo dnf install -y -q openmpi openmpi-devel >/dev/null 2>&1
    elif command -v yum >/dev/null; then sudo yum install -y -q openmpi openmpi-devel >/dev/null 2>&1
    elif command -v apt-get >/dev/null; then sudo apt-get install -y -qq openmpi-bin libopenmpi-dev >/dev/null 2>&1; fi
    { [ -x /usr/lib64/openmpi/bin/mpirun ] || [ -x /usr/bin/mpirun ] || command -v mpirun >/dev/null; } \
      || echo "  ! openmpi install failed — mlperf will fail with 'cannot load MPI library'"
  fi
  # NFS client. The gateway exports its namespace over NFS4 and both the fio leg
  # and mlperf's data generation write through it — but nothing installed the
  # client, so `mount -t nfs4` failed with "bad option; you might need a
  # /sbin/mount.nfs4 helper program", mlperf silently generated its dataset onto
  # the LOCAL disk under the mountpoint, and the write number measured the client
  # box instead of the cluster.
  if [ ! -x /sbin/mount.nfs4 ] && [ ! -x /usr/sbin/mount.nfs4 ]; then
    bold "  installing the NFS client (fio + mlperf write through the gateway's NFS export)…"
    if command -v dnf >/dev/null; then sudo dnf install -y -q nfs-utils >/dev/null 2>&1
    elif command -v yum >/dev/null; then sudo yum install -y -q nfs-utils >/dev/null 2>&1
    elif command -v apt-get >/dev/null; then sudo apt-get install -y -qq nfs-common >/dev/null 2>&1; fi
    { [ -x /sbin/mount.nfs4 ] || [ -x /usr/sbin/mount.nfs4 ]; } \
      || echo "  ! NFS client install failed — the fio and mlperf legs will be skipped"
  fi

  # dlio (mlperf resnet50 driver) — venv install, one-time.
  if [ ! -x /opt/dlio/venv_mlperf/bin/dlio_benchmark ]; then
    bold "  installing dlio-benchmark (one-time, mlperf)…"
    local dout
    # `python3 -m venv` needs ensurepip, which is a SEPARATE package on rpm hosts
    # (python3-pip) and on Debian (python3-venv); without it venv fails and the
    # 2>/dev/null here hid that too.
    command -v dnf >/dev/null && ! python3 -c 'import ensurepip' 2>/dev/null \
      && sudo dnf install -y -q python3-pip >/dev/null 2>&1
    command -v apt-get >/dev/null && ! python3 -c 'import ensurepip' 2>/dev/null \
      && sudo apt-get install -y -qq python3-venv >/dev/null 2>&1
    # TMPDIR must NOT be /tmp: on Amazon Linux /tmp is a RAM-backed tmpfs (1.9 GB
    # on a c6in.large, and the suite's own artifacts had it at 76% full), while
    # dlio-benchmark pulls tensorflow + torchvision — multiple GB of wheels that
    # pip unpacks under TMPDIR. It ran out of space every time while the root disk
    # had 195 GB free, and the failure surfaced only as `dlio: missing`.
    # --no-cache-dir keeps the footprint down; a pip cache is useless here anyway.
    local dtmp="${DLIO_TMPDIR:-/var/tmp/dlio-build}"
    sudo mkdir -p /opt/dlio "$dtmp"
    # Mirror the recipe the CLUSTER uses (zusCloudNative zs3-init.go
    # installMLPerfBenchmark), which demonstrably works — the cluster's own
    # "Run mlperf" button drives it. The order matters:
    #
    #   1. pip/wheel/setuptools first, or the torch wheel resolution misbehaves.
    #   2. torch from the CPU-ONLY index BEFORE dlio-benchmark. Left to itself,
    #      dlio pulls the default (CUDA) torch — several GB of nvidia-* wheels
    #      that have no use on a CPU box and that filled /tmp here.
    #   3. dlio-benchmark last, so it finds torch already satisfied.
    #   4. s3torchconnector for the S3 read path (best-effort).
    local PIPQ="sudo env TMPDIR=$dtmp /opt/dlio/venv_mlperf/bin/pip install --no-cache-dir"
    dout=$(sudo python3 -m venv /opt/dlio/venv_mlperf 2>&1 \
      && $PIPQ --upgrade pip wheel setuptools 2>&1 \
      && $PIPQ --index-url https://download.pytorch.org/whl/cpu torch 2>&1 \
      && $PIPQ dlio-benchmark 2>&1)
    $PIPQ s3torchconnector >/dev/null 2>&1 || true
    sudo rm -rf "$dtmp" 2>/dev/null || true
    [ -x /opt/dlio/venv_mlperf/bin/dlio_benchmark ] || {
      echo "  ! dlio install failed — mlperf section will be skipped"
      printf '%s\n' "$dout" | tail -3 | sed 's/^/    | /'
    }
  fi
  echo "  warp: $(warp --version 2>/dev/null | head -1 || echo missing) · fio: $(fio --version 2>/dev/null || echo missing) · mount-s3: $(command -v mount-s3 >/dev/null && echo ok || echo missing) · dlio: $([ -x /opt/dlio/venv_mlperf/bin/dlio_benchmark ] && echo ok || echo missing)"
}

# ACID_BIN — the compiled porcupine linearizability checker (built from acid/).
ACID_BIN="$HERE/acid/ptest"

# ensure_acid_tools builds the porcupine checker (acid/ptest). It is a single Go
# program; building it needs a Go toolchain, which we fetch to /usr/local/go if
# the host has none (same one-time pattern as warp/mount-s3/dlio). Idempotent:
# a present, runnable binary is reused.
ensure_acid_tools(){
  [ "${BLIMP_SKIP_DEPS:-0}" = 1 ] && return 0
  [ -x "$ACID_BIN" ] && { echo "  porcupine (acid): ok"; return 0; }
  bold "== building the porcupine ACID checker (acid/ptest) =="
  local GO; GO=$(command -v go || echo /usr/local/go/bin/go)
  if ! "$GO" version >/dev/null 2>&1; then
    bold "  installing Go toolchain (one-time, to build the ACID checker)…"
    local arch gover; arch=$(uname -m); [ "$arch" = aarch64 ] && arch=arm64 || arch=amd64
    gover=1.22.5
    if curl -fsSL "https://go.dev/dl/go${gover}.linux-${arch}.tar.gz" -o /tmp/go.tgz; then
      sudo rm -rf /usr/local/go && sudo tar -C /usr/local -xzf /tmp/go.tgz && rm -f /tmp/go.tgz
      GO=/usr/local/go/bin/go
    fi
  fi
  if ! "$GO" version >/dev/null 2>&1; then
    echo "  ! Go toolchain unavailable — 'blimp --acid' will be unavailable"; return 1
  fi
  # Build offline-tolerant: module deps (porcupine, minio-go) are fetched on the
  # first build and cached under GOPATH thereafter.
  ( cd "$HERE/acid" && GOFLAGS=-mod=mod "$GO" build -o ptest . ) 2>&1 | tail -3
  [ -x "$ACID_BIN" ] && echo "  porcupine (acid): built ok" \
    || { echo "  ! porcupine build failed — 'blimp --acid' will be unavailable"; return 1; }
}

cmd_storage(){
  need_env
  : "${GW:?gateway missing in wiring}" "${REGION:?}"
  # Everything the ~25-minute suite needs, checked in seconds and reported
  # together. --setup installs the tools and saves the keys, so this normally
  # just confirms; when it doesn't, you learn ALL of it now rather than one item
  # per run.
  preflight 1 1
  ensure_storage_tools
  [ -n "${GW_AK:-}" ] || GW_AK=$(ask GW_AK "Gateway S3 access key")
  [ -n "${GW_SK:-}" ] || GW_SK=$(ask GW_SK "Gateway S3 secret key")
  # REFUSE to run unauthenticated. These are the GATEWAY's own S3 credentials,
  # which are NOT the source-bucket credentials: vpc mode deliberately leaves the
  # source keys blank (the node reads the origin via its IAM instance role), but
  # the gateway's S3 endpoint is MinIO-style and authenticates by key. With them
  # blank, warp cannot PUT/GET at all and run_cluster.sh aborts with "AK: set AK"
  # — taking warp AND mlperf with it — while the suite still printed a summary,
  # just with the throughput fields empty:
  #     warp   S3 PUT  MiB/s · GET  MiB/s          <- blank, looks like a format bug
  #     cache  direct-S3 26 · router 20 · mp-s3 n/a
  # An empty number reads as "the tool is broken", not "you gave me no key", so
  # say which one is missing and where to get it.
  if [ -z "${GW_AK:-}" ] || [ -z "${GW_SK:-}" ]; then
    die "gateway S3 credentials are empty (GW_AK=$([ -n "${GW_AK:-}" ] && echo set || echo EMPTY), GW_SK=$([ -n "${GW_SK:-}" ] && echo set || echo EMPTY)).
  warp and mlperf benchmark the GATEWAY's S3 endpoint, which authenticates by
  key — an IAM instance role does not apply to it, so vpc mode does not fill
  these in. Take the cluster's S3 access key/secret from the Blimp UI and either
  add them to $ENVF as GW_AK= / GW_SK=, or pass them for one run:
      GW_AK=... GW_SK=... blimp --storage"
  fi
  ORIGIN_BUCKET="${ORIGIN_BUCKET:-$(ask ORIGIN_BUCKET "Origin S3 bucket (read-through cache)")}"
  # Forward the ORIGIN's location + keys too. This env list is a whitelist, so a
  # variable absent from it simply does not reach the suite: S3_ENDPOINT/S3_KEY/
  # S3_SECRET were saved to the wiring file and read by run_router.sh, but never
  # passed here — so every origin call fell back to the IAM role and MinIO
  # answered InvalidAccessKeyId. The listing came back empty and the leg died
  # with "no objects under s3://<bucket>/{_blimp_cachebench}/".
  # Run the suite LOCALLY (on THIS node, to measure the real client->gateway
  # path), capturing its output. Unlike --query — which runs SERVER-SIDE, so the
  # gateway's cdc_service tracks it live and the UI shows a yellow "running" row
  # with partial data — --storage runs HERE, so the gateway has no live view. To
  # give the SAME live UI, a background heartbeat POSTs the partial results to
  # cdc_service every <180s as status=running (the UI shows the live row), and we
  # exits. Each leg (warp/fio/mlperf) now registers its OWN internal-format run from
  # inside test_cache.sh — identical type + labels to the gateway's run_bench rows,
  # with cdc sampling the tier columns via __tiers__ — so there is no combined
  # "storage (client)" heartbeat here anymore. CLUSTER_ID is forwarded so the
  # per-leg POST /bench/import is authed (Bearer zus-<CLUSTER_ID>).
  env GW="$GW" GW_AK="$GW_AK" GW_SK="$GW_SK" ORIGIN_BUCKET="$ORIGIN_BUCKET" \
    CLUSTER_ID="$CLUSTER_ID" \
    REGION="$REGION" CLUSTER_REGION="${CLUSTER_REGION:-$REGION}" \
    S3_ENDPOINT="${S3_ENDPOINT:-}" S3_KEY="${S3_KEY:-}" S3_SECRET="${S3_SECRET:-}" \
    STORAGE_LEGS="${STORAGE_LEGS:-}" \
    MLPERF_NUM_FILES="${MLPERF_NUM_FILES:-}" MLPERF_NUM_EVAL="${MLPERF_NUM_EVAL:-}" \
    MLPERF_ACCELS="${MLPERF_ACCELS:-}" MLPERF_REGEN="${MLPERF_REGEN:-}" \
    NAMESPACE="${NAMESPACE:-tpcds}" bash "$HERE/test_cache.sh"
  exit $?
}

# storage_heartbeat <logfile> <id> — while --storage runs, push its partial
# output to the gateway every 75s as status=running so the UI shows a LIVE
# "running" row (yellow, partial metrics) exactly like a --query run, instead of
# the run only appearing when it finishes. Each POST rewrites the gateway-side
# summary/log so bench_status() keeps reporting "running" (freshness < 180s).
# Killed by cmd_storage; the "done" finalize is a separate storage_import call.
storage_heartbeat(){
  local log="$1" id="$2"
  [ -n "${CLUSTER_ID:-}" ] && [ -n "${GW:-}" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  sleep 15   # let the first leg emit a line before the first beat
  while :; do storage_import "$log" "$id" "running" quiet; sleep 75; done
}

# storage_import <logfile> [id] [status] [quiet] — register/update a client-side
# --storage run on the Blimp UI bench list via the gateway cdc_service
# `POST /bench/import` (Authorization: Bearer zus-<CLUSTER_ID>). The suite prints
# human-readable result lines; we scrape the throughput/TTFB/AU lines into a
# [label,value] metrics array and ship them + the full log so the UI shows the
# run like a gateway-launched one (tagged client_* / source=client). status is
# "running" (heartbeat) or "done" (final). Best-effort: an older gateway image
# without /bench/import (or an unreachable :9401) just skips, never fails the run.
storage_import(){
  local log="$1" id="${2:-storage_$(date +%s)}" status="${3:-done}" quiet="${4:-}"
  [ -n "${CLUSTER_ID:-}" ] || { [ -z "$quiet" ] && echo "  (skipping UI registration — no CLUSTER_ID in wiring)"; return 0; }
  [ -n "${GW:-}" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  local tok="zus-$CLUSTER_ID"
  local payload
  payload=$(CLOG="$log" python3 - "$id" "$(hostname 2>/dev/null || echo client)" "$status" <<'PY' 2>/dev/null
import json,os,re,sys
rid,host,status=sys.argv[1],sys.argv[2],sys.argv[3]
try: raw=open(os.environ["CLOG"],errors="replace").read()
except Exception: raw=""
c=re.sub(r"\x1b\[[0-9;]*m","",raw)
# throughput is normalised to DECIMAL MB/s (or GB/s >=1000) — warp/fio report
# BINARY MiB/s, but the UI + gateway rows use MB/s, so convert (1 MiB = 1.048576 MB).
def to_mb(v,u):
    v=float(v); u=u.lower()
    return v*(1073.741824 if u.startswith("gib") else 1.048576 if u.startswith("mib") else 0.001048576 if u.startswith("kib") else 1000.0 if u.startswith("gb") else 0.001 if u.startswith("kb") else 1.0)
def fmt(mb): return "%.2f GB/s"%(mb/1000.0) if mb>=1000 else "%d MB/s"%round(mb)
def thr(s,paren=False):
    if paren:
        m=re.search(r"\(([0-9.]+)\s*(GB/s|MB/s|KB/s)\)",s)
        if m: return fmt(to_mb(m.group(1),m.group(2)))
    m=re.search(r"([0-9.]+)\s*(GiB/s|MiB/s|KiB/s|GB/s|MB/s|KB/s)",s)
    return fmt(to_mb(m.group(1),m.group(2))) if m else None
rows=[]; wctx=None
def g(rx,s,grp=1):
    m=re.search(rx,s); return m.group(grp) if m else None
for ln in c.splitlines():
    s=ln.strip()
    if "== warp PUT" in s: wctx="PUT"; continue
    if "== warp GET" in s: wctx="GET"; continue
    if s.startswith("* Average:") and wctx:
        v=thr(s); ob=g(r"([0-9.]+)\s*obj/s",s)
        if v: rows.append(["warp S3 %s (96MiB, conc16)"%wctx, v+(" · "+ob+" obj/s" if ob else "")])
        wctx=None; continue
    if "TTFB:" in s:
        med=g(r"Median:\s*([0-9a-z]+)",s); p99=g(r"99th:\s*([0-9a-z]+)",s); avg=g(r"Avg:\s*([0-9a-z]+)",s)
        parts=[x for x in [("p50 "+med if med else ""),("p99 "+p99 if p99 else ""),("avg "+avg if avg else "")] if x]
        rows.append(["TTFB 1KiB GET (conc1)", " · ".join(parts)]); continue
    if s.startswith("WRITE:") or "write BW" in s:
        v=thr(s,paren=True)
        if v: rows.append(["fio write (mp-s3, 4 jobs)", v]); continue
    if s.startswith("READ:") or "seq read" in s:
        v=thr(s,paren=True)
        if v: rows.append(["fio read (cold seq)", v]); continue
    if "mlperf read" in s:
        au=g(r"AU\s*([0-9.]+)",s); io=thr(s); acc=g(r"accel=([0-9]+)",s)
        parts=[x for x in [("AU "+au+"%" if au else ""),(io if io else "")] if x]
        rows.append(["mlperf resnet50"+(" accel-"+acc if acc else ""), " · ".join(parts)]); continue
    if re.search(r"cache .*(direct|router|mp-s3)",s):
        rows.append(["cache read-through", re.sub(r"\s+"," ",s)[:120]]); continue
od=[]; seen={}
for k,v in rows:
    if k not in seen: od.append(k)
    seen[k]=v
final=[[k,seen[k]] for k in od]
print(json.dumps({"id":rid,"type":"storage (client)","status":status,
  "summary":{"type":"storage (client)","metrics":final,"config":"run-blimp kit (client %s)"%host,"status":status},
  "log":c[-200000:]}))
PY
)
  [ -n "$payload" ] || return 0
  if curl -fsS -m 20 -X POST "http://$GW:9401/bench/import" \
       -H "Authorization: Bearer $tok" -H "Content-Type: application/json" \
       --data-binary "$payload" >/dev/null 2>&1; then
    [ -z "$quiet" ] && bold "  ✓ registered this run on the Blimp UI bench list (client_$id, $status)"
  else
    [ -z "$quiet" ] && echo "  (could not register on the UI bench list — gateway :9401 unreachable or image predates /bench/import)"
  fi
  return 0
}

cmd_query(){
  need_env
  : "${GW:?}" "${CLUSTER_ID:?}" "${ICEBERG_URL:?}" "${WAREHOUSE:?}"
  preflight 0 0
  # S3_ENDPOINT/KEY/SECRET must cross this whitelist. bench_cdc.sh forwards
  # $S3_KEY/$S3_SECRET to seed_tpcds.py and seed_tpcds.py falls back to
  # $S3_ENDPOINT — but none of the three were listed here, so the CDC APPEND
  # resolved the bucket against real AWS and died:
  #   s3fs ... FileNotFoundError: The specified bucket does not exist
  # With no append there is no delta, so every query fell back to a full
  # re-author (mode='no-delta') and the delta-merge path — the whole point of
  # this suite — was never exercised while the run still reported DONE.
  exec env GW="$GW" CLUSTER_ID="$CLUSTER_ID" ICEBERG_URL="$ICEBERG_URL" WAREHOUSE="$WAREHOUSE" \
    NAMESPACE="${NAMESPACE:-tpcds}" REGION="${REGION:-ap-south-1}" \
    S3_ENDPOINT="${S3_ENDPOINT:-}" S3_KEY="${S3_KEY:-}" S3_SECRET="${S3_SECRET:-}" \
    VERIFY="${VERIFY:-0}" FORCE_AUTHOR="${FORCE_AUTHOR:-0}" bash "$HERE/test_query.sh"
}

cmd_bench(){
  need_env
  : "${GW:?}" "${CLUSTER_ID:?}" "${ICEBERG_URL:?}" "${WAREHOUSE:?}"
  preflight 0 0
  # statistical profile: one-time author_ms + materialize_ms, and per-append
  # delta_merge_ms + materialize_ms (min/median/avg/max). Tune ITERS / AUTHOR_ITERS
  # / CDC_ROWS to size the sweep and the delta.
  exec env GW="$GW" GW_AK="${GW_AK:-}" GW_SK="${GW_SK:-}" CLUSTER_ID="$CLUSTER_ID" \
    ICEBERG_URL="$ICEBERG_URL" WAREHOUSE="$WAREHOUSE" NAMESPACE="${NAMESPACE:-tpcds}" \
    REGION="${REGION:-ap-south-1}" ITERS="${ITERS:-3}" AUTHOR_ITERS="${AUTHOR_ITERS:-3}" \
    S3_ENDPOINT="${S3_ENDPOINT:-}" S3_KEY="${S3_KEY:-}" S3_SECRET="${S3_SECRET:-}" \
    BENCH_QNR="${BENCH_QNR:-88}" Q_DIR="${Q_DIR:-$HOME/tpcds_queries}" \
    BENCH_FACT="${BENCH_FACT:-}" \
    CDC_ROWS="${CDC_ROWS:-50000}" bash "$HERE/bench_incremental.sh"
}

# Flags may follow the command: `blimp --query --verify`. VERIFY is OFF by default
# because that is the PRODUCTION path — the gateway does no verification while
# serving, so an unflagged run measures what customers actually get.
CMD="${1:-}"; shift 2>/dev/null || true
for f in "$@"; do
  case "$f" in
    --verify)       VERIFY=1; export VERIFY ;;
    --force-author) FORCE_AUTHOR=1; export FORCE_AUTHOR ;;
    *)              echo "unknown flag: $f"; exit 2 ;;
  esac
done

# cmd_acid — linearizability (ACID) check of the node's three data paths.
# For each endpoint it runs the porcupine model checker under two profiles:
#   single-writer : one client writes a key, N clients read it concurrently —
#                   the read-after-write property an object store actually
#                   promises. A stale/torn read here is a REAL consistency bug.
#   multi-writer  : all clients write AND read the same keys — a stricter
#                   total-order probe. (Some completed-op errors here are just
#                   the FUSE client refusing concurrent writers to one key; the
#                   verdict is over the ops that COMPLETED.)
# LINEARIZABLE on every endpoint == the gateway+router+mp-s3 stack preserves
# read-after-write and never exposes a torn erasure-decode under load.
cmd_acid(){
  need_env
  : "${GW:?gateway missing in wiring}"
  preflight 1 0
  [ -n "${GW_AK:-}" ] || GW_AK=$(ask GW_AK "Gateway S3 access key")
  [ -n "${GW_SK:-}" ] || GW_SK=$(ask GW_SK "Gateway S3 secret key")
  [ -n "${GW_AK:-}" ] && [ -n "${GW_SK:-}" ] || die "gateway S3 credentials required (GW_AK/GW_SK)"
  ensure_acid_tools || die "porcupine checker unavailable — run 'blimp --setup'"
  local CL="${ACID_CLIENTS:-8}" KEYS="${ACID_KEYS:-4}" DUR="${ACID_DURATION:-45s}"
  local ROUTER_PORT="${ROUTER_PORT:-8088}" S3_PORT="${S3_PORT:-9000}"
  local MP="${ACID_MPS3_MNT:-/mnt/mps3-acid}" BKT="${ACID_BUCKET:-blimp-acid}"
  export AWS_ACCESS_KEY_ID="$GW_AK" AWS_SECRET_ACCESS_KEY="$GW_SK" AWS_REGION=us-east-1
  aws s3 mb "s3://$BKT" --endpoint-url "http://$GW:$S3_PORT" >/dev/null 2>&1 || true

  # Per-leg verdict tracking. The summary MUST reflect what actually happened —
  # a leg is one of: PASS (RESULT: LINEARIZABLE), FAIL (NOT LINEARIZABLE / any
  # result=Illegal), or NO-RESULT (the checker produced no verdict at all —
  # e.g. the endpoint was unreachable, or the router was retargeted to a
  # customer source so the test bucket isn't there). A NO-RESULT leg is NOT a
  # pass and must never be reported as one.
  local acid_pass=0 acid_fail=0 acid_noresult=0 acid_bad=""
  run_one(){ # <label> <profile> <cmd...>
    local label="$1" profile="$2"; shift 2
    local out; out=$("$@" 2>&1)
    printf '%s\n' "$out" | grep -E 'RESULT|Illegal' | head -3
    if printf '%s\n' "$out" | grep -q 'RESULT: LINEARIZABLE'; then
      acid_pass=$((acid_pass+1))
    elif printf '%s\n' "$out" | grep -qE 'NOT LINEARIZABLE|result=Illegal'; then
      acid_fail=$((acid_fail+1)); acid_bad="$acid_bad|FAIL $label/$profile"
    else
      # A NO-RESULT leg means ptest died BEFORE any verdict — almost always the
      # seed PUT. Its reason is the whole diagnosis, so print it: greping only
      # for RESULT threw the error away and left the leg silently unexplained
      # ("404 NoSuchBucket" on the router looked identical to "unreachable").
      printf '%s\n' "$out" | grep -v '^$' | tail -2 | sed 's/^/     ! /'
      acid_noresult=$((acid_noresult+1)); acid_bad="$acid_bad|NO-RESULT $label/$profile"
    fi
  }
  run_leg(){ # <label> <extra ptest args...>
    local label="$1"; shift
    echo; bold "== $label =="
    echo "-- single-writer (${CL}c/${KEYS}k/${DUR}) --"
    run_one "$label" single "$ACID_BIN" -bucket "$BKT" -access-key "$GW_AK" -secret-key "$GW_SK" \
      -clients "$CL" -keys "$KEYS" -duration "$DUR" -single-writer "$@"
    echo "-- multi-writer (${CL}c/${KEYS}k/${DUR}) --"
    run_one "$label" multi "$ACID_BIN" -bucket "$BKT" -access-key "$GW_AK" -secret-key "$GW_SK" \
      -clients "$CL" -keys "$KEYS" -duration "$DUR" "$@"
  }

  bold "ACID / linearizability — node $GW  (bucket s3://$BKT)"
  run_leg "gateway S3 :$S3_PORT"  -mode s3     -endpoint "$GW:$S3_PORT"

  # The router is a READ-THROUGH cache: it proxies writes to whatever origin
  # --setup retargeted it at, NOT to the gateway's own S3. So creating $BKT on
  # :9000 (above) is not enough — the origin needs it too, or every seed PUT
  # through :8088 dies "404 NoSuchBucket" and the leg reports no verdict. That
  # is the recommended prod wiring, so the router leg was unrunnable by default.
  router_ready=1
  if [ -n "${S3_ENDPOINT:-}" ]; then
    AWS_ACCESS_KEY_ID="${S3_KEY:-$GW_AK}" AWS_SECRET_ACCESS_KEY="${S3_SECRET:-$GW_SK}" \
      aws s3 mb "s3://$BKT" --endpoint-url "$S3_ENDPOINT" >/dev/null 2>&1 || true
    AWS_ACCESS_KEY_ID="${S3_KEY:-$GW_AK}" AWS_SECRET_ACCESS_KEY="${S3_SECRET:-$GW_SK}" \
      aws s3 ls "s3://$BKT" --endpoint-url "$S3_ENDPOINT" >/dev/null 2>&1 || router_ready=0
  fi
  if [ "$router_ready" = 1 ]; then
    run_leg "router :$ROUTER_PORT"  -mode router -endpoint "$GW:$ROUTER_PORT"
  else
    # Say so loudly and count it — an unrunnable leg is not a pass, but it is
    # also not evidence of a consistency bug, and must not read as one.
    echo; bold "== router :$ROUTER_PORT =="
    echo "!! router leg SKIPPED: test bucket s3://$BKT absent on the router origin (${S3_ENDPOINT:-unset})"
    echo "   the router writes through to the origin; create the bucket there to run this leg."
    acid_noresult=$((acid_noresult+2)); acid_bad="$acid_bad|SKIPPED router (origin lacks s3://$BKT)"
  fi

  # mountpoint-s3 leg — mount the bucket as a filesystem over the gateway S3 and
  # run the file backend against it. Always remount (a stale FUSE endpoint reads
  # as "mounted"). mount-s3 default trailing checksums exercise the gateway's
  # aws-chunked-trailer decode path on write.
  if command -v mount-s3 >/dev/null 2>&1; then
    sudo mkdir -p "$MP"
    grep -qs '^user_allow_other' /etc/fuse.conf || echo user_allow_other | sudo tee -a /etc/fuse.conf >/dev/null 2>&1 || true
    fusermount -u "$MP" 2>/dev/null || sudo umount -l "$MP" 2>/dev/null || true
    if sudo -E env AWS_ACCESS_KEY_ID="$GW_AK" AWS_SECRET_ACCESS_KEY="$GW_SK" \
         mount-s3 --allow-other --force-path-style --endpoint-url "http://$GW:$S3_PORT" \
         --allow-delete --allow-overwrite --metadata-ttl minimal "$BKT" "$MP"; then
      echo; bold "== mountpoint-s3 (over :$S3_PORT) =="
      echo "-- single-writer (${CL}c/${KEYS}k/${DUR}) --"
      run_one "mountpoint-s3" single sudo "$ACID_BIN" -mode mounts3 -dir "$MP" -clients "$CL" -keys "$KEYS" -duration "$DUR" -single-writer
      echo "-- multi-writer (${CL}c/${KEYS}k/${DUR}) --"
      run_one "mountpoint-s3" multi sudo "$ACID_BIN" -mode mounts3 -dir "$MP" -clients "$CL" -keys "$KEYS" -duration "$DUR"
      fusermount -u "$MP" 2>/dev/null || sudo umount -l "$MP" 2>/dev/null || true
    else
      echo "!! mountpoint-s3 leg SKIPPED: could not mount s3://$BKT at $MP"; acid_noresult=$((acid_noresult+1)); acid_bad="$acid_bad|NO-RESULT mountpoint-s3/mount"
    fi
  else
    echo "!! mountpoint-s3 leg SKIPPED: mount-s3 not installed (run 'blimp --setup')"; acid_noresult=$((acid_noresult+1)); acid_bad="$acid_bad|NO-RESULT mountpoint-s3/mount"
  fi

  # Summary — reflects the ACTUAL per-leg verdicts, and exits non-zero on any
  # failure (so CI and `&&` chains catch it). A fixed "LINEARIZABLE on every
  # leg" banner regardless of results was a false-pass bug.
  echo
  local legs_bad; legs_bad=$(printf '%s' "$acid_bad" | tr '|' '\n' | sed '/^$/d; s/^/    /')
  if [ "$acid_fail" -gt 0 ]; then
    printf '\033[31m\033[1mACID check: NOT LINEARIZABLE — %d leg(s) FAILED (%d passed, %d no-result). Torn/stale reads observed.\033[0m\n' "$acid_fail" "$acid_pass" "$acid_noresult"
    printf '%s\n' "$legs_bad"
    return 1
  elif [ "$acid_noresult" -gt 0 ]; then
    printf '\033[33m\033[1mACID check: %d leg(s) LINEARIZABLE, but %d produced NO result — NOT a clean pass:\033[0m\n' "$acid_pass" "$acid_noresult"
    printf '%s\n' "$legs_bad"
    echo "    (a NO-RESULT leg = endpoint unreachable or router retargeted to a customer source; investigate)"
    return 2
  else
    bold "ACID check complete — LINEARIZABLE on all $acid_pass legs: read-after-write preserved, no torn reads."
  fi
}

case "$CMD" in
  --setup)            cmd_setup ;;
  --storage|storage)  cmd_storage ;;
  --acid|acid)        cmd_acid ;;
  --query|query)      cmd_query ;;
  --bench|bench)      cmd_bench ;;
  ""|-h|--help|help)  usage ;;
  *)                  echo "unknown command: $1"; echo; usage; exit 2 ;;
esac
