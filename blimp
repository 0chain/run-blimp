#!/usr/bin/env bash
# ==============================================================================
# blimp — one command to set up, then validate, a Blimp prod source.
# ==============================================================================
#   blimp                 list the commands (this help)
#   blimp --setup         PROD: run on YOUR app node — connect a Blimp cluster to
#                         your data. Asks for your Iceberg REST + S3 endpoints;
#                         if you don't have them, stands up an Iceberg catalog
#                         (:8181) and/or an S3 warehouse bucket here for you,
#                         then prints the values to point the Blimp cluster at.
#   blimp --storage       TEST: storage suite (warp, mlperf).
#   blimp --query         TEST: query + CDC suite (author → append → delta-merge).
#   blimp --bench         BENCH: statistical author / materialize / delta-merge
#                         timing profile (min/median/avg/max over N iterations).
#
# Wiring is saved to ~/.blimp_env (override path with BLIMP_ENV). --setup writes
# it; --storage/--query read it (and prompt for anything still missing).
# Non-interactive: pre-set the env vars (REGION, CLUSTER_ID, GW, ICEBERG_URL,
# WAREHOUSE, ORIGIN_BUCKET, NAMESPACE, GW_AK, GW_SK) and they won't be asked.
# ==============================================================================
set -uo pipefail
# Resolve $0 through any symlink so `blimp` works when installed as
# /usr/local/bin/blimp -> /opt/blimp/blimp — HERE must be the KIT dir (where the
# sibling scripts live), not the symlink's dir.
SELF="$0"; while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"; case "$link" in /*) SELF="$link";; *) SELF="$(dirname "$SELF")/$link";; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
ENVF="${BLIMP_ENV:-$HOME/.blimp_env}"
bold(){ printf '\033[1m%s\033[0m\n' "$*"; }
die(){ printf '\033[31m[blimp] FATAL: %s\033[0m\n' "$*" >&2; exit 1; }
# ask VAR "prompt" [default] — keep an already-set value; else prompt (default on empty)
ask(){ local var="$1" prompt="$2" def="${3:-}" cur="${!1:-}" v
  [ -n "$cur" ] && { printf '%s' "$cur"; return; }
  # No terminal (CI, `ssh host cmd`, nohup) → take the default instead of dying.
  # `read </dev/tty` on such a host printed "/dev/tty: No such device or address"
  # for EVERY prompt and the run ended with no wiring written.
  #
  # Test the OPEN, not `-r`: under nohup the /dev/tty device node still exists
  # and is readable, so `[ -r /dev/tty ]` passes and the redirect below then
  # fails with ENXIO ("No such device or address") because the process has no
  # controlling terminal. That is exactly what happened to `blimp --storage`
  # under nohup (2026-08-01): both gateway S3 key prompts errored, the run
  # continued with BLANK credentials, and warp/mlperf then measured nothing.
  if ! { : < /dev/tty; } 2>/dev/null; then
    printf '%s%s: <no tty, using default>\n' "$prompt" "${def:+ [$def]}" >&2
    printf '%s' "$def"; return
  fi
  printf '%s%s: ' "$prompt" "${def:+ [$def]}" >&2; read -r v </dev/tty || true
  printf '%s' "${v:-$def}"; }

usage(){
  bold "blimp — Blimp prod-source setup + validation"
  cat <<'H'

  blimp --setup      Connect a Blimp cluster to your data (run on your app node).
                     Asks three things, each defaulting to the INTERNAL option so
                     a plain customer needs no pre-existing infrastructure:
                       1. Iceberg catalog — the gateway's own Nessie (default),
                          stand one up on this box, or an existing REST URL.
                       2. Dataset location — the fleet cache layer at the fleet
                          S3 address (default, keys auto-fetched), or any other
                          S3 endpoint / your own bucket.
                       3. Test dataset — build TPC-DS at SF1 (default), SF10,
                          SF100 or SF1000 at that location and register it into
                          the catalog from 1; or bring your own data.
                     Every answer is overridable up-front via the env
                     (CATALOG_CHOICE / SOURCE_CHOICE / BUILD_DATASET / BLIMP_SF),
                     so a scripted run is non-interactive.
  blimp --storage    Test: storage suite.
  blimp --acid       Test: ACID / linearizability — a Jepsen-style porcupine
                     check that concurrent writers + readers never observe a
                     stale or torn value, run against the node's data paths
                     (gateway S3 :9000, mountpoint-s3).
                     Reports LINEARIZABLE / NOT-LINEARIZABLE per endpoint.
  blimp --encryption on|off|status   Toggle at-rest write encryption on the
                     gateway (runtime; new writes only). status reads current.
  blimp --gc         Reclaim orphaned blobber storage (fleet orphan sweep).
  blimp --immutable on|off           Toggle allocation immutability on-chain
                     (reversible). Optional ALLOC_ID=<id> to target one alloc.
  blimp --query      Test: query optimizer + incremental CDC (delta-merge) suite.
                     --sql <file|dir>    run YOUR SQL (any dataset): tables + fact are
                                         derived from the SQL and the catalog
                     --tick-cmd '<cmd>'  your streamer appends in phase 2 (default:
                                         the TPC-DS seeder, test set only)
                     --queries "3 7 19"  which TPC-DS queries (default: --first-10)
                     --second-40 | --third-30 | --fourth-19 | --all
                                         run a batch from suites/: --first-10 (the 10
                                         proven queries) is the DEFAULT; then the rest of
                                         the release-50, then the remaining 49 split
                                         30/19; --all = every TPC-DS query 1-99. Flags
                                         stack, and a batch name also works as a
                                         --queries token
                     --append-rows N     CDC tick base rows (default 5000)
                     Add --evict to start COLD (evict each MV, re-author from the
                     recipe library). There is NO --verify flag: correctness is
                     gated by the AUTHOR's row-hash before an MV can bank, which
                     runs on every author regardless. The old flag only added a
                     phase-4 re-verification of the merged MV against the source
                     — a full original scan per query (42 min on q72's 7.79M-row
                     MV) that proved nothing a bench run needs — and it was the
                     dominant cost of every iteration until it was removed.
  blimp --bench      Bench: author / materialize / delta-merge timing profile
                     (min/median/avg/max over N iters; ITERS, AUTHOR_ITERS, CDC_ROWS).
  blimp --update     Update software ON THE NODE (via its :9401 helper, bearer = CLUSTER_TOKEN):
                       blimp --update status                 what is running (images, rclone, tools)
                       blimp --update all                    zs3 gateway, eblobbers, nessie, gotenberg, rclone
                       blimp --update zs3,rclone             only these
                       blimp --update zs3 --tag zs3=latest-abc123 --tag rclone=1.73.5
                       blimp --update all --dry-run          show the plan, change nothing
                     One update at a time; the node keeps a backup of every compose
                     file / container it replaces and rolls back a failed recreate.

  Wiring is read from / written to ~/.blimp_env  (set BLIMP_ENV to relocate).
H
  [ -f "$ENVF" ] && { echo; bold "current wiring ($ENVF):"; sed 's/^/  /' "$ENVF"; }
  return 0
}

save_env(){
  umask 077
  cat > "$ENVF" <<E
# written by 'blimp --setup' — the wiring for --storage / --query
REGION=$REGION
CLUSTER_REGION=${CLUSTER_REGION:-$REGION}
CLUSTER_ID=$CLUSTER_ID
# Bearer the cluster's gateway validates: the account's FLEET token. Filled from
# the node's copy (/opt/0chain/zs3server/environment/admin_token) when the CLI
# runs on the gateway box, else paste it from the panel (Settings -> API token).
# Never derived from the cluster id: "blimp-<id>"/"zus-<id>" are guessable and
# no gateway accepts them any more (2026-09-14).
CLUSTER_TOKEN=${CLUSTER_TOKEN:-}
GW=$GW
GATEWAY=$GW
ICEBERG_URL=$ICEBERG_URL
# The address LOCAL tools dial. Empty when the catalog is someone else's (then
# ICEBERG_URL is the only correct address). Set only when THIS node runs it, so
# seed_tpcds.py etc. never loop out through our own public IP and get blocked by
# our own security group — see local_host().
ICEBERG_URL_LOCAL=${ICEBERG_URL_LOCAL:-}
# REST prefix. Nessie (the gateway's own catalog) serves every route under a
# BRANCH prefix — "main" — while a plain REST catalog serves the root and 404s
# if you send one. Blank = no prefix.
ICEBERG_PREFIX=${ICEBERG_PREFIX:-}
WAREHOUSE=$WAREHOUSE
ORIGIN_BUCKET=$ORIGIN_BUCKET
NAMESPACE=$NAMESPACE
# SOURCE: which gateway source the suites drive. --setup wires an external
# catalog as "customer"; without persisting it the suite fell back to a
# namespace heuristic and drove the built-in sf1000 source instead (test2
# node, 2026-09-03). Blank = let bench_cdc derive it.
SOURCE=${SOURCE:-customer}
# WHERE the origin bucket actually lives. Without these three, --storage's cache
# legs sent every origin GET/PUT to real AWS S3 in \$REGION — which is wrong for
# any non-AWS origin, and flatly broken for the MinIO source standup_data puts on
# this box (bucket blimp-sf1 does not exist on AWS). Blank = AWS S3 + IAM role.
S3_ENDPOINT=${S3_ENDPOINT:-}
S3_KEY=${S3_KEY:-}
S3_SECRET=${S3_SECRET:-}
GW_AK=${GW_AK:-}
GW_SK=${GW_SK:-}
BLIMP_PY=${BLIMP_PY:-}
E
  bold "saved wiring -> $ENVF"
}

# persist_wiring — rewrite just the GW_AK/GW_SK/CLUSTER_TOKEN lines in $ENVF from
# the current in-memory values, leaving everything else untouched. Used by
# heal_wiring after a redeploy rotates them.
persist_wiring(){
  [ -n "${ENVF:-}" ] && [ -f "$ENVF" ] || return 0
  umask 077
  local tmp="$ENVF.tmp.$$"
  grep -vE '^(GW_AK|GW_SK|CLUSTER_TOKEN)=' "$ENVF" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  {
    printf 'CLUSTER_TOKEN=%s\n' "${CLUSTER_TOKEN:-}"
    printf 'GW_AK=%s\n' "${GW_AK:-}"
    printf 'GW_SK=%s\n' "${GW_SK:-}"
  } >> "$tmp"
  mv "$tmp" "$ENVF"
}

# heal_wiring — self-heal stale wiring after a cluster REDEPLOY. A redeploy rotates
# the gateway's ZS3_ADMIN_TOKEN and its S3 keys but leaves the old $ENVF pointing at
# the destroyed cluster, so --gc/--immutable/--encryption 401 and direct S3 gives
# InvalidAccessKeyId. Probe the gateway's own credential endpoint with our token;
# if it is rejected (401/403), recover the LIVE token from the local minioserver
# container (the installer runs on the gateway box) and re-probe. On success,
# refresh GW_AK/GW_SK/CLUSTER_TOKEN and persist them so the NEXT run is already
# correct. No-op when the gateway is unreachable or nothing drifted (e.g. blimp
# running on a separate box with no local gateway container to read the token from).
# gateway_env VAR — one env var of the co-located minioserver container (empty
# when not co-located or docker is absent). The gateway's own view of its
# catalog/S3 addresses lives there; use it whenever the gateway, not this CLI,
# will dial the address.
gateway_env(){
  command -v docker >/dev/null 2>&1 || return 0
  docker inspect minioserver --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
    | sed -n "s/^$1=//p" | head -1
}

heal_wiring(){
  [ -n "${GW:-}" ] || return 0
  # PREFERRED — read this node's ACTUAL gateway auth straight from the local
  # minioserver container: the admin token (ZS3_ADMIN_TOKEN) and the S3 keys
  # (MINIO_ROOT_USER/PASSWORD, which is what the gateway authenticates S3 with).
  # NOT GET /admin/credentials for the keys: in a MULTI-NODE fleet that can return
  # the primary/fleet keys, which do NOT match node 2's own MinIO root -> the
  # InvalidAccessKeyId the regression suite hit on node 2. Co-located installs (the
  # kit runs ON the gateway box) get correct wiring on every command.
  if command -v docker >/dev/null 2>&1 && docker inspect minioserver >/dev/null 2>&1; then
    local ea tok ak sk
    ea=$(docker inspect minioserver --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null)
    # The FILE is authoritative, the container env is only a PROVISION-TIME
    # SNAPSHOT. Rotating the fleet token rewrites /opt/.../admin_token (zus-cdc
    # re-reads it within 30s and the gateway honours it via its fleet bootstrap)
    # but CANNOT rewrite a running container's env. Healing from the env
    # therefore "healed" to a stale value and every later admin call 401'd —
    # measured on node 37 (2026-09-14): env 83cfaafe… vs live file 36f62da5…,
    # which failed `blimp --query` at /admin/source/snapshot_changed. Read the
    # file first and fall back to the env for pre-fleet nodes that have none.
    tok=$(cat /opt/0chain/zs3server/environment/admin_token 2>/dev/null | tr -d '\r\n')
    ak=$(printf '%s' "$ea" | sed -n 's/^MINIO_ROOT_USER=//p' | head -1)
    sk=$(printf '%s' "$ea" | sed -n 's/^MINIO_ROOT_PASSWORD=//p' | head -1)
    [ -n "$tok" ] || tok="${CLUSTER_TOKEN:-}"
    if [ -n "$ak" ] && [ -n "$sk" ] && \
       { [ "$ak" != "${GW_AK:-}" ] || [ "$sk" != "${GW_SK:-}" ] || [ "$tok" != "${CLUSTER_TOKEN:-}" ]; }; then
      GW_AK="$ak"; GW_SK="$sk"; CLUSTER_TOKEN="$tok"
      export GW_AK GW_SK CLUSTER_TOKEN
      persist_wiring
      echo "  ✓ wiring self-healed from local gateway container (token + MinIO root creds in $ENVF)" >&2
    fi
    return 0
  fi
  # FALLBACK — blimp on a SEPARATE box (no local container): best-effort refresh via
  # the gateway admin API. Detect a stale token (401) and refetch the S3 keys.
  local port="${S3_PORT:-9000}" tok="${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" code
  local body="${TMPDIR:-/tmp}/.blimp_cred.$$"
  code=$(curl -s -o "$body" -w '%{http_code}' -m 8 \
    "http://$GW:$port/admin/credentials" -H "Authorization: Bearer $tok" 2>/dev/null)
  if [ "$code" = 200 ]; then
    local resp ak sk
    resp=$(cat "$body" 2>/dev/null)
    ak=$(printf '%s' "$resp" | sed -n 's/.*"s3_access_key":"\([^"]*\)".*/\1/p')
    sk=$(printf '%s' "$resp" | sed -n 's/.*"s3_secret_key":"\([^"]*\)".*/\1/p')
    if [ -n "$ak" ] && [ -n "$sk" ] && \
       { [ "$ak" != "${GW_AK:-}" ] || [ "$sk" != "${GW_SK:-}" ]; }; then
      GW_AK="$ak"; GW_SK="$sk"
      export GW_AK GW_SK
      persist_wiring
      echo "  ✓ wiring self-healed from gateway admin API (creds refreshed in $ENVF)" >&2
    fi
  fi
  rm -f "$body" 2>/dev/null
}

# ---- the address the Blimp cluster (on AWS) reaches THIS node on -------------
# Cross-cloud the gateway can't reach a private IP, so advertise the PUBLIC
# address by default. ADVERTISE_HOST overrides — set it to the private IP for a
# same-VPC / same-account AWS run, or to a stable DNS name you control.
this_host(){
  [ -n "${ADVERTISE_HOST:-}" ] && { printf '%s' "$ADVERTISE_HOST"; return; }
  # VPC MODE: advertise the PRIVATE address, and specifically the one that
  # ROUTES TO THE GATEWAY. The public IP is unreachable from inside the VPC —
  # the gateway hung for 411s on every metadata GET to a catalog advertised at
  # the client's public IP, then died on a read timeout with no error surfaced
  # (cluster 1785550395356, 2026-08-01). `ip route get` picks the right source
  # address on a multi-NIC host, where "first hostname -I" is a coin flip.
  if [ "${MODE:-}" = vpc ]; then
    local src=""
    [ -n "${GW_PRIV:-}" ] && src=$(ip route get "$GW_PRIV" 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)
    [ -z "$src" ] && src="${CLIENT_PRIV:-}"
    [ -z "$src" ] && src=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -n "$src" ] && { printf '%s' "$src"; return; }
  fi
  # EXTERNAL (cross-region / cross-account / cross-cloud / on-prem): the gateway
  # can only come back over a public path, so advertise the public address.
  local ip; ip=$(curl -s -m 3 https://checkip.amazonaws.com 2>/dev/null | tr -d '[:space:]')
  [ -n "$ip" ] && { printf '%s' "$ip"; return; }
  hostname -I 2>/dev/null | awk '{print $1}'
}

# ---- the address THIS node uses to reach services THIS node runs -------------
#
# NOT the same question as this_host(). this_host() answers "what address does
# the CLUSTER use to reach me?" and is correctly the PUBLIC address in external
# mode. Reusing that for our OWN calls makes the box dial itself through the
# public path, which a normal restrictive security group blocks:
#
#   ConnectTimeout host='18.141.209.155' port=8181  /v1/config?warehouse=...
#
# That is what killed the CDC tick on cluster 1786037195000 (2026-08-06) — 0 rows
# appended, so nothing went stale, so nothing delta-merged, and the whole query
# suite reported "full re-author / NO-BASELINE". The optimizer was fine; the test
# never fed it. It reads as an optimizer regression, which is why this deserves
# its own function rather than a comment on this_host().
#
# Anything we started locally is reachable on loopback, always, regardless of
# security groups, NAT, or which cloud we are on.
local_host(){
  # Only meaningful for services this script stood up. If the catalog/S3 are
  # SOMEONE ELSE'S (the user supplied ICEBERG_URL / S3_ENDPOINT), loopback is
  # wrong and the caller must keep using the real address.
  printf '127.0.0.1'
}

# local_url — rewrite a URL we advertise into one we can dial ourselves. Used for
# services THIS script started; a caller-supplied endpoint is returned unchanged.
local_url(){ # <url> <started_here:0|1>
  local u="$1" mine="${2:-0}"
  [ "$mine" = "1" ] || { printf '%s' "$u"; return; }
  printf '%s' "$u" | sed -E "s|://[^/:]+|://$(local_host)|"
}

# ---- stand up an Iceberg REST catalog here (docker compose) ------------------
# A single `docker run` — no compose plugin needed on the client box (the only
# thing that ever required it). The catalog is one container; compose bought us
# nothing here. `docker` (or `sudo docker`) is the only dependency.
# ---- pick one of N numbered options -----------------------------------------
# Same no-tty contract as ask(): with no controlling terminal take the default
# rather than dying, so CI / `ssh host blimp --setup` still completes.
pick(){ # <var> <prompt> <default-number> <label1> <label2> ...
  local var="$1" prompt="$2" def="$3"; shift 3
  local cur="${!var:-}" n=1 v
  [ -n "$cur" ] && { printf '%s' "$cur"; return; }
  { echo; bold "$prompt"; } >&2
  for l in "$@"; do printf '   %d) %s\n' "$n" "$l" >&2; n=$((n+1)); done
  if ! { : < /dev/tty; } 2>/dev/null; then
    printf '  choice [%s]: <no tty, using default>\n' "$def" >&2
    printf '%s' "$def"; return
  fi
  printf '  choice [%s]: ' "$def" >&2; read -r v </dev/tty || true
  v="${v:-$def}"
  case "$v" in ''|*[!0-9]*) v="$def";; esac
  [ "$v" -ge 1 ] 2>/dev/null && [ "$v" -le $# ] 2>/dev/null || v="$def"
  printf '%s' "$v"; }

# ---- fleet credentials from the gateway -------------------------------------
# GET /admin/credentials returns the account-wide fleet S3 address and keys:
#   fleet_url, fleet_s3_access_key, fleet_s3_secret_key
# This is what makes the "use the fleet cache layer" option zero-config — the
# customer never copies a key. Sets FLEET_URL / FLEET_AK / FLEET_SK; returns 1
# when the gateway is older than the endpoint or fleet mode is off.
fleet_creds(){
  [ -n "${GW:-}" ] || return 1
  local resp; resp=$(curl -s -m 10 "http://$GW:9000/admin/credentials" \
    -H "Authorization: Bearer ${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" 2>/dev/null) || return 1
  eval "$(printf '%s' "$resp" | "${BLIMP_PY:-python3}" -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
if not d.get("fleet_enabled"): sys.exit(0)
for k,v in (("FLEET_URL","fleet_url"),("FLEET_AK","fleet_s3_access_key"),("FLEET_SK","fleet_s3_secret_key")):
    val=str(d.get(v,"") or "").replace("\x27","")
    if val: print("%s=\x27%s\x27" % (k,val))' 2>/dev/null)"
  [ -n "${FLEET_URL:-}" ] && [ -n "${FLEET_AK:-}" ]; }

# ---- an endpoint that points back at THIS node ------------------------------
# A cloud VM usually cannot connect to its OWN public IP: there is no hairpin
# NAT, so the packet leaves and never comes back. The fleet endpoint
# fleet-<account>.blimp.software resolves to exactly that public IP, so on a
# single-node fleet every upload and every metadata write to it times out.
# Reported from a fresh GCP node (2026-09-15): "Connect timeout ... worked
# around by pinning the hostname to 127.0.0.1 in /etc/hosts".
#
# Same shape for the gateway's own docker hostname (minioserver:9000), which
# resolves inside the container network and nowhere else — table registration
# ran on the HOST and got 0/24.
#
# We do not try to work out WHY an address is unreachable (hairpin, split-horizon
# DNS, a firewall): we probe. If the published address will not open and the same
# port on loopback will, loopback is the same service one hop shorter — in a
# fleet EVERY node serves the fleet endpoint, and the gateway on this box serves
# its own S3. Anything genuinely remote is left alone.
endpoint_local(){
  local url="$1"
  [ -n "$url" ] || { printf '%s' "$url"; return 0; }
  "${BLIMP_PY:-python3}" - "$url" <<'PYEOF' 2>/dev/null || printf '%s' "$url"
import socket, sys
from urllib.parse import urlsplit, urlunsplit

url = sys.argv[1]
u = urlsplit(url if "://" in url else "http://" + url)
host, port = u.hostname, u.port or (443 if u.scheme == "https" else 80)
if not host or host in ("127.0.0.1", "localhost", "::1"):
    print(url); raise SystemExit

def opens(h, p, t=3.0):
    try:
        with socket.create_connection((h, p), timeout=t):
            return True
    except Exception:
        return False

# Only rewrite when the published address is DEAD and loopback is ALIVE.
print(url if opens(host, port) or not opens("127.0.0.1", port)
      else urlunsplit((u.scheme, "127.0.0.1:%d" % port, u.path, u.query, u.fragment)))
PYEOF
}

# ---- A. Iceberg catalog: gateway Nessie (default) | stand up here | existing --
# The gateway ALREADY runs a Nessie that serves Iceberg REST at :19122/iceberg
# over branch `main`. Registering into it is the internal path: nothing new to
# run, and the catalog the gateway itself reads is the one holding the tables.
# Standing one up here (:8181) or pointing at a URL you already have remain
# available — those were the only two choices before.
choose_catalog(){
  local c; c=$(pick CATALOG_CHOICE "Iceberg catalog" 1 \
    "use this cluster's gateway Nessie catalog (default, nothing to install)" \
    "stand up an Iceberg REST catalog on THIS box (:8181)" \
    "point at an Iceberg REST catalog I already have")
  case "$c" in
    1) ICEBERG_URL="http://$GW:19122/iceberg"
       ICEBERG_PREFIX="${ICEBERG_PREFIX:-main}"
       # Raw Nessie (:19122) is bound to localhost on the node (never exposed).
       # On-node register/seed/query reach it via loopback — which also sidesteps
       # the cloud-VM hairpin (a box cannot connect to its own public IP). Remote
       # query engines use the bearer-gated read-only shim on :19123 instead.
       ICEBERG_URL_LOCAL="http://127.0.0.1:19122/iceberg"
       export ICEBERG_PREFIX ICEBERG_URL_LOCAL
       if curl -s -m 8 "$ICEBERG_URL_LOCAL/v1/config" >/dev/null 2>&1; then
         bold "  using the gateway Nessie catalog — $ICEBERG_URL_LOCAL (branch $ICEBERG_PREFIX)"
         # Nessie warehouses are SERVER-CONFIGURED AND NAMED. A client cannot ask
         # for an arbitrary path: GET /v1/config?warehouse=s3://blimp-src/wh
         # returns 500 "Warehouse 's3://blimp-src/wh' is not known". The gateway
         # itself uses the name `mv` (ZS3_ICEBERG_WAREHOUSE), which resolves to
         # s3://tpcds-mv. So the warehouse here is a NAME, and table metadata
         # lands in whatever bucket that name resolves to — not in the data
         # bucket. Probe the name to confirm it before committing to it.
         ICEBERG_WAREHOUSE=$(ask ICEBERG_WAREHOUSE "  Nessie warehouse name" "mv")
         if curl -sf -m 8 "$ICEBERG_URL_LOCAL/v1/config?warehouse=$ICEBERG_WAREHOUSE" >/dev/null 2>&1; then
           NESSIE_WAREHOUSE=$(curl -s -m 8 "$ICEBERG_URL_LOCAL/v1/config?warehouse=$ICEBERG_WAREHOUSE" 2>/dev/null \
             | "${BLIMP_PY:-python3}" -c 'import json,sys
try: print(json.load(sys.stdin).get("defaults",{}).get("warehouse","") or "")
except Exception: print("")' 2>/dev/null)
           bold "    warehouse \"$ICEBERG_WAREHOUSE\" -> ${NESSIE_WAREHOUSE:-?} (table metadata lands there)"
         else
           bold "  ! warehouse \"$ICEBERG_WAREHOUSE\" is not known to this Nessie — falling back to a catalog on this box"
           ICEBERG_URL=""; ICEBERG_PREFIX=""; ICEBERG_WAREHOUSE=""
         fi
         export NESSIE_WAREHOUSE ICEBERG_WAREHOUSE
       else
         bold "  ! $ICEBERG_URL did not answer /v1/config — is :19122 reachable from here?"
         bold "    falling back to standing a catalog up on this box"
         ICEBERG_URL=""; ICEBERG_PREFIX=""
       fi ;;
    2) ICEBERG_URL=""; ICEBERG_PREFIX="" ;;   # standup_iceberg runs once WAREHOUSE is known
    3) ICEBERG_URL=$(ask ICEBERG_URL "  Iceberg REST URL")
       [ -n "$ICEBERG_URL" ] || die "an Iceberg REST URL is required for option 3"
       ICEBERG_PREFIX=$(ask ICEBERG_PREFIX "  REST prefix (Nessie branch; blank for a plain REST catalog)")
       ICEBERG_URL_LOCAL="$ICEBERG_URL"; export ICEBERG_PREFIX ICEBERG_URL_LOCAL ;;
  esac
  CATALOG_CHOICE="$c"; export CATALOG_CHOICE ICEBERG_URL
}

# ---- B. where the dataset (source) lives -------------------------------------
# Default is the fleet cache layer: the product's own S3 address, keyed by the
# fleet credentials the gateway hands out. The alternative is any other S3
# endpoint — your own bucket, or a MinIO/other-cloud address.
choose_source_location(){
  local have_fleet=0; fleet_creds && have_fleet=1
  # Option 2 is THIS node's own gateway S3. It was missing, and its absence was
  # a dead end on a locked-down box (reported 2026-09-15): if the fleet endpoint
  # could not be reached, the only other route stood up a fresh MinIO container
  # on :9000 — which needs a Docker Hub pull that an egress-restricted node
  # refuses, and collides with the gateway's own minioserver already on :9000.
  # The gateway is right there, already serving S3, already keyed.
  # GW_AK/GW_SK are this node's own MinIO root keys, discovered by heal_wiring()
  # from the local minioserver container (or the admin API when blimp runs off-box).
  local have_gw=0
  [ -n "${GW:-}" ] && [ -n "${GW_AK:-}" ] && [ -n "${GW_SK:-}" ] && have_gw=1
  local c
  if [ "$have_fleet" = 1 ] || [ "$have_gw" = 1 ]; then
    c=$(pick SOURCE_CHOICE "Dataset (source) location" "$([ "$have_fleet" = 1 ] && echo 1 || echo 2)" \
      "the fleet cache layer — ${FLEET_URL:-(unavailable)} (default)" \
      "this node's own gateway S3 — http://${GW:-?}:${S3_PORT:-9000} (nothing to install)" \
      "another S3 endpoint (your own bucket / MinIO / other cloud)")
  else
    bold "  (no fleet or gateway credentials — falling back to an external S3 endpoint)"
    c=3
  fi
  if [ "$c" = 1 ] && [ "$have_fleet" != 1 ]; then
    bold "  ! the fleet option needs a gateway with fleet mode on — using this node's gateway S3 instead"
    c=2
  fi
  if [ "$c" = 2 ] && [ "$have_gw" != 1 ]; then
    bold "  ! could not read this node's gateway S3 credentials — choose an external endpoint"
    c=3
  fi
  case "$c" in
    1) SOURCE_TARGET=fleet
       S3_ENDPOINT="$FLEET_URL"; S3_KEY="$FLEET_AK"; S3_SECRET="$FLEET_SK"
       ORIGIN_BUCKET=$(ask ORIGIN_BUCKET "  Bucket on the fleet endpoint" "blimp-src")
       bold "  source → $S3_ENDPOINT/$ORIGIN_BUCKET (fleet keys, fetched from the gateway)" ;;
    2) SOURCE_TARGET=gateway
       # The gateway's own S3, reached on loopback from this box. No container to
       # pull, no port to fight over, and the keys come from the node itself.
       S3_ENDPOINT="http://${GW}:${S3_PORT:-9000}"
       S3_KEY="$GW_AK"; S3_SECRET="$GW_SK"
       ORIGIN_BUCKET=$(ask ORIGIN_BUCKET "  Bucket on this node's gateway S3" "blimp-src")
       bold "  source → $S3_ENDPOINT/$ORIGIN_BUCKET (this node's gateway, keys read locally)" ;;
    3) SOURCE_TARGET=external
       ORIGIN_BUCKET=$(ask ORIGIN_BUCKET "  Data bucket (blank = generate one here)")
       [ -n "$ORIGIN_BUCKET" ] && S3_ENDPOINT=$(ask S3_ENDPOINT "  S3 endpoint URL of that bucket (MinIO/Ceph/R2/any cloud, e.g. http://minio:9000; blank = your cloud's S3 in $REGION)" "https://s3.${REGION}.amazonaws.com")
       # INCOMPATIBLE PAIR. The gateway's Nessie can only write table metadata
       # into a warehouse IT has configured — here s3://tpcds-mv, on the FLEET
       # endpoint. With the data on some other S3, metadata and data end up on
       # two different endpoints with two different credentials, and the
       # gateway's single source S3 config cannot reach both: every metadata
       # read fails. That is guardrail 1. Pairing Nessie with the fleet is fine
       # precisely because both buckets are then the same endpoint + keys.
       if [ "${CATALOG_CHOICE:-}" = 1 ]; then
         bold "  ! the gateway Nessie catalog writes metadata to its own warehouse on the FLEET"
         bold "    endpoint, but your data is on a different S3 — the gateway cannot read both."
         bold "    Standing a catalog up on this box instead, co-located with your bucket."
         ICEBERG_URL=""; ICEBERG_PREFIX=""; ICEBERG_WAREHOUSE=""; NESSIE_WAREHOUSE=""
         CATALOG_CHOICE=2; export CATALOG_CHOICE ICEBERG_URL ICEBERG_PREFIX
       fi ;;
  esac
  SOURCE_CHOICE="$c"; export SOURCE_CHOICE SOURCE_TARGET
}

# ---- C. build a TPC-DS test dataset? ----------------------------------------
# Default yes at SF1. The scale factors are the ones the query/bench suites are
# calibrated against; SF1000 is ~1 TB and takes hours to generate, so it is
# offered but never the default.
choose_dataset(){
  local c; c=$(pick BUILD_DATASET "Build a TPC-DS test dataset at that location?" 1 \
    "yes (default)" "no — I will bring my own data")
  if [ "$c" != 1 ]; then BUILD_DATASET=0; export BUILD_DATASET; return 0; fi
  # Generation stages the whole dataset on local disk before upload, so the
  # sizes below are what the SCRATCH disk needs, not just the bucket. Anything
  # past SF1000 wants a dedicated data disk — scratch_pick() refuses up front
  # rather than filling root mid-run.
  local sf; sf=$(pick SF_CHOICE "Scale factor" 1 \
    "SF1      ~1 GB    (default — minutes)" \
    "SF10     ~10 GB   (tens of minutes)" \
    "SF100    ~100 GB  (hours)" \
    "SF1000   ~1 TB    (many hours; needs a big box + disk)" \
    "SF10000  ~10 TB   (days; needs a dedicated data disk)" \
    "SF100000 ~100 TB  (fleet scale; plan the disk before you pick this)")
  case "$sf" in
    1) BLIMP_SF=1;; 2) BLIMP_SF=10;; 3) BLIMP_SF=100;; 4) BLIMP_SF=1000;;
    5) BLIMP_SF=10000;; 6) BLIMP_SF=100000;;
  esac
  BUILD_DATASET=1; SF_CHOICE="$sf"; export BUILD_DATASET BLIMP_SF SF_CHOICE
  bold "  will generate TPC-DS SF${BLIMP_SF} and register it into the catalog"
}

standup_iceberg(){
  local DKR=docker; command -v docker >/dev/null || DKR="sudo docker"
  $DKR info >/dev/null 2>&1 || DKR="sudo docker"
  $DKR info >/dev/null 2>&1 || die "docker not available — needed to stand up the Iceberg catalog. Install docker, or pass an existing Iceberg REST URL."

  # NESSIE, the same catalog the gateway runs internally.
  #
  # This used to be tabulario/iceberg-rest (a JDBC/SQLite REST catalog). Running
  # a DIFFERENT implementation here than the product uses internally meant two
  # catalogs to reason about and two dialects in every consumer: Nessie nests
  # its routes under a branch prefix and takes a warehouse NAME, the JDBC one
  # serves the root and takes an s3:// path. Every caller had to branch on which
  # kind it was talking to. Standing up Nessie makes the local catalog identical
  # in shape to the internal one — same prefix, same warehouse-name semantics,
  # same REST dialect — so there is exactly one catalog type in the product.
  # Recipe mirrors zs3-init.go installZusCatalog (ROCKSDB store, warehouse by
  # name, S3 options + secret indirection, management iface off).
  local wname="${ICEBERG_WAREHOUSE:-src}"
  local wupper; wupper=$(printf '%s' "$wname" | tr '[:lower:]-' '[:upper:]_')
  local wbucket="${ORIGIN_BUCKET:?a data bucket is required before standing up the catalog}"
  local port="${ICEBERG_PORT:-8181}"
  local ep="${S3_ENDPOINT:-https://s3.${REGION}.amazonaws.com}"

  # IDEMPOTENT: a healthy Nessie already serving THIS warehouse name over THIS
  # bucket is reused. Recreating on every --setup tore down a working catalog
  # (and anything mid-flight against it) to rebuild an identical one.
  if curl -sf -m 4 "http://localhost:$port/iceberg/v1/config?warehouse=$wname" >/dev/null 2>&1; then
    local cur
    cur=$($DKR inspect -f '{{range .Config.Env}}{{println .}}{{end}}' blimp-nessie 2>/dev/null \
          | sed -n "s/^NESSIE_CATALOG_WAREHOUSES_${wupper}_LOCATION=//p" | head -1)
    if [ "$cur" = "s3://$wbucket/" ]; then
      ICEBERG_URL="http://$(this_host):$port/iceberg"
      ICEBERG_URL_LOCAL="http://$(local_host):$port/iceberg"
      ICEBERG_PREFIX="${ICEBERG_PREFIX:-main}"; ICEBERG_WAREHOUSE="$wname"
      export ICEBERG_URL_LOCAL ICEBERG_PREFIX ICEBERG_WAREHOUSE
      bold "  Nessie already up over s3://$wbucket ($ICEBERG_URL, warehouse $wname) — reusing it"
      return 0
    fi
    bold "  catalog on :$port points at ${cur:-<unknown>}, not s3://$wbucket/ — replacing it"
  fi

  bold "standing up Nessie on :$port over s3://$wbucket (warehouse \"$wname\")"
  sudo mkdir -p /opt/blimp/nessie 2>/dev/null || mkdir -p /opt/blimp/nessie
  $DKR rm -f blimp-nessie >/dev/null 2>&1 || true
  # Path-style access: the fleet endpoint and MinIO are single hosts, not
  # per-bucket virtual hosts. Harmless against real AWS.
  $DKR run -d --name blimp-nessie --restart unless-stopped \
    -p "$port:19120" \
    -v /opt/blimp/nessie:/data/nessie \
    -e NESSIE_VERSION_STORE_TYPE=ROCKSDB \
    -e NESSIE_VERSION_STORE_PERSIST_ROCKS_DATABASE_PATH=/data/nessie \
    -e NESSIE_CATALOG_DEFAULT_WAREHOUSE="$wname" \
    -e "NESSIE_CATALOG_WAREHOUSES_${wupper}_LOCATION=s3://$wbucket/" \
    -e NESSIE_CATALOG_SERVICE_S3_DEFAULT_OPTIONS_REGION="$REGION" \
    -e NESSIE_CATALOG_SERVICE_S3_DEFAULT_OPTIONS_ENDPOINT="$ep" \
    -e NESSIE_CATALOG_SERVICE_S3_DEFAULT_OPTIONS_PATH_STYLE_ACCESS=true \
    -e NESSIE_CATALOG_SERVICE_S3_DEFAULT_OPTIONS_REQUEST_SIGNING_ENABLED=false \
    -e NESSIE_CATALOG_SERVICE_S3_DEFAULT_OPTIONS_ACCESS_KEY=urn:nessie-secret:quarkus:nessie.catalog.secrets.access-key \
    -e nessie.catalog.secrets.access-key.name="${S3_KEY:-${AWS_ACCESS_KEY_ID:-}}" \
    -e nessie.catalog.secrets.access-key.secret="${S3_SECRET:-${AWS_SECRET_ACCESS_KEY:-}}" \
    -e QUARKUS_HTTP_PORT=19120 \
    -e QUARKUS_MANAGEMENT_ENABLED=false \
    ghcr.io/projectnessie/nessie:latest >/dev/null || die "failed to start blimp-nessie"

  # Quarkus cold-start on a small box runs well past a minute; the internal
  # installer waits generously for the same reason.
  local i
  for i in $(seq 1 40); do
    curl -sf -m 4 "http://localhost:$port/iceberg/v1/config?warehouse=$wname" >/dev/null 2>&1 && break
    sleep 5
  done
  curl -sf -m 4 "http://localhost:$port/iceberg/v1/config?warehouse=$wname" >/dev/null 2>&1 \
    || die "Nessie did not come up on :$port (check: $DKR logs blimp-nessie)"

  ICEBERG_URL="http://$(this_host):$port/iceberg"
  # The cluster reaches it at ICEBERG_URL; WE reach it on loopback. Both are
  # written to the wiring so local tools (seed_tpcds.py, register_tpcds_tables.py)
  # never dial our own public address.
  ICEBERG_URL_LOCAL="http://$(local_host):$port/iceberg"
  ICEBERG_PREFIX=main; ICEBERG_WAREHOUSE="$wname"
  WAREHOUSE="$wname"     # Nessie takes the NAME everywhere, never the s3:// path
  export ICEBERG_URL_LOCAL ICEBERG_PREFIX ICEBERG_WAREHOUSE
  bold "  Nessie up — cluster reaches it at $ICEBERG_URL (local tools use $ICEBERG_URL_LOCAL), warehouse \"$wname\" -> s3://$wbucket/"
}

# ---- create an S3 warehouse bucket here (awscli) ----------------------------
# GUARDRAIL 1 (co-location): the Iceberg warehouse (table metadata) MUST live in
# the SAME bucket as the source data. The gateway reads catalog metadata through
# its single source bucket (localhost:9000 fronts ZS3_SOURCE_BUCKET only); a
# warehouse in a *different* bucket makes every metadata read 500 → grain
# unsampleable → the MV author refuses. So when a data bucket is known we put the
# warehouse at s3://<data-bucket>/wh; only with no data bucket do we mint one.
standup_bucket(){
  command -v aws >/dev/null || die "awscli not installed — the S3 client this kit uses for any S3-compatible endpoint. Install it, or pass an existing s3:// warehouse."
  aws sts get-caller-identity >/dev/null 2>&1 || die "S3 credentials not working — run 'aws configure' (or set AWS_PROFILE), or pass an existing s3:// warehouse."
  local bkt="${ORIGIN_BUCKET:-blimp-wh-${CLUSTER_ID:-$(this_host | tr -d '.')}}"
  bold "creating/using S3 warehouse bucket s3://$bkt in $REGION"
  if [ "$REGION" = us-east-1 ]; then
    aws s3api create-bucket --bucket "$bkt" --region "$REGION" >/dev/null 2>&1 || true
  else
    aws s3api create-bucket --bucket "$bkt" --region "$REGION" \
      --create-bucket-configuration "LocationConstraint=$REGION" >/dev/null 2>&1 || true
  fi
  aws s3api head-bucket --bucket "$bkt" >/dev/null 2>&1 || die "could not create/access s3://$bkt"
  WAREHOUSE="s3://$bkt/wh"
  bold "  warehouse -> $WAREHOUSE  (co-located with data bucket $bkt)"
}

# ---- GUARDRAIL 2 (IAM): grant BOTH the gateway instance role and the Iceberg
# catalog principal read/write on the data+warehouse bucket. On a split like the
# SF1 test — data written by aws-cli, catalog registered by IAM user
# blimp-catalog-*, gateway reading via its EC2 role — any one of the three
# lacking access is a silent 403 at author time. Same-account/VPC only (we can
# discover the gateway role); external creds are granted by the customer bucket
# owner instead. Merges into any existing bucket policy, never clobbers.
grant_bucket_access(){
  local bkt="${1:?bucket}"
  command -v aws >/dev/null && aws sts get-caller-identity >/dev/null 2>&1 || {
    bold "  (skip bucket-policy grant — no cloud credentials here; ensure the bucket owner grants the gateway role + catalog user s3:Get/Put/List)"; return 0; }
  local acct; acct=$(aws sts get-caller-identity --query Account --output text 2>/dev/null)
  # gateway instance role ARN (same account) — discover from the running gateway
  local role_arn=""
  local prof; prof=$(aws ec2 describe-instances --region "$CLUSTER_REGION" \
    --filters "Name=tag:Name,Values=cluster-${CLUSTER_ID}-zs3server" "Name=instance-state-name,Values=running" \
    --query 'Reservations[0].Instances[0].IamInstanceProfile.Arn' --output text 2>/dev/null)
  if [ -n "$prof" ] && [ "$prof" != None ]; then
    local pname="${prof##*/}"
    role_arn=$(aws iam get-instance-profile --instance-profile-name "$pname" \
      --query 'InstanceProfile.Roles[0].Arn' --output text 2>/dev/null)
  fi
  [ "$role_arn" = None ] && role_arn=""
  # Explicit override for the cases discovery cannot cover: cross-account, a
  # gateway not tagged cluster-<id>-zs3server, or (the case that bit us) a client
  # whose own IAM role lacks ec2:DescribeInstances / iam:GetInstanceProfile.
  [ -z "$role_arn" ] && role_arn="${GATEWAY_ROLE_ARN:-}"
  # principals: account root (covers the catalog IAM user + aws-cli writer in this
  # account) plus the gateway role explicitly (belt & suspenders if it's assumed).
  local princ="\"arn:aws:iam::${acct}:root\""
  [ -n "$role_arn" ] && princ="$princ, \"$role_arn\""
  bold "  granting s3 access on s3://$bkt to account $acct${role_arn:+ + gateway role}"
  # MERGE, don't clobber. This used to build a single-statement document and
  # put-bucket-policy it, which REPLACES the whole policy — so a second --setup
  # silently deleted every other statement on the bucket. Measured on
  # 2026-08-01: an operator-added grant for the gateway role (the only thing
  # making reads work) was wiped by a re-run, and the gateway went back to 403
  # with "no identity-based policy allows the s3:ListBucket action".
  #
  # Keep every statement that is not ours, replace only Sid BlimpSourceAccess.
  local existing; existing=$(aws s3api get-bucket-policy --bucket "$bkt" --query Policy --output text 2>/dev/null)
  local pol; pol=$(EXISTING="$existing" PRINC="$princ" BKT="$bkt" python3 - <<'PYEOF'
import json, os
princ = json.loads("[" + os.environ["PRINC"] + "]")
bkt = os.environ["BKT"]
ours = {
    "Sid": "BlimpSourceAccess", "Effect": "Allow",
    "Principal": {"AWS": princ},
    "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation"],
    "Resource": [f"arn:aws:s3:::{bkt}", f"arn:aws:s3:::{bkt}/*"],
}
doc = {"Version": "2012-10-17", "Statement": []}
raw = os.environ.get("EXISTING", "").strip()
if raw:
    try:
        prev = json.loads(raw)
        doc["Statement"] = [st for st in prev.get("Statement", []) if st.get("Sid") != "BlimpSourceAccess"]
    except Exception:
        pass  # unparseable policy: fall through to ours alone rather than fail the setup
doc["Statement"].append(ours)
print(json.dumps(doc))
PYEOF
)
  [ -n "$existing" ] && bold "  (merging into the bucket's existing policy — other statements are preserved)"
  if aws s3api put-bucket-policy --bucket "$bkt" --policy "$pol" >/dev/null 2>&1; then
    if [ -n "$role_arn" ]; then
      bold "  ✓ bucket policy applied to s3://$bkt (account + gateway role $role_arn)"
    else
      # A policy naming ONLY <acct>:root grants the gateway NOTHING: for
      # same-account access :root merely DELEGATES to IAM, so a role without its
      # own s3 allow still gets 403. Saying "✓ applied" here is how a broken
      # grant looked successful while every read failed 403 (2026-08-01).
      bold "  ! bucket policy applied to s3://$bkt, but the GATEWAY ROLE could not be discovered"
      bold "    (this client's IAM has no ec2:DescribeInstances / iam:GetInstanceProfile, or the"
      bold "     gateway is in another account). A policy naming only <account>:root does NOT grant"
      bold "     the gateway access — it delegates to IAM, and the gateway role has no s3 allow."
      bold "    Fix with either:"
      bold "      GATEWAY_ROLE_ARN=arn:aws:iam::<acct>:role/<gateway-role> ./blimp --setup"
      bold "      or have the bucket owner add that role as a Principal on s3://$bkt"
    fi
  else
    bold "  (could not set bucket policy on s3://$bkt — may already be owned cross-account; ensure the owner grants the gateway role + catalog user)"
  fi
}

# ---- auto-assess network mode: same-VPC (private) vs external cloud (public) --
# The ONE signal that matters: can THIS node reach the cluster gateway's PRIVATE
# IP? Yes → vpc mode (private IPs, IAM role, VPC S3 endpoint — no egress). No
# (non-AWS, cross-VPC, or cross-account) → external mode (stable DNS, explicit
# creds, public advertise). Sets MODE / GW_DEFAULT / ADVERTISE_DEFAULT / CREDS_HINT.

# pub_gw_default <cluster-id> — the public address of node 0, preferring the
# current pattern and falling back to the legacy one only if it resolves.
# Resolution is attempted with whatever the host has (getent / host / python3);
# with none of them, the current pattern is returned unchanged.
pub_gw_default(){
  local id="$1" cur="blimp-$1-0.blimp.software" old="zus-$1-0.zus.network" h
  _resolves(){
    if command -v getent >/dev/null 2>&1; then getent hosts "$1" >/dev/null 2>&1 && return 0; return 1; fi
    if command -v host   >/dev/null 2>&1; then host "$1" >/dev/null 2>&1 && return 0; return 1; fi
    if command -v python3 >/dev/null 2>&1; then python3 - "$1" <<'PY' >/dev/null 2>&1 && return 0; return 1
import socket,sys
socket.gethostbyname(sys.argv[1])
PY
    fi
    return 2   # nothing to resolve with — caller keeps the current pattern
  }
  _resolves "$cur" && { printf '%s' "$cur"; return; }
  [ $? = 1 ] && _resolves "$old" && { printf '%s' "$old"; return; }
  printf '%s' "$cur"
}

# IMDS is AWS-specific. On GCP and Azure the SAME address answers, with an HTML
# error page — which used to be stored as the node's "IP" and printed mid-run
# (reported from a GCP node, 2026-09-15). Accept a value only if it looks like
# what was asked for; off AWS that yields empty, which is a no-op, not an error.
imds_ipv4(){
  local v; v=$(curl -s -m 2 "$@" 2>/dev/null) || return 0
  case "$v" in ""|*[!0-9.]*) return 0;; esac
  case "$v" in *.*.*.*) printf '%s' "$v";; esac
}

assess_mode(){
  MODE=external; GW_PRIV=""; GW_PUB=""
  local imds="http://169.254.169.254/latest/meta-data" tok
  tok=$(curl -s -m 2 -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 120" 2>/dev/null)
  local H=(); [ -n "$tok" ] && H=(-H "X-aws-ec2-metadata-token: $tok")
  CLIENT_PRIV=$(imds_ipv4 "${H[@]}" "$imds/local-ipv4")
  CLIENT_PUB=$(imds_ipv4 "${H[@]}" "$imds/public-ipv4")
  # discover the cluster gateway's private IP (needs aws CLI + creds + a running gw)
  if command -v aws >/dev/null && aws sts get-caller-identity >/dev/null 2>&1; then
    read -r GW_PRIV GW_PUB <<<"$(aws ec2 describe-instances --region "$CLUSTER_REGION" \
      --filters "Name=tag:Name,Values=cluster-${CLUSTER_ID}-zs3server" "Name=instance-state-name,Values=running" \
      --query 'Reservations[0].Instances[0].[PrivateIpAddress,PublicIpAddress]' --output text 2>/dev/null)"
    [ "$GW_PRIV" = None ] && GW_PRIV=""; [ "$GW_PUB" = None ] && GW_PUB=""
  fi
  # FALLBACK when the EC2 lookup is unavailable. Discovery above needs
  # ec2:DescribeInstances, which a client's own instance role often lacks — and
  # when it silently returned nothing, GW_PRIV stayed empty, the probe below
  # never ran, MODE fell to external, and the node advertised its PUBLIC address
  # to a gateway that can only reach it privately. Every catalog read then hung
  # until timeout (cluster 1785550395356, 2026-08-01). So: if the operator
  # already told us the gateway address and it is a private one, probe THAT.
  if [ -z "$GW_PRIV" ] && [ -n "${GW:-}" ]; then
    case "$GW" in
      10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) GW_PRIV="$GW" ;;
    esac
  fi
  if [ -z "$GW_PRIV" ]; then
    bold "  ! gateway private address not discoverable (no cloud API access from here, or not a cloud node)."
    bold "    Using the public endpoint. If this client IS on the node's private network, re-run with"
    bold "    GW=<gateway-private-ip> so the catalog is advertised on a reachable address."
  fi
  # authoritative probe: reach the gateway PRIVATE IP (covers same-VPC AND peered)
  if [ -n "$GW_PRIV" ] && [ "$(curl -s -m 3 -o /dev/null -w '%{http_code}' "http://$GW_PRIV:9000/minio/health/live" 2>/dev/null)" = 200 ]; then
    MODE=vpc
  fi
  # CREDENTIAL domain is decided by ACCOUNT, not network reachability. If the
  # describe-instances above FOUND the gateway, this node's AWS identity is in
  # the SAME account → the IAM role reaches S3 (cross-REGION is fine; S3 access
  # is account-scoped), so NO keys are needed even when the gateway's private IP
  # is unreachable (different region / AZ / unpeered VPC). Keys are required only
  # when the gateway isn't discoverable from here — a different account or a
  # non-AWS host. SAME_ACCT drives whether --setup prompts for keys.
  SAME_ACCT=0; { [ -n "$GW_PRIV" ] || [ -n "$GW_PUB" ]; } && SAME_ACCT=1
  if [ "$MODE" = vpc ]; then
    GW_DEFAULT="$GW_PRIV"; ADVERTISE_DEFAULT="$CLIENT_PRIV"; CREDS_HINT="blank (IAM instance role — same VPC/account)"
  else
    # External NETWORK path (public DNS + advertise this node publicly)…
    # Public endpoint of node 0. The pattern is blimp-<id>-0.blimp.software; the
    # older zus-<id>-0.zus.network is kept only as a fallback for a legacy
    # cluster, and ONLY when it actually resolves — it was the hardcoded default
    # here, and it no longer resolves at all (SERVFAIL), so a client that could
    # not discover the gateway was handed an address that does not exist.
    GW_DEFAULT="${GW_PUB:-$(pub_gw_default "$CLUSTER_ID")}"
    ADVERTISE_DEFAULT="${CLIENT_PUB:-$(curl -s -m3 https://checkip.amazonaws.com 2>/dev/null | tr -d '[:space:]')}"
    if [ "$SAME_ACCT" = 1 ]; then
      # …but SAME account → still key-free (cross-region AWS-internal).
      CREDS_HINT="blank (IAM instance role — same account, cross-region)"
    else
      CREDS_HINT="explicit S3 keys (external / cross-account)"
    fi
  fi
  # "vpc"/"external" stay as the internal mode ids (every gate keys on them); the
  # user reads it as "can I reach the gateway on its private address or not".
  bold "network assessment → private gateway ${GW_PRIV:-unknown} reachable: $([ "$MODE" = vpc ] && echo 'yes (private path, nothing to type)' || echo 'no (public endpoint)')$([ "$MODE" != vpc ] && [ "$SAME_ACCT" = 1 ] && echo ' — same cloud account, cross-region')"
  echo "  gateway → $GW_DEFAULT · advertise this node as → ${ADVERTISE_DEFAULT:-<set ADVERTISE_HOST>} · S3 creds → $CREDS_HINT"
}

# ---- install the prerequisites this kit needs (idempotent) ------------------
# So a fresh node needs nothing pre-installed: docker (stand up the catalog),
# python venv + pyiceberg/pyarrow/boto3 (register tables + CDC appends), unzip
# (DuckDB CLI for the query suite), aws CLI (bucket create/grant + SSM). apt
# systems get the packages installed; anything already present is skipped; a
# non-apt host just gets a clear per-tool hint instead of a hard failure. Set
# BLIMP_SKIP_DEPS=1 to bypass (offline / hardened hosts). The venv path is
# recorded to the wiring (BLIMP_PY) so the test scripts reuse it.
ensure_deps(){
  [ "${BLIMP_SKIP_DEPS:-0}" = 1 ] && return 0
  bold "== checking prerequisites =="
  if command -v apt-get >/dev/null; then
    local want=() ; command -v docker >/dev/null || want+=(docker.io)
    command -v unzip  >/dev/null || want+=(unzip)
    python3 -c 'import ensurepip' 2>/dev/null || want+=(python3-venv)
    command -v aws >/dev/null || command -v snap >/dev/null || want+=(awscli)
    if [ "${#want[@]}" -gt 0 ]; then
      bold "  installing: ${want[*]}"
      sudo apt-get update -qq 2>/dev/null || true
      sudo apt-get install -y -qq "${want[@]}" 2>&1 | tail -1 || true
    fi
    command -v docker >/dev/null && sudo systemctl enable --now docker >/dev/null 2>&1 || true
    # aws CLI: prefer snap (newer) when apt's awscli is absent
    command -v aws >/dev/null || { command -v snap >/dev/null && sudo snap install aws-cli --classic >/dev/null 2>&1 || true; }
  elif command -v dnf >/dev/null || command -v yum >/dev/null; then
    # RPM hosts — Amazon Linux 2023, RHEL, Fedora, Rocky. Without this branch the
    # kit printed a hint and then died at the catalog step ("docker not
    # available"), which contradicts the README's "you need nothing
    # pre-installed" on the single most likely AWS AMI (AL2023, 2026-08-01).
    local PKG; PKG=$(command -v dnf >/dev/null && echo dnf || echo yum)
    local want=()
    command -v docker >/dev/null || want+=(docker)
    command -v unzip  >/dev/null || want+=(unzip)
    python3 -c 'import ensurepip' 2>/dev/null || want+=(python3-pip)
    if [ "${#want[@]}" -gt 0 ]; then
      bold "  installing: ${want[*]}"
      sudo "$PKG" install -y -q "${want[@]}" 2>&1 | tail -1 || true
    fi
    if command -v docker >/dev/null; then
      sudo systemctl enable --now docker >/dev/null 2>&1 || true
      # AL2023 does not add the invoking user to the docker group, so every
      # later `docker` call would need sudo. Add it AND fall back to sudo for
      # this session, since a new group only applies to a new login.
      sudo usermod -aG docker "$(id -un)" >/dev/null 2>&1 || true
      # a fresh group needs a new login, so this session keeps using sudo — the
      # catalog step already falls back to `sudo docker` when `docker info` fails.
    fi
    command -v aws >/dev/null || sudo "$PKG" install -y -q awscli 2>&1 | tail -1 || true
  else
    command -v docker >/dev/null || echo "  ! docker not found (needed to stand up the catalog) — install it or pass an existing Iceberg URL"
    command -v aws    >/dev/null || echo "  ! aws CLI not found (the S3 client this kit uses for any S3-compatible endpoint) — install it or pass an existing warehouse"
  fi
  # python venv with the Iceberg libs (register_tpcds_tables.py / seed_tpcds.py)
  BLIMP_PY="${BLIMP_PY:-$HOME/.blimp_venv/bin/python3}"
  if ! "$BLIMP_PY" -c 'import pyiceberg' 2>/dev/null; then
    if command -v python3 >/dev/null && python3 -c 'import ensurepip' 2>/dev/null; then
      bold "  creating python venv + pyiceberg (one-time)…"
      python3 -m venv "$HOME/.blimp_venv" 2>/dev/null \
        && "$HOME/.blimp_venv/bin/pip" install -q --upgrade pip 2>/dev/null \
        && "$HOME/.blimp_venv/bin/pip" install -q "pyiceberg[s3fs]" pyarrow boto3 2>&1 | tail -1
      BLIMP_PY="$HOME/.blimp_venv/bin/python3"
    fi
  fi
  "$BLIMP_PY" -c 'import pyiceberg' 2>/dev/null \
    && bold "  ✓ deps ready (python: $BLIMP_PY)" \
    || { BLIMP_PY=python3; echo "  ! pyiceberg unavailable — register/CDC steps need: pip install 'pyiceberg[s3fs]' pyarrow boto3"; }
  export BLIMP_PY
}

cmd_setup(){
  bold "== blimp --setup — connect a Blimp cluster to this node's data =="
  ensure_deps
  echo
  # "Region" only means something for a bucket on AWS; MinIO / Ceph / R2 / the
  # node's own fleet layer accept any value and the node itself runs us-east-1.
  REGION=$(ask REGION "S3 region (cloud buckets only; any value for MinIO/other S3)" "us-east-1")
  # REGION is overloaded: it is the Blimp CLUSTER's AWS region here, but
  # standup_data.sh REASSIGNS it to the ORIGIN's S3 region (us-east-1 for the
  # MinIO source it stands up on this box). Every EC2/SSM lookup for the gateway
  # must keep using the cluster's region, so pin it now, before that happens.
  CLUSTER_REGION="${CLUSTER_REGION:-$REGION}"; export CLUSTER_REGION
  CLUSTER_ID=$(ask CLUSTER_ID "Blimp cluster id (from blimp.software)")
  [ -n "$CLUSTER_ID" ] || die "CLUSTER_ID is required (the Blimp cluster to connect)"
  # Zero-touch: probe the private gateway path and pick vpc vs external mode, then
  # derive the gateway address, the address we advertise this node on, and the
  # creds default from it. Every value stays overridable via the prompts/env.
  echo; assess_mode
  GW=$(ask GW "Blimp gateway address" "$GW_DEFAULT")
  # this_host() advertises ADVERTISE_HOST to the cluster; default it from the mode
  # (private IP in vpc mode, public IP/DNS in external mode).
  [ -n "${ADVERTISE_HOST:-}" ] || ADVERTISE_HOST="$ADVERTISE_DEFAULT"
  export ADVERTISE_HOST
  NAMESPACE=$(ask NAMESPACE "Iceberg namespace" "tpcds")

  # --- A. Iceberg catalog · B. source location · C. test dataset -------------
  # These three used to be EXTERNAL-only: "give me your REST URL or I stand one
  # up here", "give me your bucket", and an implicit SF1 generated only when the
  # bucket was left blank. The defaults are now the INTERNAL ones — the catalog
  # the gateway already runs, and the fleet cache layer as the source — with the
  # bring-your-own paths kept as explicit choices.
  choose_catalog
  # No header here: choose_source_location's own pick() already prints
  # "Dataset (source) location", so this printed it twice.
  choose_source_location
  echo
  choose_dataset

  DATA_GENERATED=0
  if [ "${BUILD_DATASET:-0}" = 1 ]; then
    bold "  generating TPC-DS SF${BLIMP_SF} — all 24 tables"
    local gen
    gen=$(REGION="$REGION" CLUSTER_ID="$CLUSTER_ID" ADVERTISE_HOST="${ADVERTISE_HOST:-}" \
      BLIMP_SF="${BLIMP_SF:-1}" BLIMP_DATA_TARGET="${SOURCE_TARGET:-external}" \
      FLEET_ENDPOINT="$(endpoint_local "${S3_ENDPOINT:-}")" FLEET_KEY="${S3_KEY:-}" FLEET_SECRET="${S3_SECRET:-}" \
      FLEET_BUCKET="${ORIGIN_BUCKET:-}" \
      bash "$HERE/standup_data.sh") || die "SF${BLIMP_SF} data standup failed"
    eval "$gen"                      # sets ORIGIN_BUCKET WAREHOUSE S3_ENDPOINT [S3_KEY S3_SECRET] REGION
    # standup_data emits WAREHOUSE=s3://<bucket>/wh, which is right for a path
    # catalog and WRONG for Nessie — it takes a warehouse NAME and 500s on a
    # path. The eval above happens AFTER the catalog was chosen, so it would
    # silently clobber the name: the first E2E registered 24/24 with "mv" but
    # then wired the gateway with "s3://blimp-e2e/wh". Restore the name here.
    [ -n "${ICEBERG_WAREHOUSE:-}" ] && WAREHOUSE="$ICEBERG_WAREHOUSE"
    DATA_GENERATED=1
    bold "  SF${BLIMP_SF} source → bucket $ORIGIN_BUCKET · endpoint $S3_ENDPOINT · region $REGION"
  elif [ -z "${ORIGIN_BUCKET:-}" ]; then
    die "no dataset to build and no data bucket given — pick a bucket, or answer yes to the test dataset"
  fi
  # Warehouse (Iceberg metadata) co-locates INSIDE the data bucket (guardrail 1)
  # — EXCEPT on Nessie, where the warehouse is a NAME the server already knows,
  # not a path. Nessie 500s on an unknown one ("Warehouse 's3://…' is not
  # known"), and this value goes to BOTH the registrar and the gateway's
  # /admin/source/configure (which sends it as IRC_URL "<url>|<warehouse>"), so
  # getting it wrong breaks registration AND every source read.
  WAREHOUSE=$(ask WAREHOUSE "  Warehouse (Nessie: a warehouse NAME; otherwise s3://bucket/prefix)" \
    "${ICEBERG_WAREHOUSE:-${ORIGIN_BUCKET:+s3://$ORIGIN_BUCKET/wh}}")
  # Guardrail 1 enforcement: warn loudly if warehouse and data bucket diverge — a
  # split makes the gateway's catalog-metadata reads 500 and the MV author refuse.
  local wh_bkt; wh_bkt=$(echo "$WAREHOUSE" | sed -E 's#^s3://([^/]+).*#\1#')
  # A Nessie warehouse name is not an s3:// path, so the co-location check does
  # not apply to it at all — skip rather than warn on every run.
  if [ -z "${ICEBERG_WAREHOUSE:-}" ] && [ -n "$ORIGIN_BUCKET" ] && [ "$wh_bkt" != "$ORIGIN_BUCKET" ]; then
    printf '\033[33m  ⚠ warehouse bucket (%s) ≠ data bucket (%s). The gateway serves catalog\n    metadata only from the data bucket; a split will make MV authoring fail.\n    Recommended: use s3://%s/wh. Continue anyway? [y/N] \033[0m' "$wh_bkt" "$ORIGIN_BUCKET" "$ORIGIN_BUCKET" >&2
    local yn; read -r yn </dev/tty || true
    [ "${yn:-N}" = y ] || [ "${yn:-N}" = Y ] || WAREHOUSE="s3://$ORIGIN_BUCKET/wh"
  fi
  # Explicit S3 keys are REQUIRED only when this node's AWS identity can't reach
  # the bucket via a role — i.e. a DIFFERENT account or a non-AWS host. We ask
  # ONLY then. vpc mode (same VPC) and external-but-SAME-account (cross-region /
  # unpeered VPC) both use the IAM instance role, so no prompt — asking-then-blank
  # was noise and a stray "none" poisons the catalog. A pre-set S3_KEY still wins.
  if { [ "${MODE:-external}" = external ] && [ "${SAME_ACCT:-0}" != 1 ]; } || [ -n "${S3_KEY:-}" ]; then
    S3_KEY=$(ask S3_KEY "  S3 access key ($CREDS_HINT)")
    S3_SECRET=$(ask S3_SECRET "  S3 secret key (required cross-account)")
  fi
  # Treat a blank / whitespace / literal "none" as "use the IAM role" — never
  # hand a bogus key to the catalog or gateway.
  case "$(printf '%s' "${S3_KEY:-}" | tr -d '[:space:]')" in ""|none|None|NONE) S3_KEY=""; S3_SECRET="";; esac

  # Guardrail 2: grant the gateway role + catalog principal access to the bucket
  # (same-account only; no-op with a clear hint when we can't).
  [ -n "$ORIGIN_BUCKET" ] && grant_bucket_access "$ORIGIN_BUCKET"

  # stand up the catalog now that WAREHOUSE is known
  [ -n "$ICEBERG_URL" ] || standup_iceberg

  # We generated a source — register its 24 tables into WHICHEVER catalog was
  # chosen in A (BYO-data users register their own with register_tpcds_tables.py).
  # Targets ICEBERG_URL_LOCAL, which is loopback for a catalog we stood up here
  # and the gateway's address for the Nessie option — NOT a hardcoded :8181,
  # which silently registered into the wrong catalog once a second one existed.
  if [ "${DATA_GENERATED:-0}" = 1 ]; then
    local cat_url="${ICEBERG_URL_LOCAL:-${ICEBERG_URL:-http://localhost:8181}}"
    # Nessie serves every REST route under its branch prefix; a plain REST
    # catalog does not. Build both the probe path and the registrar flag from it.
    local pfx="${ICEBERG_PREFIX:-}" pfx_path="" pfx_flag=""
    [ -n "$pfx" ] && { pfx_path="/$pfx"; pfx_flag="--prefix $pfx"; }
    # IDEMPOTENT: registration is add_files against the catalog, so re-running it
    # on an already-populated namespace is wasted work that ends in a warning.
    local have; have=$(curl -s -m 8 "$cat_url/v1$pfx_path/namespaces/$NAMESPACE/tables" 2>/dev/null \
                       | grep -o '"name"' | wc -l | tr -d ' ')
    if [ "${have:-0}" -ge 24 ]; then
      bold "  ✓ $NAMESPACE already has $have tables registered — skipping registration"
    else
    # Nessie takes the warehouse NAME (it resolves it server-side); a plain REST
    # catalog takes the s3:// path. Sending the path to Nessie is a hard 500.
    local reg_wh="$WAREHOUSE"
    [ -n "${ICEBERG_WAREHOUSE:-}" ] && reg_wh="$ICEBERG_WAREHOUSE"
    bold "registering the 24 TPC-DS SF${BLIMP_SF:-1} tables into $cat_url (warehouse $reg_wh)"
    # Registration runs on the HOST, so it needs an address the host can reach:
    # not the gateway's docker-internal minioserver:9000, and not a fleet
    # hostname that resolves to this node's own un-hairpinnable public IP.
    # endpoint_local() probes and rewrites only when loopback actually serves it.
    local reg_ep=""
    case "$S3_ENDPOINT" in *:9000*) reg_ep="--s3-endpoint $(endpoint_local "$S3_ENDPOINT")";; esac
    # The fleet endpoint is key-authenticated, so pass it and the keys through
    # explicitly instead of relying on this box's IAM role.
    local reg_keys=""
    case "${SOURCE_TARGET:-}" in
      fleet|gateway)
        reg_ep="--s3-endpoint $(endpoint_local "$S3_ENDPOINT")"
        reg_keys="--s3-key $S3_KEY --s3-secret $S3_SECRET" ;;
    esac
    # shellcheck disable=SC2086  # reg_ep/reg_keys/pfx_flag are intentional flag pairs
    AWS_ACCESS_KEY_ID="${S3_KEY:-${AWS_ACCESS_KEY_ID:-}}" AWS_SECRET_ACCESS_KEY="${S3_SECRET:-${AWS_SECRET_ACCESS_KEY:-}}" \
      "${BLIMP_PY:-python3}" "$HERE/register_tpcds_tables.py" --catalog "$cat_url" \
      --warehouse "$reg_wh" --source-bucket "$ORIGIN_BUCKET" --region "$REGION" \
      --namespace "$NAMESPACE" $reg_ep $reg_keys $pfx_flag 2>&1 | tail -3 \
      || bold "  (auto-register had issues — re-run register_tpcds_tables.py manually)"
    fi
  fi

  save_env

  # --- how the Blimp cluster connects to this source ---
  # Only show the S3-key lines when keys are actually in play (external mode).
  # In vpc mode omit them entirely — the gateway uses its IAM role, so there is
  # no "secret you entered" to echo.
  local cred_lines=""
  if [ -n "${S3_KEY:-}" ]; then
    cred_lines="    S3 access key    : $S3_KEY
    S3 secret key    : •••• (the secret you entered above)"
  else
    cred_lines="    S3 credentials   : none — gateway reads via its IAM instance role"
  fi
  # Wire the cluster DIRECTLY over the authenticated admin API (no SSH):
  # POST /admin/source/configure sets the gateway's live source env — takes
  # effect on the next query, no restart. Bearer = zus-<CLUSTER_ID>. Falls
  # back to the manual UI/SSH instructions below when the endpoint is absent
  # (pre-2026-07-27 gateway image) or unreachable.
  if [ -n "${GW:-}" ] && [ -n "${CLUSTER_ID:-}" ]; then
    bold "== wiring the cluster over the admin API (no SSH) =="
    # s3_endpoint MUST be sent. The gateway's API documents its default as
    # https://s3.<region>.amazonaws.com, and this body used to OMIT the field —
    # so a non-AWS origin (the MinIO standup_data puts on this box) was wired as
    # real AWS and every DuckDB read of the source 403'd:
    #   [duckdb-prelude][source-env] src_endpoint="https://s3.us-east-1.amazonaws.com"
    #   HTTP GET error on 'https://blimp-sf1.s3.us-east-1.amazonaws.com/...' (403)
    #
    # ZS3_SOURCE_VIA_ROUTER=0 — SENT EXPLICITLY, NEVER OMITTED. With it on, the
    # gateway gives the source bucket a DuckDB secret scoped to the Router, and
    # the Router read-through-CACHES every source object it pulls into the
    # eblobbers. Source data must NOT enter the cache: the cache is for the
    # workload, and filling it with source scans both pollutes it and pushes the
    # allocation toward the evictor's watermark. Off by default; VIA_ROUTER=1 in
    # the environment is the deliberate opt-in.
    # FLEET SOURCE: the gateway reads it from ITS OWN S3, not the public fleet
    # address. The fleet URL is the EXTERNAL write path — that is how this CLI
    # uploaded the data — but handing it to the gateway makes the gateway take a
    # public round trip (and, on a multi-node fleet, round-robin to a peer) to
    # read a bucket it serves locally. The gateway's own S3 is what its DuckDB
    # prelude already uses (ZS3_DUCKDB_S3_ENDPOINT=http://localhost:9000), so
    # send that plus the gateway's own root keys, which heal_wiring keeps fresh.
    HOOK_EP="${S3_ENDPOINT:-}"; HOOK_KEY="${S3_KEY:-}"; HOOK_SEC="${S3_SECRET:-}"
    # `gateway` lands here too: the data is on this node's own S3, so the gateway
    # must read it on its own loopback rather than back out through its public
    # address — the same reasoning as for the fleet upload path.
    case "${SOURCE_TARGET:-}" in fleet|gateway)
      # The gateway's own root keys are fetched LATER in this run ("finishing
      # setup"), which is after this call — so populate them now. heal_wiring
      # reads them from the local minioserver container when co-located (the
      # node-correct values) and falls back to that gateway's own
      # /admin/credentials otherwise. Idempotent, so the later block is a no-op.
      [ -n "${GW_AK:-}" ] && [ -n "${GW_SK:-}" ] || heal_wiring
      HOOK_EP="http://localhost:9000"
      HOOK_KEY="${GW_AK:-$HOOK_KEY}"; HOOK_SEC="${GW_SK:-$HOOK_SEC}"
      bold "  source endpoint for the gateway: $HOOK_EP (its own zs3 — the published URL is the upload path only)"
    ;; esac
    # CATALOG URL FOR THE GATEWAY. With the gateway's own Nessie (catalog option
    # 1) this CLI reaches it at http://<GW>:19122/iceberg — the HOST port — but
    # the gateway runs in a container, where a 127.0.0.1 address is loopback to
    # ITSELF: the ATTACH fails, every MV author declines, and the suite prints
    # "?" for every timing (node 37, 2026-09-14). The gateway already knows its
    # own catalog address (ZS3_ICEBERG_REST_URL, http://zus-nessie:19120/iceberg
    # on a node). Read it from the container when co-located and send THAT; the
    # CLI's address stays for the registrar/seeder, which run here.
    HOOK_IRC="$ICEBERG_URL"
    if [ "${CATALOG_CHOICE:-}" = 1 ]; then
      local gwirc; gwirc=$(gateway_env ZS3_ICEBERG_REST_URL)
      if [ -n "$gwirc" ]; then
        HOOK_IRC="$gwirc"
        bold "  catalog URL for the gateway: $gwirc (its own Nessie, container address)"
      fi
    fi
    HOOK_BODY=$(HB_IRC="$HOOK_IRC" HB_WH="$WAREHOUSE" HB_NS="$NAMESPACE" \
      HB_BKT="$ORIGIN_BUCKET" HB_KEY="$HOOK_KEY" HB_SEC="$HOOK_SEC" HB_REG="$REGION" \
      HB_EP="$HOOK_EP" HB_VR="${VIA_ROUTER:-0}" HB_RB="${ROUTER_BASE:-}" \
      python3 -c 'import json,os;b={"source":"customer","iceberg_url":os.environ["HB_IRC"],"warehouse":os.environ["HB_WH"],"namespace":os.environ["HB_NS"],"bucket":os.environ["HB_BKT"],"s3_endpoint":os.environ["HB_EP"],"s3_key":os.environ["HB_KEY"],"s3_secret":os.environ["HB_SEC"],"s3_region":os.environ["HB_REG"],"via_router":os.environ.get("HB_VR")=="1"};b.update({"router_base":os.environ["HB_RB"]} if os.environ.get("HB_VR")=="1" and os.environ.get("HB_RB") else {});print(json.dumps(b))' 2>/dev/null)
    HOOK_RESP=$(curl -s -m 30 -X POST "http://$GW:9000/admin/source/configure" \
      -H "Authorization: Bearer ${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" -H "Content-Type: application/json" \
      -d "$HOOK_BODY" || true)
    case "$HOOK_RESP" in
      *'"status": "ok"'*|*'"status":"ok"'*)
        SOURCE=customer; export SOURCE; save_env
        bold "  ✓ cluster wired: source=customer ns=$NAMESPACE bucket=$ORIGIN_BUCKET (live, no restart)"
        echo "    (read-through cache retarget is optional — see hookup_cluster_source.sh)";;
      *)
        echo "  ! API wiring unavailable ($(printf %s "$HOOK_RESP" | head -c 120)) — use the UI/manual steps below";;
    esac
  fi
  echo; bold "================= POINT THE BLIMP CLUSTER AT THIS SOURCE ================="
  cat <<OUT
  In the cluster UI → Query Optimizer → Production (BYO Iceberg source):
    Iceberg REST URL : $ICEBERG_URL
    Warehouse        : $WAREHOUSE
    S3 endpoint      : $S3_ENDPOINT
$cred_lines
    Namespace        : $NAMESPACE

  Then push data changes and refresh MVs incrementally with:
    curl -X POST http://$GW:9000/admin/source/snapshot_changed \\
      -H "Authorization: Bearer ${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" -H "Content-Type: application/json" \\
      -d '{"namespace":"$NAMESPACE","table":"<table>","trigger":"customer"}'

  Make sure the cluster gateway can reach this node on :8181 (security group / firewall).
==========================================================================
OUT
  # ---- finish the job HERE, once ------------------------------------------
  # Everything below used to be discovered LATER, one item per 25-minute suite
  # run: the gateway S3 keys (warp/mlperf silently measured nothing without
  # them), the benchmark tools (mount-s3 was apt-only so mlperf never ran on an
  # rpm host), the router's cache (never enabled, so every cache leg read zero
  # objects). Four full runs to learn four things. Do them all now, at setup,
  # so a customer types ONE command once and every suite works first time.
  bold "== finishing setup: credentials + tools =="

  # 1. Gateway S3 credentials. NOT the source-bucket keys — vpc mode leaves those
  #    blank on purpose (IAM instance role), but the gateway's own S3 endpoint
  #    authenticates by key and warp/mlperf/cache-mp-s3 are useless without it.
  # Auto-fetched from the gateway itself (GET /admin/credentials, same Bearer
  # zus-<CLUSTER_ID> every other admin call uses) — no UI copy-paste, no
  # interactive prompt. Idempotent: safe to call every --setup run; an
  # already-set GW_AK/GW_SK wins and skips the call, and a gateway image older
  # than this endpoint (404/unreachable) just leaves them unset, same as
  # before, with warp/mlperf/cache-mp-s3 skipped.
  if [ -z "${GW_AK:-}" ] || [ -z "${GW_SK:-}" ]; then
    resp=$(curl -s -m 10 "http://$GW:9000/admin/credentials" -H "Authorization: Bearer ${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" 2>/dev/null)
    fetched_ak=$(printf '%s' "$resp" | python3 -c 'import json,sys
try:
  d=json.load(sys.stdin)
  print(d.get("s3_access_key","") if d.get("status")=="ok" else "")
except Exception: print("")' 2>/dev/null)
    fetched_sk=$(printf '%s' "$resp" | python3 -c 'import json,sys
try:
  d=json.load(sys.stdin)
  print(d.get("s3_secret_key","") if d.get("status")=="ok" else "")
except Exception: print("")' 2>/dev/null)
    if [ -n "$fetched_ak" ] && [ -n "$fetched_sk" ]; then
      GW_AK="$fetched_ak"; GW_SK="$fetched_sk"
      echo "  ✓ gateway S3 credentials auto-fetched from GET /admin/credentials"
    fi
  fi
  if [ -n "${GW_AK:-}" ] && [ -n "${GW_SK:-}" ]; then
    sed -i.bak '/^GW_AK=/d;/^GW_SK=/d' "$ENVF" 2>/dev/null || true
    printf 'GW_AK=%s\nGW_SK=%s\n' "$GW_AK" "$GW_SK" >> "$ENVF"
    rm -f "$ENVF.bak"
    echo "  ✓ gateway S3 credentials saved to $ENVF"
  else
    echo "  ! no gateway S3 credentials — warp, mlperf and cache-mp-s3 will be skipped."
    echo "    Add GW_AK= / GW_SK= to $ENVF later and re-run; nothing else needs redoing."
  fi

  # 2. Benchmark tools, up front. They take minutes to install and used to be
  #    installed at the START of --storage, so a failure cost a whole run.
  if [ "${BLIMP_SKIP_DEPS:-0}" != "1" ]; then
    ensure_storage_tools
    ensure_acid_tools || true   # porcupine ACID checker (Go build); non-fatal
  fi

  echo; bold "setup done — everything is wired. Validate with:  blimp --query    (and  blimp --storage )"
}

# preflight — verify EVERY prerequisite in seconds, before any long benchmark,
# and report them ALL at once.
#
# This exists because the suites checked prerequisites lazily: each ~25-minute
# run died on the next missing thing, so four runs were burned discovering four
# problems that a ten-second check would have listed together. Fail fast, fail
# complete, and name the fix for each.
preflight(){
  local need_gw_creds="${1:-0}" need_tools="${2:-0}" problems=0
  bold "== preflight =="
  if ! curl -s -o /dev/null -m 10 "http://$GW:9000/minio/health/live" 2>/dev/null; then
    echo "  ✗ gateway $GW:9000 unreachable — check the security group / GW= in $ENVF"
    problems=$((problems+1))
  else
    echo "  ✓ gateway reachable"
  fi
  if [ "$need_gw_creds" = "1" ]; then
    if [ -z "${GW_AK:-}" ] || [ -z "${GW_SK:-}" ]; then
      echo "  ✗ gateway S3 credentials missing (GW_AK/GW_SK in $ENVF)"
      echo "    → warp, mlperf and cache-mp-s3 cannot run. Get them from the Blimp UI."
      problems=$((problems+1))
    else
      echo "  ✓ gateway S3 credentials present"
    fi
  fi
  if [ "$need_tools" = "1" ]; then
    local miss=""
    command -v warp     >/dev/null || miss="$miss warp"
    command -v mount-s3 >/dev/null || miss="$miss mount-s3"
    [ -x /opt/dlio/venv_mlperf/bin/dlio_benchmark ] || miss="$miss dlio"
    if [ -n "$miss" ]; then
      echo "  ✗ missing benchmark tools:$miss  → run 'blimp --setup' (installs them)"
      problems=$((problems+1))
    else
      echo "  ✓ benchmark tools present (warp mount-s3 dlio)"
    fi
  fi
  if [ "$problems" -gt 0 ]; then
    die "$problems prerequisite(s) missing — fix the above and re-run. Nothing was benchmarked, so no time was wasted."
  fi
  echo "  all prerequisites met"
}

# ---- tests: source the saved wiring, then hand off to the suites -------------
# No wiring yet? Offer to run --setup right here (interactive terminals only)
# instead of just erroring — a first-time user can type `blimp --query` and be
# walked through setup, then the test runs. Non-interactive callers still die
# with the clear message.
need_env(){
  if [ ! -f "$ENVF" ]; then
    if [ -t 0 ] || [ -e /dev/tty ]; then
      printf 'No wiring yet. Run blimp --setup now? [Y/n] ' >&2
      local yn; read -r yn </dev/tty 2>/dev/null || yn=n
      case "${yn:-Y}" in n|N) die "run 'blimp --setup' first (or set BLIMP_ENV)";; esac
      cmd_setup
    else
      die "no wiring yet — run 'blimp --setup' first (or set BLIMP_ENV)."
    fi
  fi
  # shellcheck disable=SC1090
  . "$ENVF"
  GW="${GW:-${GATEWAY:-}}"; export GW GATEWAY="$GW"
  # The gateway validates the account's FLEET token only (2026-09-14). The
  # wiring carries it (heal_wiring reads the node's copy when the CLI runs on
  # the box); nothing is derived from the cluster id any more.
  export CLUSTER_TOKEN="${CLUSTER_TOKEN:-}"
  # Self-heal stale creds/token left behind by a cluster redeploy (see heal_wiring).
  heal_wiring
  [ -n "${CLUSTER_TOKEN:-}" ] || die "CLUSTER_TOKEN is empty: the gateway accepts only the account fleet token. On the gateway box it is read from /opt/0chain/zs3server/environment/admin_token; elsewhere set CLUSTER_TOKEN=<fleet token from the panel (Settings -> API token)> in $ENVF"
}

# ensure_storage_tools — the --storage suite's benchmark tools, installed
# self-contained like ensure_deps: warp (pinned ≥1.1.4 — older warp's output
# format parses as blank numbers), and mount-s3 + dlio for mlperf.
# BLIMP_SKIP_DEPS=1 opts out on hardened/offline hosts.
ensure_storage_tools(){
  [ "${BLIMP_SKIP_DEPS:-0}" = 1 ] && return 0
  bold "== checking storage-bench tools =="
  # warp: pin v1.1.4 (parser-compatible). Replace older installs.
  local wv; wv=$(warp --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  if [ "$wv" != "1.1.4" ]; then
    bold "  installing warp v1.1.4 (found: ${wv:-none})…"
    local arch; arch=$(uname -m); [ "$arch" = aarch64 ] && arch=arm64 || arch=x86_64
    curl -fsSL "https://github.com/minio/warp/releases/download/v1.1.4/warp_Linux_${arch}.tar.gz" \
      -o /tmp/warp.tgz && tar xzf /tmp/warp.tgz -C /tmp warp \
      && sudo install /tmp/warp /usr/local/bin/warp && rm -f /tmp/warp.tgz /tmp/warp \
      || echo "  ! warp install failed — warp sections will be skipped"
  fi
  # mount-s3 — needed for BOTH the mlperf read path and the cache-mp-s3 leg.
  # This was apt-ONLY, so on an rpm host (AL2023, the default Amazon Linux client)
  # the whole block was skipped silently: `mount-s3: missing`, cache-mp-s3 reported
  # `n/a` on every run, and mlperf never ran at all. Mountpoint ships an .rpm too.
  command -v mount-s3 >/dev/null || {
    bold "  installing mount-s3 (mlperf + cache-mp-s3 read path)…"
    local arch pkg url out; arch=$(uname -m)
    if command -v apt-get >/dev/null; then pkg=deb
    elif command -v dnf >/dev/null || command -v yum >/dev/null; then pkg=rpm
    fi
    if [ -n "${pkg:-}" ]; then
      url="https://s3.amazonaws.com/mountpoint-s3-release/latest/${arch}/mount-s3.${pkg}"
      if out=$(curl -fsSL "$url" -o "/tmp/mount-s3.$pkg" 2>&1); then
        case "$pkg" in
          deb) out=$(sudo apt-get install -y -qq "/tmp/mount-s3.deb" 2>&1) ;;
          rpm) out=$(sudo dnf install -y -q "/tmp/mount-s3.rpm" 2>&1 \
                  || sudo yum install -y -q "/tmp/mount-s3.rpm" 2>&1) ;;
        esac
      fi
      rm -f "/tmp/mount-s3.$pkg"
      # Print the REASON. Swallowing it is why this sat broken: the summary said
      # "missing" and the operator had nothing to act on.
      command -v mount-s3 >/dev/null || {
        echo "  ! mount-s3 install failed ($url) — mlperf + cache-mp-s3 will be skipped"
        printf '%s\n' "$out" | tail -3 | sed 's/^/    | /'
      }
    else
      echo "  ! no apt/dnf/yum — cannot install mount-s3; mlperf + cache-mp-s3 will be skipped"
    fi
  }
  # dlio imports mpi4py at startup, which dlopen()s a real MPI runtime. Without
  # one it dies with "RuntimeError: cannot load MPI library" during dataset
  # GENERATION, so mlperf produced no numbers at all even with dlio installed
  # (AL2023, 2026-08-01) — and `mpirun` is required for accel>1 on top of that.
  # Amazon Linux ships it as openmpi/openmpi-devel; Debian as openmpi-bin +
  # libopenmpi-dev. Neither puts it on PATH/LD_LIBRARY_PATH — run_cluster.sh
  # prepends /usr/lib64/openmpi/{bin,lib} itself.
  # `ls a b` exits non-zero when EITHER path is missing, so the old check always
  # claimed MPI was absent — it reinstalled every run and then reported failure
  # even on a host where OpenMPI was already installed and working.
  if ! { [ -x /usr/lib64/openmpi/bin/mpirun ] || [ -x /usr/bin/mpirun ] || command -v mpirun >/dev/null; }; then
    bold "  installing openmpi (dlio/mlperf needs an MPI runtime)…"
    if command -v dnf >/dev/null; then sudo dnf install -y -q openmpi openmpi-devel >/dev/null 2>&1
    elif command -v yum >/dev/null; then sudo yum install -y -q openmpi openmpi-devel >/dev/null 2>&1
    elif command -v apt-get >/dev/null; then sudo apt-get install -y -qq openmpi-bin libopenmpi-dev >/dev/null 2>&1; fi
    { [ -x /usr/lib64/openmpi/bin/mpirun ] || [ -x /usr/bin/mpirun ] || command -v mpirun >/dev/null; } \
      || echo "  ! openmpi install failed — mlperf will fail with 'cannot load MPI library'"
  fi
  # dlio (mlperf resnet50 driver) — venv install, one-time.
  if [ ! -x /opt/dlio/venv_mlperf/bin/dlio_benchmark ]; then
    bold "  installing dlio-benchmark (one-time, mlperf)…"
    local dout
    # `python3 -m venv` needs ensurepip, which is a SEPARATE package on rpm hosts
    # (python3-pip) and on Debian (python3-venv); without it venv fails and the
    # 2>/dev/null here hid that too.
    command -v dnf >/dev/null && ! python3 -c 'import ensurepip' 2>/dev/null \
      && sudo dnf install -y -q python3-pip >/dev/null 2>&1
    command -v apt-get >/dev/null && ! python3 -c 'import ensurepip' 2>/dev/null \
      && sudo apt-get install -y -qq python3-venv >/dev/null 2>&1
    # TMPDIR must NOT be /tmp: on Amazon Linux /tmp is a RAM-backed tmpfs (1.9 GB
    # on a c6in.large, and the suite's own artifacts had it at 76% full), while
    # dlio-benchmark pulls tensorflow + torchvision — multiple GB of wheels that
    # pip unpacks under TMPDIR. It ran out of space every time while the root disk
    # had 195 GB free, and the failure surfaced only as `dlio: missing`.
    # --no-cache-dir keeps the footprint down; a pip cache is useless here anyway.
    local dtmp="${DLIO_TMPDIR:-/var/tmp/dlio-build}"
    sudo mkdir -p /opt/dlio "$dtmp"
    # Mirror the recipe the CLUSTER uses (zusCloudNative zs3-init.go
    # installMLPerfBenchmark), which demonstrably works — the cluster's own
    # "Run mlperf" button drives it. The order matters:
    #
    #   1. pip/wheel/setuptools first, or the torch wheel resolution misbehaves.
    #   2. torch from the CPU-ONLY index BEFORE dlio-benchmark. Left to itself,
    #      dlio pulls the default (CUDA) torch — several GB of nvidia-* wheels
    #      that have no use on a CPU box and that filled /tmp here.
    #   3. dlio-benchmark last, so it finds torch already satisfied.
    #   4. s3torchconnector for the S3 read path (best-effort).
    local PIPQ="sudo env TMPDIR=$dtmp /opt/dlio/venv_mlperf/bin/pip install --no-cache-dir"
    dout=$(sudo python3 -m venv /opt/dlio/venv_mlperf 2>&1 \
      && $PIPQ --upgrade pip wheel setuptools 2>&1 \
      && $PIPQ --index-url https://download.pytorch.org/whl/cpu torch 2>&1 \
      && $PIPQ dlio-benchmark 2>&1)
    $PIPQ s3torchconnector >/dev/null 2>&1 || true
    sudo rm -rf "$dtmp" 2>/dev/null || true
    [ -x /opt/dlio/venv_mlperf/bin/dlio_benchmark ] || {
      echo "  ! dlio install failed — mlperf section will be skipped"
      printf '%s\n' "$dout" | tail -3 | sed 's/^/    | /'
    }
  fi
  echo "  warp: $(warp --version 2>/dev/null | head -1 || echo missing) · mount-s3: $(command -v mount-s3 >/dev/null && echo ok || echo missing) · dlio: $([ -x /opt/dlio/venv_mlperf/bin/dlio_benchmark ] && echo ok || echo missing)"
}

# ACID_BIN — the compiled porcupine linearizability checker (built from acid/).
ACID_BIN="$HERE/acid/ptest"

# ensure_acid_tools builds the porcupine checker (acid/ptest). It is a single Go
# program; building it needs a Go toolchain, which we fetch to /usr/local/go if
# the host has none (same one-time pattern as warp/mount-s3/dlio). Idempotent:
# a present, runnable binary is reused.
ensure_acid_tools(){
  [ "${BLIMP_SKIP_DEPS:-0}" = 1 ] && return 0
  # Reuse ONLY a binary built for THIS host. A committed/pushed ptest is a wrong-arch
  # trap: a Mac Mach-O passes `-x` but dies "Exec format error" (bit us — the repo
  # shipped a Mach-O). Match the binary's format to the OS (ELF on Linux, Mach-O on
  # Darwin); anything else rebuilds from source below. Falls through to rebuild if
  # `file` is unavailable.
  _want=ELF; [ "$(uname -s)" = Darwin ] && _want=Mach-O
  if [ -x "$ACID_BIN" ] && file "$ACID_BIN" 2>/dev/null | grep -q "$_want"; then echo "  porcupine (acid): ok"; return 0; fi
  [ -x "$ACID_BIN" ] && echo "  (existing ptest is wrong-arch for this host — rebuilding)"
  bold "== building the porcupine ACID checker (acid/ptest) =="
  local GO; GO=$(command -v go || echo /usr/local/go/bin/go)
  if ! "$GO" version >/dev/null 2>&1; then
    bold "  installing Go toolchain (one-time, to build the ACID checker)…"
    local arch gover; arch=$(uname -m); [ "$arch" = aarch64 ] && arch=arm64 || arch=amd64
    gover=1.22.5
    if curl -fsSL "https://go.dev/dl/go${gover}.linux-${arch}.tar.gz" -o /tmp/go.tgz; then
      sudo rm -rf /usr/local/go && sudo tar -C /usr/local -xzf /tmp/go.tgz && rm -f /tmp/go.tgz
      GO=/usr/local/go/bin/go
    fi
  fi
  if ! "$GO" version >/dev/null 2>&1; then
    echo "  ! Go toolchain unavailable — 'blimp --acid' will be unavailable"; return 1
  fi
  # Build offline-tolerant: module deps (porcupine, minio-go) are fetched on the
  # first build and cached under GOPATH thereafter.
  ( cd "$HERE/acid" && GOFLAGS=-mod=mod "$GO" build -o ptest . ) 2>&1 | tail -3
  [ -x "$ACID_BIN" ] && echo "  porcupine (acid): built ok" \
    || { echo "  ! porcupine build failed — 'blimp --acid' will be unavailable"; return 1; }
}

cmd_storage(){
  need_env
  : "${GW:?gateway missing in wiring}" "${REGION:?}"
  # Everything the ~25-minute suite needs, checked in seconds and reported
  # together. --setup installs the tools and saves the keys, so this normally
  # just confirms; when it doesn't, you learn ALL of it now rather than one item
  # per run.
  preflight 1 1
  ensure_storage_tools
  [ -n "${GW_AK:-}" ] || GW_AK=$(ask GW_AK "Gateway S3 access key")
  [ -n "${GW_SK:-}" ] || GW_SK=$(ask GW_SK "Gateway S3 secret key")
  # REFUSE to run unauthenticated. These are the GATEWAY's own S3 credentials,
  # which are NOT the source-bucket credentials: vpc mode deliberately leaves the
  # source keys blank (the node reads the origin via its IAM instance role), but
  # the gateway's S3 endpoint is MinIO-style and authenticates by key. With them
  # blank, warp cannot PUT/GET at all and run_cluster.sh aborts with "AK: set AK"
  # — taking warp AND mlperf with it — while the suite still printed a summary,
  # just with the throughput fields empty:
  #     warp   S3 PUT  MiB/s · GET  MiB/s          <- blank, looks like a format bug
  # An empty number reads as "the tool is broken", not "you gave me no key", so
  # say which one is missing and where to get it.
  if [ -z "${GW_AK:-}" ] || [ -z "${GW_SK:-}" ]; then
    die "gateway S3 credentials are empty (GW_AK=$([ -n "${GW_AK:-}" ] && echo set || echo EMPTY), GW_SK=$([ -n "${GW_SK:-}" ] && echo set || echo EMPTY)).
  warp and mlperf benchmark the GATEWAY's S3 endpoint, which authenticates by
  key — an IAM instance role does not apply to it, so vpc mode does not fill
  these in. Take the cluster's S3 access key/secret from the Blimp UI and either
  add them to $ENVF as GW_AK= / GW_SK=, or pass them for one run:
      GW_AK=... GW_SK=... blimp --storage"
  fi
  # Run the suite LOCALLY (on THIS node, to measure the real client->gateway
  # path), capturing its output. Unlike --query — which runs SERVER-SIDE, so the
  # gateway's cdc_service tracks it live and the UI shows a yellow "running" row
  # with partial data — --storage runs HERE, so the gateway has no live view. To
  # give the SAME live UI, a background heartbeat POSTs the partial results to
  # cdc_service every <180s as status=running (the UI shows the live row), and we
  # exits. Each leg (warp/mlperf) now registers its OWN internal-format run from
  # inside test_cache.sh — identical type + labels to the gateway's run_bench rows,
  # with cdc sampling the tier columns via __tiers__ — so there is no combined
  # "storage (client)" heartbeat here anymore. CLUSTER_ID is forwarded so the
  # per-leg POST /bench/import is authed (Bearer zus-<CLUSTER_ID>).
  env GW="$GW" GW_AK="$GW_AK" GW_SK="$GW_SK" \
    CLUSTER_ID="$CLUSTER_ID" CLUSTER_TOKEN="${CLUSTER_TOKEN:-}" \
    REGION="$REGION" CLUSTER_REGION="${CLUSTER_REGION:-$REGION}" \
    STORAGE_LEGS="${STORAGE_LEGS:-}" \
    MLPERF_NUM_FILES="${MLPERF_NUM_FILES:-}" MLPERF_NUM_EVAL="${MLPERF_NUM_EVAL:-}" \
    MLPERF_ACCELS="${MLPERF_ACCELS:-}" MLPERF_REGEN="${MLPERF_REGEN:-}" \
    NAMESPACE="${NAMESPACE:-tpcds}" bash "$HERE/test_cache.sh"
  exit $?
}

# storage_heartbeat <logfile> <id> — while --storage runs, push its partial
# output to the gateway every 75s as status=running so the UI shows a LIVE
# "running" row (yellow, partial metrics) exactly like a --query run, instead of
# the run only appearing when it finishes. Each POST rewrites the gateway-side
# summary/log so bench_status() keeps reporting "running" (freshness < 180s).
# Killed by cmd_storage; the "done" finalize is a separate storage_import call.
storage_heartbeat(){
  local log="$1" id="$2"
  [ -n "${CLUSTER_ID:-}" ] && [ -n "${GW:-}" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  sleep 15   # let the first leg emit a line before the first beat
  while :; do storage_import "$log" "$id" "running" quiet; sleep 75; done
}

# storage_import <logfile> [id] [status] [quiet] — register/update a client-side
# --storage run on the Blimp UI bench list via the gateway cdc_service
# `POST /bench/import` (Authorization: Bearer zus-<CLUSTER_ID>). The suite prints
# human-readable result lines; we scrape the throughput/TTFB/AU lines into a
# [label,value] metrics array and ship them + the full log so the UI shows the
# run like a gateway-launched one (tagged client_* / source=client). status is
# "running" (heartbeat) or "done" (final). Best-effort: an older gateway image
# without /bench/import (or an unreachable :9401) just skips, never fails the run.
storage_import(){
  local log="$1" id="${2:-storage_$(date +%s)}" status="${3:-done}" quiet="${4:-}"
  [ -n "${CLUSTER_ID:-}" ] || { [ -z "$quiet" ] && echo "  (skipping UI registration — no CLUSTER_ID in wiring)"; return 0; }
  [ -n "${GW:-}" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  local tok="${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}"
  local payload
  payload=$(CLOG="$log" python3 - "$id" "$(hostname 2>/dev/null || echo client)" "$status" <<'PY' 2>/dev/null
import json,os,re,sys
rid,host,status=sys.argv[1],sys.argv[2],sys.argv[3]
try: raw=open(os.environ["CLOG"],errors="replace").read()
except Exception: raw=""
c=re.sub(r"\x1b\[[0-9;]*m","",raw)
# throughput is normalised to DECIMAL MB/s (or GB/s >=1000) — warp reports
# BINARY MiB/s, but the UI + gateway rows use MB/s, so convert (1 MiB = 1.048576 MB).
def to_mb(v,u):
    v=float(v); u=u.lower()
    return v*(1073.741824 if u.startswith("gib") else 1.048576 if u.startswith("mib") else 0.001048576 if u.startswith("kib") else 1000.0 if u.startswith("gb") else 0.001 if u.startswith("kb") else 1.0)
def fmt(mb): return "%.2f GB/s"%(mb/1000.0) if mb>=1000 else "%d MB/s"%round(mb)
def thr(s,paren=False):
    if paren:
        m=re.search(r"\(([0-9.]+)\s*(GB/s|MB/s|KB/s)\)",s)
        if m: return fmt(to_mb(m.group(1),m.group(2)))
    m=re.search(r"([0-9.]+)\s*(GiB/s|MiB/s|KiB/s|GB/s|MB/s|KB/s)",s)
    return fmt(to_mb(m.group(1),m.group(2))) if m else None
rows=[]; wctx=None
def g(rx,s,grp=1):
    m=re.search(rx,s); return m.group(grp) if m else None
for ln in c.splitlines():
    s=ln.strip()
    if "== warp PUT" in s: wctx="PUT"; continue
    if "== warp GET" in s: wctx="GET"; continue
    if s.startswith("* Average:") and wctx:
        v=thr(s); ob=g(r"([0-9.]+)\s*obj/s",s)
        if v: rows.append(["warp S3 %s (96MiB, conc16)"%wctx, v+(" · "+ob+" obj/s" if ob else "")])
        wctx=None; continue
    if "TTFB:" in s:
        med=g(r"Median:\s*([0-9a-z]+)",s); p99=g(r"99th:\s*([0-9a-z]+)",s); avg=g(r"Avg:\s*([0-9a-z]+)",s)
        parts=[x for x in [("p50 "+med if med else ""),("p99 "+p99 if p99 else ""),("avg "+avg if avg else "")] if x]
        rows.append(["TTFB 1KiB GET (conc1)", " · ".join(parts)]); continue
    if "mlperf read" in s:
        au=g(r"AU\s*([0-9.]+)",s); io=thr(s); acc=g(r"accel=([0-9]+)",s)
        parts=[x for x in [("AU "+au+"%" if au else ""),(io if io else "")] if x]
        rows.append(["mlperf resnet50"+(" accel-"+acc if acc else ""), " · ".join(parts)]); continue
od=[]; seen={}
for k,v in rows:
    if k not in seen: od.append(k)
    seen[k]=v
final=[[k,seen[k]] for k in od]
print(json.dumps({"id":rid,"type":"storage (client)","status":status,
  "summary":{"type":"storage (client)","metrics":final,"config":"run-blimp kit (client %s)"%host,"status":status},
  "log":c[-200000:]}))
PY
)
  [ -n "$payload" ] || return 0
  if curl -fsS -m 20 -X POST "http://$GW:9401/bench/import" \
       -H "Authorization: Bearer $tok" -H "Content-Type: application/json" \
       --data-binary "$payload" >/dev/null 2>&1; then
    [ -z "$quiet" ] && bold "  ✓ registered this run on the Blimp UI bench list (client_$id, $status)"
  else
    [ -z "$quiet" ] && echo "  (could not register on the UI bench list — gateway :9401 unreachable or image predates /bench/import)"
  fi
  return 0
}

# prod_ingest — pull the customer's Iceberg tables INTO the cluster's own
# eblobber-backed warehouse before querying.
#
# THIS IS THE PATH THE PRODUCT ACTUALLY USES. The panel's Prod Query does exactly
# this (datalake ProdQuery -> zus-cdc /prod/ingest, then /admin/query/run), and it
# is why the UI can author MVs over a customer source. `blimp --setup` instead
# wires a BYO ATTACH (source=customer), which points the gateway at the customer
# catalog — and on that path every grain-gate cardinality probe fails to resolve
# the schema, so authoring falls through to "serve base" with status=no_mv and
# every timing reads "?". Measured on node 37 (2026-09-14) at SF1 and SF10.
#
# After ingesting, queries must NOT carry source=customer: the tables now live in
# the CLUSTER's catalog, and asking for the customer source re-attaches the BYO
# one and defeats the ingest.
prod_ingest(){
  local tables="$1"          # JSON array string, or "" for the whole namespace
  local base="http://$GW:${CDC_PORT:-9401}/prod/ingest"
  local body
  body=$(ING_IRC="$ICEBERG_URL" ING_WH="$WAREHOUSE" ING_NS="${NAMESPACE:-tpcds}"     ING_EP="${S3_ENDPOINT:-}" ING_KEY="${S3_KEY:-}" ING_SEC="${S3_SECRET:-}" ING_TBL="$tables"     "${BLIMP_PY:-python3}" -c 'import json,os
b={"iceberg_url":os.environ["ING_IRC"],"warehouse":os.environ["ING_WH"],
   "namespace":os.environ["ING_NS"],"s3_endpoint":os.environ["ING_EP"],
   "s3_key":os.environ["ING_KEY"],"s3_secret":os.environ["ING_SEC"]}
t=os.environ.get("ING_TBL","").strip()
if t: b["tables"]=json.loads(t)
print(json.dumps(b))')
  bold "ingesting the source into the cluster warehouse (zus-cdc /prod/ingest)"
  local out
  out=$(curl -s -m "${INGEST_TIMEOUT:-1800}" -X POST "$base" \
    -H "Authorization: Bearer ${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" \
    -H "Content-Type: application/json" -d "$body" 2>/dev/null)
  case "$out" in
    *'"ingested"'*) printf '%s' "$out" | "${BLIMP_PY:-python3}" -c 'import json,sys
d=json.load(sys.stdin)
for t in d.get("ingested",[]): print("    %-18s %s rows" % (t.get("table"), t.get("rows")))
sk=d.get("skipped") or []
if sk: print("    skipped:", sk)' 2>/dev/null || echo "  $out" ;;
    *) bold "  ! ingest did not report tables — continuing anyway: ${out:0:200}" ;;
  esac
}

cmd_query(){
  need_env
  : "${GW:?}" "${CLUSTER_ID:?}" "${ICEBERG_URL:?}" "${WAREHOUSE:?}"
  preflight 0 0
  # The suite runs against the source wired by `blimp --setup` (the gateway's
  # "customer" source): the gateway authors MVs from it, the CDC append lands in
  # it, and the delta merge diffs its snapshots. That is the production path.
  # `/prod/ingest` (BLIMP_INGEST=1) is a one-shot FULL COPY of the namespace into
  # the cluster warehouse (delete + re-append every table) — useful to snapshot a
  # remote source locally, useless for the suite: with the gateway Nessie as the
  # catalog it copies the namespace onto itself, and a later append to the source
  # is never seen by the copy, so every timing came back "?" (node 37,
  # 2026-09-14). Ingest is therefore opt-in and never replaces the source.
  if [ "${BLIMP_INGEST:-0}" = 1 ]; then
    prod_ingest "${INGEST_TABLES:-}"
  fi
  # S3_ENDPOINT/KEY/SECRET must cross this whitelist. bench_cdc.sh forwards
  # $S3_KEY/$S3_SECRET to seed_tpcds.py and seed_tpcds.py falls back to
  # $S3_ENDPOINT — but none of the three were listed here, so the CDC APPEND
  # resolved the bucket against real AWS and died:
  #   s3fs ... FileNotFoundError: The specified bucket does not exist
  # With no append there is no delta, so every query fell back to a full
  # re-author (mode='no-delta') and the delta-merge path — the whole point of
  # this suite — was never exercised while the run still reported DONE.
  # Pin the CDC seeder's S3 endpoint to the node's OWN gateway over loopback:
  # the tick writes both the parquet DATA and the Iceberg METADATA there, and on
  # a cloud VM the published fleet endpoint (fleet-<id>.blimp.software:9443 -> the
  # node's own public IP) can't hairpin, while the catalog vends the container-only
  # name minioserver:9000 which the host can't resolve. endpoint_local() rewrites
  # to loopback ONLY when loopback actually serves the port, so a genuinely-remote
  # external source is left untouched. Mirrors the --setup fix.
  local Q_S3_ENDPOINT; Q_S3_ENDPOINT="$(endpoint_local "${S3_ENDPOINT:-http://$GW:9000}")"
  run_query_suite(){
    env GW="$GW" CLUSTER_ID="$CLUSTER_ID" ICEBERG_URL="$ICEBERG_URL" WAREHOUSE="$WAREHOUSE" \
      NAMESPACE="${NAMESPACE:-tpcds}" REGION="${REGION:-ap-south-1}" \
      S3_ENDPOINT="$Q_S3_ENDPOINT" MV_S3_ENDPOINT="$Q_S3_ENDPOINT" S3_KEY="${S3_KEY:-}" S3_SECRET="${S3_SECRET:-}" \
      QAPI="${QAPI:-}" TOKEN="${TOKEN:-}" CLUSTER_TOKEN="${CLUSTER_TOKEN:-}" SOURCE="${SOURCE:-}" GW_AK="${GW_AK:-}" GW_SK="${GW_SK:-}" \
      QNRS="$1" SUITES="${SUITES:-}" CDC_ROWS="${CDC_ROWS:-5000}" \
      SQL_FILES="${SQL_FILES:-}" CDC_TICK_CMD="${CDC_TICK_CMD:-}" \
      ICEBERG_PREFIX="${ICEBERG_PREFIX:-}" ICEBERG_URL_LOCAL="${ICEBERG_URL_LOCAL:-}" \
      VERIFY="${VERIFY:-0}" FORCE_AUTHOR="${FORCE_AUTHOR:-0}" EVICT="${EVICT:-0}" bash "$HERE/test_query.sh"
  }
  # ONE QUERY AT A TIME. A batch runs phase 1 for every query, ONE append, then
  # phase 3 for every query — so a slow cold author holds every other query's
  # tick hostage, the append lands in whichever query's window it happens to
  # hit, and a "tick" line cannot be tied to that query's own merge (q4 reported
  # incr_query=2ms merge=– in a 12-query batch: nothing merged, 2026-09-22).
  # Each query gets its own serve → append → tick. An explicit SUITES or --sql
  # run is left as given.
  local qs=(${QNRS:-}) q rc=0
  if [ -n "${SUITES:-}" ] || [ -n "${SQL_FILES:-}" ] || [ "${#qs[@]}" -le 1 ]; then
    run_query_suite "${QNRS:-}"; return $?
  fi
  for q in "${qs[@]}"; do
    echo "######## q$q — serve, append, tick ########"
    run_query_suite "$q" || rc=$?
  done
  return $rc
}

cmd_bench(){
  need_env
  : "${GW:?}" "${CLUSTER_ID:?}" "${ICEBERG_URL:?}" "${WAREHOUSE:?}"
  preflight 0 0
  # statistical profile: one-time author_ms + materialize_ms, and per-append
  # delta_merge_ms + materialize_ms (min/median/avg/max). Tune ITERS / AUTHOR_ITERS
  # / CDC_ROWS to size the sweep and the delta.
  # One bench_incremental.sh run per query of the selected batch (default
  # --first-10; --second-40/--third-30/--fourth-19/--all/--queries stack). An
  # explicit BENCH_QNR=<n> in the env still benches that single query.
  local q rc=0
  for q in ${BENCH_QNR:-$QNRS}; do
  env GW="$GW" GW_AK="${GW_AK:-}" GW_SK="${GW_SK:-}" CLUSTER_ID="$CLUSTER_ID" \
    ICEBERG_URL="$ICEBERG_URL" WAREHOUSE="$WAREHOUSE" NAMESPACE="${NAMESPACE:-tpcds}" \
    REGION="${REGION:-ap-south-1}" ITERS="${ITERS:-3}" AUTHOR_ITERS="${AUTHOR_ITERS:-3}" \
    S3_ENDPOINT="${S3_ENDPOINT:-}" S3_KEY="${S3_KEY:-}" S3_SECRET="${S3_SECRET:-}" \
    BENCH_QNR="$q" Q_DIR="${Q_DIR:-$HOME/tpcds_queries}" \
    BENCH_FACT="${BENCH_FACT:-}" \
    CDC_ROWS="${CDC_ROWS:-50000}" bash "$HERE/bench_incremental.sh" || rc=$?
  done
  return $rc
}

# Flags may follow the command: `blimp --query --evict`. There is no --verify:
# a run is always the PRODUCTION path — the gateway does no verification while
# serving, so a run measures what customers actually get. Correctness is gated
# at AUTHOR time by the row-hash an MV must pass before it banks.
# LIBRARY MODE: `BLIMP_LIB_ONLY=1 . ./blimp` defines every function and then
# stops, without parsing argv or running a command. test_setup_options.sh uses
# this to unit-test the setup choices; nothing else should set it.
if [ "${BLIMP_LIB_ONLY:-0}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

CMD="${1:-}"; shift 2>/dev/null || true
pending=""   # name of the variable the NEXT argument fills (--queries "3 7 19")
for f in "$@"; do
  # --update / --update-log take their own sub-arguments (service lists,
  # --tag svc=tag, --dry-run, an update id); cmd_update validates them.
  case "$CMD" in --update|update|--update-log) break ;; esac
  if [ -n "$pending" ]; then
    printf -v "$pending" '%s' "$f"; export "$pending"; pending=""; continue
  fi
  case "$f" in
    # --verify is GONE (2026-09-19). It set VERIFY=1, whose only effect was
    # bench_cdc.sh's phase 4, "verify the merged MV against the source": a full
    # original scan per query, measured at 42 min on q72 and the single biggest
    # cost in every fix-and-prove cycle. The verification that actually gates
    # correctness is the author's row-hash before banking, which is unaffected.
    # Refuse it loudly rather than ignore it, so a stale script is fixed and not
    # silently slowed.
    --verify)
      echo "blimp: --verify was removed — verification happens at AUTHOR time and always runs." >&2
      echo "       The flag only added a phase-4 re-verify of the merged MV against source (tens of minutes per query)." >&2
      exit 2 ;;
    --force-author) FORCE_AUTHOR=1; export FORCE_AUTHOR ;;
    # --evict: genuine cold state — evict each query's MV(s) via /admin/mv/evict
    # before phase 1 so it re-authors from the recipe library. force_author was
    # removed from the gateway (2026-07-31); this is the only real cold path.
    --evict)        EVICT=1; export EVICT ;;
    # --queries "3 7 19": the TPC-DS query numbers to run (default: the proven
    # delta-merge set). --append-rows N: base rows for the CDC tick (default 5000).
    --queries)      pending=QNRS ;;
    # --sql <file|dir>: run ANY SQL against the wired source (author → verify →
    # append → merge → serve); the query's tables and fact are derived from the
    # SQL + catalog. --tick-cmd '<cmd>': your own streamer does the phase-2
    # append (default: the TPC-DS seeder for the test set).
    --sql)          pending=SQL_FILES ;;
    --sql=*)        SQL_FILES="${f#--sql=}"; export SQL_FILES ;;
    --tick-cmd)     pending=CDC_TICK_CMD ;;
    --tick-cmd=*)   CDC_TICK_CMD="${f#--tick-cmd=}"; export CDC_TICK_CMD ;;
    --first-10|--second-40|--third-30|--fourth-19)
                    QNRS="${QNRS:+$QNRS }${f#--}"; export QNRS ;;
    --all)          QNRS="$(seq -s ' ' 1 99)"; export QNRS ;;
    --queries=*)    QNRS="${f#--queries=}"; export QNRS ;;
    --append-rows)  pending=CDC_ROWS ;;
    --append-rows=*) CDC_ROWS="${f#--append-rows=}"; export CDC_ROWS ;;
    # Positional sub-arg for --encryption / --immutable (on|off|status); consumed
    # by the dispatch below, not a global flag.
    on|off|true|false|1|0|status) : ;;
    *)              echo "unknown flag: $f"; exit 2 ;;
  esac
done
[ -z "$pending" ] || { echo "flag --${pending,,} needs a value"; exit 2; }

# Named suites: a --queries token (or --first-10/--second-40/--third-30/--fourth-19)
# that names a file under suites/ expands to the numbers in that file, so a release
# list lives in the repo once instead of being retyped on every box.
resolve_suite_names(){
  local out="" t f
  for t in ${QNRS:-}; do
    f="$HERE/suites/$t"
    if [ -f "$f" ]; then out="$out $(grep -v '^#' "$f" | tr '\n' ' ')"
    else out="$out $t"; fi
  done
  QNRS="$(echo $out)"; export QNRS
}
# Default batch for a query run is first-10 (a --queries/batch flag overrides).
case "$CMD" in --query|query|--bench|bench) [ -n "${QNRS:-}" ] || QNRS=first-10 ;; esac
[ -z "${QNRS:-}" ] || resolve_suite_names

# cmd_acid — linearizability (ACID) check of the node's three data paths.
# For each endpoint it runs the porcupine model checker under two profiles:
#   single-writer : one client writes a key, N clients read it concurrently —
#                   the read-after-write property an object store actually
#                   promises. A stale/torn read here is a REAL consistency bug.
#   multi-writer  : all clients write AND read the same keys — a stricter
#                   total-order probe. (Some completed-op errors here are just
#                   the FUSE client refusing concurrent writers to one key; the
#                   verdict is over the ops that COMPLETED.)
# LINEARIZABLE on every endpoint == the gateway+mp-s3 stack preserves
# read-after-write and never exposes a torn erasure-decode under load.
cmd_acid(){
  need_env
  : "${GW:?gateway missing in wiring}"
  preflight 1 0
  [ -n "${GW_AK:-}" ] || GW_AK=$(ask GW_AK "Gateway S3 access key")
  [ -n "${GW_SK:-}" ] || GW_SK=$(ask GW_SK "Gateway S3 secret key")
  [ -n "${GW_AK:-}" ] && [ -n "${GW_SK:-}" ] || die "gateway S3 credentials required (GW_AK/GW_SK)"
  ensure_acid_tools || die "porcupine checker unavailable — run 'blimp --setup'"
  local CL="${ACID_CLIENTS:-8}" KEYS="${ACID_KEYS:-4}" DUR="${ACID_DURATION:-45s}"
  local S3_PORT="${S3_PORT:-9000}"
  local MP="${ACID_MPS3_MNT:-/mnt/mps3-acid}" BKT="${ACID_BUCKET:-blimp-acid}"
  export AWS_ACCESS_KEY_ID="$GW_AK" AWS_SECRET_ACCESS_KEY="$GW_SK" AWS_REGION=us-east-1
  aws s3 mb "s3://$BKT" --endpoint-url "http://$GW:$S3_PORT" >/dev/null 2>&1 || true

  # ── ACID must be ARMED for this test, and only for this test ───────────────
  #
  # The gateway defaults ZS3_ACID_ALL to OFF (2026-08-06): the warp benchmark
  # that argued strict whole-file verify was free is the same tool that produced
  # the phantom EOF errors, so it cannot be used to justify paying that cost on
  # every deployment. A linearizability test against a gateway with ACID off is
  # measuring the wrong configuration and will report torn reads that say
  # nothing about the ACID path.
  #
  # So: turn it ON here, and turn it back OFF when we are done — including on
  # failure or Ctrl-C, via the trap. POST /admin/acid is a RUNTIME pin and is
  # NOT persisted, so a gateway restart reverts to ZS3_ACID_ALL regardless;
  # this only affects the live process for the duration of the run.
  acid_pin(){ # <true|false>
    curl -s -m 15 -o /dev/null -X POST "http://$GW:$S3_PORT/admin/acid" \
      -H "Authorization: Bearer ${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" -H "Content-Type: application/json" \
      -d "{\"enabled\":$1}" 2>/dev/null || true
  }
  ACID_WAS=$(curl -s -m 15 "http://$GW:$S3_PORT/admin/acid" \
    -H "Authorization: Bearer ${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" 2>/dev/null | grep -o '"enabled":[a-z]*' | cut -d: -f2)
  [ -n "$ACID_WAS" ] || ACID_WAS=false
  bold "== arming ACID for the test (was: $ACID_WAS) =="
  acid_pin true
  # Restore on ANY exit path — a test that leaves the gateway pinned would make
  # every later benchmark measure the ACID cost without saying so.
  trap 'bold "== restoring ACID to $ACID_WAS =="; acid_pin "$ACID_WAS"' RETURN INT TERM

  # Per-leg verdict tracking. The summary MUST reflect what actually happened —
  # a leg is one of: PASS (RESULT: LINEARIZABLE), FAIL (NOT LINEARIZABLE / any
  # result=Illegal), or NO-RESULT (the checker produced no verdict at all —
  # e.g. the endpoint was unreachable). A NO-RESULT leg is NOT a
  # pass and must never be reported as one.
  local acid_pass=0 acid_fail=0 acid_noresult=0 acid_bad=""
  run_one(){ # <label> <profile> <cmd...>
    local label="$1" profile="$2"; shift 2
    local out; out=$("$@" 2>&1)
    printf '%s\n' "$out" | grep -E 'RESULT|Illegal' | head -3
    if printf '%s\n' "$out" | grep -q 'RESULT: LINEARIZABLE'; then
      acid_pass=$((acid_pass+1))
    elif printf '%s\n' "$out" | grep -qE 'NOT LINEARIZABLE|result=Illegal'; then
      acid_fail=$((acid_fail+1)); acid_bad="$acid_bad|FAIL $label/$profile"
    else
      # A NO-RESULT leg means ptest died BEFORE any verdict — almost always the
      # seed PUT. Its reason is the whole diagnosis, so print it: greping only
      # for RESULT threw the error away and left the leg silently unexplained.
      printf '%s\n' "$out" | grep -v '^$' | tail -2 | sed 's/^/     ! /'
      acid_noresult=$((acid_noresult+1)); acid_bad="$acid_bad|NO-RESULT $label/$profile"
    fi
  }
  run_leg(){ # <label> <extra ptest args...>
    local label="$1"; shift
    echo; bold "== $label =="
    echo "-- single-writer (${CL}c/${KEYS}k/${DUR}) --"
    run_one "$label" single "$ACID_BIN" -bucket "$BKT" -access-key "$GW_AK" -secret-key "$GW_SK" \
      -clients "$CL" -keys "$KEYS" -duration "$DUR" -single-writer "$@"
    echo "-- multi-writer (${CL}c/${KEYS}k/${DUR}) --"
    run_one "$label" multi "$ACID_BIN" -bucket "$BKT" -access-key "$GW_AK" -secret-key "$GW_SK" \
      -clients "$CL" -keys "$KEYS" -duration "$DUR" "$@"
  }

  bold "ACID / linearizability — node $GW  (bucket s3://$BKT)"
  run_leg "gateway S3 :$S3_PORT"  -mode s3     -endpoint "$GW:$S3_PORT"


  # mountpoint-s3 leg — mount the bucket as a filesystem over the gateway S3 and
  # run the file backend against it. Always remount (a stale FUSE endpoint reads
  # as "mounted"). mount-s3 default trailing checksums exercise the gateway's
  # aws-chunked-trailer decode path on write.
  if command -v mount-s3 >/dev/null 2>&1; then
    sudo mkdir -p "$MP"
    grep -qs '^user_allow_other' /etc/fuse.conf || echo user_allow_other | sudo tee -a /etc/fuse.conf >/dev/null 2>&1 || true
    fusermount -u "$MP" 2>/dev/null || sudo umount -l "$MP" 2>/dev/null || true
    if sudo -E env AWS_ACCESS_KEY_ID="$GW_AK" AWS_SECRET_ACCESS_KEY="$GW_SK" \
         mount-s3 --allow-other --force-path-style --endpoint-url "http://$GW:$S3_PORT" \
         --allow-delete --allow-overwrite --metadata-ttl minimal "$BKT" "$MP"; then
      echo; bold "== mountpoint-s3 (over :$S3_PORT) =="
      echo "-- single-writer (${CL}c/${KEYS}k/${DUR}) --"
      run_one "mountpoint-s3" single sudo "$ACID_BIN" -mode mounts3 -dir "$MP" -clients "$CL" -keys "$KEYS" -duration "$DUR" -single-writer
      echo "-- multi-writer (${CL}c/${KEYS}k/${DUR}) --"
      run_one "mountpoint-s3" multi sudo "$ACID_BIN" -mode mounts3 -dir "$MP" -clients "$CL" -keys "$KEYS" -duration "$DUR"
      fusermount -u "$MP" 2>/dev/null || sudo umount -l "$MP" 2>/dev/null || true
    else
      echo "!! mountpoint-s3 leg SKIPPED: could not mount s3://$BKT at $MP"; acid_noresult=$((acid_noresult+1)); acid_bad="$acid_bad|NO-RESULT mountpoint-s3/mount"
    fi
  else
    echo "!! mountpoint-s3 leg SKIPPED: mount-s3 not installed (run 'blimp --setup')"; acid_noresult=$((acid_noresult+1)); acid_bad="$acid_bad|NO-RESULT mountpoint-s3/mount"
  fi

  # Summary — reflects the ACTUAL per-leg verdicts, and exits non-zero on any
  # failure (so CI and `&&` chains catch it). A fixed "LINEARIZABLE on every
  # leg" banner regardless of results was a false-pass bug.
  echo
  local legs_bad; legs_bad=$(printf '%s' "$acid_bad" | tr '|' '\n' | sed '/^$/d; s/^/    /')
  if [ "$acid_fail" -gt 0 ]; then
    printf '\033[31m\033[1mACID check: NOT LINEARIZABLE — %d leg(s) FAILED (%d passed, %d no-result). Torn/stale reads observed.\033[0m\n' "$acid_fail" "$acid_pass" "$acid_noresult"
    printf '%s\n' "$legs_bad"
    return 1
  elif [ "$acid_noresult" -gt 0 ]; then
    printf '\033[33m\033[1mACID check: %d leg(s) LINEARIZABLE, but %d produced NO result — NOT a clean pass:\033[0m\n' "$acid_pass" "$acid_noresult"
    printf '%s\n' "$legs_bad"
    echo "    (a NO-RESULT leg = endpoint unreachable; investigate)"
    return 2
  else
    bold "ACID check complete — LINEARIZABLE on all $acid_pass legs: read-after-write preserved, no torn reads."
  fi
}

# cmd_encryption — toggle at-rest write encryption on the gateway (runtime pin,
# not persisted; zs3server.json "encrypt" governs restarts). Goes browser-free
# THROUGH the gateway, like --acid. `status`/no-arg reads the current state.
cmd_encryption(){
  need_env   # source the wiring (GW / CLUSTER_ID / CLUSTER_TOKEN); without this
             # $CLUSTER_ID is unbound under `set -u` and every call aborts.
  local a="${1:-status}" S3_PORT="${S3_PORT:-9000}" en
  local tok="${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}"
  case "$a" in
    on|true|1)   en=true ;;
    off|false|0) en=false ;;
    status|"")
      printf 'encryption: '; curl -s -m 10 "http://$GW:$S3_PORT/admin/encryption" \
        -H "Authorization: Bearer $tok"; echo; return 0 ;;
    *) echo "usage: blimp --encryption on|off|status"; return 2 ;;
  esac
  curl -s -m 15 -X POST "http://$GW:$S3_PORT/admin/encryption" \
    -H "Authorization: Bearer $tok" -H "Content-Type: application/json" -d "{\"enabled\":$en}"; echo
}

# cmd_immutable — toggle allocation immutability (on-chain update_allocation
# file_options via the gateway). Reversible: on = upload-only (forbid the mutating
# ops update/delete/copy/move/rename; uploads, downloads and shares STILL allowed —
# file_options=1), off = allow all ops (file_options=63).
# Set ALLOC_ID to target a specific allocation; newer gateways default to their
# own allocation when it's omitted.
cmd_immutable(){
  need_env   # source the wiring (GW / CLUSTER_ID / CLUSTER_TOKEN); without this
             # $CLUSTER_ID is unbound under `set -u` and every call aborts.
  local a="${1:-}" S3_PORT="${S3_PORT:-9000}" im
  local tok="${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}"
  case "$a" in
    on|true|1)   im=true ;;
    off|false|0) im=false ;;
    *) echo "usage: blimp --immutable on|off   (optional: ALLOC_ID=<id>)"; return 2 ;;
  esac
  curl -s -m 40 -X POST "http://$GW:$S3_PORT/admin/onchain/immutable" \
    -H "Authorization: Bearer $tok" -H "Content-Type: application/json" \
    -d "{\"allocation_id\":\"${ALLOC_ID:-}\",\"immutable\":$im}"; echo
}

# cmd_gc — reclaim orphaned blobber storage. Triggers the gateway's fleet orphan
# sweep (drain pending-reap + physical reconcile of /.fleet/blobs vs the dedup
# index), which deletes content-blobs no object references — e.g. left behind
# when a delete could not run because the disk was write-degraded. Loops until a
# pass reclaims nothing. Reads GW + CLUSTER_TOKEN from the wiring file.
cmd_gc(){
  need_env
  : "${GW:?gateway missing in wiring — run 'blimp --setup'}"
  local S3_PORT="${S3_PORT:-9000}" tok="${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}"
  local url="http://$GW:$S3_PORT/admin/fleet/orphan-sweep"
  if [ "$(curl -s -o /dev/null -w '%{http_code}' -m 10 "http://$GW:$S3_PORT/minio/health/live" 2>/dev/null)" != 200 ]; then
    die "gateway $GW:$S3_PORT unreachable — check GW= in $ENVF and the security group"
  fi
  echo "== fleet blobber GC (orphan sweep) on $GW =="
  local total=0 pass=0 r n
  while :; do
    pass=$((pass+1))
    r=$(curl -s -m 900 -X POST "$url" -H "Authorization: Bearer $tok" 2>&1)
    n=$(printf '%s' "$r" | sed -n 's/.*"reclaimed":\([0-9][0-9]*\).*/\1/p')
    case "$n" in
      ''|*[!0-9]*) echo "  pass $pass: unexpected response: $r"; return 1 ;;
    esac
    echo "  pass $pass: reclaimed $n blob(s)"
    total=$((total+n))
    [ "$n" -eq 0 ] && break
    [ "$pass" -ge 30 ] && { echo "  (stopping after 30 passes; re-run 'blimp --gc' to continue)"; break; }
  done
  echo "== done: reclaimed $total orphan blob(s) =="
}

# --update: drive the node's own updater (zs3-init --update) through the
# zus-cdc helper on :9401. The node does the work (backup, rm→up, alias
# re-attach, health checks, rollback); this just submits, polls, and tails.
cmd_update(){
  need_env
  : "${GW:?gateway missing in wiring — run 'blimp --setup'}"
  local tok="${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" base="http://$GW:${CDC_PORT:-9401}"
  local what="" dry=0 tags="" a
  while [ $# -gt 0 ]; do
    a="$1"; shift
    case "$a" in
      --dry-run) dry=1 ;;
      --tag)     tags="${tags:+$tags,}${1:?--tag needs svc=tag}"; shift ;;
      --tag=*)   tags="${tags:+$tags,}${a#--tag=}" ;;
      status|all|zs3*|eblobber*|nessie*|gotenberg*|rclone*) what="$a" ;;
      *) die "unknown --update argument: $a (see blimp --help)" ;;
    esac
  done
  [ -n "$what" ] || what="status"
  if [ "$(curl -s -o /dev/null -w '%{http_code}' -m 10 "$base/update/status" -H "Authorization: Bearer $tok")" = 403 ]; then
    die "node helper rejected the token — check CLUSTER_TOKEN in $ENVF"
  fi
  if [ "$what" = status ]; then
    echo "== node $GW: running versions =="
    curl -s -m 120 "$base/update/status" -H "Authorization: Bearer $tok" \
      | python3 -c '
import sys,json
d=json.load(sys.stdin)
if "error" in d: print("error:", d["error"]); sys.exit(1)
for c in d.get("components",[]):
    print("  %-10s %-9s %-28s %s" % (c["name"], c["status"], c["kind"][:28], (c.get("image") or c.get("detail") or "")[:70]))
st=d.get("storage") or []
if st:
    print("  storage (what each data path is mounted on):")
    for m in st:
        print("    %-22s %-9s %-9s %s %s" % (m.get("path",""), m.get("fstype",""), m.get("class",""), (m.get("devices") or m.get("source","")), ("["+m["note"]+"]") if m.get("note") else ""))
print("  updatable:", ", ".join(d.get("updatable",[])), " active update:", d.get("active_update") or "none")'
    return $?
  fi
  local tagjson="{}"
  [ -n "$tags" ] && tagjson=$(printf '%s' "$tags" | python3 -c 'import sys,json;print(json.dumps(dict(kv.split("=",1) for kv in sys.stdin.read().strip().split(",") if kv)))')
  local body id r
  body=$(printf '{"services":"%s","tags":%s,"dry_run":%s}' "$what" "$tagjson" "$([ $dry = 1 ] && echo true || echo false)")
  r=$(curl -s -m 30 -X POST "$base/update/run" -H "Authorization: Bearer $tok" -H 'Content-Type: application/json' -d "$body")
  id=$(printf '%s' "$r" | sed -n 's/.*"id": *"\([^"]*\)".*/\1/p')
  case "$r" in *'"error"'*) die "node refused: $r" ;; esac
  [ -n "$id" ] || die "unexpected response: $r"
  echo "== update $id submitted to $GW: services=$what tags=${tags:-none} dry_run=$dry =="
  local seen=0 st="running" log n
  while [ "$st" = running ]; do
    sleep 5
    log=$(curl -s -m 20 "$base/update/log?id=$id&token=$tok"); n=$(printf '%s\n' "$log" | grep -c .)
    [ "$n" -gt "$seen" ] && { printf '%s\n' "$log" | tail -n +"$((seen+1))" | grep -E '\[update\]|\[rclone\]|FAIL|rolled back' | sed 's/^/  /'; seen=$n; }
    st=$(curl -s -m 20 "$base/update/state?id=$id&token=$tok" | sed -n 's/.*"status": *"\([a-z]*\)".*/\1/p')
    [ -n "$st" ] || st=running
  done
  echo "== update $id: $st ==  (full log: blimp --update-log $id)"
  [ "$st" = ok ]
}

case "$CMD" in
  --setup)            cmd_setup ;;
  --update|update)    cmd_update "$@" ;;
  --update-log)       need_env; curl -s -m 20 "http://$GW:${CDC_PORT:-9401}/update/log?id=${1:?id}&token=${CLUSTER_TOKEN:?fleet token required (node file /opt/0chain/zs3server/environment/admin_token or the panel API token)}" ;;
  --storage|storage)  cmd_storage ;;
  --acid|acid)        cmd_acid ;;
  --encryption|encryption) cmd_encryption "${1:-}" ;;
  --immutable|immutable)   cmd_immutable "${1:-}" ;;
  --gc|gc)            cmd_gc ;;
  --query|query)      cmd_query ;;
  --bench|bench)      cmd_bench ;;
  ""|-h|--help|help)  usage ;;
  *)                  echo "unknown command: $1"; echo; usage; exit 2 ;;
esac
