#!/bin/bash
# tpc_all — run TPC-DS queries ONE AT A TIME through blimp, the way the SF1000
# benchmark is run:
#   1. blimp --query --tpc N --evict-family   cold: evict the query's MV family,
#                                             author (+ the author's row-hash
#                                             verify), append, tick 1
#   2. blimp --query --tpc N --verify         steady state: append, tick 2, then
#                                             compare the tick's answer with the
#                                             original query over base
# and prints one summary line per query.
#
# usage: ./tpc_all                 all 99
#        ./tpc_all "3 7 19"        a subset
# env:   TPC_ALL_OUT  log directory (default ./tpc_all_logs)
#        BLIMP_ENV    wiring file, as for blimp
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
QS="${1:-$(seq -s ' ' 1 99)}"
OUT="${TPC_ALL_OUT:-./tpc_all_logs}"; mkdir -p "$OUT"
SUM="$OUT/summary.txt"; : > "$SUM"

# b <q> <flag> <log>: one blimp run, every output line stamped with epoch seconds
b(){ "$HERE/blimp" --query --tpc "$1" $2 2>&1 | while IFS= read -r l; do printf '%(%s)T %s\n' -1 "$l"; done > "$3"; }

for q in $QS; do
  t0=$(date +%s)
  echo "== q$q $(date -u +%T)"
  b "$q" --evict-family "$OUT/q${q}_1.log"
  b "$q" --verify       "$OUT/q${q}_2.log"
  # author = wall seconds from phase 1 to phase 2 of the cold run (covers the
  # author's build, its row-hash verify and the drain of its background work)
  aw=$(awk '/>> phase 1/{a=$1} />> phase 2/{if(a){print $1-a; exit}}' "$OUT/q${q}_1.log")
  av=$(grep -m1 -oE "q$q: author=[0-9?]+ materialize=[0-9?]+ verify=[0-9?]+" "$OUT/q${q}_1.log" | sed 's/.*verify=//')
  case "$av" in ''|'?') ;; *) av=$(awk -v m="$av" 'BEGIN{printf "%.1f", m/1000}') ;; esac
  t1=$(grep -oE "q$q: tick: [0-9.]+" "$OUT/q${q}_1.log" | tail -1 | awk '{print $3}')
  t2=$(grep -oE "q$q: tick: [0-9.]+" "$OUT/q${q}_2.log" | tail -1 | awk '{print $3}')
  v=$(grep -oE "q$q: verify: [A-Z()a-z]+" "$OUT/q${q}_2.log" | tail -1 | awk '{print $3}')
  printf 'q%-3s author=%ss verify=%ss tick1=%ss tick2=%ss result=%s wall=%ss\n' \
    "$q" "${aw:-?}" "${av:-?}" "${t1:-?}" "${t2:-?}" "${v:-?}" "$(( $(date +%s) - t0 ))" | tee -a "$SUM"
done
echo; echo "== summary ($(wc -l < "$SUM") queries; logs in $OUT)"; cat "$SUM"
